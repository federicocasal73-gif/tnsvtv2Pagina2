# .env.example
#
# TNSVT V2 — Environment variables template.
#
# This file is COMMITTED to the repo. It contains ONLY placeholders.
# Real values live in:
#   - .env.local   (gitignored, plain text, dev)
#   - Symfony Secrets vault (encrypted, prod) — `bin/console secrets:set`
#
# See docs/SECURITY.md for the rotation protocol.
# See docs/DEPLOYMENT.md for production setup.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_ME_32_BYTES_HEX
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://tnsvt.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Examples (uncomment the one that matches your DB):
#   SQLite (dev):
#DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
#   MySQL:
#DATABASE_URL="mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:3306/CHANGE_ME_DB?serverVersion=8.0.32&charset=utf8mb4"
#   PostgreSQL:
#DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME_GENERATE_VIA_OPENSSL
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Comma-separated regex of allowed origins. Production should be tight.
CORS_ALLOW_ORIGIN='^https?://tnsvt\.com$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> tnsvt ###
# Single admin password (kills ACADEMIA_ADMIN_PASS - unified admin auth per spec)
ADMIN_PASSWORD=CHANGE_ME_USE_PASSWORD_MANAGER
###< tnsvt ###

###> tnsvt/app-version ###
APP_VERSION=2.0.0
APP_VERSION_CODE=500
APP_DOWNLOAD_URL=https://tnsvt.com/api/app/download-web
APP_RELEASE_NOTES=See CHANGELOG.md or docs/INTEGRATION-NOTES.md
###< tnsvt/app-version ###

###> firebase/push-notifications ###
FIREBASE_CREDENTIALS_PATH=var/firebase/service-account.json
FIREBASE_WEB_API_KEY=CHANGE_ME_FROM_FIREBASE_CONSOLE
FIREBASE_AUTH_DOMAIN=tnsvt-web.firebaseapp.com
FIREBASE_PROJECT_ID=tnsvt-web
FIREBASE_STORAGE_BUCKET=tnsvt-web.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
FIREBASE_APP_ID=CHANGE_ME
FIREBASE_WEB_PUSH_VAPID_KEY=CHANGE_ME
###< firebase/push-notifications ###

###> symfony/mercure ###
# Production uses a real Mercure hub. For local dev, can use the bundled one.
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_JWT_SECRET=CHANGE_ME_32_BYTES_HEX_NOT_DEV_SECRET
###< symfony/mercure ###

###> sentry/sentry-symfony ###
# Sentry error tracking (https://sentry.io). Leave SENTRY_DSN empty to disable.
# Set the real DSN in .env.local for production (never commit).
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
###< sentry/sentry-symfony ###

###> tnsvt/link-preview ###
LINK_PREVIEW_CACHE_TTL=86400
LINK_PREVIEW_MAX_DOWNLOAD=2097152
LINK_PREVIEW_HTTP_TIMEOUT=5.0
LINK_PREVIEW_UPLOAD_DIR=public/uploads/link-previews
###< tnsvt/link-preview ###

###> tnsvt email ###
APP_SERVER_URL=https://tnsvt.com
APP_EMAIL_FROM=no-reply@tnsvt.app
APP_EMAIL_FROM_NAME=T.N.S.V.T
###< tnsvt email ###

###> legacy-migration ###
# Connection string for the legacy tnsvt.com DB.
# Used by Migration\LegacyDataMigrator during one-time migrations.
# Set in .env.local or Symfony Secrets (NEVER committed).
# LEGACY_DATABASE_URL=
###< legacy-migration ###
