<script>
(function() {
      // Active nav highlight: match both exact path and data-page prefix so
      // that /sanctum/guardian/anything still marks Guardian as active, etc.
      (function markActiveNav() {
          const path = window.location.pathname.replace(/\/+$/, '') || '/';
          const links = document.querySelectorAll('#sanctum-sidebar .sanctum-link[data-page]');
          let bestMatch = null;
          let bestLen = -1;
          links.forEach(a => {
              const href = (a.getAttribute('href') || '').replace(/\/+$/, '') || '/';
              if (path === href || path.startsWith(href + '/') || href === '/' && path.startsWith('/')) {
                  if (href.length > bestLen) {
                      bestMatch = a;
                      bestLen = href.length;
                  }
              }
          });
          if (bestMatch) {
              bestMatch.classList.add('active');
              bestMatch.setAttribute('aria-current', 'page');
          }
          // Scroll the active item into view inside the .sanctum-nav
          // scroll container (only if it would be clipped). We do this on
          // load so the active page is visible even on a long menu where
          // the active section sits past the viewport.
          if (bestMatch) {
              requestAnimationFrame(() => {
                  const nav = bestMatch.closest('.sanctum-nav');
                  if (!nav) return;
                  const navRect = nav.getBoundingClientRect();
                  const itemRect = bestMatch.getBoundingClientRect();
                  if (itemRect.top < navRect.top || itemRect.bottom > navRect.bottom) {
                      bestMatch.scrollIntoView({ block: 'center' });
                  }
              });
          }
      })();

    // Load user info from session via /api/auth/check (using robust helper)
    if (window.apiFetch) {
        apiFetch('/api/auth/check').then(r => {
            if (r.ok && r.data && r.data.user) {
                const u = r.data.user;
                window.TNSVT_USER = u;
                window.dispatchEvent(new CustomEvent('tnsvt:user-loaded', { detail: u }));
                const code = (u.code || '??').slice(0, 2);
                const avatarEl = document.getElementById('user-avatar');
                const nameEl = document.getElementById('user-name');
                if (avatarEl) avatarEl.textContent = code;
                if (nameEl) nameEl.textContent = u.name || u.code;
                const tierEl = document.getElementById('user-tier');
                if (tierEl) {
                    tierEl.textContent = (u.tier || 'INITIATE');
                    tierEl.className = 'tier-badge-elev tier-' + (u.tier || 'INITIATE').toLowerCase().replace(/_/g, '-');
                }
            } else if (r.status === 401) {
                const nameEl = document.getElementById('user-name');
                if (nameEl) nameEl.textContent = 'Sin sesión';
                window.TNSVT_USER = null;
            } else if (!r.ok) {
                const nameEl = document.getElementById('user-name');
                if (nameEl) nameEl.textContent = '—';
            }
        });
    }

    // Logout
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) logoutBtn.addEventListener('click', async function() {
        if (await apiConfirm('¿Cerrar sesión?', { title: 'Cerrar sesión', variant: 'danger' })) {
            apiFetch('/api/auth/logout', { method: 'POST', silent: true }).then(() => location.href = '/');
        }
    });

    // Notification badge in sidebar + topbar (poll every 60s)
    function refreshNotifBadge() {
        if (!window.TNSVT_USER) return;
        fetch('/sanctum/notifications/unread-count')
            .then(function(r) { return r.ok ? r.json() : { count: 0 }; })
            .then(function(data) {
                var n = (data && data.count) || 0;
                var label = n > 99 ? '99+' : n;
                var badge = document.getElementById('bell-badge');
                if (badge) {
                    badge.textContent = label;
                    badge.classList.toggle('hidden', n === 0);
                }
                var headerBadge = document.getElementById('header-notif-badge');
                if (headerBadge) {
                    headerBadge.textContent = label;
                    headerBadge.classList.toggle('hidden', n === 0);
                }
            }).catch(function() {});
    }
    refreshNotifBadge();
    setInterval(refreshNotifBadge, 60000);
})();
</script>

<script>
// Rail tooltip (sidebar collapsed ≤1024px)
(function() {
    const RAIL_BP = 1024;
    var tip = document.createElement('div');
    tip.id = 'sanctum-rail-tooltip';
    document.body.appendChild(tip);

    function show(link) {
        if (window.innerWidth > RAIL_BP) return;
        var label = link.querySelector('.sanctum-link-label');
        if (!label) return;
        tip.textContent = label.textContent;
        tip.classList.add('visible');
        var r = link.getBoundingClientRect();
        tip.style.left = (r.right + 12) + 'px';
        tip.style.top = Math.round(r.top + r.height / 2) + 'px';
    }
    function hide() { tip.classList.remove('visible'); }

    document.querySelectorAll('#sanctum-sidebar .sanctum-link').forEach(function(link) {
        link.addEventListener('mouseenter', function() { show(link); });
        link.addEventListener('mouseleave', hide);
        link.addEventListener('focus', function() { show(link); });
        link.addEventListener('blur', hide);
    });
    window.addEventListener('resize', hide);
})();
</script>

<script>
// Manual sidebar collapse/expand (user-driven, persisted in localStorage).
(function() {
    var btn = document.getElementById('sidebar-toggle');
    var aside = document.getElementById('sanctum-sidebar');
    if (!btn || !aside) return;
    var KEY = 'tnsvt_sidebar_collapsed';
    function apply(collapsed) {
        aside.classList.toggle('sidebar-manual-collapsed', collapsed);
        btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        btn.setAttribute('aria-label', collapsed ? 'Expandir menú' : 'Colapsar menú');
        var icon = btn.querySelector('.material-symbols-elev');
        if (icon) icon.textContent = collapsed ? 'chevron_right' : 'chevron_left';
        try { localStorage.setItem(KEY, collapsed ? '1' : '0'); } catch (_) {}
    }
    try {
        if (localStorage.getItem(KEY) === '1') apply(true);
    } catch (_) {}
    btn.addEventListener('click', function () {
        apply(aside.classList.contains('sidebar-manual-collapsed'));
    });
})();
</script>

