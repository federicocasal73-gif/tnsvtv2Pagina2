<!DOCTYPE html>
<html lang="es" class="dark" data-apk="false">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050308" />
<link rel="manifest" href="{{ asset('manifest.json') }}" />
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}" />
    <link rel="alternate icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Sanctum" />
    <link rel="apple-touch-icon" href="{{ asset('favicon.svg') }}" />
    <title>{% block title %}T.N.S.V.T — Sanctum{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/v2-sparklines.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/animations.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/glow.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/shell.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/accessibility.css') }}" />

    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-[var(--void-elev)] text-[var(--on-surface-elev)] font-['Space_Grotesk'] min-h-screen antialiased relative"
      data-controller="pwa">

{# ═══ FASE 0 — Fondo estrellado global (V2 identidad visual) ═══ #}
{# https://tnsvt.com necesita esta identidad en TODAS las páginas. #}
{% block background %}{% endblock %}
<script src="{{ asset('js/modules/webgl-background.js') }}" defer></script>

{# api_helper MUST be included BEFORE any {% block content %} to ensure window.apiFetch is defined #}
{% include '_partials/api_helper.html.twig' with {} %}

{# ═══ FASE 0 — Emblema 3D del gateway (solo home) ═══ #}
{% block gateway_emblem %}{% endblock %}

<div class="flex min-h-screen">
    <aside id="sanctum-sidebar" class="w-64 bg-[var(--surface-elev)] border-r border-[var(--outline-variant-elev)] flex flex-col">
        <div class="p-6 border-b border-[var(--outline-variant-elev)]">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg gold-glow-elev flex items-center justify-center bg-gradient-to-br from-[var(--gold-elev)] to-[var(--gold-bright-elev)]">
                    <span class="material-symbols-elev text-[var(--on-primary-elev)]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-wider text-[var(--on-surface-elev)]">T.N.S.V.T</h1>
                    <p class="text-xs text-[var(--outline-elev)] tracking-widest">SANCTUM</p>
                </div>
            </div>
        </div>

        <nav class="flex-1 overflow-y-auto py-4">
            {# ═══ ⌂ INICIO ═══ #}
            <a href="{{ path('sanctum_dashboard') }}" class="sanctum-link" data-page="dashboard">
                <span class="material-symbols-elev">dashboard</span>
                <span>Inicio</span>
            </a>

            {# ═══ 👤 MI CUENTA ═══ #}
            <div class="px-6 my-2 text-[10px] uppercase tracking-wider text-[var(--outline-elev)] opacity-40">Mi cuenta</div>
            <a href="/profile" class="sanctum-link" data-page="profile">
                <span class="material-symbols-elev">person</span>
                <span>Perfil</span>
            </a>
            <a href="{{ path('account_settings') }}" class="sanctum-link" data-page="account-settings">
                <span class="material-symbols-elev">settings</span>
                <span>Configuración</span>
            </a>
            <a href="{{ path('sanctum_notifications') }}" class="sanctum-link" data-page="notifications">
                <span class="material-symbols-elev">notifications_active</span>
                <span>Notificaciones</span>
                <span id="bell-badge" class="hidden ml-auto px-1.5 rounded-full bg-[var(--gold-elev)] text-black text-[0.65rem] font-bold leading-tight py-0.5">0</span>
            </a>

            {# ═══ ⚔ TRADING ═══ #}
            <div class="px-6 my-2 text-[10px] uppercase tracking-wider text-[var(--outline-elev)] opacity-40">Trading</div>
            <a href="/journal" class="sanctum-link" data-page="journal">
                <span class="material-symbols-elev">edit_note</span>
                <span>Journal</span>
            </a>
            <a href="/calendar" class="sanctum-link" data-page="calendar">
                <span class="material-symbols-elev">calendar_month</span>
                <span>Calendario</span>
            </a>
            <a href="/leaderboard" class="sanctum-link" data-page="leaderboard">
                <span class="material-symbols-elev">leaderboard</span>
                <span>Leaderboard</span>
            </a>

            {# ═══ 🎓 FORMACIÓN ═══ #}
            <div class="px-6 my-2 text-[10px] uppercase tracking-wider text-[var(--outline-elev)] opacity-40">Formación</div>
            <a href="/campus" class="sanctum-link" data-page="campus">
                <span class="material-symbols-elev">school</span>
                <span>Campus</span>
            </a>

            {# ═══ � MENTE & MACRO ═══ #}
            <div class="px-6 my-2 text-[10px] uppercase tracking-wider text-[var(--outline-elev)] opacity-40">Mente & Macro</div>
            <a href="/macro" class="sanctum-link" data-page="macro">
                <span class="material-symbols-elev">event_upcoming</span>
                <span>Macroeconomía</span>
            </a>
            <a href="/oracle" class="sanctum-link" data-page="oracle">
                <span class="material-symbols-elev">auto_awesome</span>
                <span>Oráculo</span>
            </a>
            <a href="/sanctum/guardian" class="sanctum-link" data-page="guardian">
                <span class="material-symbols-elev">shield_person</span>
                <span>Guardian</span>
            </a>
            <a href="/diario" class="sanctum-link" data-page="diario">
                <span class="material-symbols-elev">menu_book</span>
                <span>Diario</span>
            </a>
            <a href="/frequencies" class="sanctum-link">
                <span class="material-symbols-elev">graphic_eq</span>
                <span>Frecuencias</span>
            </a>

            {# ═══ 👥 COMUNIDAD ═══ #}
            <div class="px-6 my-2 text-[10px] uppercase tracking-wider text-[var(--outline-elev)] opacity-40">Comunidad</div>

            {# Social #}
            <div class="px-6 my-1 text-[9px] uppercase tracking-wider text-[var(--outline-elev)] opacity-30 pl-10">Social</div>
            <a href="/feed" class="sanctum-link" data-page="feed">
                <span class="material-symbols-elev">forum</span>
                <span>Feed</span>
            </a>
            <a href="{{ path('sanctum_social') }}" class="sanctum-link" data-page="social">
                <span class="material-symbols-elev">share</span>
                <span>Conexiones</span>
            </a>
            <a href="/chat" class="sanctum-link" data-page="chat">
                <span class="material-symbols-elev">chat</span>
                <span>Chat</span>
            </a>
            <a href="/clan" class="sanctum-link" data-page="clan">
                <span class="material-symbols-elev">groups</span>
                <span>Clanes</span>
            </a>

            {# Compete #}
            <div class="px-6 my-1 text-[9px] uppercase tracking-wider text-[var(--outline-elev)] opacity-30 pl-10">Compete</div>
            <a href="/tournaments" class="sanctum-link" data-page="tournaments">
                <span class="material-symbols-emoji">🏆</span>
                <span>Torneos</span>
            </a>
            <a href="/duels" class="sanctum-link" data-page="duels">
                <span class="material-symbols-elev">swords</span>
                <span>Duelos 1v1</span>
            </a>
            <a href="/game" class="sanctum-link" data-page="game">
                <span class="material-symbols-elev">sports_esports</span>
                <span>Game</span>
            </a>
            <a href="/honor" class="sanctum-link" data-page="honor">
                <span class="material-symbols-elev">military_tech</span>
                <span>Honor</span>
            </a>

            {# Wallet #}
            <div class="px-6 my-1 text-[9px] uppercase tracking-wider text-[var(--outline-elev)] opacity-30 pl-10">Wallet</div>
            <a href="/wallet" class="sanctum-link" data-page="wallet">
                <span class="material-symbols-elev">account_balance_wallet</span>
                <span>Wallet</span>
            </a>
            <a href="/shop" class="sanctum-link" data-page="shop">
                <span class="material-symbols-elev">store</span>
                <span>Tienda</span>
            </a>

            {# ═══ ⚙ ADMIN (solo visible para ROLE_ADMIN) ═══ #}
            {% if is_granted('ROLE_ADMIN') %}
            <div class="px-6 my-2 text-[10px] uppercase tracking-wider text-[var(--outline-elev)] opacity-40">Admin</div>
            <a href="{{ path('sanctum_users') }}" class="sanctum-link" data-page="users">
                <span class="material-symbols-elev">group</span>
                <span>Usuarios</span>
            </a>
            <a href="/sanctum/tasks" class="sanctum-link" data-page="tasks">
                <span class="material-symbols-elev">task_alt</span>
                <span>Tareas</span>
            </a>
            <a href="{{ path('sanctum_audit') }}" class="sanctum-link" data-page="audit">
                <span class="material-symbols-elev">shield</span>
                <span>Audit</span>
            </a>
            <a href="/sanctum/settings" class="sanctum-link" data-page="settings">
                <span class="material-symbols-elev">settings</span>
                <span>Settings</span>
            </a>
            <a href="/sanctum/monitoring" class="sanctum-link" data-page="monitoring">
                <span class="material-symbols-elev">monitoring</span>
                <span>Monitoring</span>
            </a>
            {% endif %}
        </nav>

        <div class="p-4 border-t border-[var(--outline-variant-elev)]">
            <div class="glass-card-elev p-3">
                <div class="flex items-center gap-3">
                    <div id="user-avatar" class="w-10 h-10 rounded-full bg-gradient-to-br from-[var(--gold-elev)] to-[var(--gold-bright-elev)] flex items-center justify-center text-[var(--on-primary-elev)] font-bold">
                        ?
                    </div>
                    <div class="flex-1 min-w-0">
                        <p id="user-name" class="text-sm font-medium text-[var(--on-surface-elev)] truncate">Cargando...</p>
                        <span id="user-tier" class="tier-badge-elev tier-initiate">—</span>
                    </div>
                </div>
                <button id="logout-btn" class="mt-2 w-full text-xs py-1 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-variant-elev)] hover:bg-[var(--glass-bg-strong-elev)]">
                    Cerrar sesión
                </button>
            </div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col">
    <header class="h-16 bg-[var(--surface-elev)] border-b border-[var(--outline-variant-elev)] flex items-center justify-between px-6">
        <div>
            <h2 class="text-cinzel-display text-xl tracking-wide">{% block topbar_title %}Command Center{% endblock %}</h2>
            <p class="text-xs text-[var(--outline-elev)] italic">{% block topbar_subtitle %}Divine synchronization active.{% endblock %}</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="btn-elev-primary group" title="Invocar Protocolo">
                <span class="material-symbols-elev text-base">bolt</span>
                <span>Invoke Protocol</span>
            </button>
            <button class="btn-elev-ghost relative" title="Notificaciones">
                <span class="material-symbols-elev">notifications</span>
                <span id="header-notif-badge" class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] flex items-center justify-center rounded-full bg-[var(--gold-elev)] text-black text-[10px] font-bold px-1">0</span>
            </button>
        </div>
    </header>

        <div class="flex-1 overflow-auto p-6">
            {% block content %}{% endblock %}
        </div>
    </main>
</div>

<div id="sanctum-floats" class="fixed inset-0 pointer-events-none z-50">
    {% block floats %}{% endblock %}
</div>

{% block importmap %}{{ importmap('app') }}{% endblock %}

<script>
(function() {
    // Active nav highlight
    const path = window.location.pathname;
    document.querySelectorAll('.sanctum-link[data-page]').forEach(a => {
        if (a.getAttribute('href') === path) a.classList.add('active');
    });

    // Load user info from session via /api/auth/check (using robust helper)
    if (window.apiFetch) {
        apiFetch('/api/auth/check').then(r => {
            if (r.ok && r.data && r.data.user) {
                const u = r.data.user;
                window.TNSVT_USER = u;
                window.dispatchEvent(new CustomEvent('tnsvt:user-loaded', { detail: u }));
                const code = (u.code || '??').slice(0, 2);
                document.getElementById('user-avatar').textContent = code;
                document.getElementById('user-name').textContent = u.name || u.code;
                const tierEl = document.getElementById('user-tier');
                tierEl.textContent = (u.tier || 'INITIATE');
                tierEl.className = 'tier-badge-elev tier-' + (u.tier || 'INITIATE').toLowerCase().replace(/_/g, '-');
            } else if (r.status === 401) {
                document.getElementById('user-name').textContent = 'Sin sesión';
                window.TNSVT_USER = null;
            } else if (!r.ok) {
                document.getElementById('user-name').textContent = '—';
            }
        });
    }

    // Logout
    document.getElementById('logout-btn').addEventListener('click', function() {
        if (confirm('¿Cerrar sesión?')) {
            apiFetch('/api/auth/logout', { method: 'POST', silent: true }).then(() => location.href = '/');
        }
    });

    // Notification badge in sidebar (poll every 60s)
    function refreshNotifBadge() {
        if (!window.TNSVT_USER) return;
        fetch('/sanctum/notifications/unread-count')
            .then(function(r) { return r.ok ? r.json() : { count: 0 }; })
            .then(function(data) {
                var badge = document.getElementById('bell-badge');
                if (!badge) return;
                var n = (data && data.count) || 0;
                if (n > 0) {
                    badge.textContent = n > 99 ? '99+' : n;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }).catch(function() {});
    }
    refreshNotifBadge();
    setInterval(refreshNotifBadge, 60000);
})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>