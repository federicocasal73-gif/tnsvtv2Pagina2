        </nav>

        <div class="sidebar-user-card">
            <div class="glass-card-elev p-3">
                <div class="flex items-center gap-3">
                    <div id="user-avatar" class="w-10 h-10 rounded-full bg-gradient-to-br from-[var(--gold-elev)] to-[var(--gold-bright-elev)] flex items-center justify-center text-[var(--on-primary-elev)] font-bold">
                        ?
                    </div>
                    <div class="sidebar-user-meta">
                        <p id="user-name" class="text-sm font-medium text-[var(--on-surface-elev)] truncate">Cargando...</p>
                        <span id="user-tier" class="tier-badge-elev tier-initiate">—</span>
                    </div>
                </div>
                <button id="logout-btn" class="mt-2 w-full text-xs py-1 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-variant-elev)] hover:bg-[var(--glass-bg-strong-elev)]">
                    Cerrar sesión
                </button>
            </div>
        </div>
    </aside>

    <main class="sanctum-main">
        <header class="sanctum-topbar">
        <div>
            <h2 class="text-cinzel-display text-xl tracking-wide">{% block topbar_title %}Command Center{% endblock %}</h2>
            <p class="text-xs text-[var(--outline-elev)] italic">{% block topbar_subtitle %}Divine synchronization active.{% endblock %}</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="btn-elev-primary group" title="Invocar Protocolo" aria-label="Invocar Protocolo">
                <span class="material-symbols-elev text-base" aria-hidden="true">bolt</span>
                <span>Invocar Protocolo</span>
            </button>
            <button class="btn-elev-ghost relative" title="Notificaciones" aria-label="Notificaciones">
                <span class="material-symbols-elev" aria-hidden="true">notifications</span>
                <span id="header-notif-badge" class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] flex items-center justify-center rounded-full bg-[var(--gold-elev)] text-black text-[10px] font-bold px-1">0</span>
            </button>
        </div>
    </header>

        <div class="sanctum-content">
            {% block content %}{% endblock %}
        </div>
    </main>
</div>

<div id="sanctum-floats" class="fixed inset-0 pointer-events-none z-50">
    {% block floats %}{% endblock %}
</div>

{% block importmap %}{{ importmap('app') }}{% endblock %}

<script>
(function() {
    // Active nav highlight
    const path = window.location.pathname;
    document.querySelectorAll('.sanctum-link[data-page]').forEach(a => {
        if (a.getAttribute('href') === path) {
            a.classList.add('active');
            a.setAttribute('aria-current', 'page');
        }
    });

    // Load user info from session via /api/auth/check (using robust helper)
    if (window.apiFetch) {
        apiFetch('/api/auth/check').then(r => {
            if (r.ok && r.data && r.data.user) {
                const u = r.data.user;
                window.TNSVT_USER = u;
                window.dispatchEvent(new CustomEvent('tnsvt:user-loaded', { detail: u }));
                const code = (u.code || '??').slice(0, 2);
                const avatarEl = document.getElementById('user-avatar');
                const nameEl = document.getElementById('user-name');
                if (avatarEl) avatarEl.textContent = code;
                if (nameEl) nameEl.textContent = u.name || u.code;
                const tierEl = document.getElementById('user-tier');
                if (tierEl) {
                    tierEl.textContent = (u.tier || 'INITIATE');
                    tierEl.className = 'tier-badge-elev tier-' + (u.tier || 'INITIATE').toLowerCase().replace(/_/g, '-');
                }
            } else if (r.status === 401) {
                const nameEl = document.getElementById('user-name');
                if (nameEl) nameEl.textContent = 'Sin sesión';
                window.TNSVT_USER = null;
            } else if (!r.ok) {
                const nameEl = document.getElementById('user-name');
                if (nameEl) nameEl.textContent = '—';
            }
        });
    }

    // Logout
    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) logoutBtn.addEventListener('click', async function() {
        if (await apiConfirm('¿Cerrar sesión?', { title: 'Cerrar sesión', variant: 'danger' })) {
            apiFetch('/api/auth/logout', { method: 'POST', silent: true }).then(() => location.href = '/');
        }
    });

    // Notification badge in sidebar (poll every 60s)
    function refreshNotifBadge() {
        if (!window.TNSVT_USER) return;
        fetch('/sanctum/notifications/unread-count')
            .then(function(r) { return r.ok ? r.json() : { count: 0 }; })
            .then(function(data) {
                var badge = document.getElementById('bell-badge');
                if (!badge) return;
                var n = (data && data.count) || 0;
                if (n > 0) {
                    badge.textContent = n > 99 ? '99+' : n;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }).catch(function() {});
    }
    refreshNotifBadge();
    setInterval(refreshNotifBadge, 60000);
})();
</script>

<script>
// Rail tooltip (sidebar collapsed ≤1024px)
(function() {
    const RAIL_BP = 1024;
    var tip = document.createElement('div');
    tip.id = 'sanctum-rail-tooltip';
    document.body.appendChild(tip);

    function show(link) {
        if (window.innerWidth > RAIL_BP) return;
        var label = link.querySelector('.sanctum-link-label');
        if (!label) return;
        tip.textContent = label.textContent;
        tip.classList.add('visible');
        var r = link.getBoundingClientRect();
        tip.style.left = (r.right + 12) + 'px';
        tip.style.top = Math.round(r.top + r.height / 2) + 'px';
    }
    function hide() { tip.classList.remove('visible'); }

    document.querySelectorAll('#sanctum-sidebar .sanctum-link').forEach(function(link) {
        link.addEventListener('mouseenter', function() { show(link); });
        link.addEventListener('mouseleave', hide);
        link.addEventListener('focus', function() { show(link); });
        link.addEventListener('blur', hide);
    });
    window.addEventListener('resize', hide);
})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
