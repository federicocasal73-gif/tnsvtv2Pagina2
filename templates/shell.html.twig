                <span class="sanctum-link-label">Frecuencias</span>
            </a>

            <div class="sanctum-section-title"
                 data-shell-target="sidebarSection"
                 data-section-toggle
                 data-action="click->shell#toggleSection"
                 role="button" tabindex="0" title="Colapsar sección">Formación</div>
            <a href="{{ path('sanctum_campus') }}" class="sanctum-link" data-page="campus">
                <span class="material-symbols-elev">school</span>
                <span class="sanctum-link-label">Campus</span>
            </a>

            <div class="sanctum-section-title"
