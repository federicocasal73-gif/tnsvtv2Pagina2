            </a>
            <a href="{{ path('oracle_dashboard') }}" class="sanctum-link" data-page="oracle">
                <span class="material-symbols-elev">auto_awesome</span>
                <span class="sanctum-link-label">Oráculo</span>
            </a>
            <a href="{{ path('sanctum_guardian') }}" class="sanctum-link" data-page="guardian">
                <span class="material-symbols-elev">shield_person</span>
                <span class="sanctum-link-label">Guardian</span>
            </a>
            <a href="{{ path('sanctum_diary') }}" class="sanctum-link" data-page="diary">
                <span class="material-symbols-elev">menu_book</span>
