            </a>
            <a href="{{ path('sanctum_tasks') }}" class="sanctum-link" data-page="tasks">
                <span class="material-symbols-elev">task_alt</span>
                <span class="sanctum-link-label">Tareas</span>
            </a>
            <a href="{{ path('sanctum_campus_admin_courses') }}" class="sanctum-link" data-page="campus-admin">
                <span class="material-symbols-elev">school</span>
                <span class="sanctum-link-label">Campus · Contenido</span>
            </a>
            <a href="{{ path('sanctum_audit') }}" class="sanctum-link" data-page="audit">
                <span class="material-symbols-elev">shield</span>
                <span class="sanctum-link-label">Audit</span>
            </a>
            <a href="{{ path('sanctum_settings') }}" class="sanctum-link" data-page="settings">
                <span class="material-symbols-elev">settings</span>
                <span class="sanctum-link-label">Settings</span>
            </a>
            <a href="{{ path('sanctum_monitoring') }}" class="sanctum-link" data-page="monitoring">
                <span class="material-symbols-elev">monitoring</span>
                <span class="sanctum-link-label">Monitoring</span>
            </a>
