<!DOCTYPE html>
<html lang="es" class="dark" data-apk="false">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050308" />
    {# Theme flash prevention (Fase E): apply stored theme before CSS paints.
       theme.js (deferred) re-applies + syncs on load; this inline snippet
       only prevents the white/dark flash. #}
    <script>
    (function () {
        try {
            var t = localStorage.getItem('tnsvt_theme') || 'auto';
            var light = t === 'light' ||
                (t === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches);
            var html = document.documentElement;
            html.setAttribute('data-theme', t);
            html.classList.toggle('light', !light ? false : true);
            html.classList.toggle('dark', light ? false : true);
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', light ? '#f5f1e8' : '#050308');
        } catch (_) {}
    })();
    </script>
<link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}" />
    <link rel="alternate icon" type="image/x-icon" href="{{ asset('favicon.ico') }}" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Sanctum" />
    <link rel="apple-touch-icon" href="{{ asset('favicon.svg') }}" />
    <title>{% block title %}T.N.S.V.T — Sanctum{% endblock %}</title>

    {% include '_partials/og_meta.html.twig' with {
        title: block('title')|default('T.N.S.V.T — Sanctum'),
        description: 'Plataforma neuro-espiritual de trading. Análisis macro, bitácora y guardian para ejecutores del reino.',
        type: 'website',
    } %}

    {# Fonts loaded via canonical partial _partials/fonts.html.twig — see that file to add new families. #}
    {% include '_partials/fonts.html.twig' %}

    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/chat-widget.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/v2-sparklines.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/animations.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/glow.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/shell.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/accessibility.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/sonic-sanctuary.css') }}" />

    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-[var(--void-elev)] text-[var(--on-surface-elev)] font-['Space_Grotesk'] min-h-screen antialiased relative"
      data-controller="pwa shell"
      {% if app.user %}data-user-code="{{ app.user.code }}" data-user-tier="{{ app.user.tier|default('INITIATE') }}"{% endif %}>

<a href="#main-content" class="skip-link">Saltar al contenido principal</a>

{# ═══ FASE 0 — Fondo estrellado global (V2 identidad visual) ═══ #}
{# https://tnsvt.com necesita esta identidad en TODAS las páginas. #}
{% block background %}{% endblock %}
<script src="{{ asset('js/modules/theme.js') }}" defer></script>
<script src="{{ asset('js/modules/webgl-background.js') }}" defer></script>

{# api_helper MUST be included BEFORE any {% block content %} to ensure window.apiFetch is defined #}
{% include '_partials/api_helper.html.twig' with {} %}

{# ═══ FASE 0 — Emblema 3D del gateway (solo home) ═══ #}
{% block gateway_emblem %}{% endblock %}

