            <div class="sanctum-section-title"
                 data-shell-target="sidebarSection"
                 data-section-toggle
                 data-action="click->shell#toggleSection"
                 role="button" tabindex="0" title="Colapsar sección">Comunidad</div>
            <a href="{{ path('sanctum_feed') }}" class="sanctum-link" data-page="feed">
                <span class="material-symbols-elev">forum</span>
                <span class="sanctum-link-label">Feed</span>
            </a>
            <a href="{{ path('sanctum_social') }}" class="sanctum-link" data-page="social">
                <span class="material-symbols-elev">share</span>
                <span class="sanctum-link-label">Social</span>
            </a>
            <a href="{{ path('sanctum_chat') }}" class="sanctum-link" data-page="chat">
                <span class="material-symbols-elev">chat</span>
                <span class="sanctum-link-label">Chat</span>
            </a>
            <a href="{{ path('sanctum_clan') }}" class="sanctum-link" data-page="clan">
                <span class="material-symbols-elev">groups</span>
                <span class="sanctum-link-label">Clanes</span>
            </a>
        </nav>

        <div class="sidebar-user-card">
            <div class="glass-card-elev p-3">
                <div class="flex items-center gap-3">
                    <div id="user-avatar"
                         data-shell-target="userAvatar"
                         class="w-10 h-10 rounded-full bg-gradient-to-br from-[var(--gold-elev)] to-[var(--gold-bright-elev)] flex items-center justify-center text-[var(--on-primary-elev)] font-bold">
                        {{ app.user ? (app.user.name|default(app.user.code)|slice(0, 1)|upper) : '?' }}
                    </div>
                    <div class="sidebar-user-meta">
                        <p id="user-name"
                           data-shell-target="userName"
                           class="text-sm font-medium text-[var(--on-surface-elev)] truncate">{{ app.user ? (app.user.name|default(app.user.code)) : 'Invitado' }}</p>
                        <span id="user-tier"
                              data-shell-target="userTier"
                              class="tier-badge-elev tier-initiate">{{ app.user ? (app.user.tier|default('INITIATE')) : '—' }}</span>
                    </div>
                </div>
                <button id="logout-btn"
                        data-shell-target="logoutBtn"
                        data-action="click->shell#logout"
                        class="mt-2 w-full text-xs py-1 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-variant-elev)] hover:bg-[var(--glass-bg-strong-elev)]">
                    Cerrar sesión
                </button>
            </div>
        </div>
    </aside>

    <main class="sanctum-main" id="main-content" tabindex="-1">
        <header class="sanctum-topbar" data-turbo-permanent>
        <div>
            <h2 class="text-cinzel-display text-xl tracking-wide">{% block topbar_title %}Inicio{% endblock %}</h2>
            <p class="text-xs text-[var(--outline-elev)] italic">{% block topbar_subtitle %}Divine synchronization active.{% endblock %}</p>
        </div>
        {# ─── Section chips (streak, badge, etc.) — child templates can override ─── #}
        {% block topbar_chips %}{% endblock %}
        <div class="flex items-center gap-3" data-controller="protocol notification-bell">
            <button type="button" class="ui-btn ui-btn primary group" title="Invocar Protocolo" aria-label="Invocar Protocolo" aria-haspopup="dialog" data-action="protocol#onButtonClick">
                <span class="material-symbols-elev icon-size-sm" aria-hidden="true">bolt</span>
                <span>Invocar Protocolo</span>
            </button>

            {# ─── F1: command palette trigger (visible affordance for Ctrl+K) ─── #}
            <button type="button" class="ui-btn ui-btn ghost relative" title="Buscar o ejecutar (Ctrl+K)"
                    aria-label="Abrir paleta de comandos (Ctrl+K)" id="cmdk-open-btn">
                <span class="material-symbols-elev" aria-hidden="true">search</span>
                <kbd class="cmdk-trigger-kbd" aria-hidden="true">⌘K</kbd>
            </button>

            <div class="notif-wrap" data-notification-bell-target="wrap">
                <button type="button" class="ui-btn ui-btn ghost relative" title="Notificaciones" aria-label="Notificaciones" aria-haspopup="menu" aria-expanded="false" data-notification-bell-target="button" data-action="notification-bell#toggle">
                    <span class="material-symbols-elev relative" aria-hidden="true">notifications</span>
                    <span id="header-notif-badge"
                      data-shell-target="headerNotifBadge"
                      class="hidden"
                      data-notification-bell-target="count">0</span>
                </button>
                <div class="notif-popover hidden" data-notification-bell-target="popover" role="menu" aria-label="Notificaciones recientes">
                    <div class="notif-popover-header">
                        <span>Notificaciones</span>
                        <button type="button" class="notif-popover-markall" data-action="notification-bell#markAll">Marcar todas</button>
                    </div>
                    <div class="notif-popover-list" data-notification-bell-target="list"></div>
                    <a href="{{ path('sanctum_notifications') }}" class="notif-popover-footer">Ver todas →</a>
                </div>
            </div>

            <button type="button"
                        id="theme-toggle-btn"
                        data-shell-target="themeToggleBtn"
                        data-action="click->shell#toggleTheme"
                        class="ui-btn ui-btn ghost relative"
                        title="Cambiar tema claro/oscuro"
                        aria-label="Cambiar tema claro/oscuro"
                        aria-live="polite">
                <span class="material-symbols-elev"
                      id="theme-toggle-icon"
                      data-shell-target="themeIcon"
                      aria-hidden="true">dark_mode</span>
            </button>

            <div class="protocol-overlay" data-protocol-target="overlay" role="dialog" aria-modal="true" aria-labelledby="protocol-title" tabindex="-1" hidden>
                <div class="protocol-modal">
                    <div class="protocol-modal-header">
                        <h2 id="protocol-title" class="protocol-modal-title">
                            <span class="material-symbols-elev protocol-modal-icon" aria-hidden="true">shield_person</span>
                            Protocolo Guardian
                        </h2>
                        <div class="protocol-header-actions">
                            <button type="button"
                                    class="protocol-dismiss-24h"
                                    data-action="protocol#dismissFor24h"
                                    title="Cerrar y no mostrar de nuevo por 24 horas"
                                    aria-label="Cerrar y no mostrar de nuevo por 24 horas">
                                <span class="material-symbols-elev" aria-hidden="true">schedule</span>
                                <span class="protocol-dismiss-24h-label">Cerrar por 24h</span>
                            </button>
                            <button type="button"
                                    class="protocol-close"
                                    aria-label="Cerrar"
                                    data-action="protocol#onClose">
                                <span class="material-symbols-elev" aria-hidden="true">close</span>
                            </button>
                        </div>
                    </div>

                    <div class="protocol-modal-body hidden" data-protocol-target="content">
                        <div class="protocol-score">
                            <div class="protocol-score-cell">
                                <p class="protocol-score-label">Discipline Score</p>
                                <div class="protocol-score-value" data-protocol-target="scoreValue">--</div>
                                <div class="protocol-score-sub">/ 100</div>
                                <div class="tier-badge-elev tier-initiate" data-protocol-target="scoreTier">--</div>
                            </div>
                            <div class="protocol-score-breakdown">
                                <p class="protocol-score-label">Breakdown</p>
                                <ul data-protocol-target="scoreBreakdown">
                                    <li class="protocol-breakdown-clear">Sin factores negativos.</li>
                                </ul>
                                <p class="protocol-score-computed">Calculado: <span data-protocol-target="scoreComputedAt">--</span></p>
                            </div>
                        </div>

                        <div class="protocol-signals">
                            <div class="protocol-signals-head">
                                <p class="protocol-score-label">Señales activas</p>
                                <span class="protocol-count" data-protocol-target="signalCount">0</span>
                            </div>
                            <ul data-protocol-target="signalsList">
                                <li data-protocol-target="signalsEmpty" class="protocol-signal-empty">
                                    <span class="material-symbols-elev" aria-hidden="true">check_circle</span>
                                    <p>Todo en orden</p>
                                    <p class="protocol-signal-empty-sub">Sin señales activas. Tu disciplina está bajo control.</p>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="protocol-loading hidden" data-protocol-target="loading">
                        <p class="loading-pulse">Consultando al Guardian...</p>
                    </div>
                    <div class="protocol-error hidden" data-protocol-target="error" role="alert">
                        <span class="material-symbols-elev" aria-hidden="true">error</span>
                        <p>Error al consultar el Guardian. Probá refrescar.</p>
                    </div>

                    <div class="protocol-modal-footer">
                        <a href="{{ path('sanctum_guardian') }}" class="protocol-footer-link">Ver página Guardian →</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

        <div class="sanctum-content">
            {% block content %}{% endblock %}
        </div>
    </main>
</div>

{# ─── TNSVT Sprint B.4 — Chat widget flotante (visible en todas las páginas) ─── #}
{% if app.user %}
    {% include '_partials/chat_widget.html.twig' %}
{% endif %}

<div id="sanctum-floats" class="fixed inset-0 pointer-events-none z-50" data-turbo-permanent>
    {% block floats %}{% endblock %}

    {# ─── Sonic Sanctuary — reproductor unificado cross-page (Phase 1+2+3).
       Reemplaza el antiguo frequency_mini_player. Tres fuentes:
         - Templo (osciladores del Cónclave)
         - Mías (uploads del usuario via /api/frequencies/stream/{id})
         - Global (admin playlist via /api/music/stream?id=…)
       Persiste cross-page gracias a data-turbo-permanent en #sanctum-floats.
       Solo se muestra a usuarios autenticados (los anónimos no tienen
       ni presets ni subidas que reproducir). #}
    {% if app.user %}
    <div data-controller="sonic-sanctuary"
         data-sonic-sanctuary-open-panel-value="false"
         class="contents">

        {# Mini-player flotante (bottom-center, visible durante reproducción) #}
        <div class="sonic-mini-player"
             data-sonic-sanctuary-target="miniPlayer"
             role="region"
             aria-label="Reproductor"
             hidden>
            <div class="sonic-mini-icon" data-sonic-sanctuary-target="miniIcon">
                <span class="material-symbols-elev" aria-hidden="true">equalizer</span>
            </div>
            <div class="sonic-mini-body">
                <p class="sonic-mini-title"
                   data-sonic-sanctuary-target="miniTitle">—</p>
                <p class="sonic-mini-time">
                    <span data-sonic-sanctuary-target="miniElapsed">00:00</span>
                    <span aria-hidden="true"> · </span>
                    <span data-sonic-sanctuary-target="miniDuration">—</span>
                </p>
            </div>
            <button type="button"
                    class="sonic-mini-toggle sonic-mini-play"
                    data-sonic-sanctuary-target="miniPlayBtn"
                    data-action="click->sonic-sanctuary#togglePlay"
                    title="Reproducir / Pausar">
                <span class="material-symbols-elev" aria-hidden="true">pause</span>
            </button>
            <div class="sonic-mini-volume-wrap">
                <button type="button"
                        class="sonic-mini-toggle"
                        data-sonic-sanctuary-target="muteBtn"
                        data-action="click->sonic-sanctuary#toggleMute"
                        title="Silenciar">
                    <span class="material-symbols-elev" aria-hidden="true">volume_up</span>
                </button>
            </div>
            <button type="button"
                    class="sonic-mini-btn"
                    data-action="click->sonic-sanctuary#togglePanel"
                    title="Abrir Santuario Sonoro"
                    aria-label="Abrir panel del Santuario Sonoro">
                <span class="material-symbols-elev" aria-hidden="true">library_music</span>
            </button>
        </div>

        {# Botón flotante (visible cuando no hay reproducción) #}
        <button type="button"
                class="sonic-mini-launcher"
                data-action="click->sonic-sanctuary#togglePanel"
                title="Abrir Santuario Sonoro">
            <span class="material-symbols-elev" aria-hidden="true">library_music</span>
        </button>

        {# Panel lateral con tabs + visualizer + upload + lista #}
        {% include '_partials/sonic_sanctuary_panel.html.twig' %}
    </div>
    {% endif %}
</div>

{% block importmap %}
    {{ importmap('app') }}
    {{ importmap('divine_overlay') }}
    {{ importmap('onboarding') }}
{% endblock %}

{# ─── Photo lightbox (singleton) ─── #}
{% include '_partials/lightbox.html.twig' %}

{# ─── Command palette Ctrl+K (singleton) ─── #}
{% include '_partials/command_palette.html.twig' %}

{# ═══ Onboarding wizard (first-login) — hidden por default ═══ #}
{% include '_partials/_onboarding/wizard.html.twig' %}

{% block javascripts %}{% endblock %}
</body>
</html>
