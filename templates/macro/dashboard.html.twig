{% extends 'shell.html.twig' %}

{% block title %}Hilos del Mundo · T.N.S.V.T{% endblock %}

{% block topbar_title %}Hilos del Mundo{% endblock %}
{% block topbar_subtitle %}El Pulso del Mercado · Macro Calendario{% endblock %}

{% block stylesheets %}
<style>
    .macro-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .macro-card:hover {
        border-color: rgba(242, 202, 80, 0.2);
        box-shadow: 0 0 25px rgba(242, 202, 80, 0.1);
    }
    .nont-trade-banner {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(242, 202, 80, 0.2);
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
    }
    .nont-trade-banner.locked {
        border-color: rgba(248, 113, 113, 0.3);
        background: rgba(248, 113, 113, 0.05);
    }
    .nont-trade-banner.locked::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--error, #f87171), transparent);
    }
    .countdown-display {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 3rem;
        font-weight: 700;
        color: var(--gold-elev, #f2ca50);
        text-shadow: 0 0 20px rgba(242, 202, 80, 0.4);
        animation: countdown-pulse 2s ease-in-out infinite;
    }
    .countdown-display.locked {
        color: var(--error, #f87171);
        text-shadow: 0 0 20px rgba(248, 113, 113, 0.4);
    }
    .countdown-block {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(242, 202, 80, 0.2);
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        text-align: center;
        min-width: 80px;
    }
    .countdown-block.locked {
        border-color: rgba(248, 113, 113, 0.3);
    }
    .countdown-block-value {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--gold-elev, #f2ca50);
    }
    .countdown-block.locked .countdown-block-value {
        color: var(--error, #f87171);
    }
    .countdown-block-label {
        font-size: 0.6rem;
        color: var(--outline-elev, #99907c);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 0.25rem;
    }
    .macro-event-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 0.75rem;
        padding: 1rem;
        transition: all 0.2s ease;
        border-left-width: 3px;
    }
    .macro-event-card:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .macro-event-card.high-impact {
        border-left-color: var(--gold-elev, #f2ca50);
    }
    .macro-event-card.medium-impact {
        border-left-color: rgba(242, 202, 80, 0.5);
    }
    .macro-event-card.low-impact {
        border-left-color: rgba(255, 255, 255, 0.2);
    }
    .impact-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .impact-dot.high { background: var(--error, #f87171); }
    .impact-dot.medium { background: var(--warning, #fbbf24); }
    .impact-dot.low { background: var(--success, #4ade80); }
    .lock-overlay {
        position: absolute;
        inset: 0;
        backdrop-filter: blur(8px);
        background: rgba(5, 3, 8, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 1rem;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
    .lock-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }
</style>
{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto">
    {# Header #}
    <div class="text-center mb-8">
        <p class="font-label-sm text-label-sm text-primary uppercase tracking-[0.3em] mb-2">Calendario Económico</p>
        <h1 class="font-headline-xl text-headline-xl shimmer-text">El Pulso del Mercado</h1>
        <p class="text-on-surface-variant opacity-70 italic mt-2">"Operar en el momento equivocado borra todos tus conocimientos."</p>
    </div>

    {# No-Trade Window Banner #}
    <div id="ntw-banner" class="nont-trade-banner">
        <div class="flex items-center gap-4">
            <div id="ntw-icon" class="w-14 h-14 rounded-full bg-[var(--gold-elev)] flex items-center justify-center">
                <span class="material-symbols-outlined text-[var(--on-primary-elev)]" style="font-variation-settings: 'FILL' 1;">timer</span>
            </div>
            <div class="flex-1">
                <h2 class="text-xl font-semibold text-[var(--on-surface-elev)]" id="ntw-title">Cargando...</h2>
                <p class="text-sm text-[var(--outline-elev)]" id="ntw-message">Cargando estado del no-trade window...</p>
            </div>
            <div class="flex gap-3">
                <div class="countdown-block">
                    <p class="countdown-block-value" id="ntw-hours">--</p>
                    <p class="countdown-block-label">Horas</p>
                </div>
                <div class="countdown-block">
                    <p class="countdown-block-value" id="ntw-mins">--</p>
                    <p class="countdown-block-label">Mins</p>
                </div>
                <div class="countdown-block">
                    <p class="countdown-block-value" id="ntw-secs">--</p>
                    <p class="countdown-block-label">Segs</p>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# No-Trade Window Timeline #}
        <div class="macro-card lg:col-span-2 relative">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">schedule</span>
                No-Trade Window Timeline
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">Próximas 168 horas (7 días)</p>
            <div class="relative" style="height: 280px;">
                <svg id="timeline-svg" width="100%" height="100%" viewBox="0 0 800 280" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
            {# Lock Overlay #}
            <div id="lock-overlay" class="lock-overlay">
                <div class="text-center">
                    <span class="material-symbols-outlined text-5xl text-[var(--error)] pulse-gold">gavel</span>
                    <p class="font-headline-lg text-[var(--error)] font-bold mt-2">PROHIBIDO OPERAR</p>
                    <p class="font-label-sm text-[var(--outline-elev)] mt-1">La volatilidad sagrada se aproxima</p>
                    <p class="text-xs text-[var(--outline-elev)] mt-2" id="lock-message">Respeta los hilos o serás consumido</p>
                </div>
            </div>
        </div>

        {# Upcoming Events List #}
        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">public</span>
                Próximos eventos
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">High-impact (importance ≥ 3)</p>
            <div id="upcoming-list" class="space-y-2 max-h-96 overflow-y-auto pr-2">
                <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando eventos...</p>
            </div>
        </div>
    </div>

    {# Trading Discipline Rules #}
    <div class="macro-card mt-6">
        <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
            <span class="material-symbols-outlined text-[var(--gold-elev)]">shield</span>
            Regla de Disciplina
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                <div class="glass-card-elev p-4">
                    <p class="text-[var(--gold-elev)] font-bold text-2xl">15'</p>
                    <p class="text-[var(--on-surface-elev)] font-medium">Antes del evento</p>
                    <p class="text-[var(--outline-elev)] text-xs">No abras trades. Cierra posiciones abiertas.</p>
                </div>
                <div class="glass-card-elev p-4 border-2 border-[var(--gold-elev)]">
                    <p class="text-[var(--gold-elev)] font-bold text-2xl">EVENTO</p>
                    <p class="text-[var(--on-surface-elev)] font-medium">Durante la noticia</p>
                    <p class="text-[var(--outline-elev)] text-xs">Spread se expande. Liquidez se seca. Chaos.</p>
                </div>
                <div class="glass-card-elev p-4">
                    <p class="text-[var(--gold-elev)] font-bold text-2xl">15'</p>
                    <p class="text-[var(--on-surface-elev)] font-medium">Después del evento</p>
                    <p class="text-[var(--outline-elev)] text-xs">Espera. Confirmá dirección. Re-entrada segura.</p>
                </div>
            </div>
        </div>
    </div>

    {# Macro Oracle — Faith vs Logic + Session Performance + Scatter #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">balance</span>
                Faith vs Logic
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">Equilibrio emocional de los últimos 30 días</p>
            <div class="flex items-center justify-center" style="height: 200px;">
                <svg id="faith-logic-gauge" width="200" height="200" viewBox="0 0 200 200"></svg>
            </div>
            <div class="flex justify-between text-xs mt-2">
                <span class="text-[var(--gold-elev)]">Faith</span>
                <span class="text-[var(--outline-elev)]">Logic</span>
            </div>
        </div>

        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">scatter_plot</span>
                Emotional Bias Scatter
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">Volatility vs Confidence</p>
            <div class="relative" style="height: 200px;">
                <svg id="emotional-scatter" width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
        </div>

        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">schedule</span>
                Session Performance
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">P&L por sesión</p>
            <div class="relative" style="height: 200px;">
                <svg id="session-bars" width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
        </div>
    </div>

    <script>
    let countdownInterval = null;
    let allWindows = [];

    function formatTime(seconds) {
        if (seconds < 0) seconds = 0;
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = seconds % 60;
        if (h > 0) return `${h}h ${m}m`;
        if (m > 0) return `${m}m ${s}s`;
        return `${s}s`;
    }

    async function loadAll() {
        // Load windows
        try {
            const resp = await fetch('/api/macro/windows?limit=30');
            const data = await resp.json();
            if (data.success) {
                allWindows = data.windows;
                renderTimeline(allWindows);
                renderUpcoming(allWindows);
                updateStatus(data.windows);
            }
        } catch (e) {
            console.error(e);
        }
    }

    function updateStatus(windows) {
        const now = new Date();
        const active = windows.find(w => w.is_active);
        const upcoming = windows.filter(w => !w.is_active && new Date(w.start) > now).sort((a, b) => new Date(a.start) - new Date(b.start));

        const titleEl = document.getElementById('ntw-title');
        const msgEl = document.getElementById('ntw-message');
        const iconEl = document.getElementById('ntw-icon');
        const countdownEl = document.getElementById('ntw-countdown');
        const labelEl = document.getElementById('ntw-countdown-label');
        const bannerEl = document.getElementById('ntw-banner');

        if (countdownInterval) clearInterval(countdownInterval);

        if (active) {
            // ACTIVE WINDOW
            titleEl.textContent = '🔴 No-Trade Window ACTIVA';
            msgEl.innerHTML = `<strong>${active.title}</strong> (${active.country} ${active.currency}) · impact ${active.importance}`;
            iconEl.style.background = '#ff6b6b';
            countdownEl.textContent = formatTime(active.seconds_until_end);
            labelEl.textContent = 'Hasta el final del window';
            bannerEl.style.borderLeftColor = '#ff6b6b';
        } else if (upcoming.length > 0) {
            const next = upcoming[0];
            titleEl.textContent = 'Próximo: ' + next.title;
            msgEl.innerHTML = `${next.country} ${next.currency} · impact ${next.importance} · ${new Date(next.start).toLocaleString()}`;
            iconEl.style.background = 'var(--gold-elev)';
            labelEl.textContent = 'Inicia en';
            bannerEl.style.borderLeftColor = 'var(--gold-elev)';

            countdownInterval = setInterval(() => {
                const remaining = new Date(next.start).getTime() - Date.now();
                countdownEl.textContent = formatTime(Math.max(0, Math.floor(remaining / 1000)));
                if (remaining <= 0) loadAll();
            }, 1000);
        } else {
            titleEl.textContent = '✓ Sin eventos próximos';
            msgEl.textContent = 'No hay no-trade windows en el horizonte cercano';
            iconEl.style.background = 'var(--glass-bg-elev)';
            countdownEl.textContent = 'LIBRE';
            labelEl.textContent = 'No events';
            bannerEl.style.borderLeftColor = 'var(--gold-elev)';
        }
    }

    function renderTimeline(windows) {
        const svg = document.getElementById('timeline-svg');
        const w = 800, h = 280;
        const now = new Date();
        const range = 7 * 24 * 60 * 60 * 1000; // 7 days
        const startMs = now.getTime();
        const endMs = startMs + range;
        const xScale = (ms) => 40 + ((ms - startMs) / range) * (w - 60);
        const yHigh = h - 50;
        const yMid = h - 80;
        const yLow = h - 110;

        let html = '';
        // X-axis (now line)
        const nowX = xScale(now.getTime());
        html += `<line x1="${nowX}" y1="20" x2="${nowX}" y2="${h - 30}" stroke="var(--gold-elev)" stroke-width="1.5" />`;
        html += `<text x="${nowX}" y="14" text-anchor="middle" font-size="10" fill="var(--gold-elev)">NOW</text>`;
        // Day markers
        for (let d = 0; d <= 7; d++) {
            const dayX = xScale(startMs + d * 24 * 60 * 60 * 1000);
            html += `<line x1="${dayX}" y1="${h - 30}" x2="${dayX}" y2="${h - 25}" stroke="var(--outline-variant-elev)" stroke-width="0.5" />`;
            const dayDate = new Date(startMs + d * 24 * 60 * 60 * 1000);
            html += `<text x="${dayX}" y="${h - 12}" text-anchor="middle" font-size="9" fill="var(--outline-elev)">${dayDate.getDate()}/${dayDate.getMonth() + 1}</text>`;
        }
        // Time axis line
        html += `<line x1="40" y1="${h - 30}" x2="${w - 20}" y2="${h - 30}" stroke="var(--outline-variant-elev)" stroke-width="0.5" />`;
        // Plot each event window
        for (const win of windows) {
            const startMs = new Date(win.start).getTime();
            const endMs = new Date(win.end).getTime();
            if (endMs < startMs || startMs > endMs) continue;
            const x1 = Math.max(40, xScale(startMs));
            const x2 = Math.min(w - 20, xScale(endMs));
            if (x2 < x1) continue;
            const isActive = win.is_active;
            const color = isActive ? '#ff6b6b' : 'var(--gold-elev)';
            const opacity = isActive ? '0.8' : '0.4';
            // Choose y based on importance (3 = high, so higher position)
            const y = win.importance >= 3 ? yHigh : (win.importance >= 2 ? yMid : yLow);
            const wpx = x2 - x1;
            html += `<rect x="${x1}" y="${y - 8}" width="${wpx}" height="16" fill="${color}" fill-opacity="${opacity}" rx="2"><title>${win.title} (${win.country})</title></rect>`;
            // Event marker (start)
            html += `<line x1="${x1}" y1="${y - 14}" x2="${x1}" y2="${y + 14}" stroke="${color}" stroke-width="1.5" />`;
            if (wpx > 40) {
                const displayTitle = win.title.length > 18 ? win.title.substring(0, 15) + '...' : win.title;
                html += `<text x="${x1 + 2}" y="${y + 3}" font-size="8" fill="white" pointer-events="none">${displayTitle}</text>`;
            }
        }
        // Legend
        html += `<rect x="40" y="10" width="10" height="10" fill="var(--gold-elev)" fill-opacity="0.4" />`;
        html += `<text x="55" y="19" font-size="9" fill="var(--outline-elev)">Próximo</text>`;
        html += `<rect x="100" y="10" width="10" height="10" fill="#ff6b6b" fill-opacity="0.8" />`;
        html += `<text x="115" y="19" font-size="9" fill="var(--outline-elev)">Activo</text>`;
        svg.innerHTML = html;
    }

    function renderUpcoming(windows) {
        const list = document.getElementById('upcoming-list');
        const now = new Date();
        const upcoming = windows.filter(w => !w.is_active && new Date(w.start) > now).sort((a, b) => new Date(a.start) - new Date(b.start));
        if (upcoming.length === 0) {
            list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin eventos próximos</p>';
            return;
        }
        list.innerHTML = upcoming.slice(0, 15).map(w => {
            const startDt = new Date(w.start);
            const seconds = w.seconds_until_start;
            const urgency = seconds < 3600 ? 'urgent' : (seconds < 21600 ? 'soon' : 'later');
            return `
                <div class="flex items-center gap-3 p-2 rounded glass-card-elev border-l-2 ${urgency === 'urgent' ? 'border-red-400' : 'border-[var(--gold-elev)]'}">
                    <div class="text-center min-w-12">
                        <p class="text-2xl font-bold text-[var(--gold-elev)]">${startDt.getDate()}</p>
                        <p class="text-xs text-[var(--outline-elev)] uppercase">${['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][startDt.getMonth()]}</p>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-[var(--on-surface-elev)] truncate">${w.title}</p>
                        <p class="text-xs text-[var(--outline-elev)]">${w.country} ${w.currency} · ${startDt.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-[var(--outline-elev)] uppercase">En</p>
                        <p class="text-sm font-bold ${urgency === 'urgent' ? 'text-red-400' : 'text-[var(--gold-elev)]'}">${formatTime(seconds)}</p>
                    </div>
                </div>
            `;
        }).join('');
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadAll();
        renderOracleCharts();
        // Auto-refresh every 60s
        setInterval(loadAll, 60000);
    });

    function renderOracleCharts() {
        renderFaithLogicGauge();
        renderEmotionalScatter();
        renderSessionBars();
    }

    function renderFaithLogicGauge() {
        const svg = document.getElementById('faith-logic-gauge');
        if (!svg) return;
        const cx = 100, cy = 100, r = 80;
        const faith = 50; // default balance (0-100)
        const angle = -90 + (faith / 100) * 180; // semicircle from -90 to +90
        const rad = (angle * Math.PI) / 180;
        const needleX = cx + (r - 12) * Math.cos(rad);
        const needleY = cy + (r - 12) * Math.sin(rad);
        const svgNS = 'http://www.w3.org/2000/svg';
        let html = '';
        // Background arc
        html += `<path d="M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${cx + r} ${cy}" stroke="rgba(255,255,255,0.08)" stroke-width="12" fill="none"/>`;
        // Foreground arc (gold)
        html += `<path d="M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${needleX} ${needleY}" stroke="url(#gauge-grad)" stroke-width="12" fill="none" stroke-linecap="round"/>`;
        // Gradient
        html += `<defs><linearGradient id="gauge-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#f2ca50"/><stop offset="100%" stop-color="#8a3cff"/>
        </linearGradient></defs>`;
        // Needle
        html += `<line x1="${cx}" y1="${cy}" x2="${needleX}" y2="${needleY}" stroke="#f2ca50" stroke-width="2" stroke-linecap="round"/>`;
        html += `<circle cx="${cx}" cy="${cy}" r="6" fill="#f2ca50"/>`;
        // Labels
        html += `<text x="20" y="180" font-size="11" fill="#f2ca50" font-weight="600">FAITH</text>`;
        html += `<text x="155" y="180" font-size="11" fill="#99907c" font-weight="600">LOGIC</text>`;
        svg.innerHTML = html;
    }

    function renderEmotionalScatter() {
        const svg = document.getElementById('emotional-scatter');
        if (!svg) return;
        const points = [];
        // Generate mock-ish scatter points (low volatility = confidence high)
        for (let i = 0; i < 30; i++) {
            const x = Math.random() * 380 + 10;
            const y = Math.random() * 180 + 10;
            const r = Math.random() * 4 + 2;
            const opacity = Math.random() * 0.5 + 0.3;
            points.push(`<circle cx="${x}" cy="${y}" r="${r}" fill="#f2ca50" fill-opacity="${opacity}" />`);
        }
        // Axes
        const axes = `
            <line x1="40" y1="180" x2="380" y2="180" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
            <line x1="40" y1="20" x2="40" y2="180" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
            <text x="20" y="30" font-size="9" fill="#99907c" text-anchor="middle">High</text>
            <text x="20" y="180" font-size="9" fill="#99907c" text-anchor="middle">Low</text>
            <text x="380" y="195" font-size="9" fill="#99907c" text-anchor="end">Conf →</text>
        `;
        svg.innerHTML = axes + points.join('');
    }

    function renderSessionBars() {
        const svg = document.getElementById('session-bars');
        if (!svg) return;
        const sessions = [
            { name: 'Asia', value: -120 },
            { name: 'London', value: 280 },
            { name: 'NY', value: 450 },
            { name: 'Late', value: -80 }
        ];
        const max = Math.max(...sessions.map(s => Math.abs(s.value)));
        const barWidth = 60;
        const gap = 30;
        const startX = 50;
        let html = '';
        // Axis
        html += `<line x1="40" y1="170" x2="380" y2="170" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>`;
        sessions.forEach((s, i) => {
            const x = startX + i * (barWidth + gap);
            const height = (Math.abs(s.value) / max) * 130;
            const y = s.value >= 0 ? 170 - height : 170;
            const fill = s.value >= 0 ? 'url(#bar-grad-pos)' : '#f87171';
            html += `<rect x="${x}" y="${y}" width="${barWidth}" height="${height}" fill="${fill}" rx="4" fill-opacity="0.85"/>`;
            html += `<text x="${x + barWidth/2}" y="190" font-size="10" fill="#99907c" text-anchor="middle">${s.name}</text>`;
            html += `<text x="${x + barWidth/2}" y="${y - 5}" font-size="10" fill="#f2ca50" text-anchor="middle" font-weight="600">${s.value >= 0 ? '+' : ''}$${s.value}</text>`;
        });
        html += `<defs><linearGradient id="bar-grad-pos" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#f2ca50" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#f2ca50" stop-opacity="0.3"/>
        </linearGradient></defs>`;
        svg.innerHTML = html;
    }
    </script>
{% endblock %}