{% extends 'shell.html.twig' %}

{% block title %}Hilos del Mundo · T.N.S.V.T{% endblock %}

{% block topbar_title %}Hilos del Mundo{% endblock %}
{% block topbar_subtitle %}El Pulso del Mercado · Macro Calendario{% endblock %}

{% block stylesheets %}
<style>
    .macro-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .macro-card:hover {
        border-color: rgba(242, 202, 80, 0.2);
        box-shadow: 0 0 25px rgba(242, 202, 80, 0.1);
    }
    .nont-trade-banner {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(242, 202, 80, 0.2);
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
    }
    .nont-trade-banner.locked {
        border-color: rgba(248, 113, 113, 0.3);
        background: rgba(248, 113, 113, 0.05);
    }
    .nont-trade-banner.locked::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--error, #f87171), transparent);
    }
    .countdown-display {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 3rem;
        font-weight: 700;
        color: var(--gold-elev, #f2ca50);
        text-shadow: 0 0 20px rgba(242, 202, 80, 0.4);
        animation: countdown-pulse 2s ease-in-out infinite;
    }
    .countdown-display.locked {
        color: var(--error, #f87171);
        text-shadow: 0 0 20px rgba(248, 113, 113, 0.4);
    }
    .countdown-block {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(242, 202, 80, 0.2);
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        text-align: center;
        min-width: 80px;
    }
    .countdown-block.locked {
        border-color: rgba(248, 113, 113, 0.3);
    }
    .countdown-block-value {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--gold-elev, #f2ca50);
    }
    .countdown-block.locked .countdown-block-value {
        color: var(--error, #f87171);
    }
    .countdown-block-label {
        font-size: 0.6rem;
        color: var(--outline-elev, #99907c);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 0.25rem;
    }
    .macro-event-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 0.75rem;
        padding: 1rem;
        transition: all 0.2s ease;
        border-left-width: 3px;
    }
    .macro-event-card:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .macro-event-card.high-impact {
        border-left-color: var(--gold-elev, #f2ca50);
    }
    .macro-event-card.medium-impact {
        border-left-color: rgba(242, 202, 80, 0.5);
    }
    .macro-event-card.low-impact {
        border-left-color: rgba(255, 255, 255, 0.2);
    }
    .impact-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .impact-dot.high { background: var(--error, #f87171); }
    .impact-dot.medium { background: var(--warning, #fbbf24); }
    .impact-dot.low { background: var(--success, #4ade80); }
    .lock-overlay {
        position: absolute;
        inset: 0;
        backdrop-filter: blur(8px);
        background: rgba(5, 3, 8, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 1rem;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
    .lock-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    /* ══════ F3 — Bento Grid Macro ══════ */
    .bento-grid-f3 .bento-card {
        background: var(--glass-bg-elev);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border-elev);
        border-radius: 1rem;
        padding: 1.25rem 1.4rem;
        position: relative;
        overflow: hidden;
    }

    /* F7 — Timezone selector + freshness indicator */
    .bento-tz {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
        background: var(--glass-bg-elev);
        border: 1px solid var(--glass-border-elev);
        border-radius: 0.4rem;
        color: var(--on-surface-elev);
        cursor: pointer;
        transition: border-color 0.15s;
    }
    .bento-tz:hover, .bento-tz:focus { border-color: var(--gold-elev); outline: none; }
    #bento-last-update {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.7rem;
        opacity: 0.7;
        transition: opacity 0.2s;
    }
    #bento-last-update.stale { color: #fbbf24; opacity: 1; }
        transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .bento-grid-f3 .bento-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(242, 202, 80, 0.5), transparent);
    }
    .bento-grid-f3 .bento-card:hover { border-color: rgba(242, 202, 80, 0.25); }
    .bento-card-critical::before { background: linear-gradient(90deg, transparent, #f87171, transparent); }
    .bento-card-window::before   { background: linear-gradient(90deg, transparent, var(--gold-elev), transparent); }
    .bento-card-pairs::before    { background: linear-gradient(90deg, transparent, #8a3cff, transparent); }
    .bento-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .bento-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--outline-elev);
    }
    .bento-eyebrow .material-symbols-outlined { font-size: 1rem; }
    .bento-card-title {
        font-family: 'Cinzel', serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--gold-elev);
        margin: 0.3rem 0 0.25rem;
        line-height: 1.2;
    }
    .bento-card-meta {
        font-size: 0.75rem;
        color: var(--outline-elev);
        margin: 0 0 0.75rem 0;
    }
    .bento-impact-pill {
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 9999px;
        background: rgba(248, 113, 113, 0.18);
        color: #f87171;
        border: 1px solid rgba(248, 113, 113, 0.4);
        letter-spacing: 0.05em;
    }
    .bento-impact-pill.muted { background: rgba(255,255,255,0.05); color: var(--outline-elev); border-color: var(--glass-border-elev); }
    .bento-status-pill {
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 9999px;
        background: rgba(242, 202, 80, 0.15);
        color: var(--gold-elev);
        border: 1px solid rgba(242, 202, 80, 0.4);
        letter-spacing: 0.08em;
    }
    .bento-status-pill.active {
        background: rgba(248, 113, 113, 0.18);
        color: #f87171;
        border-color: rgba(248, 113, 113, 0.5);
        animation: bento-pulse 2s ease-in-out infinite;
    }
    .bento-status-pill.clear { background: rgba(74, 222, 128, 0.15); color: #4ade80; border-color: rgba(74, 222, 128, 0.4); }
    @keyframes bento-pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.85; }
    }
    .bento-countdown {
        font-family: 'Cinzel', serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--on-surface-elev);
        margin: 0.5rem 0 1rem;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }
    .bento-countdown.active { color: #f87171; text-shadow: 0 0 12px rgba(248, 113, 113, 0.35); }
    .bento-countdown.cleared { color: #4ade80; }
    .bento-kv {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.4rem;
        padding-top: 0.6rem;
        border-top: 1px dashed var(--glass-border-elev);
    }
    .bento-kv > div { min-width: 0; }
    .bento-kv dt {
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--outline-elev);
        margin-bottom: 0.15rem;
    }
    .bento-kv dd {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--on-surface-elev);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .bento-window-rule {
        font-size: 0.7rem;
        color: var(--outline-elev);
        margin: 0.75rem 0;
        line-height: 1.4;
    }
    .bento-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .bento-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.85rem;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        background: rgba(242, 202, 80, 0.18);
        color: var(--gold-elev);
        border: 1px solid rgba(242, 202, 80, 0.5);
        border-radius: 0.4rem;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
    }
    .bento-btn-primary:hover { background: rgba(242, 202, 80, 0.28); transform: translateY(-1px); }
    .bento-btn-primary.active {
        background: rgba(74, 222, 128, 0.18);
        color: #4ade80;
        border-color: rgba(74, 222, 128, 0.5);
    }
    .bento-btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: transparent;
        border: 1px solid var(--glass-border-elev);
        border-radius: 0.4rem;
        color: var(--outline-elev);
        cursor: pointer;
        transition: color 0.15s;
    }
    .bento-btn-ghost:hover { color: var(--on-surface-elev); }
    .bento-reminder-config {
        margin-top: 0.6rem;
        padding: 0.5rem 0.7rem;
        background: rgba(74, 222, 128, 0.08);
        border: 1px solid rgba(74, 222, 128, 0.3);
        border-radius: 0.4rem;
        font-size: 0.7rem;
        color: #bbf7d0;
    }
    .bento-reminder-config[hidden] { display: none; }
    .bento-pairs-list {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 0;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }
    .bento-pair-row {
        display: grid;
        grid-template-columns: 64px 1fr 38px;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0.5rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 0.4rem;
    }
    .bento-pair-name {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--on-surface-elev);
    }
    .bento-pair-bar {
        height: 8px;
        background: rgba(138, 60, 255, 0.15);
        border-radius: 9999px;
        overflow: hidden;
        position: relative;
    }
    .bento-pair-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #8a3cff 0%, var(--gold-elev) 100%);
        border-radius: 9999px;
        transition: width 0.4s ease;
    }
    .bento-pair-conf {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--gold-elev);
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
    .bento-pair-rationale {
        font-size: 0.6rem;
        color: var(--outline-elev);
        grid-column: 1 / -1;
        margin-top: 0.2rem;
        line-height: 1.3;
    }
    .bento-pair-empty {
        text-align: center;
        color: var(--outline-elev);
        font-size: 0.8rem;
        padding: 1.5rem 0;
        list-style: none;
        line-height: 1.5;
    }
    .bento-pair-empty .material-symbols-outlined {
        font-size: 1.8rem;
        opacity: 0.4;
        color: var(--gold-elev);
        display: block;
        margin: 0 auto 0.4rem;
    }
    @media (max-width: 640px) {
        .bento-countdown { font-size: 1.5rem; }
        .bento-kv { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto">

    {# ══════ F3 — Bento Grid (Próximo Crítico + Ventana + Pares Afectados) ══════ #}
    <section class="mb-6 bento-grid-f3" aria-label="Bento macro">
        <div class="flex items-center justify-between mb-3 flex-wrap gap-3">
            <h2 class="text-cinzel-display text-lg tracking-wider flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">view_in_ar</span>
                MACRO BENTO
            </h2>
            <div class="flex items-center gap-3 flex-wrap" id="bento-counter">
                <span id="bento-counter-text" class="text-xs text-[var(--outline-elev)]">Cargando…</span>
                <select id="bento-tz" class="bento-tz" title="Zona horaria" aria-label="Zona horaria">
                    <option value="America/Argentina/Buenos_Aires">🇦🇷 AR</option>
                    <option value="America/New_York">🇺🇸 NY</option>
                    <option value="America/Los_Angeles">🇺🇸 LA</option>
                    <option value="America/Sao_Paulo">🇧🇷 BR</option>
                    <option value="Europe/Madrid">🇪🇸 ES</option>
                    <option value="Europe/London">🇬🇧 UK</option>
                    <option value="Asia/Tokyo">🇯🇵 JP</option>
                    <option value="UTC">🌐 UTC</option>
                </select>
                <span class="text-xs text-[var(--outline-elev)]" id="bento-last-update">—</span>
                <button type="button" id="bento-refresh" class="text-[var(--gold-elev)] hover:underline" title="Refrescar ahora">↻</button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            {# 1. Próximo Crítico #}
            <article class="bento-card bento-card-critical" aria-labelledby="bento-critical-title">
                <header class="bento-card-header">
                    <span class="bento-eyebrow"><span class="material-symbols-outlined">local_fire_department</span> Próximo crítico</span>
                    <span class="bento-impact-pill" id="bento-critical-impact">—</span>
                </header>
                <h3 class="bento-card-title" id="bento-critical-title">—</h3>
                <p class="bento-card-meta">
                    <span id="bento-critical-country">—</span>
                    ·
                    <span id="bento-critical-time">—</span>
                    (<span id="bento-critical-tz">—</span>)
                </p>
                <div class="bento-countdown" id="bento-critical-countdown">—</div>

                <dl class="bento-kv">
                    <div><dt>Previsión</dt><dd id="bento-critical-forecast">—</dd></div>
                    <div><dt>Anterior</dt><dd id="bento-critical-previous">—</dd></div>
                    <div><dt>Actual</dt><dd id="bento-critical-actual">—</dd></div>
                </dl>
            </article>

            {# 2. Ventana No-Operar #}
            <article class="bento-card bento-card-window" aria-labelledby="bento-window-title">
                <header class="bento-card-header">
                    <span class="bento-eyebrow">
                        <span class="material-symbols-outlined">timer</span> Ventana No-Operar
                    </span>
                    <span class="bento-status-pill" id="bento-window-status">—</span>
                </header>
                <h3 class="bento-card-title" id="bento-window-title">—</h3>
                <p class="bento-card-meta" id="bento-window-meta">—</p>
                <div class="bento-countdown" id="bento-window-countdown">—</div>
                <p class="bento-window-rule">
                    15' antes · <strong>EVENTO</strong> · 15' después.
                    <br><span class="text-[var(--outline-elev)]">Disciplina = capital.</span>
                </p>
                <div class="bento-actions">
                    <button type="button" class="bento-btn-primary" id="bento-remind-btn">
                        <span class="material-symbols-outlined">notifications_active</span>
                        Recordarme 15' antes
                    </button>
                    <button type="button" class="bento-btn-ghost" id="bento-mute-btn">
                        <span class="material-symbols-outlined">volume_off</span>
                    </button>
                </div>
                <div class="bento-reminder-config" id="bento-reminder-config" hidden>
                    <span id="bento-reminder-status">Recordatorio configurado para</span>
                    <strong id="bento-reminder-when">—</strong>
                </div>
            </article>

            {# 3. Pares Más Afectados #}
            <article class="bento-card bento-card-pairs" aria-labelledby="bento-pairs-title">
                <header class="bento-card-header">
                    <span class="bento-eyebrow">
                        <span class="material-symbols-outlined">hub</span> Pares más afectados
                    </span>
                    <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">confianza</span>
                </header>
                <h3 class="bento-card-title" id="bento-pairs-title">—</h3>
                <ul class="bento-pairs-list" id="bento-pairs-list">
                    <li class="bento-pair-empty">Sin próximo evento crítico</li>
                </ul>
            </article>
        </div>
    </section>

    {# Header #}
    <div class="text-center mb-8">
        <p class="font-label-sm text-label-sm text-primary uppercase tracking-[0.3em] mb-2">Calendario Económico</p>
        <h1 class="font-headline-xl text-headline-xl shimmer-text">El Pulso del Mercado</h1>
        <p class="text-on-surface-variant opacity-70 italic mt-2">"Operar en el momento equivocado borra todos tus conocimientos."</p>
    </div>

    {# No-Trade Window Banner #}
    <div id="ntw-banner" class="nont-trade-banner">
        <div class="flex items-center gap-4">
            <div id="ntw-icon" class="w-14 h-14 rounded-full bg-[var(--gold-elev)] flex items-center justify-center">
                <span class="material-symbols-outlined text-[var(--on-primary-elev)]" style="font-variation-settings: 'FILL' 1;">timer</span>
            </div>
            <div class="flex-1">
                <h2 class="text-xl font-semibold text-[var(--on-surface-elev)]" id="ntw-title">Cargando...</h2>
                <p class="text-sm text-[var(--outline-elev)]" id="ntw-message">Cargando estado del no-trade window...</p>
            </div>
            <div class="flex gap-3">
                <div class="countdown-block">
                    <p class="countdown-block-value" id="ntw-hours">--</p>
                    <p class="countdown-block-label">Horas</p>
                </div>
                <div class="countdown-block">
                    <p class="countdown-block-value" id="ntw-mins">--</p>
                    <p class="countdown-block-label">Mins</p>
                </div>
                <div class="countdown-block">
                    <p class="countdown-block-value" id="ntw-secs">--</p>
                    <p class="countdown-block-label">Segs</p>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# No-Trade Window Timeline #}
        <div class="macro-card lg:col-span-2 relative">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">schedule</span>
                No-Trade Window Timeline
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">Próximas 168 horas (7 días)</p>
            <div class="relative" style="height: 280px;">
                <svg id="timeline-svg" width="100%" height="100%" viewBox="0 0 800 280" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
            {# Lock Overlay #}
            <div id="lock-overlay" class="lock-overlay">
                <div class="text-center">
                    <span class="material-symbols-outlined text-5xl text-[var(--error)] pulse-gold">gavel</span>
                    <p class="font-headline-lg text-[var(--error)] font-bold mt-2">PROHIBIDO OPERAR</p>
                    <p class="font-label-sm text-[var(--outline-elev)] mt-1">La volatilidad sagrada se aproxima</p>
                    <p class="text-xs text-[var(--outline-elev)] mt-2" id="lock-message">Respeta los hilos o serás consumido</p>
                </div>
            </div>
        </div>

        {# Upcoming Events List #}
        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">public</span>
                Próximos eventos
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">High-impact (importance ≥ 3)</p>
            <div id="upcoming-list" class="space-y-2 max-h-96 overflow-y-auto pr-2">
                <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando eventos...</p>
            </div>
        </div>
    </div>

    {# Trading Discipline Rules #}
    <div class="macro-card mt-6">
        <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
            <span class="material-symbols-outlined text-[var(--gold-elev)]">shield</span>
            Regla de Disciplina
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                <div class="glass-card-elev p-4">
                    <p class="text-[var(--gold-elev)] font-bold text-2xl">15'</p>
                    <p class="text-[var(--on-surface-elev)] font-medium">Antes del evento</p>
                    <p class="text-[var(--outline-elev)] text-xs">No abras trades. Cierra posiciones abiertas.</p>
                </div>
                <div class="glass-card-elev p-4 border-2 border-[var(--gold-elev)]">
                    <p class="text-[var(--gold-elev)] font-bold text-2xl">EVENTO</p>
                    <p class="text-[var(--on-surface-elev)] font-medium">Durante la noticia</p>
                    <p class="text-[var(--outline-elev)] text-xs">Spread se expande. Liquidez se seca. Chaos.</p>
                </div>
                <div class="glass-card-elev p-4">
                    <p class="text-[var(--gold-elev)] font-bold text-2xl">15'</p>
                    <p class="text-[var(--on-surface-elev)] font-medium">Después del evento</p>
                    <p class="text-[var(--outline-elev)] text-xs">Espera. Confirmá dirección. Re-entrada segura.</p>
                </div>
            </div>
        </div>
    </div>

    {# Macro Oracle — Faith vs Logic + Session Performance + Scatter #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">balance</span>
                Faith vs Logic
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">Equilibrio emocional de los últimos 30 días</p>
            <div class="flex items-center justify-center" style="height: 200px;">
                <svg id="faith-logic-gauge" width="200" height="200" viewBox="0 0 200 200"></svg>
            </div>
            <div class="flex justify-between text-xs mt-2">
                <span class="text-[var(--gold-elev)]">Faith</span>
                <span class="text-[var(--outline-elev)]">Logic</span>
            </div>
        </div>

        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">scatter_plot</span>
                Emotional Bias Scatter
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">Volatility vs Confidence</p>
            <div class="relative" style="height: 200px;">
                <svg id="emotional-scatter" width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
        </div>

        <div class="macro-card">
            <h3 class="text-lg font-semibold mb-2 text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">schedule</span>
                Session Performance
            </h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">P&L por sesión</p>
            <div class="relative" style="height: 200px;">
                <svg id="session-bars" width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
        </div>
    </div>

    <script>
    // ══════ F3 — Bento Grid ══════
    let _bentoState = null;
    let _bentoReminderTimer = null;

    function fmtDuration(seconds) {
        if (seconds < 0) seconds = 0;
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = seconds % 60;
        if (h > 0) return `${h}h ${String(m).padStart(2,'0')}m`;
        if (m > 0) return `${m}m ${String(s).padStart(2,'0')}s`;
        return `${s}s`;
    }

    function escapeHtmlBento(s) {
        return String(s ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    async function loadMacroBento() {
        const grid = document.getElementById('bento-counter-text');
        if (!grid) return;
        const tz = (document.getElementById('bento-tz') || { value: 'America/Argentina/Buenos_Aires' }).value;
        try {
            const r = await apiFetch('/api/macro/bento?tz=' + encodeURIComponent(tz), { silent: true });
            if (!r.ok || !r.data || !r.data.success) {
                grid.textContent = 'Sin datos';
                return;
            }
            _bentoState = r.data;
            renderBento(r.data);
            updateBentoLastUpdate();
        } catch (e) {
            grid.textContent = 'Sin conexión';
        }
    }

    // F7 — Freshness indicator (relative time + auto-refresh countdown)
    let _bentoLastUpdate = null;
    function updateBentoLastUpdate() {
        _bentoLastUpdate = new Date();
        const el = document.getElementById('bento-last-update');
        if (!el) return;
        el.textContent = 'Recién';
        el.classList.remove('stale');
    }
    function tickBentoFreshness() {
        if (!_bentoLastUpdate) return;
        const el = document.getElementById('bento-last-update');
        if (!el) return;
        const secs = Math.floor((Date.now() - _bentoLastUpdate.getTime()) / 1000);
        if (secs < 5)        el.textContent = 'Recién';
        else if (secs < 60)  el.textContent = `hace ${secs}s`;
        else if (secs < 3600) el.textContent = `hace ${Math.floor(secs/60)}m`;
        else                 el.textContent = `hace ${Math.floor(secs/3600)}h`;
        if (secs > 600) el.classList.add('stale');
        else el.classList.remove('stale');
    }
    setInterval(tickBentoFreshness, 5 * 1000);

    function renderBento(data) {
        const next = data.next_critical;
        const window = data.window;

        // === Counter header ===
        const counterEl = document.getElementById('bento-counter-text');
        if (counterEl) {
            const total = data.upcoming_count || 0;
            const critical = data.critical_this_week_count || 0;
            counterEl.textContent = `${total} eventos próximos · ${critical} críticos esta semana`;
        }

        // === Card 1 — Próximo Crítico ===
        const impactEl = document.getElementById('bento-critical-impact');
        const titleEl = document.getElementById('bento-critical-title');
        const countryEl = document.getElementById('bento-critical-country');
        const timeEl = document.getElementById('bento-critical-time');
        const tzEl = document.getElementById('bento-critical-tz');
        const countdownEl = document.getElementById('bento-critical-countdown');
        const forecastEl = document.getElementById('bento-critical-forecast');
        const previousEl = document.getElementById('bento-critical-previous');
        const actualEl = document.getElementById('bento-critical-actual');

        if (next) {
            impactEl.textContent = `IMPACT ${next.importance || 3}`;
            impactEl.classList.remove('muted');
            titleEl.textContent = next.title || next.original_title || '—';
            countryEl.textContent = `${next.country || ''} ${next.currency || ''}`.trim() || '—';
            timeEl.textContent = `${next.date || ''} ${next.time || ''}`;
            tzEl.textContent = data.tz_label || '—';
            forecastEl.textContent = next.forecast || '—';
            previousEl.textContent = next.previous || '—';
            actualEl.textContent = next.actual || '—';
            if (data.next_critical.seconds_until_event > 0) {
                countdownEl.textContent = 'En ' + fmtDuration(data.next_critical.seconds_until_event);
                countdownEl.classList.remove('active');
                countdownEl.classList.remove('cleared');
            } else {
                countdownEl.textContent = 'EN VIVO';
                countdownEl.classList.add('active');
            }
        } else {
            impactEl.textContent = '—';
            impactEl.classList.add('muted');
            titleEl.textContent = 'Sin eventos críticos próximos';
            countryEl.textContent = '—'; timeEl.textContent = '—'; tzEl.textContent = '—';
            forecastEl.textContent = '—'; previousEl.textContent = '—'; actualEl.textContent = '—';
            countdownEl.textContent = '✓ Libre';
            countdownEl.classList.add('cleared');
        }

        // === Card 2 — Ventana ===
        const winStatusEl = document.getElementById('bento-window-status');
        const winTitleEl = document.getElementById('bento-window-title');
        const winMetaEl = document.getElementById('bento-window-meta');
        const winCountdownEl = document.getElementById('bento-window-countdown');
        const remindBtn = document.getElementById('bento-remind-btn');
        const muteBtn = document.getElementById('bento-remind-btn');
        const reminderConfig = document.getElementById('bento-reminder-config');
        const reminderWhen = document.getElementById('bento-reminder-when');
        const reminderStatus = document.getElementById('bento-reminder-status');

        if (window) {
            winStatusEl.classList.remove('clear', 'active');
            if (window.is_active) {
                winStatusEl.textContent = 'ACTIVA';
                winStatusEl.classList.add('active');
                winTitleEl.textContent = '⛔ NO OPERAR';
                winCountdownEl.textContent = 'Ends in ' + fmtDuration(window.seconds_until_end);
                winCountdownEl.classList.add('active');
            } else {
                winStatusEl.textContent = 'PRÓXIMA';
                winTitleEl.textContent = window.reason || '—';
                winCountdownEl.textContent = 'En ' + fmtDuration(window.seconds_until_start);
                winCountdownEl.classList.remove('active');
            }
            winMetaEl.textContent = `± 30 min · starts ${formatBsAs(window.starts_at)}`;
        } else {
            winStatusEl.textContent = 'CLEAR';
            winStatusEl.classList.add('clear');
            winTitleEl.textContent = 'Sin ventanas activas';
            winCountdownEl.textContent = '✓';
            winCountdownEl.classList.add('cleared');
            winMetaEl.textContent = '';
        }

        // === Card 3 — Pares Afectados ===
        const pairsTitle = document.getElementById('bento-pairs-title');
        const pairsList = document.getElementById('bento-pairs-list');
        const pairs = data.affected_pairs || [];
        if (pairs.length > 0 && next) {
            pairsTitle.textContent = `${next.currency || 'USD'} mueve:`;
            pairsList.innerHTML = pairs.map(p => {
                const w = Math.max(8, Math.min(100, p.confidence || 0));
                return `
                    <li class="bento-pair-row">
                        <span class="bento-pair-name">${escapeHtmlBento(p.pair)}</span>
                        <div class="bento-pair-bar"><div class="bento-pair-bar-fill" style="width:${w}%"></div></div>
                        <span class="bento-pair-conf">${p.confidence}%</span>
                        <span class="bento-pair-rationale">${escapeHtmlBento(p.rationale)}</span>
                    </li>
                `;
            }).join('');
        } else {
            pairsTitle.textContent = 'Sin próximo evento';
            pairsList.innerHTML = `
                <li class="bento-pair-empty">
                    <span class="material-symbols-outlined">sailing</span>
                    Mar en calma.
                    <br>El próximo evento crítico activará la lista.
                </li>
            `;
        }

        // === Reminder persistence ===
        restoreReminderUI();
    }

    function formatBsAs(iso) {
        try {
            const d = new Date(iso);
            return d.toLocaleString('es-AR', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: 'short' });
        } catch (e) { return iso; }
    }

    async function requestNotificationPermissionIfNeeded() {
        if (!('Notification' in window)) return false;
        if (Notification.permission === 'granted') return true;
        if (Notification.permission === 'denied') return false;
        try {
            const perm = await Notification.requestPermission();
            return perm === 'granted';
        } catch (e) { return false; }
    }

    function setReminder(eventIso, remindBeforeSec = 900) {
        const eventDt = new Date(eventIso).getTime();
        if (isNaN(eventDt)) return false;
        const remindAt = eventDt - remindBeforeSec * 1000;
        if (remindAt <= Date.now()) return false;
        localStorage.setItem('tnsvt_bento_reminder', JSON.stringify({
            eventIso, remindAtSec: remindBeforeSec,
        }));
        // Clear any existing timer
        if (_bentoReminderTimer) clearTimeout(_bentoReminderTimer);
        const ms = Math.max(0, remindAt - Date.now());
        _bentoReminderTimer = setTimeout(() => {
            triggerReminder();
        }, ms);
        return true;
    }

    function clearReminder() {
        localStorage.removeItem('tnsvt_bento_reminder');
        if (_bentoReminderTimer) clearTimeout(_bentoReminderTimer);
        _bentoReminderTimer = null;
    }

    function triggerReminder() {
        if (!(_bentoState && _bentoState.next_critical)) return;
        const evt = _bentoState.next_critical;
        // Show in-page alert
        showReminderBanner(evt);
        // Browser notification if permitted
        if ('Notification' in window && Notification.permission === 'granted') {
            try {
                new Notification('⏰ Recordatorio macro · 15 min', {
                    body: `${evt.title} ${evt.currency} en 15 min · No operes durante ±30 min.`,
                    icon: '/assets/icons/icon-192.png',
                });
            } catch (e) { /* no-op */ }
        }
    }

    function showReminderBanner(evt) {
        // Insert a transient banner at the top of <main>
        const main = document.querySelector('main') || document.body;
        const existing = document.getElementById('bento-reminder-banner');
        if (existing) existing.remove();
        const banner = document.createElement('div');
        banner.id = 'bento-reminder-banner';
        banner.style.cssText = 'position:sticky;top:0;z-index:50;background:rgba(248,113,113,0.18);border:1px solid #f87171;color:#fecaca;padding:0.6rem 1rem;border-radius:0.4rem;backdrop-filter:blur(8px);margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center;gap:0.5rem;';
        banner.innerHTML = `
            <span><strong>⏰ 15 min para:</strong> ${escapeHtmlBento(evt.title)} (${escapeHtmlBento(evt.currency)}) · cerrá posiciones o esperá</span>
            <button type="button" id="bento-reminder-dismiss" style="background:transparent;border:1px solid #f87171;color:#fecaca;padding:0.25rem 0.5rem;border-radius:0.3rem;cursor:pointer;">OK</button>
        `;
        main.insertBefore(banner, main.firstChild);
        document.getElementById('bento-reminder-dismiss').addEventListener('click', () => banner.remove());
    }

    function restoreReminderUI() {
        const remindBtn = document.getElementById('bento-remind-btn');
        const reminderConfig = document.getElementById('bento-reminder-config');
        const reminderWhen = document.getElementById('bento-reminder-when');
        const stored = localStorage.getItem('tnsvt_bento_reminder');
        if (!stored) {
            remindBtn.classList.remove('active');
            reminderConfig.hidden = true;
            return;
        }
        try {
            const r = JSON.parse(stored);
            remindBtn.classList.add('active');
            reminderConfig.hidden = false;
            const dt = new Date(r.eventIso);
            reminderWhen.textContent = dt.toLocaleString('es-AR');
            // Re-arm timer if needed
            const remindAt = new Date(r.eventIso).getTime() - r.remindAtSec * 1000;
            const ms = Math.max(0, remindAt - Date.now());
            if (ms > 0 && !_bentoReminderTimer) {
                _bentoReminderTimer = setTimeout(triggerReminder, ms);
            }
        } catch (e) {
            localStorage.removeItem('tnsvt_bento_reminder');
        }
    }

    function wireBento() {
        const remindBtn = document.getElementById('bento-remind-btn');
        const muteBtn = document.getElementById('bento-mute-btn');
        const refreshBtn = document.getElementById('bento-refresh');
        const tzSelect = document.getElementById('bento-tz');
        if (!remindBtn) return;

        // F7 — restore saved TZ + react to changes
        if (tzSelect) {
            const saved = localStorage.getItem('tnsvt_macro_tz');
            if (saved) {
                const opt = Array.from(tzSelect.options).find(o => o.value === saved);
                if (opt) tzSelect.value = saved;
            }
            tzSelect.addEventListener('change', () => {
                localStorage.setItem('tnsvt_macro_tz', tzSelect.value);
                loadMacroBento();
            });
        }

        remindBtn.addEventListener('click', async () => {
            if (!_bentoState || !_bentoState.next_critical || !_bentoState.window) {
                alert('No hay un próximo evento crítico para recordarte.');
                return;
            }
            const existing = localStorage.getItem('tnsvt_bento_reminder');
            if (existing) {
                if (confirm('¿Cancelar el recordatorio actual?')) {
                    clearReminder();
                    restoreReminderUI();
                }
                return;
            }
            const ok = await requestNotificationPermissionIfNeeded();
            // Set timer regardless (in-page banner works without permission)
            const set = setReminder(_bentoState.window.starts_at, 15 * 60);
            if (!set) {
                alert('El evento empieza en menos de 15 minutos. Recordatorio no aplica.');
                return;
            }
            restoreReminderUI();
        });
        muteBtn && muteBtn.addEventListener('click', () => clearReminder());
        refreshBtn && refreshBtn.addEventListener('click', () => loadMacroBento());
    }

    document.addEventListener('DOMContentLoaded', () => {
        wireBento();
        loadMacroBento();
        // Re-fetch every 5 min for freshest data
        setInterval(loadMacroBento, 5 * 60 * 1000);
    });

    let countdownInterval = null;
    let allWindows = [];

    function formatTime(seconds) {
        if (seconds < 0) seconds = 0;
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = seconds % 60;
        if (h > 0) return `${h}h ${m}m`;
        if (m > 0) return `${m}m ${s}s`;
        return `${s}s`;
    }

    async function loadAll() {
        // Load windows
        try {
            const resp = await fetch('/api/macro/windows?limit=30');
            const data = await resp.json();
            if (data.success) {
                allWindows = data.windows;
                renderTimeline(allWindows);
                renderUpcoming(allWindows);
                updateStatus(data.windows);
            }
        } catch (e) {
            console.error(e);
        }
    }

    function updateStatus(windows) {
        const now = new Date();
        const active = windows.find(w => w.is_active);
        const upcoming = windows.filter(w => !w.is_active && new Date(w.start) > now).sort((a, b) => new Date(a.start) - new Date(b.start));

        const titleEl = document.getElementById('ntw-title');
        const msgEl = document.getElementById('ntw-message');
        const iconEl = document.getElementById('ntw-icon');
        const countdownEl = document.getElementById('ntw-countdown');
        const labelEl = document.getElementById('ntw-countdown-label');
        const bannerEl = document.getElementById('ntw-banner');

        if (countdownInterval) clearInterval(countdownInterval);

        if (active) {
            // ACTIVE WINDOW
            titleEl.textContent = '🔴 No-Trade Window ACTIVA';
            msgEl.innerHTML = `<strong>${active.title}</strong> (${active.country} ${active.currency}) · impact ${active.importance}`;
            iconEl.style.background = '#ff6b6b';
            countdownEl.textContent = formatTime(active.seconds_until_end);
            labelEl.textContent = 'Hasta el final del window';
            bannerEl.style.borderLeftColor = '#ff6b6b';
        } else if (upcoming.length > 0) {
            const next = upcoming[0];
            titleEl.textContent = 'Próximo: ' + next.title;
            msgEl.innerHTML = `${next.country} ${next.currency} · impact ${next.importance} · ${new Date(next.start).toLocaleString()}`;
            iconEl.style.background = 'var(--gold-elev)';
            labelEl.textContent = 'Inicia en';
            bannerEl.style.borderLeftColor = 'var(--gold-elev)';

            countdownInterval = setInterval(() => {
                const remaining = new Date(next.start).getTime() - Date.now();
                countdownEl.textContent = formatTime(Math.max(0, Math.floor(remaining / 1000)));
                if (remaining <= 0) loadAll();
            }, 1000);
        } else {
            titleEl.textContent = '✓ Sin eventos próximos';
            msgEl.textContent = 'No hay no-trade windows en el horizonte cercano';
            iconEl.style.background = 'var(--glass-bg-elev)';
            countdownEl.textContent = 'LIBRE';
            labelEl.textContent = 'No events';
            bannerEl.style.borderLeftColor = 'var(--gold-elev)';
        }
    }

    function renderTimeline(windows) {
        const svg = document.getElementById('timeline-svg');
        const w = 800, h = 280;
        const now = new Date();
        const range = 7 * 24 * 60 * 60 * 1000; // 7 days
        const startMs = now.getTime();
        const endMs = startMs + range;
        const xScale = (ms) => 40 + ((ms - startMs) / range) * (w - 60);
        const yHigh = h - 50;
        const yMid = h - 80;
        const yLow = h - 110;

        let html = '';
        // X-axis (now line)
        const nowX = xScale(now.getTime());
        html += `<line x1="${nowX}" y1="20" x2="${nowX}" y2="${h - 30}" stroke="var(--gold-elev)" stroke-width="1.5" />`;
        html += `<text x="${nowX}" y="14" text-anchor="middle" font-size="10" fill="var(--gold-elev)">NOW</text>`;
        // Day markers
        for (let d = 0; d <= 7; d++) {
            const dayX = xScale(startMs + d * 24 * 60 * 60 * 1000);
            html += `<line x1="${dayX}" y1="${h - 30}" x2="${dayX}" y2="${h - 25}" stroke="var(--outline-variant-elev)" stroke-width="0.5" />`;
            const dayDate = new Date(startMs + d * 24 * 60 * 60 * 1000);
            html += `<text x="${dayX}" y="${h - 12}" text-anchor="middle" font-size="9" fill="var(--outline-elev)">${dayDate.getDate()}/${dayDate.getMonth() + 1}</text>`;
        }
        // Time axis line
        html += `<line x1="40" y1="${h - 30}" x2="${w - 20}" y2="${h - 30}" stroke="var(--outline-variant-elev)" stroke-width="0.5" />`;
        // Plot each event window
        for (const win of windows) {
            const startMs = new Date(win.start).getTime();
            const endMs = new Date(win.end).getTime();
            if (endMs < startMs || startMs > endMs) continue;
            const x1 = Math.max(40, xScale(startMs));
            const x2 = Math.min(w - 20, xScale(endMs));
            if (x2 < x1) continue;
            const isActive = win.is_active;
            const color = isActive ? '#ff6b6b' : 'var(--gold-elev)';
            const opacity = isActive ? '0.8' : '0.4';
            // Choose y based on importance (3 = high, so higher position)
            const y = win.importance >= 3 ? yHigh : (win.importance >= 2 ? yMid : yLow);
            const wpx = x2 - x1;
            html += `<rect x="${x1}" y="${y - 8}" width="${wpx}" height="16" fill="${color}" fill-opacity="${opacity}" rx="2"><title>${win.title} (${win.country})</title></rect>`;
            // Event marker (start)
            html += `<line x1="${x1}" y1="${y - 14}" x2="${x1}" y2="${y + 14}" stroke="${color}" stroke-width="1.5" />`;
            if (wpx > 40) {
                const displayTitle = win.title.length > 18 ? win.title.substring(0, 15) + '...' : win.title;
                html += `<text x="${x1 + 2}" y="${y + 3}" font-size="8" fill="white" pointer-events="none">${displayTitle}</text>`;
            }
        }
        // Legend
        html += `<rect x="40" y="10" width="10" height="10" fill="var(--gold-elev)" fill-opacity="0.4" />`;
        html += `<text x="55" y="19" font-size="9" fill="var(--outline-elev)">Próximo</text>`;
        html += `<rect x="100" y="10" width="10" height="10" fill="#ff6b6b" fill-opacity="0.8" />`;
        html += `<text x="115" y="19" font-size="9" fill="var(--outline-elev)">Activo</text>`;
        svg.innerHTML = html;
    }

    function renderUpcoming(windows) {
        const list = document.getElementById('upcoming-list');
        const now = new Date();
        const upcoming = windows.filter(w => !w.is_active && new Date(w.start) > now).sort((a, b) => new Date(a.start) - new Date(b.start));
        if (upcoming.length === 0) {
            list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin eventos próximos</p>';
            return;
        }
        list.innerHTML = upcoming.slice(0, 15).map(w => {
            const startDt = new Date(w.start);
            const seconds = w.seconds_until_start;
            const urgency = seconds < 3600 ? 'urgent' : (seconds < 21600 ? 'soon' : 'later');
            return `
                <div class="flex items-center gap-3 p-2 rounded glass-card-elev border-l-2 ${urgency === 'urgent' ? 'border-red-400' : 'border-[var(--gold-elev)]'}">
                    <div class="text-center min-w-12">
                        <p class="text-2xl font-bold text-[var(--gold-elev)]">${startDt.getDate()}</p>
                        <p class="text-xs text-[var(--outline-elev)] uppercase">${['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][startDt.getMonth()]}</p>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-[var(--on-surface-elev)] truncate">${w.title}</p>
                        <p class="text-xs text-[var(--outline-elev)]">${w.country} ${w.currency} · ${startDt.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-[var(--outline-elev)] uppercase">En</p>
                        <p class="text-sm font-bold ${urgency === 'urgent' ? 'text-red-400' : 'text-[var(--gold-elev)]'}">${formatTime(seconds)}</p>
                    </div>
                </div>
            `;
        }).join('');
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadAll();
        renderOracleCharts();
        // Auto-refresh every 60s
        setInterval(loadAll, 60000);
    });

    function renderOracleCharts() {
        renderFaithLogicGauge();
        renderEmotionalScatter();
        renderSessionBars();
    }

    function renderFaithLogicGauge() {
        const svg = document.getElementById('faith-logic-gauge');
        if (!svg) return;
        const cx = 100, cy = 100, r = 80;
        const faith = 50; // default balance (0-100)
        const angle = -90 + (faith / 100) * 180; // semicircle from -90 to +90
        const rad = (angle * Math.PI) / 180;
        const needleX = cx + (r - 12) * Math.cos(rad);
        const needleY = cy + (r - 12) * Math.sin(rad);
        const svgNS = 'http://www.w3.org/2000/svg';
        let html = '';
        // Background arc
        html += `<path d="M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${cx + r} ${cy}" stroke="rgba(255,255,255,0.08)" stroke-width="12" fill="none"/>`;
        // Foreground arc (gold)
        html += `<path d="M ${cx - r} ${cy} A ${r} ${r} 0 0 1 ${needleX} ${needleY}" stroke="url(#gauge-grad)" stroke-width="12" fill="none" stroke-linecap="round"/>`;
        // Gradient
        html += `<defs><linearGradient id="gauge-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#f2ca50"/><stop offset="100%" stop-color="#8a3cff"/>
        </linearGradient></defs>`;
        // Needle
        html += `<line x1="${cx}" y1="${cy}" x2="${needleX}" y2="${needleY}" stroke="#f2ca50" stroke-width="2" stroke-linecap="round"/>`;
        html += `<circle cx="${cx}" cy="${cy}" r="6" fill="#f2ca50"/>`;
        // Labels
        html += `<text x="20" y="180" font-size="11" fill="#f2ca50" font-weight="600">FAITH</text>`;
        html += `<text x="155" y="180" font-size="11" fill="#99907c" font-weight="600">LOGIC</text>`;
        svg.innerHTML = html;
    }

    function renderEmotionalScatter() {
        const svg = document.getElementById('emotional-scatter');
        if (!svg) return;
        const points = [];
        // Generate mock-ish scatter points (low volatility = confidence high)
        for (let i = 0; i < 30; i++) {
            const x = Math.random() * 380 + 10;
            const y = Math.random() * 180 + 10;
            const r = Math.random() * 4 + 2;
            const opacity = Math.random() * 0.5 + 0.3;
            points.push(`<circle cx="${x}" cy="${y}" r="${r}" fill="#f2ca50" fill-opacity="${opacity}" />`);
        }
        // Axes
        const axes = `
            <line x1="40" y1="180" x2="380" y2="180" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
            <line x1="40" y1="20" x2="40" y2="180" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
            <text x="20" y="30" font-size="9" fill="#99907c" text-anchor="middle">High</text>
            <text x="20" y="180" font-size="9" fill="#99907c" text-anchor="middle">Low</text>
            <text x="380" y="195" font-size="9" fill="#99907c" text-anchor="end">Conf →</text>
        `;
        svg.innerHTML = axes + points.join('');
    }

    function renderSessionBars() {
        const svg = document.getElementById('session-bars');
        if (!svg) return;
        const sessions = [
            { name: 'Asia', value: -120 },
            { name: 'London', value: 280 },
            { name: 'NY', value: 450 },
            { name: 'Late', value: -80 }
        ];
        const max = Math.max(...sessions.map(s => Math.abs(s.value)));
        const barWidth = 60;
        const gap = 30;
        const startX = 50;
        let html = '';
        // Axis
        html += `<line x1="40" y1="170" x2="380" y2="170" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>`;
        sessions.forEach((s, i) => {
            const x = startX + i * (barWidth + gap);
            const height = (Math.abs(s.value) / max) * 130;
            const y = s.value >= 0 ? 170 - height : 170;
            const fill = s.value >= 0 ? 'url(#bar-grad-pos)' : '#f87171';
            html += `<rect x="${x}" y="${y}" width="${barWidth}" height="${height}" fill="${fill}" rx="4" fill-opacity="0.85"/>`;
            html += `<text x="${x + barWidth/2}" y="190" font-size="10" fill="#99907c" text-anchor="middle">${s.name}</text>`;
            html += `<text x="${x + barWidth/2}" y="${y - 5}" font-size="10" fill="#f2ca50" text-anchor="middle" font-weight="600">${s.value >= 0 ? '+' : ''}$${s.value}</text>`;
        });
        html += `<defs><linearGradient id="bar-grad-pos" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#f2ca50" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#f2ca50" stop-opacity="0.3"/>
        </linearGradient></defs>`;
        svg.innerHTML = html;
    }
    </script>
{% endblock %}