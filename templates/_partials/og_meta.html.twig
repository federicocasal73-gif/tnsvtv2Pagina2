{#
   og_meta.html.twig — Open Graph + Twitter Card meta tags
   ───────────────────────────────────────────────────────────────
   Usage (in shell.html.twig or any base template):
     {% block meta_description %}default shell desc{% endblock %}
     {% include '_partials/og_meta.html.twig' with {
       title: block('title')|default('T.N.S.V.T'),
       description: block('meta_description'),
       type: 'website',
     } %}

   Per-page overrides — define in the page template that extends the
   shell. `block()` in the shell walks the inheritance chain and picks
   up the page's value:
     {% block meta_description %}Bitácora de trading con equity
         curve, drawdown y Guardian de riesgo para ejecutores
         del reino.{% endblock %}

   Optional direct overrides (rare; prefer blocks):
     {% include '_partials/og_meta.html.twig' with {
       title: 'Mi Página · T.N.S.V.T',
       description: 'Override hardcoded description',
       image: 'https://tnsvt.com/og/dashboard.png',
       type: 'website',
       url: 'https://tnsvt.com/calendar',
       twitter_card: 'summary_large_image',
       canonical: 'https://tnsvt.com/journal',    ← optional, defaults to app.request.uri
     } %}
#}
{% set _title = title|default('T.N.S.V.T — Reino del Cristo Íntegro') %}
{% set _desc  = description|default('Plataforma neuro-espiritual de trading. Análisis macro, bitácora y guardian.') %}
{% set _type  = type|default('website') %}
{% set _img   = image|default('https://tnsvt.com/og/image?title=T.N.S.V.T%20%E2%80%94%20Reino%20del%20Cristo%20%C3%8Dntegro&variant=gold') %}
{% set _url   = url|default('') %}
{% set _twc   = twitter_card|default('summary_large_image') %}
{% set _site  = 'T.N.S.V.T' %}
{% set _canonical = canonical|default(app.request.uri) %}

<!-- Open Graph -->
<meta property="og:type" content="{{ _type }}" />
<meta property="og:site_name" content="{{ _site }}" />
<meta property="og:title" content="{{ _title }}" />
<meta property="og:description" content="{{ _desc }}" />
<meta property="og:image" content="{{ _img }}" />
<meta property="og:locale" content="es_AR" />
{% if _url %}<meta property="og:url" content="{{ _url }}" />{% endif %}

<!-- Twitter Card -->
<meta name="twitter:card" content="{{ _twc }}" />
<meta name="twitter:title" content="{{ _title }}" />
<meta name="twitter:description" content="{{ _desc }}" />
<meta name="twitter:image" content="{{ _img }}" />

<!-- General meta -->
<meta name="description" content="{{ _desc }}" />
<link rel="canonical" href="{{ _canonical }}" />
<meta name="theme-color" content="#050308" />
<meta name="color-scheme" content="dark" />
<meta name="format-detection" content="telephone=no" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="T.N.S.V.T" />
