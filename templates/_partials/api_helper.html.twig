{# _partials/api_helper.html.twig — Global API helper + error UI.

   Provides:
     • window.apiFetch(url, opts)        → fetch wrapper w/ 30s timeout, 401→redirect, 500→banner, AbortError→timeout
     • window.apiToast(msg, kind)        → top-right toast (success|error|info|warning)
     • window.apiSetupModal(el)          → focus-trap helper for modals
     • window.apiConfirm(msg, opts)      → async styled confirm dialog (Promise<boolean>)
     • <div id="api-error-banner">       → inline error banner mounted by apiFetch on 5xx

   Mount once via:  {% include '_partials/api_helper.html.twig' %}

   Each page may call: apiFetch('/sanctum/api/tasks').then(d => …) — the helper handles errors gracefully.
#}

<div id="api-error-banner" class="hidden" role="alert" aria-live="assertive">
    <span class="material-symbols-elev api-banner-icon">error</span>
    <span id="api-error-banner-msg">Server error</span>
    <button type="button" onclick="const _el = document.getElementById('api-error-banner'); if (_el) _el.classList.add('hidden')" aria-label="Dismiss">
        <span class="material-symbols-elev icon-size-sm">close</span>
    </button>
</div>

<div id="api-toast-stack" aria-live="polite"></div>

<script>
(function () {
    'use strict';

    const DEFAULT_TIMEOUT_MS = 30000;
    const banner = () => document.getElementById('api-error-banner');
    const bannerMsg = () => document.getElementById('api-error-banner-msg');
    const toastStack = () => document.getElementById('api-toast-stack');

    function showBanner(message) {
        const el = banner();
        if (!el) return;
        const _elBannerMsg = bannerMsg();
        if (_elBannerMsg) _elBannerMsg.textContent = message;
        el.classList.remove('hidden');
    }

    function hideBanner() {
        const el = banner();
        if (el) el.classList.add('hidden');
    }

    /* ═══════════════════════════════════════════════════════════════
       TOAST QUEUE
       • Max 5 visible (older get rotated out)
       • Hover-pauses auto-dismiss
       • Auto-dismiss after 4s (error: 6s)
       • Same message = dedupe (don't spam identical toasts)
       ═══════════════════════════════════════════════════════════════ */
    const TOAST_MAX = 5;
    const TOAST_TTL = { info: 4000, success: 4000, warning: 5500, error: 6000 };
    const _activeToasts = new Map();

    function _toastExpire(node) {
        if (!_activeToasts.has(node)) return;
        clearTimeout(_activeToasts.get(node));
        node.style.opacity = '0';
        setTimeout(() => { if (node.parentNode) node.remove(); }, 200);
        _activeToasts.delete(node);
    }

    function _toastPause(node) {
        if (!_activeToasts.has(node)) return;
        clearTimeout(_activeToasts.get(node));
        node.dataset.paused = '1';
        const bar = node.querySelector('.api-toast-progress');
        if (bar) bar.style.animationPlayState = 'paused';
    }

    function _toastResume(node) {
        if (!_activeToasts.has(node)) return;
        if (node.dataset.paused !== '1') return;
        const kind = (node.className.match(/api-toast-(\w+)/) || [])[1] || 'info';
        const t = setTimeout(() => _toastExpire(node), TOAST_TTL[kind] || 4000);
        _activeToasts.set(node, t);
        node.dataset.paused = '0';
        const bar = node.querySelector('.api-toast-progress');
        if (bar) bar.style.animationPlayState = 'running';
    }

    function apiToast(message, kind) {
        kind = kind || 'info';
        // F18: per-kind channel filter. If the user disabled this
        // kind in their preferences, suppress the toast entirely.
        try {
            const prefs = JSON.parse(localStorage.getItem('tnsvt_toast_prefs') || '{}');
            if (prefs[kind] === false) return;
        } catch (e) {}
        const stack = toastStack();
        if (!stack) return;
        const dedupKey = kind + '|' + message;
        for (const n of _activeToasts.keys()) {
            if (n.dataset.dedup === dedupKey) return;
        }
        while (stack.children.length >= TOAST_MAX) {
            _toastExpire(stack.firstElementChild);
        }
        const node = document.createElement('div');
        node.className = 'api-toast api-toast-' + kind;
        node.dataset.dedup = dedupKey;
        node.setAttribute('role', kind === 'error' ? 'alert' : 'status');
        node.setAttribute('aria-live', kind === 'error' ? 'assertive' : 'polite');
        const icons = { success: 'check_circle', error: 'error', warning: 'warning', info: 'info' };
        const ttl = TOAST_TTL[kind] || 4000;
        node.innerHTML = '<span class="material-symbols-elev" aria-hidden="true"></span><span class="api-toast-msg"></span><button type="button" class="api-toast-close" aria-label="Descartar notificación"><span class="material-symbols-elev" aria-hidden="true">close</span></button><span class="api-toast-progress" aria-hidden="true"></span>';
        node.children[0].textContent = icons[kind] || 'info';
        node.children[1].textContent = message;
        const bar = node.querySelector('.api-toast-progress');
        if (bar) bar.style.animationDuration = ttl + 'ms';
        const closeBtn = node.querySelector('.api-toast-close');
        if (closeBtn) closeBtn.addEventListener('click', (e) => { e.stopPropagation(); _toastExpire(node); });
        node.addEventListener('mouseenter', () => _toastPause(node));
        node.addEventListener('mouseleave', () => _toastResume(node));
        node.addEventListener('click', () => _toastExpire(node));
        node.style.cursor = 'pointer';
        stack.appendChild(node);
        const t = setTimeout(() => _toastExpire(node), ttl);
        _activeToasts.set(node, t);
    }

    /**
     * Robust fetch wrapper.
     * @param {string} url
     * @param {object} [opts]
     * @param {number} [opts.timeoutMs=30000]
     * @param {boolean} [opts.silent=false]
     * @param {boolean} [opts.redirectOn401=true]
     * @returns {Promise<{ok:boolean, status:number, data:any}>}
     */
    async function apiFetch(url, opts) {
        opts = opts || {};
        const timeoutMs = opts.timeoutMs || DEFAULT_TIMEOUT_MS;
        const silent = !!opts.silent;
        const redirectOn401 = opts.redirectOn401 !== false;

        // Auto-attach X-Game-Code header for any URL that needs the user-code auth.
        // Centralises what used to be a per-controller chore (chat_controller
        // et al. used to attach it manually, often forgetting it for new
        // endpoints — every backend controller reads it from the
        // `X-Game-Code` request header).
        if (!opts.headers || !('X-Game-Code' in opts.headers)) {
            const code = (window.TNSVT_USER && window.TNSVT_USER.code) || '';
            if (code) {
                opts.headers = Object.assign({}, opts.headers || {}, { 'X-Game-Code': code });
            }
        }

        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeoutMs);

        try {
            const res = await fetch(url, Object.assign({}, opts, { signal: controller.signal }));
            clearTimeout(timer);

            const status = res.status;
            let data = null;
            const ct = res.headers.get('content-type') || '';
            if (ct.indexOf('application/json') !== -1) {
                try { data = await res.json(); } catch (_) { data = null; }
            } else {
                try { data = await res.text(); } catch (_) { data = null; }
            }

            if (status === 401 && redirectOn401) {
                hideBanner();
                window.location.href = '/';
                return { ok: false, status: 401, data: null };
            }

            if (status >= 500) {
                const msg = (data && (data.error || data.message)) || ('Server error ' + status);
                if (!silent) showBanner('⚠ ' + msg);
                return { ok: false, status: status, data: data };
            }

            return { ok: status >= 200 && status < 300, status: status, data: data };
        } catch (err) {
            clearTimeout(timer);
            if (err && err.name === 'AbortError') {
                if (!silent) showBanner('⏱ Request timeout — el servidor no respondió en ' + Math.round(timeoutMs / 1000) + 's');
                return { ok: false, status: 0, data: null, timeout: true };
            }
            if (!silent) showBanner('🌐 Sin conexión con el servidor');
            return { ok: false, status: 0, data: null, networkError: true };
        }
    }

    window.apiFetch = apiFetch;
    window.apiToast = apiToast;
    window.apiHideBanner = hideBanner;

    /* ═══════════════════════════════════════════════════════════════
       BUTTON LOADING (Fase C — opt-in)
       Use: const done = apiButtonLoading(btn); try { await save(); } finally { done(); }
       Adds .is-loading + aria-busy, disables the button to prevent
       double-submit, restores previous state on done().
       ─────────────────────────────────────────────────────────────── */
    function apiButtonLoading(btn) {
        if (!btn) return function () {};
        const prevDisabled = btn.disabled;
        const prevBusy = btn.getAttribute('aria-busy');
        btn.classList.add('is-loading');
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;
        return function done() {
            btn.classList.remove('is-loading');
            if (prevBusy === null) btn.removeAttribute('aria-busy');
            else btn.setAttribute('aria-busy', prevBusy);
            btn.disabled = prevDisabled;
        };
    }
    window.apiButtonLoading = apiButtonLoading;

    /* ═══════════════════════════════════════════════════════════════
       VISIBILITY-AWARE POLLER
       Use: const id = apiPoller(fn, 60000);  // fn runs only while visible
       Returns the interval id (compatible with clearInterval).
       ─────────────────────────────────────────────────────────────── */
    const _apiPollers = new Set();
    function apiPoller(fn, ms) {
        let id = null;
        let lastRun = 0;
        let pending = null;
        const tick = () => {
            lastRun = Date.now();
            pending = null;
            try { fn(); } catch (e) { console.error('[apiPoller]', e); }
        };
        const start = () => {
            if (id) return;
            id = setInterval(tick, ms);
            // H12: stagger the immediate first tick by 0–800ms so the
            // ~8 page pollers don't thundering-herd the API on load.
            pending = setTimeout(tick, Math.floor(Math.random() * 800));
        };
        const stop = () => {
            if (!id) return;
            clearInterval(id);
            id = null;
            if (pending) { clearTimeout(pending); pending = null; }
        };
        const onVis = () => { document.hidden ? stop() : start(); };
        document.addEventListener('visibilitychange', onVis);
        if (!document.hidden) start();
        _apiPollers.add({ start, stop, onVis });
        // Return a token that clears the poller if used as an id.
        return { stop: () => { stop(); document.removeEventListener('visibilitychange', onVis); _apiPollers.delete(id); } };
    }
    // Backwards-compatible shim: if a caller passes the return value to
    // clearInterval(), wrap it. Most call sites will use the .stop() method.
    window.apiPoller = apiPoller;

    /* ═══════════════════════════════════════════════════════════════
       FORM REQUIRED MARKERS
       On load: any [required] input gets aria-required="true" and the
       matching <label for=id> gets the .required class (which renders
       a red asterisk via CSS). Idempotent.
       ─────────────────────────────────────────────────────────────── */
    function apiMarkRequired() {
        document.querySelectorAll('input[required], select[required], textarea[required]').forEach(function (el) {
            el.setAttribute('aria-required', 'true');
            const id = el.id;
            if (!id) return;
            const labels = document.querySelectorAll('label[for="' + id + '"]');
            labels.forEach(function (l) { l.classList.add('required'); });
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', apiMarkRequired);
    } else {
        apiMarkRequired();
    }
    window.apiMarkRequired = apiMarkRequired;

    /* ═══════════════════════════════════════════════════════════════
       CTRL+ENTER SUBMIT
       Global keydown: any textarea inside a form with data-ctrl-enter
       (default true) submits the closest form on Ctrl/Cmd+Enter, unless
       the textarea is marked with data-ctrl-enter="off". Adds a tiny
       hint badge to focused textareas.
       ─────────────────────────────────────────────────────────────── */
    document.addEventListener('keydown', function (e) {
        const ta = e.target;
        if (!ta || ta.tagName !== 'TEXTAREA') return;
        if (!(e.key === 'Enter' && (e.ctrlKey || e.metaKey))) return;
        if (ta.dataset.ctrlEnter === 'off') return;
        const form = ta.closest('form');
        if (!form) return;
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"], input[type="submit"]')
            || form.querySelector('button:not([type])');
        if (submitBtn && !submitBtn.disabled) {
            submitBtn.click();
        } else if (form.requestSubmit) {
            form.requestSubmit();
        } else {
            form.submit();
        }
    });

    /* ═══════════════════════════════════════════════════════════════
       INLINE FORM VALIDATION (F19)
       Auto-attaches to any form with [data-api-validate]. Each
       required/pattern field gets:
         - aria-invalid="true" on failure
         - field-error tooltip with arrow above the field
         - success check on valid (user-valid state)
       Re-validates on blur (first time) and on input thereafter.
       Falls back to native :invalid pseudo-class when the tooltip
       helper isn't available.
       ─────────────────────────────────────────────────────────────── */
    function _ensureTooltip(errEl, anchor) {
        if (!errEl) {
            errEl = document.createElement('div');
            errEl.className = 'field-error';
            errEl.setAttribute('role', 'alert');
            errEl.hidden = true;
            anchor.parentNode.insertBefore(errEl, anchor.nextSibling);
        }
        return errEl;
    }
    function _showFieldError(input, msg) {
        const errEl = _ensureTooltip(null, input);
        errEl.textContent = msg;
        errEl.hidden = false;
        input.setAttribute('aria-invalid', 'true');
        input.classList.add('is-invalid');
    }
    function _clearFieldError(input) {
        const errEl = input.parentNode.querySelector('.field-error');
        if (errEl) { errEl.hidden = true; errEl.textContent = ''; }
        input.removeAttribute('aria-invalid');
        input.classList.remove('is-invalid');
        input.classList.add('is-valid');
    }
    function apiValidateField(input) {
        // Re-uses the native constraint validation API. Custom rules
        // can be added via data-rule="rule-name" and the registered
        // map below.
        const rules = {
            positive: function (v) { return Number(v) > 0 ? '' : 'Debe ser positivo'; },
            rr:       function (v) { return Number(v) >= 1 ? '' : 'Risk:Reward ≥ 1 recomendado'; },
            future:   function (v) { return new Date(v) > new Date() ? '' : 'Debe ser futuro'; },
        };
        const v = (input.value || '').trim();
        if (input.required && !v) {
            _showFieldError(input, 'Este campo es obligatorio');
            return false;
        }
        if (input.pattern && v && !new RegExp(input.pattern).test(v)) {
            _showFieldError(input, input.title || 'Formato inválido');
            return false;
        }
        if (input.type === 'email' && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
            _showFieldError(input, 'Email inválido');
            return false;
        }
        if (input.dataset.rule && rules[input.dataset.rule]) {
            const msg = rules[input.dataset.rule](v);
            if (msg) { _showFieldError(input, msg); return false; }
        }
        _clearFieldError(input);
        return true;
    }
    function apiValidateForm(form) {
        const fields = form.querySelectorAll('input, select, textarea');
        let ok = true;
        fields.forEach(function (el) {
            if (!apiValidateField(el)) ok = false;
        });
        return ok;
    }
    function apiAttachValidation(form) {
        if (!form || form.__apiValidate) return;
        form.__apiValidate = true;
        const fields = form.querySelectorAll('input, select, textarea');
        fields.forEach(function (input) {
            if (input.type === 'hidden' || input.type === 'submit') return;
            // Validate on blur the first time, then on every input.
            let touched = false;
            input.addEventListener('blur', function () {
                touched = true;
                apiValidateField(input);
            });
            input.addEventListener('input', function () {
                if (!touched) return;
                apiValidateField(input);
            });
        });
        // Block submission when invalid.
        form.addEventListener('submit', function (e) {
            if (!apiValidateForm(form)) {
                e.preventDefault();
                e.stopPropagation();
                const firstBad = form.querySelector('.is-invalid');
                if (firstBad) firstBad.focus();
            }
        }, true);
    }
    function apiAutoAttach() {
        document.querySelectorAll('form[data-api-validate]').forEach(apiAttachValidation);
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', apiAutoAttach);
    } else {
        apiAutoAttach();
    }
    window.apiValidateForm = apiValidateForm;
    window.apiAttachValidation = apiAttachValidation;
    window.apiValidateField = apiValidateField;

    /* ═══════════════════════════════════════════════════════════════
       KPI COUNTER ANIMATION (P2)
       Animate any element with [data-counter] from 0 to the value
       parsed from its initial textContent. Honour
       prefers-reduced-motion (skip animation).
       ─────────────────────────────────────────────────────────────── */
    function apiAnimateCounter(el, opts) {
        opts = opts || {};
        const text = el.textContent.trim();
        // Parse: "$1,234", "12%", "1,234.56", "-42", "—", "∞"
        const m = text.match(/^(-?)\s*([\$]?)([\d,\.]+)([%a-z]*)$/i);
        if (!m) return false;
        const sign = m[1] === '-' ? -1 : 1;
        const prefix = m[2] || '';
        const suffix = m[4] || '';
        const target = parseFloat(m[3].replace(/,/g, '')) * sign;
        if (!isFinite(target)) return false;
        const duration = opts.duration || 900;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) return false;
        const decimals = (m[3].split('.')[1] || '').length;
        const fmt = new Intl.NumberFormat('es-AR', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
        });
        const start = performance.now();
        function step(now) {
                const t = Math.min(1, (now - start) / duration);
                const eased = 1 - Math.pow(1 - t, 3);  // easeOutCubic
                el.textContent = prefix + fmt.format(target * eased) + suffix;
                if (t < 1) requestAnimationFrame(step);
            }
        requestAnimationFrame(step);
        return true;
    }
    function apiAnimateCounters(selector) {
        const els = document.querySelectorAll(selector || '[data-counter]');
        els.forEach(function (el) { apiAnimateCounter(el); });
    }
    window.apiAnimateCounter = apiAnimateCounter;
    window.apiAnimateCounters = apiAnimateCounters;

    /* ═══════════════════════════════════════════════════════════════
       GLOBAL ERROR HANDLER (T3)
       Catches unhandled errors and unhandled promise rejections,
       surfaces them as a non-blocking toast, and logs to console.
       Opt-out per-zone via window.__apiQuiet = true.
       ─────────────────────────────────────────────────────────────── */
    function _reportError(kind, message, source) {
        if (window.__apiQuiet) {
            console[kind === 'error' ? 'error' : 'warn'](message, source || '');
            return;
        }
        // Avoid duplicate toasts for the same error string within 1.5s.
        const k = kind + ':' + message;
        if (_reportError._last === k && Date.now() - _reportError._t < 1500) return;
        _reportError._last = k; _reportError._t = Date.now();
        const toastKind = kind === 'error' ? 'error' : 'warning';
        if (window.apiToast) {
            window.apiToast('Error inesperado: ' + (message || kind), toastKind);
        }
        console[kind === 'error' ? 'error' : 'warn'](message, source || '');
    }
    window.addEventListener('error', function (e) {
        _reportError('error', (e.error && e.error.message) || e.message, e.filename + ':' + e.lineno);
    });
    window.addEventListener('unhandledrejection', function (e) {
        const reason = e.reason && (e.reason.message || e.reason) || 'Promise rechazada';
        _reportError('error', String(reason), 'unhandledrejection');
    });

    /* ═══════════════════════════════════════════════════════════════
       HAPTIC FEEDBACK (P3) — opt-in via window.apiHaptic(kind)
       Mobile only (navigator.vibrate). Falls back silently on
       desktop. Kinds: 'success' / 'warning' / 'error'.
       ─────────────────────────────────────────────────────────────── */
    function apiHaptic(kind) {
        try {
            if (!navigator.vibrate) return false;
            const patterns = { success: [10], warning: [30, 30, 30], error: [60, 40, 60] };
            navigator.vibrate(patterns[kind] || [20]);
            return true;
        } catch (e) { return false; }
    }
    window.apiHaptic = apiHaptic;
    // Auto-haptic on toast (only success / error / warning kinds).
    // Skip info (too noisy).
    (function () {
        // Patch apiToast to also vibrate on haptic-capable devices.
        const orig = window.apiToast;
        if (typeof orig !== 'function') return;
        window.apiToast = function (msg, kind) {
            orig(msg, kind);
            if (kind === 'success' || kind === 'error' || kind === 'warning') {
                apiHaptic(kind);
            }
        };
    })();

    /* ═══════════════════════════════════════════════════════════════
       SCREEN-READER LOADING ANNOUNCER (T5)
       For every .loading-pulse element without role/aria-live set,
       inject role="status" + aria-live="polite" so SR users hear
       "Cargando…" / "Sin datos" / etc. as content changes.
       ─────────────────────────────────────────────────────────────── */
    function apiA11yLoading() {
        document.querySelectorAll('.loading-pulse:not([role]):not([aria-live])').forEach(function (el) {
            el.setAttribute('role', 'status');
            el.setAttribute('aria-live', 'polite');
        });
    }
    // Re-scan when DOM mutates (new loading-pulse elements added).
    if (window.MutationObserver) {
        new MutationObserver(apiA11yLoading).observe(document.body, {
            childList: true,
            subtree: true,
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', apiA11yLoading);
    } else {
        apiA11yLoading();
    }
    window.apiA11yLoading = apiA11yLoading;

    /* ═══════════════════════════════════════════════════════════════
       UNDO TOAST (H14)
       apiUndoToast({ message, undoLabel='Deshacer', ttl=5000, undo, onExpire })
       Renders a success toast with a clickable "Deshacer" button that
       calls undo() when clicked within ttl ms. Visual countdown bar
       shrinks over time. undo() can return a Promise (e.g., to POST
       a restore request); the toast stays until the Promise settles.
       ─────────────────────────────────────────────────────────────── */
    function apiUndoToast(opts) {
        if (!opts || typeof opts.undo !== 'function') {
            return typeof apiToast === 'function' ? apiToast(opts.message, 'info') : null;
        }
        const ttl = opts.ttl || 5000;
        const undoLabel = opts.undoLabel || 'Deshacer';
        const msg = opts.message || 'Acción completada';
        const kind = opts.kind || 'success';

        // Custom DOM: toast with undo button + countdown bar.
        const root = document.createElement('div');
        root.className = 'api-toast api-toast-' + kind + ' api-undo-toast';
        root.setAttribute('role', 'status');
        root.setAttribute('aria-live', 'polite');
        root.innerHTML = `
            <span class="api-toast-message"></span>
            <button type="button" class="api-undo-btn"></button>
            <div class="api-undo-progress"><div class="api-undo-progress-bar"></div></div>`;
        root.querySelector('.api-toast-message').textContent = msg;
        const btn = root.querySelector('.api-undo-btn');
        btn.textContent = undoLabel;
        const bar = root.querySelector('.api-undo-progress-bar');
        const container = document.getElementById('api-toast-container') || document.body;
        container.appendChild(root);
        // Animate entrance.
        requestAnimationFrame(() => root.classList.add('is-visible'));

        let done = false;
        let timer = null;
        const close = () => {
            if (done) return;
            done = true;
            clearTimeout(timer);
            root.classList.remove('is-visible');
            setTimeout(() => root.remove(), 220);
        };
        const finish = (promise) => {
            if (promise && typeof promise.then === 'function') {
                btn.disabled = true;
                bar.style.animationPlayState = 'paused';
                promise.then(function () {
                    if (typeof apiToast === 'function') {
                        apiToast('Restaurado', 'success');
                    }
                }).catch(function (e) {
                    if (typeof apiToast === 'function') {
                        apiToast('No se pudo restaurar: ' + (e.message || 'error'), 'error');
                    }
                }).finally(close);
            } else {
                close();
            }
        };
        btn.addEventListener('click', () => {
            try {
                finish(opts.undo());
            } catch (e) {
                close();
                if (typeof apiToast === 'function') {
                    apiToast('No se pudo restaurar: ' + (e.message || 'error'), 'error');
                }
            }
        });
        timer = setTimeout(() => {
            if (!done && typeof opts.onExpire === 'function') {
                try { opts.onExpire(); } catch (e) {}
            }
            close();
        }, ttl);
        // Set CSS animation duration so the progress bar matches ttl.
        bar.style.animationDuration = ttl + 'ms';
        return { dismiss: close };
    }
    window.apiUndoToast = apiUndoToast;

    /* ═══════════════════════════════════════════════════════════════
       FOCUS TRAP + MODAL A11Y
       Use: apiSetupModal(modalEl, { open: () => {}, close: () => {} })
       ─────────────────────────────────────────────────────────────── */
    function apiSetupModal(modalEl, opts) {
        opts = opts || {};
        if (!modalEl) return null;
        if (!modalEl.hasAttribute('role')) modalEl.setAttribute('role', 'dialog');
        if (!modalEl.hasAttribute('aria-modal')) modalEl.setAttribute('aria-modal', 'true');

        const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
        let prevFocus = null;
        let escHandler = null;
        let trapHandler = null;

        function focusables() {
            return Array.from(modalEl.querySelectorAll(FOCUSABLE)).filter(el => el.offsetParent !== null);
        }

        let backdropHandler = null;
        let closingTimer = null;
        const REDUCED_MOTION = typeof window.matchMedia === 'function' &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function doHide() {
            modalEl.style.display = 'none';
            modalEl.setAttribute('hidden', '');
            document.body.style.overflow = '';
            if (trapHandler) modalEl.removeEventListener('keydown', trapHandler);
            escHandler = null;
            trapHandler = null;
            if (backdropHandler) {
                modalEl.removeEventListener('click', backdropHandler);
                backdropHandler = null;
            }
            (opts.close || function () {})();
            if (prevFocus && typeof prevFocus.focus === 'function') {
                prevFocus.focus();
            }
        }

        function onKeydown(e) {
            if (e.key === 'Escape') {
                e.stopPropagation();
                closeAnimated();
                return;
            }
            if (e.key !== 'Tab') return;
            const items = focusables();
            if (items.length === 0) {
                e.preventDefault();
                return;
            }
            const first = items[0];
            const last = items[items.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        }

        function closeAnimated() {
            if (modalEl.classList.contains('is-closing')) return;
            if (closingTimer) { clearTimeout(closingTimer); closingTimer = null; }
            if (REDUCED_MOTION) { doHide(); return; }
            modalEl.classList.add('is-closing');
            closingTimer = setTimeout(() => {
                closingTimer = null;
                modalEl.classList.remove('is-closing');
                doHide();
            }, 180);
        }

        return {
            open() {
                if (closingTimer) { clearTimeout(closingTimer); closingTimer = null; }
                modalEl.classList.remove('is-closing');
                prevFocus = document.activeElement;
                document.body.style.overflow = 'hidden';
                modalEl.removeAttribute('hidden');
                modalEl.style.display = modalEl.dataset.modalDisplay || 'flex';
                (opts.open || function () {})();
                const items = focusables();
                if (items.length > 0) items[0].focus();
                else modalEl.focus();
                escHandler = onKeydown;
                trapHandler = onKeydown;
                modalEl.addEventListener('keydown', trapHandler);
                if (opts.dismissBackdrop !== false && !backdropHandler) {
                    backdropHandler = (e) => {
                        if (e.target === modalEl) closeAnimated();
                    };
                    modalEl.addEventListener('click', backdropHandler);
                }
            },
            close() {
                closeAnimated();
            },
            isOpen() {
                return modalEl.style.display !== 'none' && !modalEl.hasAttribute('hidden');
            },
        };
    }

    function apiOpenModal(modalEl, opts) {
        const m = apiSetupModal(modalEl, opts);
        if (m) m.open();
        return m;
    }

    function apiCloseModal(modalEl) {
        if (!modalEl) return;
        const reduced = typeof window.matchMedia === 'function' &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || modalEl.classList.contains('is-closing')) {
            modalEl.classList.remove('is-closing');
            modalEl.style.display = 'none';
            modalEl.setAttribute('hidden', '');
            document.body.style.overflow = '';
            return;
        }
        modalEl.classList.add('is-closing');
        setTimeout(() => {
            modalEl.classList.remove('is-closing');
            modalEl.style.display = 'none';
            modalEl.setAttribute('hidden', '');
            document.body.style.overflow = '';
        }, 180);
    }

    window.apiSetupModal = apiSetupModal;
    window.apiOpenModal = apiOpenModal;
    window.apiCloseModal = apiCloseModal;

    /* ═══════════════════════════════════════════════════════════════
       apiConfirm — styled async confirm dialog (Phase 6.8b)
       Returns Promise<boolean>. Replaces native confirm() which
       blocks the main thread and is not styleable.
       ─────────────────────────────────────────────────────────────── */
    let _confirmDialog = null;
    function _ensureConfirmDialog() {
        if (_confirmDialog) return _confirmDialog;
        const dlg = document.createElement('div');
        dlg.id = 'api-confirm-dialog';
        dlg.setAttribute('role', 'dialog');
        dlg.setAttribute('aria-modal', 'true');
        dlg.className = 'api-confirm-overlay';
        dlg.hidden = true;
        dlg.innerHTML = '' +
            '<div class="api-confirm-card">' +
                '<h2 class="api-confirm-title" id="api-confirm-title"></h2>' +
                '<p class="api-confirm-message" id="api-confirm-message"></p>' +
                '<div class="api-confirm-actions">' +
                    '<button type="button" class="api-confirm-btn api-confirm-cancel" data-confirm="cancel">' +
                        '<span class="material-symbols-elev" aria-hidden="true">close</span>' +
                        '<span class="api-confirm-cancel-label">Cancelar</span>' +
                    '</button>' +
                    '<button type="button" class="api-confirm-btn api-confirm-ok" data-confirm="ok">' +
                        '<span class="material-symbols-elev" aria-hidden="true">check</span>' +
                        '<span class="api-confirm-ok-label">Confirmar</span>' +
                    '</button>' +
                '</div>' +
            '</div>';
        document.body.appendChild(dlg);
        _confirmDialog = dlg;
        return dlg;
    }

    function apiConfirm(message, opts) {
        opts = opts || {};
        const title = opts.title || 'Confirmar acción';
        const confirmLabel = opts.confirmLabel || 'Confirmar';
        const cancelLabel = opts.cancelLabel || 'Cancelar';
        const variant = opts.variant || 'default';

        return new Promise((resolve) => {
            const dlg = _ensureConfirmDialog();
            const card = dlg.querySelector('.api-confirm-card');
            const titleEl = dlg.querySelector('.api-confirm-title');
            const msgEl = dlg.querySelector('.api-confirm-message');
            const okBtn = dlg.querySelector('[data-confirm="ok"]');
            const cancelBtn = dlg.querySelector('[data-confirm="cancel"]');
            const okLabel = dlg.querySelector('.api-confirm-ok-label');
            const cancelLabelEl = dlg.querySelector('.api-confirm-cancel-label');

            titleEl.textContent = title;
            msgEl.textContent = message;
            okLabel.textContent = confirmLabel;
            cancelLabelEl.textContent = cancelLabel;
            dlg.classList.toggle('api-confirm-danger', variant === 'danger');

            dlg.hidden = false;
            document.body.style.overflow = 'hidden';
            const prevFocus = document.activeElement;
            setTimeout(() => cancelBtn.focus(), 30);

            const onKey = (e) => {
                if (e.key === 'Escape') {
                    e.preventDefault();
                    cleanup(false);
                } else if (e.key === 'Enter' && document.activeElement !== cancelBtn) {
                    e.preventDefault();
                    cleanup(true);
                }
            };
            document.addEventListener('keydown', onKey);

            const onTabKey = (e) => {
                if (e.key !== 'Tab') return;
                e.preventDefault();
                (e.shiftKey ? cancelBtn : okBtn).focus();
            };
            card.addEventListener('keydown', onTabKey);

            function cleanup(result) {
                document.removeEventListener('keydown', onKey);
                card.removeEventListener('keydown', onTabKey);
                dlg.hidden = true;
                document.body.style.overflow = '';
                if (prevFocus && typeof prevFocus.focus === 'function') {
                    prevFocus.focus();
                }
                resolve(result);
            }

            okBtn.onclick = () => cleanup(true);
            cancelBtn.onclick = () => cleanup(false);
            dlg.onclick = (e) => { if (e.target === dlg) cleanup(false); };
        });
    }

    window.apiConfirm = apiConfirm;

    /* ═══════════════════════════════════════════════════════════════
       apiEmpty — render empty state into a container
       Usage: apiEmpty('#feed-list', { icon: 'forum', message: 'Sin publicaciones', size: 'lg' })
       Same structure as _partials/empty_state.html.twig.
       ═══════════════════════════════════════════════════════════════ */
    function apiEmpty(target, opts) {
        opts = opts || {};
        const el = typeof target === 'string' ? document.querySelector(target) : target;
        if (!el) return;
        const icon = opts.icon || 'inbox';
        const message = opts.message || 'Sin datos';
        const description = opts.description || '';
        const ctaUrl = opts.cta_url || '';
        const ctaLabel = opts.cta_label || '';
        const size = opts.size || 'md';

        const descHtml = description ? '<p class="empty-state-description">' + description + '</p>' : '';
        const ctaHtml = (ctaUrl && ctaLabel)
            ? '<a href="' + ctaUrl + '" class="empty-state-cta">' + ctaLabel + ' <span class="material-symbols-elev" aria-hidden="true">arrow_forward</span></a>'
            : '';

        el.innerHTML = '' +
            '<div class="empty-state empty-state-' + size + '" role="status">' +
                '<span class="material-symbols-elev empty-state-icon" aria-hidden="true">' + icon + '</span>' +
                '<p class="empty-state-message">' + message + '</p>' +
                descHtml +
                ctaHtml +
            '</div>';
    }

    window.apiEmpty = apiEmpty;
})();
</script>
