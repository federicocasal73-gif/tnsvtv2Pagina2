{# _partials/api_helper.html.twig — Global API helper DOM mount.

   The actual helper functions (window.apiFetch, window.apiToast, …) now live
   in src/assets/js/api-helper.js (ES module, loaded once via the asset-mapper
   importmap from app.js). This partial renders the DOM elements the helper
   needs (error banner, toast stack) and is included from shell.html.twig and
   public/shell.html.twig. Do not call window.apiFetch in inline <script>
   blocks without `typeof apiFetch === 'function'` guard — the module loads
   asynchronously, so it is not guaranteed to be defined during HTML parse.
#}

<div id="api-error-banner" class="hidden" role="alert" aria-live="assertive">
    <span class="material-symbols-elev api-banner-icon">error</span>
    <span id="api-error-banner-msg">Server error</span>
    <button type="button" onclick="const _el = document.getElementById('api-error-banner'); if (_el) _el.classList.add('hidden')" aria-label="Dismiss">
        <span class="material-symbols-elev icon-size-sm">close</span>
    </button>
</div>

<div id="api-toast-stack" aria-live="polite"></div>

