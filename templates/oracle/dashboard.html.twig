{% extends 'shell.html.twig' %}

{% block title %}Oráculo de Métricas · T.N.S.V.T{% endblock %}

{% block topbar_title %}Oráculo de Métricas{% endblock %}
{% block topbar_subtitle %}Emotional Bias · Faith vs Logic · Session Performance{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
{# WebGL Background #}
<script src="{{ asset('js/modules/webgl-background.js') }}" defer></script>

<div class="max-w-7xl mx-auto"
     data-controller="oracle">
    {# Header with glow #}
    <div class="text-center mb-8">
        {# L42: sacred sigil mark (CSS-only, mirrors profile identity) #}
        <div class="oracle-sigil" aria-hidden="true">
            <div class="sigil-pulse"></div>
            <div class="sigil-core"></div>
        </div>
        <p class="font-label-sm text-label-sm text-primary uppercase tracking-[0.3em] mb-2">Análisis Neuro-Espiritual</p>
        <h2 class="font-headline-xl text-headline-xl shimmer-text">Oráculo de Métricas</h2>
        <p class="text-on-surface-variant opacity-70 mt-2">El cruce perfecto entre el dogma logístico y la intuición cuántica</p>
    </div>

    {# User selector + range controls #}
    <div class="oracle-card mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <div>
                <label class="oracle-label block mb-1">Usuario</label>
                <input id="user-code"
                       data-oracle-target="userCode"
                       type="text"
                       value="{{ app.user ? app.user.code : '' }}"
                       placeholder="Tu código"
                       data-action="keypress->oracle#submitOnEnter"
                       class="w-full px-3 py-2 rounded bg-[rgba(255,255,255,0.03)] border border-[rgba(255,255,255,0.1)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
            </div>
            <div>
                <label class="oracle-label block mb-1">Rango (días)</label>
                <select id="days-select"
                        data-oracle-target="daysSelect"
                        data-action="change->oracle#selectDays"
                        class="w-full px-3 py-2 rounded bg-[rgba(255,255,255,0.03)] border border-[rgba(255,255,255,0.1)] text-[var(--on-surface-elev)] text-sm">
                    <option value="7">7 días</option>
                    <option value="30" selected>30 días</option>
                    <option value="90">90 días</option>
                    <option value="365">1 año</option>
                </select>
            </div>
            <div class="flex items-end">
                {# L41: keyboard hint — Enter in the user field also refreshes #}
                <button id="refresh-btn"
                        data-oracle-target="refreshBtn"
                        data-action="click->oracle#refresh"
                        class="ui-btn ui-btn primary w-full"
                        title="Actualizar (o Enter en el campo Usuario)">
                    <span class="material-symbols-elev align-middle icon-size-xs">refresh</span>
                    Actualizar
                </button>
            </div>
            <div class="flex items-end text-xs text-[var(--outline-elev)]">
                <span data-oracle-target="loadingStatus"
                      id="loading-status">Cargando...</span>
            </div>
        </div>
    </div>

    {# Divine Insights Row #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="oracle-card text-center">
            <span class="material-symbols-outlined text-3xl text-primary">auto_awesome</span>
            <h4 class="font-label-md text-primary uppercase tracking-widest mt-2">Divine Insight</h4>
            <p class="text-sm text-on-surface-variant mt-2">Tu ratio de 'Fe' ha superado la 'Lógica' en el NY Session.</p>
            <div class="sacred-progress w-full mt-3">
                <div class="sacred-progress-fill" style="width: 75%"></div>
                <div class="sacred-progress-head" style="left: 75%"></div>
            </div>
        </div>
        <div class="oracle-card text-center">
            <span class="material-symbols-outlined text-3xl text-secondary">graphic_eq</span>
            <h4 class="font-label-md text-secondary uppercase tracking-widest mt-2">Frecuencia Vibratoria</h4>
            <p class="text-sm text-on-surface-variant mt-2">Estado de flujo detectado: 88.4Hz</p>
            <div class="flex items-end justify-center gap-1 h-12 mt-3">
                <div class="w-2 bg-secondary/30 h-1/2"></div>
                <div class="w-2 bg-secondary/50 h-3/4"></div>
                <div class="w-2 bg-secondary h-full"></div>
                <div class="w-2 bg-secondary/80 h-2/3"></div>
                <div class="w-2 bg-secondary/40 h-1/3"></div>
            </div>
        </div>
        <div class="oracle-card text-center" style="background: linear-gradient(135deg, rgba(45,27,78,0.3), transparent);">
            <span class="material-symbols-outlined text-3xl text-primary">route</span>
            <h4 class="font-label-md text-primary uppercase tracking-widest mt-2">Path Projection</h4>
            <p class="text-sm text-on-surface-variant mt-2">Grado Adepto. Próximo hito en 12 operaciones.</p>
            {# L43: Ver Mapa scrolls to the metrics map below #}
            <button type="button"
                    data-oracle-target="verMapaBtn"
                    id="ver-mapa-btn"
                    data-action="click->oracle#scrollToMapa"
                    class="mt-3 px-4 py-2 border border-primary text-primary rounded-full text-xs uppercase tracking-widest hover:bg-primary hover:text-void-black transition-all">Ver Mapa</button>
        </div>
    </div>

    {# Faith vs Logic Gauge + Emotional Bias Map #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        <div class="oracle-card">
            <h3 class="font-title-md text-primary tracking-widest flex items-center gap-2">
                <span class="material-symbols-outlined">balance</span> EQUILIBRIUM
            </h3>
            <p class="oracle-label mb-4">Faith vs Logic Gauge</p>
            <div class="flex justify-center my-6 gauge-container">
                <svg id="gauge-svg"
                     data-oracle-target="gaugeSvg"
                     width="220" height="220" viewBox="0 0 220 220"></svg>
            </div>
            <div class="text-center">
                <p class="oracle-value"
                   data-oracle-target="logicPercent"
                   id="logic-percent">--</p>
                <p class="oracle-label">Logic Weighted</p>
                <p class="text-xs text-[var(--outline-elev)] mt-2"
                   data-oracle-target="gaugeMeta"
                   id="gauge-meta">--</p>
            </div>
        </div>

        <div class="oracle-card lg:col-span-2">
            <h3 class="font-title-md text-primary tracking-widest flex items-center gap-2">
                <span class="material-symbols-outlined">grid_on</span> EMOTIONAL BIAS MAP
            </h3>
            <p class="oracle-label mb-4">Correlación entre estado emocional y rentabilidad</p>
            <div class="relative" style="height: 280px;">
                <svg id="bias-svg"
                     data-oracle-target="biasSvg"
                     width="100%" height="100%" viewBox="0 0 600 280" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
            <div class="flex justify-center gap-6 mt-4">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-error"></span>
                    <span class="text-xs text-on-surface-variant">Caos</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-primary"></span>
                    <span class="text-xs text-on-surface-variant">Zen</span>
                </div>
            </div>
            <p data-oracle-target="biasMeta"
               id="bias-meta"
               class="text-center text-xs text-on-surface-variant mt-2"></p>
        </div>
    </div>

    {# Session Performance #}
    <div class="oracle-card">
        <h3 class="font-title-md text-primary tracking-widest flex items-center gap-2">
            <span class="material-symbols-outlined">schedule</span> SESSION PERFORMANCE
        </h3>
        <p class="oracle-label mb-4">Rendimiento por sesión de trading</p>
        <div class="relative" style="height: 240px;">
            <svg id="perf-svg"
                 data-oracle-target="perfSvg"
                 width="100%" height="100%" viewBox="0 0 800 240" preserveAspectRatio="xMidYMid meet"></svg>
        </div>
    </div>
</div>
{% endblock %}
