{% extends 'shell.html.twig' %}

{% block title %}Oráculo de Métricas · T.N.S.V.T{% endblock %}

{% block topbar_title %}Oráculo de Métricas{% endblock %}
{% block topbar_subtitle %}Emotional Bias · Faith vs Logic · Session Performance{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto">
        {# User selector + range controls #}
        <div class="glass-card-elev p-4 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-[var(--outline-elev)] mb-1">Usuario</label>
                    <input id="user-code" type="text" value="ADMIN01" class="w-full px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-[var(--outline-elev)] mb-1">Rango (días)</label>
                    <select id="days-select" class="w-full px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm">
                        <option value="7">7 días</option>
                        <option value="30" selected>30 días</option>
                        <option value="90">90 días</option>
                        <option value="365">1 año</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button id="refresh-btn" class="btn-elev-primary w-full">
                        <span class="material-symbols-elev align-middle text-sm">refresh</span>
                        Actualizar
                    </button>
                </div>
                <div class="flex items-end text-xs text-[var(--outline-elev)]">
                    <span id="loading-status">Cargando...</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            {# Faith vs Logic Gauge #}
            <div class="glass-card-elev p-6">
                <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Equilibrium</h3>
                <p class="text-xs text-[var(--outline-elev)] mb-2 uppercase tracking-wider">Faith vs Logic</p>
                <div class="flex justify-center my-6">
                    <svg id="gauge-svg" width="220" height="220" viewBox="0 0 220 220"></svg>
                </div>
                <div class="text-center">
                    <p class="text-4xl font-bold text-[var(--gold-elev)]" id="logic-percent">--</p>
                    <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Logic Weighted</p>
                    <p class="text-xs text-[var(--outline-elev)] mt-2" id="gauge-meta">--</p>
                </div>
            </div>

            {# Emotional Bias Map #}
            <div class="glass-card-elev p-6 lg:col-span-2">
                <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Emotional Bias Map</h3>
                <p class="text-xs text-[var(--outline-elev)] mb-2 uppercase tracking-wider">Mapa de Bias Emocional</p>
                <div class="relative" style="height: 280px;">
                    <svg id="bias-svg" width="100%" height="100%" viewBox="0 0 600 280" preserveAspectRatio="xMidYMid meet"></svg>
                </div>
                <p class="text-xs text-[var(--outline-elev)] mt-2 text-center" id="bias-meta">Sin datos</p>
            </div>
        </div>

        {# Session Performance #}
        <div class="glass-card-elev p-6">
            <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Session Performance</h3>
            <p class="text-xs text-[var(--outline-elev)] mb-4 uppercase tracking-wider">Histórico de performance</p>
            <div class="relative" style="height: 240px;">
                <svg id="perf-svg" width="100%" height="100%" viewBox="0 0 800 240" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
        </div>
    </div>

    <script>
    let faithLogicGauge = null;
    let biasMapChart = null;
    let perfChart = null;

    async function loadAll() {
        const userCode = document.getElementById('user-code').value.trim();
        const days = parseInt(document.getElementById('days-select').value);
        const status = document.getElementById('loading-status');
        status.textContent = 'Cargando...';

        try {
            const [gaugResp, biasResp, perfResp] = await Promise.all([
                fetch(`/sanctum/api/oracle/faith-logic?code=${encodeURIComponent(userCode)}&days=${days}`),
                fetch(`/sanctum/api/oracle/emotional-bias?code=${encodeURIComponent(userCode)}&days=${days}`),
                fetch(`/sanctum/api/oracle/session-performance?code=${encodeURIComponent(userCode)}&days=${days}`),
            ]);

            const gaugeData = (await gaugResp.json()).gauge;
            const biasData = (await biasResp.json());
            const perfData = (await perfResp.json());

            renderGauge(gaugeData);
            renderBiasMap(biasData);
            renderPerformance(perfData);

            status.textContent = 'Última actualización: ' + new Date().toLocaleTimeString();
        } catch (e) {
            console.error(e);
            status.textContent = 'Error: ' + e.message;
        }
    }

    function renderGauge(g) {
        const svg = document.getElementById('gauge-svg');
        const cx = 110, cy = 110, r = 90;
        // Background arc
        let html = '';
        html += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--glass-border-elev)" stroke-width="16" />`;
        // Logic arc (filled portion)
        const logicPct = g.logic || 0;
        const circ = 2 * Math.PI * r;
        // Use 270deg arc (3/4 circle) for gauge
        const arcLen = circ * 0.75;
        html += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--gold-elev)" stroke-width="16"
            stroke-dasharray="${(logicPct / 100) * arcLen} ${arcLen}"
            transform="rotate(135 ${cx} ${cy})" stroke-linecap="round" />`;
        // Center text
        html += `<text x="${cx}" y="${cy + 5}" text-anchor="middle" font-size="36" font-weight="bold" fill="var(--gold-elev)">${logicPct}</text>`;
        html += `<text x="${cx}" y="${cy + 30}" text-anchor="middle" font-size="11" fill="var(--outline-elev)">LOGIC</text>`;
        // Labels at start/end
        html += `<text x="35" y="200" text-anchor="start" font-size="10" fill="var(--outline-elev)">Faith</text>`;
        html += `<text x="185" y="200" text-anchor="end" font-size="10" fill="var(--outline-elev)">Cold Logic</text>`;
        svg.innerHTML = html;

        document.getElementById('logic-percent').textContent = logicPct + '%';
        document.getElementById('gauge-meta').textContent = `${g.total} trades · ${g.win_rate}% win rate · asset favorito: ${g.preferred_asset || '-'}`;
    }

    function renderBiasMap(d) {
        const svg = document.getElementById('bias-svg');
        const w = 600, h = 280;
        const points = d.points || [];
        let html = '';
        // Axes
        html += `<line x1="40" y1="${h - 30}" x2="${w - 20}" y2="${h - 30}" stroke="var(--outline-variant-elev)" stroke-width="0.5" />`;
        html += `<line x1="40" y1="20" x2="40" y2="${h - 30}" stroke="var(--outline-variant-elev)" stroke-width="0.5" />`;
        // Axis labels
        html += `<text x="10" y="20" font-size="10" fill="var(--outline-elev)">Analytical</text>`;
        html += `<text x="${w - 80}" y="${h - 10}" font-size="10" fill="var(--outline-elev)">Emotional</text>`;
        // Points
        for (const p of points) {
            const x = 40 + (p.analytical * (w - 60));
            const y = (h - 30) - (p.emotional * (h - 50));
            const win = p.result === 'WIN';
            const color = win ? 'var(--gold-elev)' : '#ff6b6b';
            const r = Math.max(3, Math.min(10, Math.abs(p.pnl) / 50 + 3));
            html += `<circle cx="${x}" cy="${y}" r="${r}" fill="${color}" fill-opacity="0.6" stroke="${color}" stroke-width="0.5"><title>${p.date} ${p.asset} ${p.result} PnL: ${p.pnl}</title></circle>`;
        }
        svg.innerHTML = html;

        const winCount = points.filter(p => p.result === 'WIN').length;
        const lossCount = points.filter(p => p.result === 'LOSS' || p.result === 'BE').length;
        document.getElementById('bias-meta').textContent = `${points.length} trades · ${winCount} wins · ${lossCount} losses/BE`;
    }

    function renderPerformance(d) {
        const svg = document.getElementById('perf-svg');
        const w = 800, h = 240;
        const days = d.days || [];
        if (days.length === 0) {
            svg.innerHTML = '<text x="400" y="120" text-anchor="middle" font-size="14" fill="var(--outline-elev)">Sin trades en el rango seleccionado</text>';
            return;
        }
        let html = '';
        // Y axis: PnL range
        const pnls = days.map(d => d.pnl);
        const maxAbs = Math.max(100, ...pnls.map(Math.abs));
        const yScale = (val) => h - 30 - (val / maxAbs) * (h - 50) / 2 - (h / 2 - 30);
        const zeroY = h - 30;
        // X axis: days
        const xStep = (w - 80) / Math.max(1, days.length - 1);

        // Zero line
        html += `<line x1="40" y1="${zeroY}" x2="${w - 20}" y2="${zeroY}" stroke="var(--outline-variant-elev)" stroke-width="0.5" stroke-dasharray="2,2" />`;
        // Positive bars
        for (let i = 0; i < days.length; i++) {
            const d = days[i];
            if (d.pnl >= 0) {
                const x = 40 + i * xStep;
                const y = zeroY - (d.pnl / maxAbs) * (h - 50) / 2;
                const height = zeroY - y;
                html += `<rect x="${x - 4}" y="${y}" width="8" height="${height}" fill="var(--gold-elev)" fill-opacity="0.7" rx="1"><title>${d.date} ${d.trades}t PnL: ${d.pnl} ${d.wins}W ${d.losses}L</title></rect>`;
            }
        }
        // Negative bars
        for (let i = 0; i < days.length; i++) {
            const d = days[i];
            if (d.pnl < 0) {
                const x = 40 + i * xStep;
                const y = zeroY;
                const height = (Math.abs(d.pnl) / maxAbs) * (h - 50) / 2;
                html += `<rect x="${x - 4}" y="${y}" width="8" height="${height}" fill="#ff6b6b" fill-opacity="0.7" rx="1"><title>${d.date} ${d.trades}t PnL: ${d.pnl} ${d.wins}W ${d.losses}L</title></rect>`;
            }
        }
        // X-axis labels (first, middle, last)
        if (days.length > 0) {
            html += `<text x="40" y="${h - 12}" font-size="9" fill="var(--outline-elev)">${days[0].date.substring(5)}</text>`;
            if (days.length > 2) {
                html += `<text x="40 + ${(days.length - 1) / 2 * xStep}" y="${h - 12}" font-size="9" fill="var(--outline-elev)" text-anchor="middle">${days[Math.floor(days.length / 2)].date.substring(5)}</text>`;
            }
            html += `<text x="${40 + (days.length - 1) * xStep}" y="${h - 12}" font-size="9" fill="var(--outline-elev)" text-anchor="end">${days[days.length - 1].date.substring(5)}</text>`;
        }
        svg.innerHTML = html;
    }

    document.getElementById('refresh-btn').addEventListener('click', loadAll);
    document.getElementById('days-select').addEventListener('change', loadAll);
    document.getElementById('user-code').addEventListener('keypress', (e) => { if (e.key === 'Enter') loadAll(); });
    loadAll();
    </script>
{% endblock %}