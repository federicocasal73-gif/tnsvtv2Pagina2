{% extends 'shell.html.twig' %}

{% block title %}Command Center · T.N.S.V.T{% endblock %}

{% block sidebar_nav %}
    <a href="{{ path('sanctum_dashboard') }}" class="sidebar-link active">
        <span class="material-symbols-elev">dashboard</span>
        <span>Dashboard</span>
    </a>
    <a href="{{ path('sanctum_users') }}" class="sidebar-link">
        <span class="material-symbols-elev">group</span>
        <span>Adeptos</span>
    </a>
    <a href="{{ path('sanctum_audit') }}" class="sidebar-link">
        <span class="material-symbols-elev">shield</span>
        <span>Audit Log</span>
    </a>

    <style>
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            color: var(--on-surface-variant-elev);
            font-size: 0.875rem;
            font-weight: 500;
            border-left: 2px solid transparent;
            transition: all 0.2s ease;
        }
        .sidebar-link:hover {
            background: var(--glass-bg-elev);
            color: var(--on-surface-elev);
        }
        .sidebar-link.active {
            background: var(--glass-bg-strong-elev);
            color: var(--gold-elev);
            border-left-color: var(--gold-elev);
        }
    </style>
{% endblock %}

{% block topbar_title %}Command Center{% endblock %}
{% block topbar_subtitle %}Divine synchronization active.{% endblock %}

{% block content %}
    {# ====== Command Center Dashboard (Phase 1a placeholder) ====== #}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        {# KPI Cards (Stitch style) #}
        <div class="stat-card-elev">
            <p class="stat-label-elev">Global PnL</p>
            <p class="stat-value-elev">+$0</p>
            <p class="stat-meta-elev">— pending data</p>
        </div>

        <div class="stat-card-elev">
            <p class="stat-label-elev">Active Seekers</p>
            <p class="stat-value-elev">0</p>
            <p class="stat-meta-elev">Real-time presence</p>
        </div>

        <div class="stat-card-elev">
            <p class="stat-label-elev">Server Sanctum</p>
            <p class="stat-value-elev">99.9%</p>
            <p class="stat-meta-elev">Divine Integrity High</p>
        </div>

        <div class="stat-card-elev">
            <p class="stat-label-elev">Macro Signals</p>
            <p class="stat-value-elev">0</p>
            <p class="stat-meta-elev">Executions per hr</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# Task Sovereignty placeholder #}
        <div class="glass-card-elev p-6 lg:col-span-2">
            <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Task Sovereignty</h3>
            <p class="text-sm text-[var(--outline-elev)] mb-4">Phase 1a placeholder — task list will populate when data is migrated.</p>
            <div class="space-y-3">
                <div class="flex items-center justify-between p-3 rounded-lg glass-card-elev">
                    <span class="text-sm">Liquidity Stream Calibration</span>
                    <span class="status-pill-elev status-active">Active</span>
                </div>
                <div class="flex items-center justify-between p-3 rounded-lg glass-card-elev">
                    <span class="text-sm">Vault Integrity Audit</span>
                    <span class="status-pill-elev status-pending">Pending</span>
                </div>
                <div class="flex items-center justify-between p-3 rounded-lg glass-card-elev">
                    <span class="text-sm">Conclave Oracle Update</span>
                    <span class="status-pill-elev status-completed">Completed</span>
                </div>
            </div>
        </div>

        {# Recent Signals placeholder #}
        <div class="glass-card-elev p-6">
            <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Recent Signals</h3>
            <p class="text-sm text-[var(--outline-elev)]">Phase 1a placeholder — live feed coming in Phase 4.</p>
        </div>
    </div>

    <div class="mt-6 section-divider-elev"></div>

    <p class="text-xs text-center text-[var(--outline-elev)]">
        T.N.S.V.T Reino v2 · Phase 0 STEP 5 · Sanctum shell preview · {{ "now"|date("Y-m-d H:i") }}
    </p>
{% endblock %}