{% extends 'shell.html.twig' %}

{% block title %}Dashboard · T.N.S.V.T{% endblock %}

{% block topbar_title %}Command Center{% endblock %}
{% block topbar_subtitle %}Divine synchronization active.{% endblock %}

{% block stylesheets %}
<style>
    .dashboard-grid { display: grid; gap: 1.5rem; }
    .kpi-card-elev {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 1rem;
        padding: 1.25rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .kpi-card-elev:hover {
        border-color: rgba(242, 202, 80, 0.2);
        box-shadow: 0 0 20px rgba(242, 202, 80, 0.1);
    }
    .kpi-label-elev {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--outline, #99907c);
    }
    .kpi-value-elev {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--gold-elev, #f2ca50);
        margin: 0.5rem 0 0.25rem;
    }
    .kpi-meta-elev {
        font-size: 0.75rem;
        color: var(--outline, #99907c);
    }
    .live-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        background: #4ade80;
        border-radius: 50%;
        animation: pulse-gold 2s infinite;
        margin-right: 4px;
    }
</style>
{% endblock %}

{% block content %}
{# WebGL Background #}
<script src="{{ asset('js/modules/webgl-background.js') }}" defer></script>

<div class="max-w-7xl mx-auto dashboard-grid">
    {# Hero Metrics Row - 4 KPI Cards #}
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="kpi-card-elev" data-card="globalPnl">
            <div class="flex justify-between items-start">
                <span class="kpi-label-elev">Global PnL</span>
                <span class="material-symbols-elev text-[var(--gold-elev)]">trending_up</span>
            </div>
            <p class="kpi-value-elev" id="kpi-pnl-value">$0</p>
            <p class="kpi-meta-elev"><span id="kpi-pnl-meta">— calculating</span></p>
            <svg class="w-full h-8 mt-2" viewBox="0 0 100 30" preserveAspectRatio="none">
                <polyline id="kpi-pnl-spark" points="0,25 10,22 20,20 30,18 40,15 50,12 60,10 70,8 80,5 90,3 100,2" fill="none" stroke="var(--gold-elev)" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </div>
        <div class="kpi-card-elev" data-card="activeSeekers">
            <div class="flex justify-between items-start">
                <span class="kpi-label-elev">Active Seekers</span>
                <span class="material-symbols-elev text-green-400">groups</span>
            </div>
            <p class="kpi-value-elev text-green-400" id="kpi-seekers-value">0</p>
            <p class="kpi-meta-elev"><span class="live-dot"></span><span id="kpi-seekers-meta">0 activos</span></p>
            <svg class="w-full h-8 mt-2" viewBox="0 0 100 30" preserveAspectRatio="none">
                <polyline id="kpi-seekers-spark" points="0,20 10,18 20,15 30,17 40,12 50,10 60,8 70,5 80,7 90,3 100,2" fill="none" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </div>
        <div class="kpi-card-elev" data-card="serverSanctum">
            <div class="flex justify-between items-start">
                <span class="kpi-label-elev">Server Sanctum</span>
                <span class="material-symbols-elev text-green-400">verified</span>
            </div>
            <p class="kpi-value-elev text-green-400" id="kpi-server-value">99.9%</p>
            <p class="kpi-meta-elev"><span class="live-dot"></span><span id="kpi-server-meta">Divine Integrity High</span></p>
            <svg class="w-full h-8 mt-2" viewBox="0 0 100 30" preserveAspectRatio="none">
                <polyline id="kpi-server-spark" points="0,5 10,4 20,5 30,3 40,4 50,2 60,3 70,2 80,1 90,2 100,1" fill="none" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </div>
        <div class="kpi-card-elev" data-card="macroSignals">
            <div class="flex justify-between items-start">
                <span class="kpi-label-elev">Macro Signals</span>
                <span class="material-symbols-elev text-purple-400">event_upcoming</span>
            </div>
            <p class="kpi-value-elev text-purple-400" id="kpi-macro-value">0</p>
            <p class="kpi-meta-elev"><span id="kpi-macro-meta">Próximas 24h</span></p>
            <svg class="w-full h-8 mt-2" viewBox="0 0 100 30" preserveAspectRatio="none">
                <polyline id="kpi-macro-spark" points="0,28 10,25 20,22 30,20 40,18 50,15 60,12 70,10 80,8 90,5 100,3" fill="none" stroke="#8a3cff" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </div>
        </section>

        {# ─── Guardian Widget (Phase 3) ─── #}
        <section class="glass-card-elev p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">shield_person</span>
                    Guardian
                    <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--outline-elev)] font-normal">Risk & Discipline</span>
                </h3>
                <a href="/sanctum/guardian" class="text-xs text-[var(--gold-elev)] hover:underline flex items-center gap-1">
                    Ver completo
                    <span class="material-symbols-elev" style="font-size: 0.875rem;">arrow_forward</span>
                </a>
            </div>

            <div id="guardian-widget" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {# ── Score ── #}
                <div class="text-center md:border-r border-[var(--outline-variant-elev)] md:pr-6">
                    <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider mb-2">Discipline</p>
                    <div id="gw-score" class="text-5xl font-bold" style="color: var(--gold-elev); line-height: 1;">--</div>
                    <div class="text-xs text-[var(--outline-elev)] mt-1">/ 100</div>
                    <div id="gw-tier" class="mt-2 inline-block text-xs px-2 py-0.5 rounded-full border" style="border-color: var(--outline-variant-elev); color: var(--outline-elev);">—</div>
                </div>

                {# ── Top signals ── #}
                <div class="md:col-span-2">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Señales activas</p>
                        <span id="gw-signal-count" class="text-xs text-[var(--outline-elev)]">0</span>
                    </div>
                    <div id="gw-signals" class="space-y-2">
                        <p class="text-center text-[var(--outline-elev)] py-2 loading-pulse text-xs">Cargando...</p>
                    </div>
                </div>
            </div>
        </section>

        {# Recent Signals + Task Sovereignty #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="glass-card-elev p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">auto_awesome</span>
                        Task Sovereignty
                    </h3>
                    <div class="flex gap-2">
                        <button id="quick-add-task" class="btn-elev-secondary text-xs">
                            <span class="material-symbols-elev align-middle text-sm">add</span>
                            Nueva
                        </button>
                        <a href="/sanctum/tasks" class="text-xs text-[var(--gold-elev)] hover:underline">Ver todos →</a>
                    </div>
                </div>
                <div id="task-list" class="space-y-2">
                    <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando...</p>
                </div>
            </div>

            <div class="glass-card-elev p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">timeline</span>
                        Recent Signals
                    </h3>
                    <a href="/sanctum/audit" class="text-xs text-[var(--gold-elev)] hover:underline">Ver audit log →</a>
                </div>
                <div id="signal-list" class="space-y-2 max-h-72 overflow-y-auto pr-2">
                    <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando actividad reciente...</p>
                </div>
            </div>
        </div>

        {# Quick Actions + System Status #}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <div class="glass-card-elev p-6 lg:col-span-2">
                <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">bolt</span>
                    Quick Actions
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    <button class="quick-action" data-action="open-create-task">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">task_alt</span>
                        <span class="text-sm">Nueva Tarea</span>
                    </button>
                    <a href="/sanctum/users" class="quick-action">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">person_add</span>
                        <span class="text-sm">Crear Usuario</span>
                    </a>
                    <a href="/frequencies" class="quick-action">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">graphic_eq</span>
                        <span class="text-sm">Frecuencias</span>
                    </a>
                    <a href="/oracle" class="quick-action">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">auto_awesome</span>
                        <span class="text-sm">Oráculo</span>
                    </a>
                    <a href="/macro" class="quick-action">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">event_upcoming</span>
                        <span class="text-sm">Macro</span>
                    </a>
                    <a href="/sanctum/settings" class="quick-action">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">settings</span>
                        <span class="text-sm">Settings</span>
                    </a>
                </div>
            </div>

            <div class="glass-card-elev p-6">
                <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">monitor_heart</span>
                    System Status
                </h3>
                <div id="system-status" class="space-y-3 text-sm">
                    <p class="text-center text-[var(--outline-elev)] py-4 loading-pulse">Cargando...</p>
                </div>
                <a href="/sanctum/monitoring" class="text-xs text-[var(--gold-elev)] hover:underline mt-3 inline-block">Ver monitoring completo →</a>
            </div>
        </div>

        {# Activity Feed + Market Pulse #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="glass-card-elev p-6">
                <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">feed</span>
                    Actividad Reciente
                </h3>
                <div id="activity-feed" class="space-y-3 max-h-64 overflow-y-auto pr-2">
                    <p class="text-center text-[var(--outline-elev)] py-4 loading-pulse">Cargando actividad...</p>
                </div>
            </div>

            <div class="glass-card-elev p-6">
                <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">event_upcoming</span>
                    Próximos Eventos Macro
                </h3>
                <div id="market-pulse" class="space-y-3">
                    <p class="text-center text-[var(--outline-elev)] py-4 loading-pulse">Cargando eventos...</p>
                </div>
            </div>
        </div>

        {# Quick Stats Row #}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="glass-card-elev p-4 text-center">
                <div class="text-xs text-[var(--outline-elev)] uppercase tracking-wider mb-1">PnL Semanal</div>
                <div id="qs-weekly-pnl" class="text-xl font-bold">—</div>
            </div>
            <div class="glass-card-elev p-4 text-center">
                <div class="text-xs text-[var(--outline-elev)] uppercase tracking-wider mb-1">Win Rate</div>
                <div id="qs-winrate" class="text-xl font-bold text-[var(--gold-elev)]">—</div>
            </div>
            <div class="glass-card-elev p-4 text-center">
                <div class="text-xs text-[var(--outline-elev)] uppercase tracking-wider mb-1">Mejor Trade</div>
                <div id="qs-best-trade" class="text-xl font-bold text-green-400">—</div>
            </div>
            <div class="glass-card-elev p-4 text-center">
                <div class="text-xs text-[var(--outline-elev)] uppercase tracking-wider mb-1">Notificaciones</div>
                <div id="qs-notifs" class="text-xl font-bold">—</div>
            </div>
        </div>
    </div>

    {# Create Task Modal #}
    <div id="create-task-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="text-xl font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">task_alt</span>
                    Nueva Tarea
                </h2>
                <button class="modal-close" data-action="close-create-task">
                    <span class="material-symbols-elev">close</span>
                </button>
            </div>
            <form id="create-task-form" class="modal-body">
                <div class="form-group">
                    <label class="form-label">Título *</label>
                    <input id="task-title" name="title" type="text" required maxlength="255" placeholder="Ej: Auditar journal del usuario X" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label">Descripción</label>
                    <textarea id="task-description" name="description" rows="3" placeholder="Detalles opcionales..." class="form-input"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Orden</label>
                        <input id="task-orden" name="orden" type="number" min="0" value="0" class="form-input" />
                    </div>
                    <label class="form-group flex items-center gap-2 pt-6">
                        <input id="task-active" name="active" type="checkbox" checked />
                        <span>Activa</span>
                    </label>
                </div>
                <p id="create-task-error" class="text-red-400 text-sm hidden"></p>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" data-action="close-create-task">Cancelar</button>
                    <button type="submit" class="btn-primary">Crear Tarea</button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .kpi-card {
            position: relative;
            background: linear-gradient(135deg, var(--glass-bg-elev) 0%, rgba(242, 202, 80, 0.03) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border-elev);
            border-radius: 0.75rem;
            padding: 1.25rem 1.5rem;
            transition: all 0.3s ease;
            overflow: hidden;
            cursor: pointer;
        }
        .kpi-card::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 60px;
            height: 60px;
            background: radial-gradient(circle, rgba(242, 202, 80, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .kpi-card:hover {
            border-color: rgba(242, 202, 80, 0.4);
            background: linear-gradient(135deg, var(--glass-bg-strong-elev) 0%, rgba(242, 202, 80, 0.08) 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(138, 60, 255, 0.12);
        }
    .kpi-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }
    .kpi-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--outline-elev);
        margin: 0;
    }
    .kpi-icon {
        font-size: 1.25rem;
        color: var(--gold-elev);
    }
    .kpi-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--gold-elev);
        margin: 0.25rem 0;
        line-height: 1.1;
        text-shadow: 0 0 20px rgba(242, 202, 80, 0.3);
    }
    .kpi-meta {
        font-size: 0.75rem;
        color: var(--outline-elev);
        margin: 0;
    }
    .kpi-sparkline {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 30px;
        width: 100%;
        opacity: 0.6;
    }
    .kpi-pulse {
        position: absolute;
        top: 1rem;
        right: 1rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4ade80;
        animation: pulse 2s infinite;
        box-shadow: 0 0 8px #4ade80;
    }
    .pulse-text {
        font-size: 0.7rem;
        color: var(--outline-elev);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }
    .kpi-meta-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 0.5rem;
        vertical-align: middle;
    }
    .kpi-ring {
        position: absolute;
        top: -10px;
        right: -10px;
        width: 80px;
        height: 80px;
        border: 2px solid var(--gold-elev);
        border-radius: 50%;
        opacity: 0.2;
    }
    .kpi-icon-large {
        position: absolute;
        bottom: 0;
        right: 0;
        font-size: 4rem;
        opacity: 0.05;
    }
    .quick-action {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 0.5rem;
        border-radius: 0.5rem;
        background: linear-gradient(135deg, var(--glass-bg-elev) 0%, rgba(242, 202, 80, 0.02) 100%);
        border: 1px solid var(--glass-border-elev);
        color: var(--on-surface-elev);
        text-decoration: none;
        cursor: pointer;
        font: inherit;
        transition: all 0.2s ease;
    }
    .quick-action:hover {
        background: linear-gradient(135deg, var(--glass-bg-strong-elev) 0%, rgba(242, 202, 80, 0.08) 100%);
        border-color: var(--gold-elev);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(242, 202, 80, 0.2);
    }
    /* Modal */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
        padding: 1rem;
    }
    .modal-content {
        background: linear-gradient(135deg, var(--surface-elev) 0%, rgba(16, 11, 28, 0.95) 100%);
        border: 1px solid var(--glass-border-elev);
        border-radius: 1rem;
        width: 100%;
        max-width: 500px;
        max-height: 90vh;
        overflow: auto;
        box-shadow: 0 0 40px rgba(138, 60, 255, 0.15);
    }
    .modal-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--glass-border-elev);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, rgba(242, 202, 80, 0.05) 0%, transparent 100%);
    }
    .modal-close {
        background: transparent;
        border: none;
        color: var(--on-surface-elev);
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 0.25rem;
        transition: all 0.2s ease;
    }
    .modal-close:hover {
        background: var(--glass-bg-elev);
        color: var(--gold-elev);
    }
    .modal-body {
        padding: 1.5rem;
    }
    .modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--glass-border-elev);
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        background: rgba(0, 0, 0, 0.1);
    }
    .form-group { margin-bottom: 1rem; }
    .form-row { display: flex; gap: 1rem; align-items: flex-end; margin-bottom: 1rem; }
    .form-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--outline-elev);
        margin-bottom: 0.25rem;
    }
    .form-input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: var(--glass-bg-elev);
        border: 1px solid var(--glass-border-elev);
        border-radius: 0.375rem;
        color: var(--on-surface-elev);
        font-size: 0.875rem;
    }
    .form-input:focus {
        outline: none;
        border-color: var(--gold-elev);
    }
    .btn-primary {
        padding: 0.5rem 1.25rem;
        background: linear-gradient(135deg, var(--gold-elev), var(--gold-bright-elev));
        color: var(--on-primary-elev);
        font-weight: 600;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
    }
    .btn-secondary {
        padding: 0.5rem 1.25rem;
        background: transparent;
        color: var(--on-surface-elev);
        border: 1px solid var(--glass-border-elev);
        border-radius: 0.375rem;
        cursor: pointer;
    }
    .impact-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .impact-high { background:#f87171; }
    .impact-medium { background:#fbbf24; }
    .impact-low { background:#4ade80; }
    </style>

    <script>
    async function loadDashboard() {
        // Tasks (server returns {success, tasks, activeCount})
        const tasksRes = await apiFetch('/sanctum/api/tasks');
        if (tasksRes.ok && tasksRes.data && tasksRes.data.success) {
            renderTasks(tasksRes.data.tasks);
            document.getElementById('kpi-pnl-meta').textContent = `${tasksRes.data.activeCount} activas`;
            // Render recent signals
            if (tasksRes.data.tasks && tasksRes.data.tasks.length > 0) {
                document.getElementById('signal-list').innerHTML = tasksRes.data.tasks.slice(0, 5).map(t => `
                    <div class="flex items-center justify-between p-2 rounded glass-card-elev text-sm">
                        <span class="truncate">${escapeHtml(t.title)}</span>
                        <span class="status-pill ${t.active ? 'status-active' : 'status-inactive'} text-xs">${t.active ? 'Active' : 'Inactive'}</span>
                    </div>
                `).join('');
            } else {
                document.getElementById('signal-list').innerHTML = '<p class="text-center text-[var(--outline-elev)] py-4 text-sm">Sin actividad reciente</p>';
            }
        } else {
            document.getElementById('task-list').innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8 text-sm">Sin datos disponibles</p>';
            document.getElementById('signal-list').innerHTML = '<p class="text-center text-[var(--outline-elev)] py-4 text-sm">Sin datos disponibles</p>';
        }

        // System status
        const monRes = await apiFetch('/sanctum/api/monitoring/status', { silent: true });
        if (monRes.ok && monRes.data && monRes.data.success) {
            renderSystemStatus(monRes.data.data);
        } else {
            document.getElementById('system-status').innerHTML = '<p class="text-center text-[var(--outline-elev)] py-4 text-sm">Sin datos disponibles</p>';
        }

        // Activity Feed (recent journal entries)
        const journalRes = await apiFetch('/api/journal?limit=5', { silent: true });
        if (journalRes.ok && journalRes.data && journalRes.data.entries && journalRes.data.entries.length > 0) {
            document.getElementById('activity-feed').innerHTML = journalRes.data.entries.slice(0, 5).map(e => `
                <div class="flex items-center gap-3 p-2 rounded glass-card-elev text-sm">
                    <span class="text-xs">${e.asset||'—'}</span>
                    <span class="text-xs ${e.direction === 'BUY' ? 'text-green-400' : 'text-red-400'}">${e.direction||'—'}</span>
                    <span class="text-xs text-[var(--outline-elev)] ml-auto">${e.date||''}</span>
                </div>
            `).join('');
        } else {
            document.getElementById('activity-feed').innerHTML = '<p class="text-center text-[var(--outline-elev)] py-4 text-sm">Sin actividad reciente</p>';
        }

        // Market Pulse (upcoming macro events)
        const calRes = await apiFetch('/api/calendar/events?limit=3', { silent: true });
        if (calRes.ok && calRes.data && calRes.data.events && calRes.data.events.length > 0) {
            document.getElementById('market-pulse').innerHTML = calRes.data.events.slice(0, 3).map(ev => `
                <div class="flex items-center gap-3 p-2 rounded glass-card-elev text-sm">
                    <span class="text-xs font-medium">${ev.country||'—'}</span>
                    <span class="text-xs flex-1 truncate">${ev.event||ev.title||'—'}</span>
                    <span class="impact-dot impact-${ev.impact||'medium'}"></span>
                </div>
            `).join('');
        } else {
            document.getElementById('market-pulse').innerHTML = '<p class="text-center text-[var(--outline-elev)] py-4 text-sm">Sin eventos próximos</p>';
        }

        // Quick Stats
        const statsRes = await apiFetch('/api/journal/stats', { silent: true });
        if (statsRes.ok && statsRes.data) {
            const s = statsRes.data;
            const pnl = parseFloat(s.total_pnl || 0);
            document.getElementById('qs-weekly-pnl').textContent = (pnl >= 0 ? '+' : '') + '$' + Math.abs(pnl).toFixed(0);
            document.getElementById('qs-weekly-pnl').className = 'text-xl font-bold ' + (pnl >= 0 ? 'text-green-400' : 'text-red-400');
            document.getElementById('qs-winrate').textContent = (s.win_rate || 0) + '%';
            document.getElementById('qs-best-trade').textContent = s.best_trade ? '$' + parseFloat(s.best_trade).toFixed(0) : '—';
        }

        // Notifications count
        const notifRes = await apiFetch('/api/notifications/count', { silent: true });
        if (notifRes.ok && notifRes.data) {
            document.getElementById('qs-notifs').textContent = notifRes.data.count || 0;
        }
    }

    function renderTasks(tasks) {
        const list = document.getElementById('task-list');
        if (!tasks || tasks.length === 0) {
            list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin tareas activas</p>';
            return;
        }
        list.innerHTML = tasks.slice(0, 5).map(t => `
            <div class="flex items-center gap-3 p-3 rounded glass-card-elev">
                <span class="status-pill ${t.active ? 'status-active' : 'status-inactive'} text-xs">${t.active ? 'Active' : 'Inactive'}</span>
                <span class="text-sm flex-1 truncate">${escapeHtml(t.title || '')}</span>
                <span class="text-xs text-[var(--outline-elev)] font-mono">#${t.orden}</span>
            </div>
        `).join('');
    }

    function renderSystemStatus(d) {
        const html = `
            <div class="flex justify-between"><span class="text-[var(--outline-elev)]">PHP</span><span class="font-mono">${d.server.php_version.split(' ')[0]}</span></div>
            <div class="flex justify-between"><span class="text-[var(--outline-elev)]">DB</span><span class="font-mono">${d.database.tables} tablas</span></div>
            <div class="flex justify-between"><span class="text-[var(--outline-elev)]">Users</span><span class="font-mono">${d.database.users_total} total</span></div>
            <div class="flex justify-between"><span class="text-[var(--outline-elev)]">Opcache</span><span class="font-mono">${d.opcache.cached_scripts} scripts</span></div>
            <div class="flex justify-between"><span class="text-[var(--outline-elev)]">Memory</span><span class="font-mono">${d.server.memory_used_mb} / ${d.server.memory_limit}</span></div>
        `;
        document.getElementById('system-status').innerHTML = html;
    }

    function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    // Modal handlers
    function openCreateTask() {
        document.getElementById('create-task-modal').style.display = 'flex';
        setTimeout(() => document.getElementById('task-title').focus(), 100);
    }
    function closeCreateTask() {
        document.getElementById('create-task-modal').style.display = 'none';
        document.getElementById('create-task-form').reset();
        document.getElementById('create-task-error').classList.add('hidden');
    }
    async function submitCreateTask(e) {
        e.preventDefault();
        const errEl = document.getElementById('create-task-error');
        errEl.classList.add('hidden');
        const title = document.getElementById('task-title').value.trim();
        const description = document.getElementById('task-description').value.trim();
        const orden = parseInt(document.getElementById('task-orden').value) || 0;
        const active = document.getElementById('task-active').checked;
        if (!title) {
            errEl.textContent = 'El título es obligatorio';
            errEl.classList.remove('hidden');
            return;
        }
        const r = await apiFetch('/sanctum/api/tasks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title, description, orden, active })
        });
        if (r.ok && r.data && r.data.success) {
            if (window.apiToast) apiToast('Tarea creada', 'success');
            closeCreateTask();
            loadDashboard();
        } else {
            const msg = (r.data && (r.data.error || r.data.message)) || (r.timeout ? 'Timeout' : r.networkError ? 'Sin conexión' : 'Error');
            errEl.textContent = msg;
            errEl.classList.remove('hidden');
        }
    }

    const GW_TIER_COLOR = {
        elite: '#ffe088', strong: 'var(--gold-elev)', steady: 'var(--violet)',
        caution: 'var(--gold-elev)', risk: '#f87171',
    };
    const GW_SEVERITY_VISUAL = {
        danger:  { icon: 'error',   color: '#f87171' },
        warning: { icon: 'warning', color: 'var(--gold-elev)' },
        info:    { icon: 'info',    color: 'var(--violet)' },
    };

    async function loadGuardianWidget() {
        const [scoreRes, sigRes] = await Promise.all([
            apiFetch('/api/guardian/score', { silent: true }),
            apiFetch('/api/guardian/signals', { silent: true }),
        ]);
        if (scoreRes.ok && scoreRes.data) {
            const d = scoreRes.data;
            const scoreEl = document.getElementById('gw-score');
            const tierEl  = document.getElementById('gw-tier');
            scoreEl.textContent = d.score ?? 0;
            const c = GW_TIER_COLOR[d.tier] || 'var(--outline-elev)';
            scoreEl.style.color = (d.score ?? 0) >= 75 ? c : (d.score >= 40 ? 'var(--gold-elev)' : '#f87171');
            tierEl.textContent = (d.tier || '—').toUpperCase();
            tierEl.style.color = c;
            tierEl.style.borderColor = c;
        }
        if (sigRes.ok && sigRes.data) {
            const signals = sigRes.data.signals || [];
            const listEl = document.getElementById('gw-signals');
            const countEl = document.getElementById('gw-signal-count');
            countEl.textContent = signals.length === 0 ? 'Sin señales' : `${signals.length} activas`;
            if (signals.length === 0) {
                listEl.innerHTML = `
                    <div class="flex items-center gap-2 p-2 rounded text-sm text-green-400">
                        <span class="material-symbols-elev" style="font-size: 1.1rem;">check_circle</span>
                        <span>Todo en orden · tu disciplina está bajo control</span>
                    </div>`;
                return;
            }
            const top3 = signals.slice(0, 3);
            listEl.innerHTML = top3.map(s => {
                const v = GW_SEVERITY_VISUAL[s.severity] || GW_SEVERITY_VISUAL.info;
                const action = s.action_label && s.action_route
                    ? `<a href="${escapeHtml(s.action_route)}" class="text-xs text-[var(--gold-elev)] hover:underline ml-auto">${escapeHtml(s.action_label)} →</a>`
                    : '';
                return `
                    <div class="flex items-center gap-2 p-2 rounded hover:bg-[var(--glass-bg-elev)] transition-colors">
                        <span class="material-symbols-elev flex-shrink-0" style="color: ${v.color}; font-size: 1.1rem;">${v.icon}</span>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-[var(--on-surface-elev)] truncate">${escapeHtml(s.title)}</p>
                            <p class="text-xs text-[var(--outline-elev)] truncate">${escapeHtml(s.message)}</p>
                        </div>
                        ${action}
                    </div>
                `;
            }).join('');
        }
    }

    // Wire up events
    document.addEventListener('DOMContentLoaded', () => {
        loadDashboard();
        loadGuardianWidget();
        document.getElementById('quick-add-task').addEventListener('click', openCreateTask);
        document.querySelectorAll('[data-action="open-create-task"]').forEach(b => b.addEventListener('click', openCreateTask));
        document.querySelectorAll('[data-action="close-create-task"]').forEach(b => b.addEventListener('click', closeCreateTask));
        document.getElementById('create-task-form').addEventListener('submit', submitCreateTask);
        document.getElementById('create-task-modal').addEventListener('click', e => {
            if (e.target === e.currentTarget) closeCreateTask();
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && document.getElementById('create-task-modal').style.display === 'flex') {
                closeCreateTask();
            }
        });
        setInterval(loadDashboard, 60000);
        setInterval(loadGuardianWidget, 90000);
    });
    </script>
    <script src="{{ asset('js/modules/sparklines.js') }}"></script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        window._sparklineData = {
            pnl: [120, 135, 128, 142, 155, 148, 162, 170, 165, 180, 175, 190],
            seekers: [5, 6, 7, 8, 9, 8, 10, 11, 10, 12, 13, 14],
            server: [99.5, 99.6, 99.8, 99.9, 99.7, 99.9, 100, 99.9, 99.8, 99.9, 100, 99.9],
            macro: [2, 3, 1, 4, 2, 5, 3, 6, 4, 7, 5, 8]
        };
        if (window.initDashboardAnimations) window.initDashboardAnimations();
    });
    </script>
{% endblock %}