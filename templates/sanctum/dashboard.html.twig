{% extends 'shell.html.twig' %}

{% block title %}Dashboard · T.N.S.V.T{% endblock %}

{% block topbar_title %}Command Center{% endblock %}
{% block topbar_subtitle %}Divine synchronization active.{% endblock %}

{% block content %}
    {# Skeleton loading state — JS will replace #kpi-grid, #task-list, #signal-list on load #}
    <div id="kpi-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6 loading-pulse">
        <div class="kpi-card"><p class="kpi-label">Global PnL</p><p class="kpi-value">—</p><p class="kpi-meta">cargando...</p></div>
        <div class="kpi-card"><p class="kpi-label">Active Seekers</p><p class="kpi-value">—</p><p class="kpi-meta">cargando...</p></div>
        <div class="kpi-card"><p class="kpi-label">Server Sanctum</p><p class="kpi-value">—</p><p class="kpi-meta">cargando...</p></div>
        <div class="kpi-card"><p class="kpi-label">Macro Signals</p><p class="kpi-value">—</p><p class="kpi-meta">cargando...</p></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="glass-card-elev p-6 lg:col-span-2">
            <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Task Sovereignty</h3>
            <div id="task-list" class="space-y-3">
                <div class="flex items-center justify-between p-3 rounded-lg glass-card-elev loading-pulse">
                    <span class="text-sm text-[var(--outline-elev)]">Cargando tareas...</span>
                </div>
            </div>
        </div>

        <div class="glass-card-elev p-6">
            <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Recent Signals</h3>
            <div id="signal-list" class="space-y-3 text-sm">
                <p class="text-[var(--outline-elev)]">Sin actividad reciente.</p>
            </div>
        </div>
    </div>

    <div class="mt-6 section-divider-elev"></div>
    <p class="text-xs text-center text-[var(--outline-elev)]">T.N.S.V.T Reino v2 · Phase 1a · Sanctum real con datos del DB</p>

    <script>
    (async function() {
        try {
            const r = await fetch('/sanctum/api/dashboard');
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            if (!data.success) throw new Error(data.error || 'unknown error');

            // Render KPIs
            const k = data.kpis;
            const pnlFmt = (k.globalPnl >= 0 ? '+$' : '-$') + Math.abs(k.globalPnl).toLocaleString('en-US', {maximumFractionDigits: 0});
            document.getElementById('kpi-grid').innerHTML = `
                <div class="kpi-card"><p class="kpi-label">Global PnL</p><p class="kpi-value" style="color:${k.globalPnl >= 0 ? 'var(--gold-elev)' : '#ff6b6b'}">${pnlFmt}</p><p class="kpi-meta">${k.totalUsers} usuarios totales</p></div>
                <div class="kpi-card"><p class="kpi-label">Active Seekers</p><p class="kpi-value">${k.activeSeekers}</p><p class="kpi-meta">${k.activeUsers} de ${k.totalUsers} activos</p></div>
                <div class="kpi-card"><p class="kpi-label">Server Sanctum</p><p class="kpi-value">${k.serverSanctum}%</p><p class="kpi-meta">${k.serverSanctum >= 99 ? 'Divine Integrity High' : 'Operational'}</p></div>
                <div class="kpi-card"><p class="kpi-label">Macro Signals</p><p class="kpi-value">${k.macroSignals}</p><p class="kpi-meta">Eventos en próximas 24h</p></div>
            `;
            document.getElementById('kpi-grid').classList.remove('loading-pulse');

            // Render tasks
            const t = data.tasks;
            const taskHtml = [];
            if (t.active > 0) taskHtml.push(`<div class="flex items-center justify-between p-3 rounded-lg glass-card-elev"><span class="text-sm">Tareas activas en sistema</span><span class="status-pill status-active">${t.active} Active</span></div>`);
            if (t.inactive > 0) taskHtml.push(`<div class="flex items-center justify-between p-3 rounded-lg glass-card-elev"><span class="text-sm">Tareas desactivadas</span><span class="status-pill status-inactive">${t.inactive} Inactive</span></div>`);
            if (taskHtml.length === 0) taskHtml.push(`<div class="flex items-center justify-between p-3 rounded-lg glass-card-elev"><span class="text-sm">Sin tareas — el sistema está limpio.</span></div>`);
            document.getElementById('task-list').innerHTML = taskHtml.join('');
            document.getElementById('task-list').classList.remove('loading-pulse');

            // Render recent signals
            const sig = data.recentSignals;
            if (sig && sig.length > 0) {
                document.getElementById('signal-list').innerHTML = sig.map(s => `
                    <div class="p-2 border-l-2 border-[var(--gold-elev)]">
                        <p class="text-xs text-[var(--outline-elev)]">${new Date(s.time).toLocaleString()}</p>
                        <p><span class="font-mono text-xs">${s.admin}</span> · <span class="text-[var(--on-surface-elev)]">${s.action}</span></p>
                    </div>
                `).join('');
            } else {
                document.getElementById('signal-list').innerHTML = '<p class="text-[var(--outline-elev)]">Sin actividad reciente.</p>';
            }
        } catch (e) {
            console.error('Dashboard load failed:', e);
            document.getElementById('kpi-grid').innerHTML = '<div class="kpi-card col-span-4 text-center text-red-400">Error cargando dashboard: ' + e.message + '</div>';
        }
    })();
    </script>
{% endblock %}