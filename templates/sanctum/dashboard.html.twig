                    <div class="flex items-center gap-2 p-2 rounded hover:bg-[var(--glass-bg-elev)] transition-colors">
                        <span class="material-symbols-elev flex-shrink-0" style="color: ${v.color}; font-size: 1.1rem;">${v.icon}</span>
