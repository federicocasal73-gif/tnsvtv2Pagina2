    // ══════ F1.1 — Equity Curve ══════
    function fmtUSD(n) {
        const v = Math.abs(n);
        if (v >= 1e6) return `$${(n/1e6).toFixed(2)}M`;
        if (v >= 1e3) return `$${(n/1e3).toFixed(2)}k`;
        return `$${n.toFixed(2)}`;
    }
    function fmtPct(n) {
        const s = n >= 0 ? '+' : '';
        return `${s}${n.toFixed(2)}%`;
    }
    async function loadEquityCurve(range) {
        const svg = document.getElementById('ec-chart');
        // F1.5/F1.1 guard: solo correr cuando el tab dashboard esté renderizado
        if (!svg) return;

        const url = `/api/journal/equity-curve?range=${encodeURIComponent(range)}&account_size=10000`;
        const r = await apiFetch(url, { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;

        const { summary, points, account_size: accountSize, range: serverRange } = r.data;

        // Toggle active tab + aria-selected
        document.querySelectorAll('#ec-range-tabs .ec-tab').forEach(btn => {
            const isActive = btn.dataset.range === serverRange;
            btn.classList.toggle('active', isActive);
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Stats
        const balanceEl = document.getElementById('ec-balance');
        const balanceMetaEl = document.getElementById('ec-balance-meta');
        balanceEl.textContent = fmtUSD(summary.current);
        balanceMetaEl.textContent = `Peak ${fmtUSD(summary.peak)} · Low ${fmtUSD(summary.low)}`;

        const returnEl = document.getElementById('ec-return');
        returnEl.textContent = fmtPct(summary.total_return_pct);
        returnEl.classList.remove('pos', 'neg');
        returnEl.classList.add(summary.total_return_pct >= 0 ? 'pos' : 'neg');
        document.getElementById('ec-return-meta').textContent =
            `${summary.trade_count} trades · ${summary.wins}W / ${summary.losses}L · WR ${summary.win_rate}%`;

        const ddEl = document.getElementById('ec-drawdown');
        ddEl.textContent = `-${(summary.max_drawdown_pct || 0).toFixed(2)}%`;
        ddEl.classList.remove('pos', 'neg');
        ddEl.classList.add('neg');
        document.getElementById('ec-drawdown-meta').textContent =
            `Peak-to-trough · ${summary.breakeven} BE`;

        // Empty state
        const emptyEl = document.getElementById('ec-empty');
        const loadingEl = document.getElementById('ec-loading');
        if (loadingEl) loadingEl.remove();

        if (points.length === 0) {
            svg.hidden = true;
            emptyEl.hidden = false;
            document.getElementById('ec-source').textContent = serverRange;
            return;
        }
        svg.hidden = false;
        emptyEl.hidden = true;

        drawEquitySvg(svg, points, accountSize, serverRange);
    }

    function drawEquitySvg(svg, points, accountSize, rangeLabel) {
        const W = 1000, H = 280;
        const padT = 20, padB = 32, padL = 60, padR = 24;
        const chartW = W - padL - padR;
        const chartH = H - padT - padB;

        const balances = points.map(p => p.balance);
        const min = Math.min(accountSize, ...balances);
        const max = Math.max(accountSize, ...balances);
        const range = (max - min) || 1;

        const xs = points.map((_, i) =>
            points.length === 1
                ? padL + chartW / 2
                : padL + (i / (points.length - 1)) * chartW
        );
        const ys = points.map(p =>
            padT + chartH - ((p.balance - min) / range) * chartH
        );

        const linePath = xs.map((x, i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${ys[i].toFixed(1)}`).join(' ');
        const fillPath = `${linePath} L ${xs[xs.length-1].toFixed(1)} ${padT+chartH} L ${xs[0].toFixed(1)} ${padT+chartH} Z`;
        const baselineY = padT + chartH - ((accountSize - min) / range) * chartH;

        // y-axis labels (4 niveles)
        const yTicks = [0, 0.25, 0.5, 0.75, 1].map(f => {
            const value = min + (max - min) * f;
            const y = padT + chartH - f * chartH;
            return `<text x="${padL-8}" y="${y+4}" fill="rgba(255,255,255,0.45)" font-size="10" text-anchor="end" font-family="Space Grotesk">${fmtUSD(value)}</text>`;
        }).join('');

        svg.innerHTML = `
            <defs>
                <linearGradient id="ec-fill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="rgba(242, 202, 80, 0.35)" />
                    <stop offset="100%" stop-color="rgba(242, 202, 80, 0)" />
                </linearGradient>
            </defs>
            <g stroke="rgba(255,255,255,0.06)" stroke-width="1">
                <line x1="${padL}" x2="${W-padR}" y1="${padT}" y2="${padT}" />
                <line x1="${padL}" x2="${W-padR}" y1="${padT+chartH/2}" y2="${padT+chartH/2}" />
                <line x1="${padL}" x2="${W-padR}" y1="${padT+chartH}" y2="${padT+chartH}" />
            </g>
            ${yTicks}
            <line x1="${padL}" x2="${W-padR}" y1="${baselineY.toFixed(1)}" y2="${baselineY.toFixed(1)}"
                  stroke="rgba(255,255,255,0.25)" stroke-dasharray="4 4" stroke-width="1" />
            <text x="${W-padR}" y="${(baselineY-4).toFixed(1)}" fill="rgba(255,255,255,0.5)" font-size="9" text-anchor="end" font-family="Space Grotesk">baseline</text>
            <path d="${fillPath}" fill="url(#ec-fill)" />
            <path d="${linePath}" stroke="#f2ca50" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            ${points.map((p, i) => {
                const color = p.pnl > 0 ? '#4ade80' : p.pnl < 0 ? '#f87171' : 'rgba(255,255,255,0.45)';
                return `<circle class="ec-point" cx="${xs[i].toFixed(1)}" cy="${ys[i].toFixed(1)}" r="3" fill="${color}" stroke="#0e0a18" stroke-width="1" data-idx="${i}" style="cursor:pointer" />`;
            }).join('')}
        `;

        // Hover tooltip
        const tooltip = document.getElementById('ec-tooltip');
        const card = svg.closest('.equity-curve-card');
        svg.querySelectorAll('.ec-point').forEach(circle => {
            const idx = parseInt(circle.dataset.idx, 10);
            const p = points[idx];
            circle.addEventListener('mouseenter', () => {
                const dateStr = p.date ? new Date(p.date).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: '2-digit' }) : '—';
                const pnlSign = p.pnl >= 0 ? '+' : '';
                const pnlColor = p.pnl >= 0 ? '#4ade80' : '#f87171';
                tooltip.innerHTML = `
                    <div class="text-xs">
                        <div class="flex items-center gap-2 mb-1">
                            <strong class="text-[var(--gold-elev)]">${escapeHtml(p.asset)} ${escapeHtml(p.direction)}</strong>
                            <span class="text-[10px] px-1.5 rounded ${p.result === 'WIN' ? 'bg-green-500/20 text-green-300' : p.result === 'LOSS' ? 'bg-red-500/20 text-red-300' : 'bg-white/10 text-white/60'}">${escapeHtml(p.result || '—')}</span>
                        </div>
                        <div class="text-[var(--outline-elev)]">${dateStr}</div>
                        <div class="mt-1">Balance <span class="font-bold">$${p.balance.toLocaleString('es-AR', {minimumFractionDigits: 2})}</span></div>
                        <div style="color: ${pnlColor}">P&L ${pnlSign}$${Math.abs(p.pnl).toFixed(2)}</div>
                        ${p.drawdown_pct > 0 ? `<div class="text-[var(--outline-elev)] text-[10px]">DD ${p.drawdown_pct.toFixed(2)}%</div>` : ''}
                    </div>
                `;
                if (card) {
                    const cardRect = card.getBoundingClientRect();
                    const svgRect  = svg.getBoundingClientRect();
                    const xRatio = xs[idx] / W;
                    const yRatio = ys[idx] / H;
                    const left = (svgRect.left - cardRect.left) + xRatio * svgRect.width;
                    const top  = (svgRect.top  - cardRect.top)  + yRatio * svgRect.height;
                    tooltip.style.left = `${left}px`;
                    tooltip.style.top  = `${top}px`;
                    tooltip.hidden = false;
                }
            });
            circle.addEventListener('mouseleave', () => {
                tooltip.hidden = true;
            });
        });

        document.getElementById('ec-source').textContent =
            `${rangeLabel.toUpperCase()} · ${points.length} ops`;
    }

    function wireEquityCurveTabs() {
        const wrap = document.getElementById('ec-range-tabs');
        if (!wrap) return;
        wrap.addEventListener('click', e => {
            const btn = e.target.closest('.ec-tab');
            if (!btn) return;
            loadEquityCurve(btn.dataset.range);
        });
    }

    // ══════ F1.2 — Stats ══════
    async function loadStats() {
        // F1.5/F1.2 guard: solo correr cuando el tab dashboard esté renderizado
        if (!document.getElementById('stats-pf')) return;

        const r = await apiFetch('/api/journal/stats', { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;
        const s = r.data.stats;
        const hasTrades = s.total > 0;

        // Profit Factor
        const pfEl = document.getElementById('stats-pf');
        const pfMetaEl = document.getElementById('stats-pf-meta');
        pfEl.textContent = hasTrades ? (s.profit_factor >= 99.99 ? '∞' : s.profit_factor.toFixed(2)) : '—';
        pfEl.classList.remove('pos', 'neg', 'muted');
        if (!hasTrades) pfEl.classList.add('muted');
        else if (s.profit_factor >= 1.5) pfEl.classList.add('pos');
        else if (s.profit_factor < 1) pfEl.classList.add('neg');
        pfMetaEl.textContent = hasTrades
            ? `Gross +$${s.gross_profit.toFixed(0)} / -$${s.gross_loss.toFixed(0)}`
            : 'Sin operaciones';

        // Expectativa
        const expEl = document.getElementById('stats-expect');
        expEl.textContent = hasTrades
            ? (s.expectancy >= 0 ? '+$' : '-$') + Math.abs(s.expectancy).toFixed(2)
            : '—';
        expEl.classList.remove('pos', 'neg', 'muted');
        if (!hasTrades) expEl.classList.add('muted');
        else expEl.classList.add(s.expectancy >= 0 ? 'pos' : 'neg');
        document.getElementById('stats-expect-meta').textContent = hasTrades
            ? 'por trade promedio'
            : '—';

        // Win Rate
        const wrEl = document.getElementById('stats-wr');
        wrEl.textContent = hasTrades ? s.win_rate.toFixed(1) + '%' : '—';
        wrEl.classList.remove('pos', 'neg', 'muted');
        if (!hasTrades) wrEl.classList.add('muted');
        else if (s.win_rate >= 50) wrEl.classList.add('pos');
        else wrEl.classList.add('neg');
        document.getElementById('stats-wr-meta').textContent = hasTrades
            ? `${s.wins}W / ${s.losses}L`
            : '—';

        // Avg Win
        document.getElementById('stats-avg-w').textContent = hasTrades && s.avg_win > 0
            ? '+$' + s.avg_win.toFixed(2)
            : '—';
        document.getElementById('stats-avg-w-meta').textContent = hasTrades
            ? `${s.wins} ops ganadoras`
            : '—';

        // Avg Loss
        document.getElementById('stats-avg-l').textContent = hasTrades && s.avg_loss > 0
            ? '-$' + s.avg_loss.toFixed(2)
            : '—';
        document.getElementById('stats-avg-l-meta').textContent = hasTrades
            ? `${s.losses} ops perdedoras`
            : '—';

        // Best/Worst/Total
        document.getElementById('stats-best').textContent = s.best_trade !== null
            ? '+$' + s.best_trade.toFixed(2)
            : '—';
        document.getElementById('stats-worst').textContent = s.worst_trade !== null
            ? '-$' + Math.abs(s.worst_trade).toFixed(2)
            : '—';
        const totalEl = document.getElementById('stats-total-pnl');
        totalEl.textContent = (s.total_pnl >= 0 ? '+' : '-$') + Math.abs(s.total_pnl).toFixed(2);
        totalEl.style.color = s.total_pnl >= 0 ? '#4ade80' : '#f87171';

        document.getElementById('stats-trade-count').textContent = s.total;
    }

    // ══════ F1.3 — Calendar state ══════
    let _CALstate = null;  // { year, month }
    function _nowYM() {
        const d = new Date();
        return { year: d.getFullYear(), month: d.getMonth() + 1 };
    }
    function _pad(n) { return n < 10 ? '0' + n : '' + n; }

    async function loadCalendarMonthly(year, month) {
        const grid = document.getElementById('cal-month-grid');
        if (!grid) return;
        const url = `/api/journal/calendar-monthly?year=${year}&month=${month}`;
        const r = await apiFetch(url, { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;

        _CALstate = { year: r.data.year, month: r.data.month_num };

        document.getElementById('cal-month-title').textContent =
            `${r.data.month_name} ${r.data.year}`;
        document.getElementById('cal-month-pnl').textContent = fmtUSD(r.data.summary.total_pnl);
        document.getElementById('cal-month-pnl').style.color =
            r.data.summary.total_pnl >= 0 ? '#4ade80' : '#f87171';
        document.getElementById('cal-month-trades').textContent = r.data.summary.trade_count;
        document.getElementById('cal-month-wr').textContent = r.data.summary.win_rate;

        renderMonthGrid(r.data.year, r.data.month_num, r.data.days);
        renderMonthlyPnlChart(r.data.monthly_pnl);
    }

    function renderMonthGrid(year, month, daysByDate) {
        const grid = document.getElementById('cal-month-grid');
        const dayMap = Object.fromEntries(daysByDate.map(d => [d.date, d]));
        const headers = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
        const headerHtml = headers.map(h =>
            `<div class="cal-month-day-header">${h}</div>`
        ).join('');

        const firstOfMonth = new Date(year, month - 1, 1);
        // ISO weekday: Mon=1..Sun=7 → array index: Mon=0..Sun=6
        const firstIsoWeekday = firstOfMonth.getDay() === 0 ? 7 : firstOfMonth.getDay();
        const offsetCells = firstIsoWeekday - 1;
        const daysInMonth = new Date(year, month, 0).getDate();
        const daysInPrevMonth = new Date(year, month - 1, 0).getDate();
        const totalCells = Math.ceil((offsetCells + daysInMonth) / 7) * 7;

        const today = new Date();
        const todayIso = `${today.getFullYear()}-${_pad(today.getMonth() + 1)}-${_pad(today.getDate())}`;

        let bodyHtml = '';
        for (let i = 0; i < totalCells; i++) {
            let cellYear = year, cellMonth = month;
            let cellNum;
            let outside = false;
            const dayIndex = i - offsetCells + 1;
            if (dayIndex < 1) {
                // previous month
                cellMonth = month === 1 ? 12 : month - 1;
                cellYear  = month === 1 ? year - 1 : year;
                cellNum = daysInPrevMonth + dayIndex;
                outside = true;
            } else if (dayIndex > daysInMonth) {
                // next month
                cellMonth = month === 12 ? 1 : month + 1;
                cellYear  = month === 12 ? year + 1 : year;
                cellNum = dayIndex - daysInMonth;
                outside = true;
            } else {
                cellNum = dayIndex;
            }
            const isoDate = `${cellYear}-${_pad(cellMonth)}-${_pad(cellNum)}`;
            const dayData = !outside ? dayMap[isoDate] : null;
            const isToday = !outside && isoDate === todayIso;

            const trades = dayData?.trade_count || 0;
            const pnl = dayData?.pnl || 0;
            const wins = dayData?.wins || 0;
            const losses = dayData?.losses || 0;
            const hasOpen = dayData?.has_open || false;

            let variant = '';
            if (trades > 0) {
                if (wins > 0 && losses === 0 && !hasOpen) variant = 'wins';
                else if (losses > 0 && wins === 0 && !hasOpen) variant = 'losses';
                else if (hasOpen) variant = 'has-open';
                else variant = 'mixed';
            }

            const pnlClass = pnl > 0 ? 'pos' : (pnl < 0 ? 'neg' : 'zero');
            const pnlSign = pnl > 0 ? '+' : '';
            const pnlTxt = trades === 0 ? '' : `${pnlSign}$${Math.abs(pnl).toFixed(0)}`;
            const countTxt = trades === 0 ? '' : `${trades} op${trades>1?'s':''}`;

            bodyHtml += `
                <div class="cal-month-day ${outside ? 'outside' : ''} ${isToday ? 'today' : ''} ${variant}"
                     data-date="${isoDate}"
                     ${outside ? '' : 'role="button" tabindex="0"'}>
                    <div class="cal-month-day-num">${cellNum}</div>
                    <div>
                        <div class="cal-month-day-pnl ${pnlClass}">${pnlTxt}</div>
                        <div class="cal-month-day-count">${countTxt}</div>
                    </div>
                </div>
            `;
        }
        grid.innerHTML = headerHtml + bodyHtml;
    }

    function wireCalendarNav() {
        const prev = document.getElementById('cal-prev');
        const next = document.getElementById('cal-next');
        const today = document.getElementById('cal-today');
        if (!prev || !next || !today) return;
        prev.addEventListener('click', () => {
            const s = _CALstate || _nowYM();
            let m = s.month - 1, y = s.year;
            if (m < 1) { m = 12; y--; }
            loadCalendarMonthly(y, m);
        });
        next.addEventListener('click', () => {
            const s = _CALstate || _nowYM();
            let m = s.month + 1, y = s.year;
            if (m > 12) { m = 1; y++; }
            loadCalendarMonthly(y, m);
        });
        today.addEventListener('click', () => {
            const t = _nowYM();
            loadCalendarMonthly(t.year, t.month);
        });
    }

    function wireCalendarClicks() {
        const grid = document.getElementById('cal-month-grid');
        if (!grid) return;
        grid.addEventListener('click', e => {
            const cell = e.target.closest('.cal-month-day');
            if (!cell || cell.classList.contains('outside')) return;
            openCalDayModal(cell.dataset.date);
        });
        grid.addEventListener('keydown', e => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            const cell = e.target.closest('.cal-month-day');
            if (!cell || cell.classList.contains('outside')) return;
            e.preventDefault();
            openCalDayModal(cell.dataset.date);
        });
    }

    async function openCalDayModal(isoDate) {
        // Re-fetch from /api/journal/calendar-monthly for the month, then filter day
        if (!_CALstate) {
            const t = _nowYM();
            _CALstate = t;
        }
        const r = await apiFetch(`/api/journal/calendar-monthly?year=${_CALstate.year}&month=${_CALstate.month}`, { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;
        const dayData = (r.data.days || []).find(d => d.date === isoDate);

        const titleEl = document.getElementById('cal-day-modal-title');
        titleEl.textContent = `Detalle · ${formatLongDate(isoDate)}`;

        const body = document.getElementById('cal-day-modal-body');
        if (!dayData || !dayData.trades || dayData.trades.length === 0) {
            body.innerHTML = '<p class="cal-trades-empty">No hay trades registrados en este día.</p>';
        } else {
            const total = dayData.pnl;
            const totalClass = total >= 0 ? 'pnl-pos' : 'pnl-neg';
            const totalSign = total >= 0 ? '+' : '';
            body.innerHTML = `
                <div class="flex items-center gap-3 mb-3 text-sm">
                    <span>Total del día: <strong class="${totalClass}">${totalSign}$${Math.abs(total).toFixed(2)}</strong></span>
                    <span class="text-[var(--outline-elev)]">·</span>
                    <span>${dayData.trade_count} operacion${dayData.trade_count>1?'es':''}</span>
                    <span class="text-[var(--outline-elev)]">·</span>
                    <span><span class="text-green-400">${dayData.wins}W</span> / <span class="text-red-400">${dayData.losses}L</span>${dayData.breakeven ? ` / <span class="text-[var(--outline-elev)]">${dayData.breakeven}BE</span>` : ''}${dayData.has_open ? ` / <span class="text-violet-400">abiertas</span>` : ''}</span>
                </div>
                <table class="cal-trades-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Activo</th>
                            <th>Dir</th>
                            <th>Result</th>
                            <th class="text-right">P&L</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${dayData.trades.map(t => {
                            const date = new Date(t.date);
                            const hora = `${_pad(date.getHours())}:${_pad(date.getMinutes())}`;
                            const pnlCls = t.pnl >= 0 ? 'pnl-pos' : 'pnl-neg';
                            const pnlSign = t.pnl >= 0 ? '+' : '';
                            return `
                                <tr>
                                    <td class="font-mono text-xs text-[var(--outline-elev)]">${hora}</td>
                                    <td class="font-semibold">${escapeHtml(t.asset || '')}</td>
                                    <td><span class="px-1.5 py-0.5 rounded text-xs ${t.direction === 'BUY' ? 'bg-green-500/15 text-green-300' : 'bg-red-500/15 text-red-300'}">${escapeHtml(t.direction || '')}</span></td>
                                    <td><span class="px-1.5 py-0.5 rounded text-xs ${t.result === 'WIN' ? 'bg-green-500/20 text-green-300' : t.result === 'LOSS' ? 'bg-red-500/20 text-red-300' : 'bg-white/10 text-white/60'}">${escapeHtml(t.result || '')}</span></td>
                                    <td class="text-right ${pnlCls}">${pnlSign}$${Math.abs(t.pnl).toFixed(2)}</td>
                                </tr>
                            `;
                        }).join('')}
                    </tbody>
                </table>
            `;
        }
        const modal = document.getElementById('cal-day-modal');
        modal.style.display = 'flex';
    }

    function wireCalDayModal() {
        const modal = document.getElementById('cal-day-modal');
        if (!modal) return;
        modal.addEventListener('click', e => {
            if (e.target === e.currentTarget) closeCalDayModal();
        });
        document.querySelectorAll('[data-action="close-cal-day"]').forEach(b => {
            b.addEventListener('click', closeCalDayModal);
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && modal.style.display === 'flex') closeCalDayModal();
        });
    }
    function closeCalDayModal() {
        const modal = document.getElementById('cal-day-modal');
        if (modal) modal.style.display = 'none';
    }

    function formatLongDate(isoDate) {
        const [y, m, d] = isoDate.split('-').map(Number);
        const date = new Date(y, m - 1, d);
        const dias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
        const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        return `${dias[date.getDay()]} ${d} de ${meses[date.getMonth()]}, ${y}`;
    }

    // ══════ F1.4 — P&L Mensual Bar Chart (bonus, mismo endpoint) ══════
    function renderMonthlyPnlChart(rows) {
        const wrap = document.getElementById('monthly-pnl-chart');
        if (!wrap) return;
        if (!rows || rows.length === 0) {
            wrap.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8 text-xs">Sin datos.</p>';
            return;
        }
        const W = 720, H = 260;
        const padT = 20, padB = 36, padL = 56, padR = 16;
        const chartW = W - padL - padR;
        const chartH = H - padT - padB;
        const n = rows.length;
        const barGap = 0.25;
        const barW = (chartW / n) * (1 - barGap);

        const vals = rows.map(r => r.pnl);
        const maxAbs = Math.max(...vals.map(Math.abs), 1);
        const yMax = Math.ceil(maxAbs * 1.1);
        const yMin = -yMax;
        const yRange = yMax - yMin;
        const zeroY = padT + chartH * (yMax / yRange);

        const xFor = (i) => padL + (i + 0.5) * (chartW / n) - barW / 2;
        const yFor = (v) => padT + chartH * ((yMax - v) / yRange);

        const monthLabels = ['ENE','FEB','MAR','ABR','MAY','JUN','JUL','AGO','SEP','OCT','NOV','DIC'];
        const bars = rows.map((r, i) => {
            const x = xFor(i);
            const y = yFor(r.pnl);
            const h = Math.abs(zeroY - y);
            const color = r.pnl >= 0 ? '#4ade80' : '#f87171';
            return `
                <rect class="monthly-bar" x="${x.toFixed(1)}" y="${Math.min(y, zeroY).toFixed(1)}" width="${barW.toFixed(1)}" height="${h.toFixed(1)}" fill="${color}" stroke="#0e0a18" stroke-width="1" rx="3" data-month="${r.month}" />
                <text class="monthly-pnl-axis-text" x="${(x + barW/2).toFixed(1)}" y="${(padT + chartH + 16).toFixed(1)}" text-anchor="middle">${monthLabels[parseInt(r.month.slice(5), 10) - 1]}</text>
            `;
        }).join('');

        // Y-axis ticks
        const ticks = [-yMax, -yMax/2, 0, yMax/2, yMax].map(v => {
            const y = yFor(v);
            return `
                <line x1="${padL}" x2="${W-padR}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                <text class="monthly-pnl-axis-text" x="${padL-8}" y="${(y+4).toFixed(1)}" text-anchor="end">${fmtUSD(v)}</text>
            `;
        }).join('');

        wrap.innerHTML = `
            <svg class="monthly-pnl-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-label="P&L mensual últimos 6 meses">
                ${ticks}
                <line x1="${padL}" x2="${W-padR}" y1="${zeroY.toFixed(1)}" y2="${zeroY.toFixed(1)}" stroke="rgba(255,255,255,0.25)" stroke-dasharray="4 4" stroke-width="1" />
                <text class="monthly-pnl-axis-text" x="${W-padR}" y="${(zeroY-4).toFixed(1)}" text-anchor="end">$0</text>
                ${bars}
            </svg>
        `;

        // source line
        const tot = vals.reduce((a, b) => a + b, 0);
        const sign = tot >= 0 ? '+' : '';
        const srcEl = document.getElementById('monthly-pnl-source');
        if (srcEl) srcEl.textContent = `6m: ${sign}${fmtUSD(tot)} · ${rows.reduce((a, r) => a + r.trade_count, 0)} ops`;
    }

    </script>
