{% extends 'shell.html.twig' %}

{% block title %}Dashboard · T.N.S.V.T{% endblock %}

{% block topbar_title %}Command Center{% endblock %}
{% block topbar_subtitle %}Divine synchronization active.{% endblock %}

{# ═══ F1.5 — URL ?tab= state ═══ #}
{% set tab = app.request.query.get('tab', 'dashboard') %}
{% set tabs = {
    'dashboard':    {label: 'DASHBOARD',     icon: 'dashboard',       desc: 'Tu centro de control'},
    'registrar':    {label: 'REGISTRAR',     icon: 'edit_note',       desc: 'Asentar una operación cerrada'},
    'trade_log':    {label: 'TRADE LOG',     icon: 'list_alt',        desc: 'Historial completo de operaciones'},
    'estadisticas': {label: 'ESTADÍSTICAS',  icon: 'insights',        desc: 'Equity, calendario y métricas'},
} %}
{% set valid_tabs = tabs|keys %}

{% block stylesheets %}
{# Styles moved to assets/styles/components/dashboard.css #}
{% endblock %}

{% block content %}
{# WebGL Background #}
<script src="{{ asset('js/modules/webgl-background.js') }}" defer></script>

<div class="max-w-7xl mx-auto dashboard-grid">

    {# ══════ F1.5 — Hero ══════ #}
    <section class="dashboard-hero" aria-labelledby="hero-title">
        <h1 id="hero-title" class="hero-title text-cinzel-display">EL CRISTO ÍNTEGRO</h1>
        <p class="hero-sub">Edición Completa — Trading Neuro-Spiritual Value Theory (2026)</p>
        <div class="hero-divider" aria-hidden="true"></div>
    </section>

    {# ══════ F1.5 — Sticky Tabs ══════ #}
    <div class="dashboard-tabs-wrap">
        <nav class="dashboard-tabs" id="dashboard-tabs-nav" aria-label="Dashboard tabs">
            {% for key, t in tabs %}
                <a href="?tab={{ key }}"
                   class="dashboard-tab {{ tab == key ? 'active' : '' }}"
                   data-tab="{{ key }}"
                   {{ tab == key ? 'aria-current="page"' : '' }}>
                    <span class="material-symbols-elev" aria-hidden="true">{{ t.icon }}</span>
                    <span class="tab-text">{{ t.label }}</span>
                </a>
            {% endfor %}
        </nav>
    </div>

    {# ══════ F1.5 — Tab Routing (default: dashboard) ══════ #}
    {% if tab == 'dashboard' %}

    {# ══════ F1.1 — Equity Curve (Fila 1) ══════ #}
    <section class="glass-card-elev p-6 equity-curve-card">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-elev text-[var(--gold-elev)]">timeline</span>
                <span class="text-cinzel-display text-base tracking-wider">EQUITY CURVE</span>
            </h3>
            <div class="ec-range-tabs" id="ec-range-tabs" role="tablist" aria-label="Range">
                <button type="button" class="ec-tab active" data-range="all" role="tab" aria-selected="true">Todo</button>
                <button type="button" class="ec-tab" data-range="30d" role="tab" aria-selected="false">30d</button>
                <button type="button" class="ec-tab" data-range="7d" role="tab" aria-selected="false">7d</button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div class="ec-stat">
                <span class="ec-stat-label">Balance actual</span>
                <span class="ec-stat-value" id="ec-balance">$0</span>
                <span class="ec-stat-meta" id="ec-balance-meta">—</span>
            </div>
            <div class="ec-stat">
                <span class="ec-stat-label">Total return</span>
                <span class="ec-stat-value" id="ec-return">0.00%</span>
                <span class="ec-stat-meta" id="ec-return-meta">—</span>
            </div>
            <div class="ec-stat">
                <span class="ec-stat-label">Max drawdown</span>
                <span class="ec-stat-value" id="ec-drawdown">0.00%</span>
                <span class="ec-stat-meta" id="ec-drawdown-meta">—</span>
            </div>
        </div>

        <svg id="ec-chart" viewBox="0 0 1000 280" preserveAspectRatio="none" class="w-full h-72" aria-label="Equity curve">
            <defs>
                <linearGradient id="ec-fill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="rgba(242, 202, 80, 0.35)" />
                    <stop offset="100%" stop-color="rgba(242, 202, 80, 0)" />
                </linearGradient>
            </defs>
            <text id="ec-loading" x="500" y="140" fill="rgba(255,255,255,0.4)" font-size="14" text-anchor="middle" font-family="Space Grotesk">Cargando curva...</text>
        </svg>

        <div id="ec-tooltip" class="ec-tooltip" hidden></div>

        <div id="ec-empty" class="text-center text-[var(--outline-elev)] py-8" hidden>
            <span class="material-symbols-elev text-4xl block mb-2 opacity-50">timeline</span>
            Aún no hay operaciones registradas.
            <a href="?tab=registrar" class="text-[var(--gold-elev)] hover:underline ml-1">Asentá la primera →</a>
        </div>

        <div class="ec-legend mt-3">
            <span><span class="ec-legend-dot" style="background: #4ade80"></span>Win</span>
            <span><span class="ec-legend-dot" style="background: #f87171"></span>Loss</span>
            <span><span class="ec-legend-dot" style="background: rgba(255,255,255,0.4)"></span>BE</span>
            <span class="ml-auto" id="ec-source">—</span>
        </div>
    </section>

    {# ══════ F1.3 — Calendario Mensual (Fila 2, izquierda) ══════ #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="glass-card-elev p-6 calendar-monthly-card">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-elev text-[var(--gold-elev)]">calendar_month</span>
                <span class="text-cinzel-display text-base tracking-wider">CALENDARIO</span>
            </h3>
            <div class="flex items-center gap-2" id="cal-month-nav" role="group" aria-label="Mes">
                <button type="button" class="cal-nav-btn" id="cal-prev" aria-label="Mes anterior">
                    <span class="material-symbols-elev text-base">chevron_left</span>
                </button>
                <span id="cal-month-title" class="text-sm font-semibold min-w-[140px] text-center">—</span>
                <button type="button" class="cal-nav-btn" id="cal-next" aria-label="Mes siguiente">
                    <span class="material-symbols-elev text-base">chevron_right</span>
                </button>
                <button type="button" class="cal-today-btn" id="cal-today">Hoy</button>
            </div>
        </div>

        <div class="flex items-center gap-4 mb-3 text-xs text-[var(--outline-elev)]">
            <span>Total mes: <strong id="cal-month-pnl" class="text-[var(--on-surface-elev)]">$0</strong></span>
            <span><span id="cal-month-trades">0</span> trades</span>
            <span><span id="cal-month-wr">0</span>% WR</span>
        </div>

        <div class="cal-month-grid" id="cal-month-grid" aria-label="Calendario de operaciones">
            <!-- day headers + day cells injected via JS -->
            <div class="col-span-7 text-center text-[var(--outline-elev)] py-6 text-xs loading-pulse">Cargando calendario...</div>
        </div>

        <div class="cal-legend mt-3">
            <span><span class="ec-legend-dot" style="background: #4ade80"></span>Día ganador</span>
            <span><span class="ec-legend-dot" style="background: #f87171"></span>Día perdedor</span>
            <span><span class="ec-legend-dot" style="background: #fbbf24"></span>Mixto</span>
            <span><span class="ec-legend-dot" style="background: #8a3cff"></span>Abierta</span>
        </div>
    </section>

    {# ══════ F1.4 — P&L Mensual Bar Chart (Fila 2, derecha — F1.3 insert) ══════ #}
    <section class="glass-card-elev p-6 monthly-pnl-card" id="monthly-pnl-card">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-elev text-[var(--gold-elev)]">bar_chart</span>
                <span class="text-cinzel-display text-base tracking-wider">P&L MENSUAL</span>
            </h3>
            <span class="text-xs text-[var(--outline-elev)]">últimos 6 meses</span>
        </div>
        <div id="monthly-pnl-chart" class="w-full" style="min-height: 240px;">
            <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse text-xs">Cargando P&L mensual...</p>
        </div>
        <div class="cal-legend mt-3">
            <span><span class="ec-legend-dot" style="background: #4ade80"></span>Positivo</span>
            <span><span class="ec-legend-dot" style="background: #f87171"></span>Negativo</span>
            <span class="ml-auto" id="monthly-pnl-source">—</span>
        </div>
    </section>
    </div>

    {# Day detail modal (F1.3) #}
    <div id="cal-day-modal" class="cal-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="cal-day-modal-title">
        <div class="cal-modal-content">
            <div class="cal-modal-header">
                <h2 id="cal-day-modal-title" class="text-lg font-semibold">Detalle</h2>
                <button type="button" class="modal-close" data-action="close-cal-day" aria-label="Cerrar">
                    <span class="material-symbols-elev">close</span>
                </button>
            </div>
            <div id="cal-day-modal-body" class="cal-modal-body">
                <!-- table injected via JS -->
            </div>
        </div>
    </div>

{# Hero Metrics Row - 4 KPI Cards #}
    {# ══════ F1.2 — Stats (reemplaza 4-KPI placeholder de V1) ══════ #}
    <section class="glass-card-elev p-6 stats-row" aria-label="Estadísticas de trading">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-elev text-[var(--gold-elev)]">analytics</span>
                <span class="text-cinzel-display text-base tracking-wider">ESTADÍSTICAS</span>
            </h3>
            <span class="text-xs text-[var(--outline-elev)]">
                <span id="stats-trade-count">0</span> trades en total
            </span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3" id="stats-grid">
            <div class="kpi-card" data-stat="pf">
                <span class="kpi-label">Profit Factor</span>
                <p class="kpi-value" id="stats-pf">—</p>
                <p class="kpi-meta" id="stats-pf-meta">—</p>
            </div>
            <div class="kpi-card" data-stat="expect">
                <span class="kpi-label">Expectativa</span>
                <p class="kpi-value" id="stats-expect">—</p>
                <p class="kpi-meta" id="stats-expect-meta">—</p>
            </div>
            <div class="kpi-card" data-stat="wr">
                <span class="kpi-label">Win Rate</span>
                <p class="kpi-value" id="stats-wr">—</p>
                <p class="kpi-meta" id="stats-wr-meta">—</p>
            </div>
            <div class="kpi-card" data-stat="avg-w">
                <span class="kpi-label">Avg Win</span>
                <p class="kpi-value text-green-400" id="stats-avg-w">—</p>
                <p class="kpi-meta" id="stats-avg-w-meta">—</p>
            </div>
            <div class="kpi-card" data-stat="avg-l">
                <span class="kpi-label">Avg Loss</span>
                <p class="kpi-value text-red-400" id="stats-avg-l">—</p>
                <p class="kpi-meta" id="stats-avg-l-meta">—</p>
            </div>
        </div>
        <div class="mt-4 pt-4 border-t border-[var(--outline-variant-elev)] grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
            <div>
                <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Mejor trade</span>
                <p class="text-green-400 font-bold text-lg" id="stats-best">—</p>
            </div>
            <div>
                <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Peor trade</span>
                <p class="text-red-400 font-bold text-lg" id="stats-worst">—</p>
            </div>
            <div>
                <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Total P&L</span>
                <p class="font-bold text-lg" id="stats-total-pnl">—</p>
            </div>
        </div>
    </section>

        {# ─── Guardian Widget (Phase 3) ─── #}
        <section class="glass-card-elev p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">shield_person</span>
                    Guardian
                    <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--outline-elev)] font-normal">Risk & Discipline</span>
                </h3>
                <a href="/sanctum/guardian" class="text-xs text-[var(--gold-elev)] hover:underline flex items-center gap-1">
                    Ver completo
                    <span class="material-symbols-elev" style="font-size: 0.875rem;">arrow_forward</span>
                </a>
            </div>

            <div id="guardian-widget" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {# ── Score ── #}
                <div class="text-center md:border-r border-[var(--outline-variant-elev)] md:pr-6">
                    <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider mb-2">Discipline</p>
                    <div id="gw-score" class="text-5xl font-bold" style="color: var(--gold-elev); line-height: 1;">--</div>
                    <div class="text-xs text-[var(--outline-elev)] mt-1">/ 100</div>
                    <div id="gw-tier" class="mt-2 inline-block text-xs px-2 py-0.5 rounded-full border" style="border-color: var(--outline-variant-elev); color: var(--outline-elev);">—</div>
                </div>

                {# ── Top signals ── #}
                <div class="md:col-span-2">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Señales activas</p>
                        <span id="gw-signal-count" class="text-xs text-[var(--outline-elev)]">0</span>
                    </div>
                    <div id="gw-signals" class="space-y-2">
                        <p class="text-center text-[var(--outline-elev)] py-2 loading-pulse text-xs">Cargando...</p>
                    </div>
                </div>
            </div>
        </section>

        {# Recent Signals + Task Sovereignty #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="glass-card-elev p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">auto_awesome</span>
                        Task Sovereignty
                    </h3>
                    <div class="flex gap-2">
                        <button id="quick-add-task" class="btn-elev-secondary text-xs">
                            <span class="material-symbols-elev align-middle text-sm">add</span>
                            Nueva
                        </button>
                        <a href="/sanctum/tasks" class="text-xs text-[var(--gold-elev)] hover:underline">Ver todos →</a>
                    </div>
                </div>
                <div id="task-list" class="space-y-2">
                    <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando...</p>
                </div>
            </div>

            <div class="glass-card-elev p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">timeline</span>
                        Recent Signals
                    </h3>
                    <a href="/sanctum/audit" class="text-xs text-[var(--gold-elev)] hover:underline">Ver audit log →</a>
                </div>
                <div id="signal-list" class="space-y-2 max-h-72 overflow-y-auto pr-2">
                    <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando actividad reciente...</p>
                </div>
            </div>
        </div>

        {# Educational Mastery - Course Cards #}
        <section class="mb-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">school</span>
                    Educational Mastery
                </h3>
                <a href="/sanctum/education" class="text-xs text-[var(--gold-elev)] hover:underline">Ver todos →</a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="course-card-elev">
                    <div class="flex items-center justify-between mb-3">
                        <span class="material-symbols-elev text-[var(--gold-elev)] text-2xl">psychology</span>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--gold-elev)] text-black font-bold">75%</span>
                    </div>
                    <h4 class="text-base font-semibold text-[var(--on-surface-elev)] mb-1">Mastering Risk</h4>
                    <p class="text-xs text-[var(--outline-elev)] mb-3">12 módulos · Position sizing avanzado</p>
                    <div class="course-progress-bar">
                        <div class="course-progress-fill" style="width: 75%;"></div>
                    </div>
                </div>
                <div class="course-card-elev">
                    <div class="flex items-center justify-between mb-3">
                        <span class="material-symbols-elev text-[var(--gold-elev)] text-2xl">candlestick_chart</span>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--outline-elev)] font-bold">42%</span>
                    </div>
                    <h4 class="text-base font-semibold text-[var(--on-surface-elev)] mb-1">Price Action</h4>
                    <p class="text-xs text-[var(--outline-elev)] mb-3">8 módulos · Estructura de mercado</p>
                    <div class="course-progress-bar">
                        <div class="course-progress-fill" style="width: 42%;"></div>
                    </div>
                </div>
                <div class="course-card-elev">
                    <div class="flex items-center justify-between mb-3">
                        <span class="material-symbols-elev text-[var(--gold-elev)] text-2xl">visibility</span>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--outline-elev)] font-bold">18%</span>
                    </div>
                    <h4 class="text-base font-semibold text-[var(--on-surface-elev)] mb-1">Macro Vision</h4>
                    <p class="text-xs text-[var(--outline-elev)] mb-3">6 módulos · Contexto fundamental</p>
                    <div class="course-progress-bar">
                        <div class="course-progress-fill" style="width: 18%;"></div>
                    </div>
                </div>
            </div>
        </section>

    {# ══════ F1.5 — Stub panels for non-default tabs ══════ #}
    {% elseif tab == 'registrar' %}
        <div class="tab-panel-stub">
            <span class="material-symbols-elev" aria-hidden="true">edit_note</span>
            <h2>REGISTRAR OPERACIÓN</h2>
            <p><strong>Fase 2 ✅</strong> · Abrí el formulario completo para asentar una operación cerrada con todos los detalles: activo, dirección, precios, P&L y notas.</p>
            <a href="/journal/new" class="btn-elev-primary">Asentar operación nueva →</a>
        </div>
    {% elseif tab == 'trade_log' %}
        <div class="tab-panel-stub">
            <span class="material-symbols-elev" aria-hidden="true">list_alt</span>
            <h2>TRADE LOG</h2>
            <p>Disponible en <strong>Fase 2</strong>. Historial completo filtrable de tus operaciones con búsqueda, ordenamiento y exportación CSV.</p>
            <a href="/journal" class="btn-elev-primary">Ver Journal completo</a>
        </div>
    {% elseif tab == 'estadisticas' %}
        <div class="tab-panel-stub">
            <span class="material-symbols-elev" aria-hidden="true">insights</span>
            <h2>ESTADÍSTICAS</h2>
            <p>Próximamente en <strong>F1.1 – F1.4</strong>: Equity Curve SVG · Calendario Mensual · P&L Mensual · Profit Factor · Expectativa · Win Rate.</p>
            <a href="/api/journal/drawdown" class="btn-elev-primary" target="_blank" rel="noopener">Ver preview (JSON)</a>
        </div>
    {% else %}
        <div class="tab-panel-stub">
            <span class="material-symbols-elev" aria-hidden="true">error</span>
            <h2>TAB NO ENCONTRADA</h2>
            <p>Solicitud inválida. Volvé al <a href="?tab=dashboard" class="text-[var(--gold-elev)] hover:underline">Dashboard</a>.</p>
        </div>
    {% endif %}
    </div>

    {# Create Task Modal #}
    <div id="create-task-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="text-xl font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">task_alt</span>
                    Nueva Tarea
                </h2>
                <button class="modal-close" data-action="close-create-task">
                    <span class="material-symbols-elev">close</span>
                </button>
            </div>
            <form id="create-task-form" class="modal-body">
                <div class="form-group">
                    <label class="form-label">Título *</label>
                    <input id="task-title" name="title" type="text" required maxlength="255" placeholder="Ej: Auditar journal del usuario X" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label">Descripción</label>
                    <textarea id="task-description" name="description" rows="3" placeholder="Detalles opcionales..." class="form-input"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="form-label">Orden</label>
                        <input id="task-orden" name="orden" type="number" min="0" value="0" class="form-input" />
                    </div>
                    <label class="form-group flex items-center gap-2 pt-6">
                        <input id="task-active" name="active" type="checkbox" checked />
                        <span>Activa</span>
                    </label>
                </div>
                <p id="create-task-error" class="text-red-400 text-sm hidden"></p>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" data-action="close-create-task">Cancelar</button>
                    <button type="submit" class="btn-primary">Crear Tarea</button>
                </div>
            </form>
        </div>
    </div>

    {# Styles moved to assets/styles/components/dashboard.css #}

    <script>
    async function loadDashboard() {
        // F1.5: only run when the dashboard tab is rendered
