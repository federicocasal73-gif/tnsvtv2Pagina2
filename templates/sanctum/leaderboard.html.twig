{% extends 'shell.html.twig' %}

{% block title %}Leaderboard · T.N.S.V.T{% endblock %}

{% block topbar_title %}Leaderboard{% endblock %}
{% block topbar_subtitle %}Ranking de traders del Reino.{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto"
     data-controller="leaderboard">
    <div class="grid grid-cols-3 gap-3 mb-6"
         data-leaderboard-target="podium">
        <p class="text-center text-[var(--outline-elev)] py-8 col-span-3">Cargando...</p>
    </div>

    <div class="glass-card-elev p-4">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-3">Ranking Completo</h3>
        <div class="space-y-2"
             data-leaderboard-target="list">
            <p class="text-center text-[var(--outline-elev)] py-8">Cargando leaderboard...</p>
        </div>
    </div>
</div>

{% endblock %}