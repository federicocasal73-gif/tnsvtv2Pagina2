{% extends 'shell.html.twig' %}

{% block title %}Leaderboard · T.N.S.V.T{% endblock %}

{% block topbar_title %}Leaderboard{% endblock %}
{% block topbar_subtitle %}Ranking de traders del Reino.{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto"
     data-controller="leaderboard">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-1 lb-filters" role="tablist" aria-label="Periodo">
            <button type="button" class="lb-filter is-active" data-period="all" aria-pressed="true">Total</button>
            <button type="button" class="lb-filter" data-period="month" aria-pressed="false" disabled title="Próximamente">Mes</button>
            <button type="button" class="lb-filter" data-period="week"  aria-pressed="false" disabled title="Próximamente">Semana</button>
        </div>
        <label class="lb-metric-pick">
            <span class="kpi-label">Ordenar por</span>
            <select class="form-input"
                    data-action="change->leaderboard#setMetric"
                    data-leaderboard-target="metricSelect">
                <option value="total_pnl">P&L total</option>
                <option value="win_rate">Win rate</option>
                <option value="total_trades">Cantidad de trades</option>
                <option value="profit_factor">Profit factor</option>
                <option value="best_trade">Mejor trade</option>
            </select>
        </label>
    </div>

    <div class="grid grid-cols-3 gap-3 mb-6"
         data-leaderboard-target="podium">
        <p class="text-center text-[var(--outline-elev)] py-8 col-span-3">Cargando...</p>
    </div>

    <div class="glass-card-elev p-4">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-3">Ranking Completo</h3>
        <div class="space-y-2"
             data-leaderboard-target="list">
            <p class="text-center text-[var(--outline-elev)] py-8">Cargando leaderboard...</p>
        </div>
    </div>

    {# ─── L72: Your-rank banner (highlights your position) ─── #}
    <div class="lb-your-rank" id="lb-your-rank" hidden>
        <span class="material-symbols-elev icon-size-sm" aria-hidden="true">military_tech</span>
        <span class="lb-your-rank-label">Tu posición</span>
        <strong class="lb-your-rank-pos" data-leaderboard-target="yourRankPos">—</strong>
        <span class="lb-your-rank-sep">·</span>
        <span class="lb-your-rank-name" data-leaderboard-target="yourRankName">—</span>
        <span class="lb-your-rank-meta">
            <span data-leaderboard-target="yourRankMetric">—</span>
        </span>
    </div>
</div>

{% endblock %}