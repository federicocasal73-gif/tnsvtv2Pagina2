{% extends 'shell.html.twig' %}

{% block title %}Monitoring · T.N.S.V.T{% endblock %}

{% block topbar_title %}Monitoring · System Status{% endblock %}
{% block topbar_subtitle %}Server, DB, PHP, Opcache, Security & Business metrics{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto" data-controller="monitoring">
        {# Toolbar #}
        <div class="glass-card-elev p-4 mb-6 flex items-center justify-between">
            <div>
                <p class="text-sm text-[var(--on-surface-elev)]">Estado del sistema en tiempo real</p>
                <p class="text-xs text-[var(--outline-elev)]">Refresh: <span id="last-refresh">--</span> · Auto-refresh cada 30s</p>
            </div>
            <button id="refresh-btn" class="btn-elev-secondary text-xs">
                <span class="material-symbols-elev align-middle text-sm">refresh</span>
                Refrescar
            </button>
        </div>

        {# Loading state #}
        <div id="status-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <p class="col-span-full text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando métricas del sistema...</p>
        </div>
    </div>
{% endblock %}