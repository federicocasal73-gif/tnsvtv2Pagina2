{% extends 'shell.html.twig' %}

{% block title %}Wallet · T.N.S.V.T{% endblock %}

{% block topbar_title %}Mi Wallet{% endblock %}
{% block topbar_subtitle %}Tu saldo y transacciones.{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto"
     data-controller="wallet">
    <div class="glass-card-elev p-6 mb-4 text-center">
        <div class="text-sm text-[var(--outline-elev)] mb-1">Saldo Disponible</div>
        <div class="text-3xl font-bold text-[var(--gold-elev)]"
             data-wallet-target="balance">—</div>
    </div>

    <div class="glass-card-elev p-4">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-3">Últimas Transacciones</h3>
        <div class="space-y-2"
             data-wallet-target="transactions">
            <p class="text-center text-[var(--outline-elev)] py-8">Cargando transacciones...</p>
        </div>
    </div>
</div>

{% endblock %}