{% extends 'shell.html.twig' %}

{% block title %}Wallet · T.N.S.V.T{% endblock %}

{% block topbar_title %}Mi Wallet{% endblock %}
{% block topbar_subtitle %}Tu saldo y transacciones.{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto"
     data-controller="wallet">
    <div class="glass-card-elev p-6 mb-4 text-center">
        <div class="text-sm text-[var(--outline-elev)] mb-1">Saldo Disponible</div>
        <div class="text-3xl font-bold text-[var(--gold-elev)]"
             data-wallet-target="balance">—</div>
    </div>

    <div class="glass-card-elev p-4">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-3">Últimas Transacciones</h3>
        <div class="space-y-2"
             data-wallet-target="transactions">
            <p class="text-center text-[var(--outline-elev)] py-8">Cargando transacciones...</p>
        </div>
    </div>
</div>

<style>
.tx-item { display:flex; align-items:center; gap:0.75rem; padding:0.5rem 0.75rem; border-radius:0.5rem; }
.tx-item:hover { background:var(--glass-bg-elev); }
.tx-icon { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.875rem; flex-shrink:0; }
.tx-icon.credit { background:rgba(52,211,153,0.2); color:#34d399; }
.tx-icon.debit { background:rgba(248,113,113,0.2); color:#f87171; }
.tx-info { flex:1; }
.tx-desc { font-size:0.875rem; font-weight:500; }
.tx-date { font-size:0.7rem; color:var(--outline-elev); }
.tx-amount { font-weight:600; font-size:0.875rem; }
.tx-amount.credit { color:#34d399; }
.tx-amount.debit { color:#f87171; }
</style>
{% endblock %}