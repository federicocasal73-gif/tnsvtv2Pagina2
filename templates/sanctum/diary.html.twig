{% extends 'shell.html.twig' %}

{% block title %}El Cuaderno · T.N.S.V.T{% endblock %}

{% block topbar_title %}El Cuaderno{% endblock %}
{% block topbar_subtitle %}"Lo que escribes, queda cifrado — solo vos lo leés."{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="diary-wrap">

    <div class="diary-header">
        <h1>EL CUADERNO</h1>
        <p>"Lo que escribes, queda cifrado — solo vos lo leés"</p>
    </div>

    <div id="diary-message" hidden></div>

    {# ══════ State 1: LOCKED ══════ #}
    <section id="diary-state-locked" class="diary-state" hidden>
        <div class="diary-state-locked">
            <div class="diary-lock-icon">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">lock</span>
            </div>
            <h2 class="diary-lock-title">El Cuaderno está cerrado</h2>
            <p class="diary-lock-sub" id="diary-lock-subtitle">
                Ingresá tu clave maestra para descifrar tus reflexiones.
            </p>
            <input id="diary-pass-input" type="password" class="diary-key-input"
                   placeholder="Clave maestra..." autocomplete="off" />
            <div class="diary-unlock-actions">
                <button type="button" class="diary-btn-primary" id="diary-unlock-btn">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock_open</span>
                    Desbloquear
                </button>
                <button type="button" class="diary-btn-secondary" id="diary-fingerprint-btn"
                        title="Huella biométrica (próxima iteración)">
                    <span class="material-symbols-outlined" style="font-size:1rem;">fingerprint</span>
                </button>
            </div>
            <p class="diary-lock-tip">
                <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">info</span>
                Si nunca configuraste una clave, ingresá una nueva (mínimo 8 caracteres).
                Esta clave cifra y descifra tus entradas — no se envía al servidor.
            </p>
        </div>
    </section>

    {# ══════ State 2: LIST ══════ #}
    <section id="diary-state-list" class="diary-state" hidden>
        <div class="diary-topbar">
            <div>
                <h2 class="text-cinzel-display" style="font-size:1.1rem;margin:0;">TUS REFLEXIONES</h2>
                <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider" id="diary-list-summary">— entradas cifradas</p>
            </div>
            <div class="flex gap-2">
                <button type="button" class="diary-btn-primary" id="diary-new-btn" style="font-size:0.8rem;padding:0.55rem 1rem;">
                    <span class="material-symbols-outlined" style="font-size:1rem;">edit</span>
                    Escribir nueva
                </button>
                <button type="button" class="diary-lock-btn" id="diary-lock-now-btn" title="Bloquear cuaderno">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock</span>
                    Bloquear
                </button>
            </div>
        </div>
        <div id="diary-entries-grid" class="diary-entries-grid"></div>
    </section>

    {# ══════ State 3: EMPTY ══════ #}
    <section id="diary-state-empty" class="diary-state" hidden>
        <div class="diary-state-empty">
            <div class="diary-empty-icon">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 0;">draw</span>
            </div>
            <h2 class="diary-lock-title">El Cuaderno está vacío</h2>
            <p class="diary-lock-sub">
                Tus reflexiones vivirán cifradas — solo vos las podés leer.
            </p>
            <button type="button" class="diary-btn-primary" id="diary-write-first-btn" style="margin-top:1.25rem;">
                <span class="material-symbols-outlined" style="font-size:1rem;">edit_note</span>
                Escribir la primera
            </button>
            <div style="margin-top:2rem;">
                <button type="button" class="diary-lock-btn" id="diary-lock-empty-btn" title="Bloquear cuaderno">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock</span>
                    Bloquear
                </button>
            </div>
        </div>
    </section>

    {# ══════ State 4: EDITING ══════ #}
    <section id="diary-state-editing" class="diary-state" hidden>
        <div class="diary-topbar">
            <div class="flex items-center gap-3">
                <button type="button" class="diary-btn-back" id="diary-back-btn">
                    <span class="material-symbols-outlined" style="font-size:1rem;">arrow_back</span>
                    Volver
                </button>
                <h2 class="text-cinzel-display" style="font-size:1.05rem;margin:0;" id="diary-editor-title">Nueva entrada</h2>
            </div>
            <div class="flex gap-2 items-center">
                <span class="diary-autosave-badge" id="diary-autosave-badge">
                    <span class="material-symbols-outlined" style="font-size:0.85rem;">check_circle</span>
                    Guardado
                </span>
                <button type="button" class="diary-btn-secondary" id="diary-manual-save-btn">
                    <span class="material-symbols-outlined" style="font-size:1rem;">save</span>
                    Guardar ahora
                </button>
                <button type="button" class="diary-lock-btn" id="diary-lock-edit-btn" title="Bloquear">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock</span>
                </button>
            </div>
        </div>

        <div class="diary-editor-wrap">
            <div class="diary-editor-side">
                <input id="diary-editor-title-input" type="text" class="diary-editor-input"
                       placeholder="Título (opcional)" maxlength="120" />
                <textarea id="diary-editor-textarea" class="diary-editor-textarea"
                          placeholder="Empezá a escribir lo que sentís, aprendiste, o querés recordar..."></textarea>

                <div class="diary-prompts">
                    <span class="diary-editor-side-header" style="margin:0;padding-top:0.2rem;">Prompts rotativos:</span>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué emoción dominó hoy?">Emoción</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué hice bien?">Aciertos</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué patrón volvió a aparecer?">Repetición</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué voy a ajustar mañana?">Ajuste</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Por qué estoy agradecido hoy?">Gratitud</button>
                </div>

                <div class="diary-editor-meta">
                    <span id="diary-word-count">0 palabras · 0 caracteres</span>
                    <span style="color:var(--gold-elev);">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">lock</span>
                        Cifrado de extremo a extremo (AES-GCM 256)
                    </span>
                </div>
            </div>
            <div class="diary-editor-side">
                <div class="diary-editor-side-header">Vista de lectura</div>
                <div id="diary-editor-preview" class="diary-editor-preview">
                    <p class="diary-editor-preview-empty">La vista previa aparece en cuanto escribas...</p>
                </div>
            </div>
        </div>
    </section>

</div>

<script>
(function() {
    'use strict';

    // ══════ F4 — State machine ══════
    const STATES = ['locked', 'list', 'empty', 'editing'];
    function showState(s) {
        STATES.forEach(name => {
            const el = document.getElementById('diary-state-' + name);
            if (el) el.hidden = (name !== s);
        });
    }

    // ─── Crypto ───
    let masterKey = null;
    const ENTRIES = [];
    let currentEditId = null;
    let autosaveTimer = null;
    let dirty = false;

    function escapeHtml(s) {
        return String(s == null ? '' : s)
            .replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    async function deriveKey(pass) {
        const enc = new TextEncoder();
        const keyMaterial = await crypto.subtle.importKey(
            'raw', enc.encode(pass), { name: 'PBKDF2' }, false, ['deriveKey']
        );
        return crypto.subtle.deriveKey(
            { name: 'PBKDF2', salt: enc.encode('tnsvt-diary-v2'),
              iterations: 100000, hash: 'SHA-256' },
            keyMaterial,
            { name: 'AES-GCM', length: 256 },
            true, ['encrypt', 'decrypt']
        );
    }

    async function encryptText(plaintext, key) {
        const iv = crypto.getRandomValues(new Uint8Array(12));
        const ct = await crypto.subtle.encrypt(
            { name: 'AES-GCM', iv }, key, new TextEncoder().encode(plaintext)
        );
        return {
            encrypted: btoa(String.fromCharCode(...new Uint8Array(ct))),
            iv:        btoa(String.fromCharCode(...iv))
        };
    }

    async function decryptText(encB64, ivB64, key) {
        try {
            const iv  = Uint8Array.from(atob(ivB64), c => c.charCodeAt(0));
            const ct  = Uint8Array.from(atob(encB64), c => c.charCodeAt(0));
            const pt  = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ct);
            return new TextDecoder().decode(pt);
        } catch (e) { return null; }
    }

    function tokenFromKey(key) {
        return crypto.subtle.exportKey('raw', key)
            .then(raw => crypto.subtle.digest('SHA-256', raw))
            .then(h => btoa(String.fromCharCode(...new Uint8Array(h))));
    }

    // ─── State helpers ───
    function showMessage(text, type) {
        const div = document.getElementById('diary-message');
        div.className = type === 'success' ? 'diary-success' : 'diary-error';
        div.textContent = text;
        div.hidden = false;
        if (type === 'success') {
            setTimeout(() => { div.hidden = true; }, 4000);
        }
    }

    function parseEntry(plaintext) {
        const lines = (plaintext || '').split('\n');
        if (lines[0] && lines[0].startsWith('#')) {
            return {
                title: lines.shift().slice(1).trim() || '(sin título)',
                body: lines.join('\n').trim()
            };
        }
        return { title: '(sin título)', body: (plaintext || '').trim() };
    }

    function serializeEntry(title, body) {
        const safeTitle = (title || '').trim() || '(sin título)';
        return '# ' + safeTitle + '\n\n' + (body || '').trim();
    }

    function fmtDate(iso) {
        try {
            const d = new Date(iso);
            const dias = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
            return { day: d.getDate(), weekday: dias[d.getDay()],
                     month: d.toLocaleString('es-AR', { month: 'short' }) };
        } catch (e) { return { day: '?', weekday: '—', month: '—' }; }
    }
    function wordCount(s) {
        return (s.trim().match(/\S+/g) || []).length;
    }

    // ─── LOCKED state actions ───
    async function checkSetupAndLoad() {
        try {
            const r = await apiFetch('/api/diary/setup', { silent: true });
            const data = (r.ok && r.data) ? r.data : null;
            const hasSetup = !!(data && data.setup_token);
            const subEl = document.getElementById('diary-lock-subtitle');
            if (subEl) {
                subEl.textContent = hasSetup
                    ? 'Ingresá tu clave maestra para descifrar tus reflexiones.'
                    : 'Bienvenido. Configurá tu clave maestra (mínimo 8 caracteres).';
            }
            showState('locked');
        } catch (e) {
            showState('locked');
        }
    }

    async function unlockOrSetup() {
        const pass = document.getElementById('diary-pass-input').value;
        if (!pass || pass.length < 8) {
            showMessage('La clave debe tener al menos 8 caracteres', 'error');
            return;
        }
        try {
            masterKey = await deriveKey(pass);
            const r = await apiFetch('/api/diary/setup', { silent: true });
            const data = (r.ok && r.data) ? r.data : null;
            const storedToken = (data && data.setup_token) || null;

            const computedToken = await tokenFromKey(masterKey);

            if (storedToken) {
                if (computedToken !== storedToken) {
                    masterKey = null;
                    showMessage('Clave incorrecta — no descifra las entradas', 'error');
                    return;
                }
                showMessage('Cuaderno desbloqueado', 'success');
            } else {
                const ivB64 = btoa(String.fromCharCode(
                    ...crypto.getRandomValues(new Uint8Array(12))
                ));
                const sr = await apiFetch('/api/diary/setup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ setup_token: computedToken, setup_iv: ivB64 })
                });
                if (!sr.ok || !sr.data || !sr.data.success) {
                    masterKey = null;
                    showMessage('Error guardando setup', 'error');
                    return;
                }
                showMessage('Clave maestra configurada', 'success');
            }
            await loadEntries();
        } catch (e) {
            console.error(e);
            masterKey = null;
            showMessage('Error: ' + (e.message || 'desconocido'), 'error');
        }
    }

    // ─── Load + render LIST ───
    async function loadEntries() {
        try {
            const r = await apiFetch('/api/diary', { silent: true });
            if (!r.ok || !r.data) {
                showState('empty');
                return;
            }
            const data = Array.isArray(r.data) ? { entries: r.data } : r.data;
            const encrypted = data.entries || [];

            const decrypted = [];
            for (const e of encrypted) {
                const pt = await decryptText(e.encrypted_data, e.iv, masterKey);
                if (pt === null) {
                    showMessage('La clave no descifra estas entradas — usando clave incorrecta', 'error');
                    masterKey = null;
                    showState('locked');
                    return;
                }
                const parsed = parseEntry(pt);
                decrypted.push({
                    id: e.id,
                    created_at: e.created_at,
                    updated_at: e.updated_at,
                    ...parsed
                });
            }
            ENTRIES.length = 0;
            decrypted
                .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))
                .forEach(e => ENTRIES.push(e));

            if (ENTRIES.length === 0) {
                showState('empty');
                return;
            }
            renderList();
            showState('list');
        } catch (e) {
            console.error(e);
            showState('empty');
        }
    }

    function renderList() {
        const grid = document.getElementById('diary-entries-grid');
        const summary = document.getElementById('diary-list-summary');
        if (summary) {
            summary.textContent =
                `${ENTRIES.length} ${ENTRIES.length === 1 ? 'entrada cifrada' : 'entradas cifradas'}`;
        }
        grid.innerHTML = ENTRIES.map(e => {
            const d = fmtDate(e.created_at);
            const wc = wordCount(e.body);
            return `
                <article class="diary-entry-card" data-id="${e.id}" tabindex="0">
                    <div class="diary-entry-card-date">${d.day}</div>
                    <div class="diary-entry-card-weekday">${d.weekday} · ${d.month}</div>
                    <h3 class="diary-entry-card-title">${escapeHtml(e.title)}</h3>
                    <p class="diary-entry-card-preview">${escapeHtml(e.body.slice(0, 200))}</p>
                    <div class="diary-entry-card-footer">
                        <span style="display:inline-flex;align-items:center;gap:0.3rem;">
                            <span class="material-symbols-outlined" style="font-size:0.85rem;">lock</span>
                            Cifrada · ${wc} palabras
                        </span>
                        <span class="material-symbols-outlined diary-entry-card-chevron">chevron_right</span>
                    </div>
                </article>
            `;
        }).join('');

        grid.querySelectorAll('.diary-entry-card').forEach(el => {
            el.addEventListener('click', () => openEntry(parseInt(el.dataset.id, 10)));
            el.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    openEntry(parseInt(el.dataset.id, 10));
                }
            });
        });
    }

    // ─── EDITING state ───
    function openEntry(id) {
        const e = ENTRIES.find(en => en.id === id);
        if (!e) return;
        currentEditId = id;
        const titleEl = document.getElementById('diary-editor-title');
        if (titleEl) {
            try {
                titleEl.textContent = new Date(e.created_at)
                    .toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
            } catch (_) {
                titleEl.textContent = 'Editar entrada';
            }
        }
        document.getElementById('diary-editor-title-input').value = e.title;
        document.getElementById('diary-editor-textarea').value = e.body;
        updatePreview();
        updateWordCount();
        dirty = false;
        setAutosaveBadge('saved');
        showState('editing');
        setTimeout(() => {
            const ta = document.getElementById('diary-editor-textarea');
            if (ta) ta.focus();
        }, 50);
    }

    function newEntry() {
        currentEditId = null;
        const titleEl = document.getElementById('diary-editor-title');
        if (titleEl) titleEl.textContent = 'Nueva entrada';
        document.getElementById('diary-editor-title-input').value = '';
        document.getElementById('diary-editor-textarea').value = '';
        updatePreview();
        updateWordCount();
        dirty = false;
        setAutosaveBadge('saved');
        showState('editing');
        setTimeout(() => {
            const ta = document.getElementById('diary-editor-textarea');
            if (ta) ta.focus();
        }, 50);
    }

    function updatePreview() {
        const v = document.getElementById('diary-editor-textarea').value;
        const preview = document.getElementById('diary-editor-preview');
        if (!v.trim()) {
            preview.innerHTML = '<p class="diary-editor-preview-empty">La vista previa aparece en cuanto escribas...</p>';
            return;
        }
        // Very light markdown: # heading, **bold**, *italic*, paragraphs
        const html = escapeHtml(v)
            .replace(/^# (.+)$/gm, '<h3>$1</h3>')
            .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
            .replace(/\*([^*\n]+)\*/g, '<em>$1</em>')
            .replace(/\n\n/g, '</p><p>')
            .replace(/\n/g, '<br>');
        preview.innerHTML = '<p>' + html + '</p>';
    }

    function updateWordCount() {
        const v = document.getElementById('diary-editor-textarea').value;
        const wc = wordCount(v);
        document.getElementById('diary-word-count').textContent =
            `${wc} palabras · ${v.length} caracteres`;
    }

    function setAutosaveBadge(state) {
        const b = document.getElementById('diary-autosave-badge');
        if (!b) return;
        if (state === 'saving') {
            b.innerHTML = '<span class="material-symbols-outlined" style="font-size:0.85rem;">progress_activity</span> Guardando…';
            b.classList.remove('saved');
            b.classList.add('saving');
        } else {
            b.innerHTML = '<span class="material-symbols-outlined" style="font-size:0.85rem;">check_circle</span> Guardado';
            b.classList.remove('saving');
            b.classList.add('saved');
        }
    }

    async function saveCurrent(opts) {
        opts = opts || {};
        const silent = !!opts.silent;
        const title = document.getElementById('diary-editor-title-input').value.trim();
        const body = document.getElementById('diary-editor-textarea').value;
        if (!body.trim()) return false;
        const payload = serializeEntry(title, body);
        const { encrypted, iv } = await encryptText(payload, masterKey);
        setAutosaveBadge('saving');
        let r;
        if (currentEditId) {
            r = await apiFetch('/api/diary/' + currentEditId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ encrypted_data: encrypted, iv })
            });
        } else {
            r = await apiFetch('/api/diary', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ encrypted_data: encrypted, iv })
            });
            if (r.ok && r.data && r.data.id) currentEditId = r.data.id;
        }
        if (r.ok && r.data && (r.data.success || r.data.id)) {
            dirty = false;
            setAutosaveBadge('saved');
            if (!silent) showMessage('Entrada guardada', 'success');
            return true;
        } else {
            setAutosaveBadge('saved');
            showMessage('Error guardando — reintentá', 'error');
            return false;
        }
    }

    function scheduleAutosave() {
        dirty = true;
        if (autosaveTimer) clearTimeout(autosaveTimer);
        setAutosaveBadge('saved');
        autosaveTimer = setTimeout(() => {
            if (dirty) saveCurrent({ silent: true });
        }, 30000);
    }

    async function lockNow() {
        if (dirty) {
            if (!await apiConfirm('Tenés cambios sin guardar. ¿Bloquear igual?', { title: 'Cambios sin guardar' })) return;
        }
        masterKey = null;
        currentEditId = null;
        ENTRIES.length = 0;
        document.getElementById('diary-pass-input').value = '';
        if (autosaveTimer) { clearTimeout(autosaveTimer); autosaveTimer = null; }
        showMessage('Cuaderno bloqueado', 'success');
        showState('locked');
    }

    // ─── Wire-up ───
    function wire() {
        document.getElementById('diary-unlock-btn').addEventListener('click', unlockOrSetup);
        document.getElementById('diary-pass-input').addEventListener('keydown', e => {
            if (e.key === 'Enter') unlockOrSetup();
        });
        document.getElementById('diary-fingerprint-btn').addEventListener('click', () => {
            showMessage('Huella biométrica requiere WebAuthn — próxima iteración', 'error');
        });

        document.getElementById('diary-new-btn').addEventListener('click', newEntry);
        document.getElementById('diary-lock-now-btn').addEventListener('click', lockNow);
        document.getElementById('diary-write-first-btn').addEventListener('click', newEntry);
        document.getElementById('diary-lock-empty-btn').addEventListener('click', lockNow);

        const $title = document.getElementById('diary-editor-title-input');
        const $body = document.getElementById('diary-editor-textarea');
        $body.addEventListener('input', () => {
            updatePreview();
            updateWordCount();
            scheduleAutosave();
        });
        $title.addEventListener('input', scheduleAutosave);

        document.querySelectorAll('.diary-prompt-chip').forEach(btn => {
            btn.addEventListener('click', () => {
                const cur = $body.value;
                const phrase = btn.dataset.prompt;
                $body.value = cur ? cur + '\n\n' + phrase + '\n\n' : phrase + '\n\n';
                $body.focus();
                $body.dispatchEvent(new Event('input'));
            });
        });

        document.getElementById('diary-back-btn').addEventListener('click', async () => {
            if (dirty) {
                if (!await apiConfirm('Tenés cambios sin guardar. ¿Volver sin guardar?', { title: 'Cambios sin guardar' })) return;
                dirty = false;
            }
            if (currentEditId) await saveCurrent({ silent: true });
            ENTRIES.length = 0;
            await loadEntries();
        });
        document.getElementById('diary-manual-save-btn').addEventListener('click', () => saveCurrent());
        document.getElementById('diary-lock-edit-btn').addEventListener('click', lockNow);

        window.addEventListener('beforeunload', e => {
            if (dirty) {
                e.preventDefault();
                e.returnValue = '';
                return '';
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        wire();
        checkSetupAndLoad();
    });
})();
</script>
{% endblock %}
