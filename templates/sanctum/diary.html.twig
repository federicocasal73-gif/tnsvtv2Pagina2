{% extends 'shell.html.twig' %}

{% block title %}El Cuaderno · T.N.S.V.T{% endblock %}

{% block topbar_title %}El Cuaderno del Alma{% endblock %}
{% block topbar_subtitle %}"Un santuario privado para tus pensamientos más profundos." — Cifrado Punto a Punto{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="diary-wrap" data-controller="diary">

    <div class="diary-header">
        <h1>EL CUADERNO</h1>
        <p>"Lo que escribes, queda cifrado — solo vos lo leés"</p>
    </div>

    <div id="diary-message" data-diary-target="message" hidden></div>

    {# ══════ State 1: LOCKED ══════ #}
    <section id="diary-state-locked"
             data-diary-target="stateLocked"
             class="diary-state" hidden>
        <div class="diary-state-locked">
            <div class="diary-lock-icon">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">lock</span>
            </div>
            <h2 class="diary-lock-title">El Cuaderno está cerrado</h2>
            <p class="diary-lock-sub"
               data-diary-target="lockSubtitle"
               id="diary-lock-subtitle">
                Ingresá tu clave maestra para descifrar tus reflexiones.
            </p>
            <input id="diary-pass-input"
                   data-diary-target="passInput"
                   type="password" class="diary-key-input"
                   placeholder="Clave maestra..." autocomplete="off" />
            <div class="diary-unlock-actions">
                <button type="button" class="diary-btn-primary"
                        data-diary-target="unlockBtn"
                        id="diary-unlock-btn">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock_open</span>
                    Desbloquear
                </button>
                <button type="button" class="diary-btn-secondary"
                        data-diary-target="fingerprintBtn"
                        id="diary-fingerprint-btn"
                        title="Huella biométrica (próxima iteración)">
                    <span class="material-symbols-outlined" style="font-size:1rem;">fingerprint</span>
                </button>
            </div>
            <p class="diary-lock-tip">
                <span class="material-symbols-outlined align-middle" style="font-size:0.95rem;">info</span>
                Si nunca configuraste una clave, ingresá una nueva (mínimo 8 caracteres).
                Esta clave cifra y descifra tus entradas — no se envía al servidor.
            </p>
            <p class="diary-lock-tip" style="margin-top:0.75rem;">
                ¿Olvidaste tu clave? Como el cifrado es de extremo a extremo,
                no hay forma de recuperarla.
                <button type="button" class="diary-link-btn"
                        data-diary-target="resetLockedBtn"
                        id="diary-reset-locked-btn">
                    Borrar todo y empezar de cero
                </button>
            </p>
        </div>
    </section>

    {# ══════ State 2: LIST ══════ #}
    <section id="diary-state-list"
             data-diary-target="stateList"
             class="diary-state" hidden>
        <div class="diary-topbar">
            <div>
                <h2 class="text-cinzel-display" style="font-size:1.1rem;margin:0;">TUS REFLEXIONES</h2>
                <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider"
                   data-diary-target="listSummary"
                   id="diary-list-summary">— entradas cifradas</p>
            </div>
            <div class="flex gap-2">
                <button type="button" class="diary-btn-primary"
                        data-diary-target="newBtn"
                        id="diary-new-btn"
                        style="font-size:0.8rem;padding:0.55rem 1rem;">
                    <span class="material-symbols-outlined" style="font-size:1rem;">edit</span>
                    Escribir nueva
                </button>
                <button type="button" class="diary-btn-secondary"
                        data-diary-target="exportBtn"
                        id="diary-export-btn"
                        title="Descargar entradas descifradas como Markdown">
                    <span class="material-symbols-outlined" style="font-size:1rem;">download</span>
                    Exportar
                </button>
                <button type="button" class="diary-lock-btn"
                        data-diary-target="lockBtn"
                        id="diary-lock-now-btn"
                        title="Bloquear cuaderno">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock</span>
                    Bloquear
                </button>
                <button type="button" class="diary-btn-danger"
                        data-diary-target="resetBtn"
                        id="diary-reset-btn"
                        title="Resetear clave (borra todo)"
                        style="font-size:0.8rem;padding:0.55rem 1rem;background:rgba(248,113,113,0.15);color:#f87171;border:1px solid rgba(248,113,113,0.4);">
                    <span class="material-symbols-outlined" style="font-size:1rem;">restart_alt</span>
                    Resetear clave
                </button>
            </div>
        </div>
        <div id="diary-entries-grid"
             data-diary-target="entriesGrid"
             class="diary-entries-grid"></div>
    </section>

    {# ══════ State 3: EMPTY ══════ #}
    <section id="diary-state-empty"
             data-diary-target="stateEmpty"
             class="diary-state" hidden>
        <div class="diary-state-empty">
            <div class="diary-empty-icon">
                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 0;">draw</span>
            </div>
            <h2 class="diary-lock-title">El Cuaderno está vacío</h2>
            <p class="diary-lock-sub">
                Tus reflexiones vivirán cifradas — solo vos las podés leer.
            </p>
            <button type="button" class="diary-btn-primary"
                    data-diary-target="writeFirstBtn"
                    id="diary-write-first-btn"
                    style="margin-top:1.25rem;">
                <span class="material-symbols-outlined" style="font-size:1rem;">edit_note</span>
                Escribir la primera
            </button>
            <div style="margin-top:2rem;">
                <button type="button" class="diary-lock-btn"
                        data-diary-target="lockEmptyBtn"
                        id="diary-lock-empty-btn"
                        title="Bloquear cuaderno">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock</span>
                    Bloquear
                </button>
            </div>
        </div>
    </section>

    {# ══════ State 4: EDITING ══════ #}
    <section id="diary-state-editing"
             data-diary-target="stateEditing"
             class="diary-state" hidden>
        <div class="diary-topbar">
            <div class="flex items-center gap-3">
                <button type="button" class="diary-btn-back"
                        data-diary-target="backBtn"
                        id="diary-back-btn">
                    <span class="material-symbols-outlined" style="font-size:1rem;">arrow_back</span>
                    Volver
                </button>
                <h2 class="text-cinzel-display"
                    data-diary-target="editorTitle"
                    style="font-size:1.05rem;margin:0;"
                    id="diary-editor-title">Nueva entrada</h2>
            </div>
            <div class="flex gap-2 items-center">
                <span class="diary-autosave-badge"
                      data-diary-target="autosaveBadge"
                      id="diary-autosave-badge">
                    <span class="material-symbols-outlined" style="font-size:0.85rem;">check_circle</span>
                    Guardado
                </span>
                <button type="button" class="diary-btn-secondary"
                        data-diary-target="manualSaveBtn"
                        id="diary-manual-save-btn">
                    <span class="material-symbols-outlined" style="font-size:1rem;">save</span>
                    Guardar ahora
                </button>
                <button type="button" class="diary-lock-btn"
                        data-diary-target="lockEditBtn"
                        id="diary-lock-edit-btn"
                        title="Bloquear">
                    <span class="material-symbols-outlined" style="font-size:1rem;">lock</span>
                </button>
            </div>
        </div>

        <div class="diary-editor-wrap"
             data-diary-target="editorWrap"
             id="diary-editor-wrap"
             data-diary-view="write">
            <div class="diary-view-toggle" role="tablist" aria-label="Vista del editor">
                <button type="button" class="diary-view-tab is-active"
                        data-view="write" role="tab" aria-selected="true">Escribir</button>
                <button type="button" class="diary-view-tab"
                        data-view="read" role="tab" aria-selected="false">Vista</button>
            </div>
            <div class="diary-editor-side" data-side="write">
                <input id="diary-editor-title-input"
                       data-diary-target="editorTitleInput"
                       type="text" class="diary-editor-input"
                       placeholder="Título (opcional)" maxlength="120" />
                <textarea id="diary-editor-textarea"
                          data-diary-target="editorTextarea"
                          class="diary-editor-textarea"
                          placeholder="Empezá a escribir lo que sentís, aprendiste, o querés recordar..."></textarea>

                <div class="diary-prompts">
                    <span class="diary-editor-side-header" style="margin:0;padding-top:0.2rem;">Prompts rotativos:</span>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué emoción dominó hoy?">Emoción</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué hice bien?">Aciertos</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué patrón volvió a aparecer?">Repetición</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Qué voy a ajustar mañana?">Ajuste</button>
                    <button type="button" class="diary-prompt-chip" data-prompt="¿Por qué estoy agradecido hoy?">Gratitud</button>
                </div>

                <div class="diary-editor-meta">
                    <span id="diary-word-count"
                          data-diary-target="wordCount">0 palabras · 0 caracteres</span>
                    <span style="color:var(--gold-elev);">
                        <span class="material-symbols-outlined align-middle" style="font-size:0.85rem;">lock</span>
                        Cifrado de extremo a extremo (AES-GCM 256)
                    </span>
                </div>
            </div>
            <div class="diary-editor-side" data-side="read">
                <div class="diary-editor-side-header">Vista de lectura</div>
                <div id="diary-editor-preview"
                     data-diary-target="editorPreview"
                     class="diary-editor-preview">
                    <p class="diary-editor-preview-empty">La vista previa aparece en cuanto escribas...</p>
                </div>
            </div>
        </div>
    </section>

</div>
{% endblock %}
