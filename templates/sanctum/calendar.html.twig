{% extends 'shell.html.twig' %}

{% block title %}Calendario Económico · T.N.S.V.T{% endblock %}

{% block topbar_title %}El Pulso del Mercado{% endblock %}
{% block topbar_subtitle %}"Operar en el momento equivocado borra todos tus conocimientos." — Los Hilos del Mundo{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto" data-controller="calendar-events">

    {# ─── Mystic Header (V1-style) ─── #}
    <div class="cal-mystic-header">
        <div class="cal-mystic-eyebrow">
            <span class="cal-mystic-line"></span>
            <span class="cal-mystic-mark">⛧ EL PULSO DEL MUNDO ⛧</span>
            <span class="cal-mystic-line"></span>
        </div>
        <h1 class="cal-mystic-title">Calendario Económico</h1>
        <p class="cal-mystic-quote">
            "El mercado no te avisa. El calendario sí. Aprende a leerlo antes de ejecutar."
        </p>
    </div>

    {# ─── Tareas próximas (Fase 6) ─── #}
    <section class="glass-card-elev p-4 mb-4" data-controller="upcoming-tasks">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom: var(--space-3);">
            <h3 style="display:flex; align-items:center; gap: var(--space-2); font-weight:600; color: var(--on-surface-elev);">
                <span class="material-symbols-elev" style="color: var(--gold-elev);">task_alt</span>
                Tareas próximas en el calendario
                <span class="status-pill size-sm" data-upcoming-tasks-target="count" style="background: var(--glass-bg-elev);">—</span>
            </h3>
            <a href="/sanctum/tasks" style="font-size:0.8rem; color: var(--gold-elev);">Ver todas →</a>
        </div>
        <div data-upcoming-tasks-target="list" style="display:grid; gap: var(--space-2);">
            <p style="text-align:center; color: var(--outline-elev); padding: var(--space-3);">Cargando…</p>
        </div>
    </section>

    {# ─── Filters ─── #}
    <div class="glass-card-elev p-4 mb-4 flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
            <label class="kpi-label" for="cal-date">Fecha</label>
            <input id="cal-date" type="date" class="form-input"
                   data-action="change->calendar-events#refresh" />
        </div>
        <div class="flex items-center gap-2">
            <label class="kpi-label" for="cal-country">País</label>
            <select id="cal-country" multiple size="1" class="form-input"
                    data-action="change->calendar-events#refresh">
                <option value="US" selected>🇺🇸 USD</option>
                <option value="EU" selected>🇪🇺 EUR</option>
                <option value="GB" selected>🇬🇧 GBP</option>
                <option value="JP" selected>🇯🇵 JPY</option>
                <option value="CA">🇨🇦 CAD</option>
                <option value="AU">🇦🇺 AUD</option>
                <option value="CH">🇨🇭 CHF</option>
                <option value="CN">🇨🇳 CNY</option>
            </select>
        </div>
        <div class="flex items-center gap-2">
            <label class="kpi-label" for="cal-impact">Impacto</label>
            <select id="cal-impact" class="form-input"
                    data-action="change->calendar-events#refresh">
                <option value="">Todos</option>
                <option value="3" selected>Alto (3)</option>
                <option value="2">Medio (2)</option>
                <option value="1">Bajo (1)</option>
            </select>
        </div>
        <div class="flex-1"></div>
        <div class="text-sm text-[var(--outline-elev)]">
            <span id="cal-count">0 eventos</span>
        </div>
    </div>

    {# ─── Impact Legend (V1-style) ─── #}
    <div class="cal-impacts-legend">
        <span><span class="cal-impact-dot dot-3"></span>Alto impacto</span>
        <span><span class="cal-impact-dot dot-2"></span>Medio</span>
        <span><span class="cal-impact-dot dot-1"></span>Bajo</span>
        <span class="cal-now-marker"><span class="cal-now-pulse"></span>AHORA</span>
    </div>

    {# ─── Timeline Vertical (V1-style) ─── #}
    <div class="cal-thread" id="cal-thread">
        <div class="cal-thread-line"></div>
        <p class="text-center text-[var(--outline-elev)] py-12 loading-pulse">Cargando eventos del día...</p>
    </div>

    {# ─── Hidden data for backward compat (cal-list still referenced by old scripts) ─── #}
    <div class="glass-card-elev p-0 overflow-hidden mt-6" id="cal-table-legacy" style="display:none;">
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Hora</th>
                        <th scope="col">País</th>
                        <th scope="col">Evento</th>
                        <th scope="col">Impacto</th>
                        <th scope="col">Actual</th>
                        <th scope="col">Previsión</th>
                        <th scope="col">Anterior</th>
                    </tr>
                </thead>
                <tbody id="cal-list"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';
    const threadEl = document.getElementById('cal-thread');
    const listEl = document.getElementById('cal-list');
    const countEl = document.getElementById('cal-count');
    const dateInput = document.getElementById('cal-date');
    const countrySel = document.getElementById('cal-country');
    const impactSel = document.getElementById('cal-impact');

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    function selectedCountries() {
        return Array.from(countrySel.selectedOptions).map(o => o.value);
    }

    function pushState() {
        const params = new URLSearchParams();
        if (dateInput.value) params.set('date', dateInput.value);
        const countries = selectedCountries();
        if (countries.length) params.set('countries', countries.join(','));
        if (impactSel.value) params.set('impact', impactSel.value);
        const qs = params.toString();
        history.replaceState(null, '', qs ? '?' + qs : location.pathname);
    }

    function restoreState() {
        const params = new URLSearchParams(location.search);
        if (params.has('date') && dateInput) dateInput.value = params.get('date');
        if (params.has('countries') && countrySel) {
            const wanted = params.get('countries').split(',');
            Array.from(countrySel.options).forEach(o => {
                o.selected = wanted.includes(o.value);
            });
        }
        if (params.has('impact') && impactSel) impactSel.value = params.get('impact');
    }

    function timeUntil(eventIso) {
        if (!eventIso) return null;
        const target = new Date(eventIso);
        if (isNaN(target.getTime())) return null;
        const now = new Date();
        const diffMs = target - now;
        if (!isFinite(diffMs) || diffMs < 0) return { past: true, text: '—' };
        const m = Math.floor(diffMs / 60000);
        const h = Math.floor(m / 60);
        const d = Math.floor(h / 24);
        if (d > 0) return { past: false, text: `en ${d}d ${h % 24}h` };
        if (h > 0) return { past: false, text: `en ${h}h ${m % 60}m` };
        if (m > 0) return { past: false, text: `en ${m}m` };
        return { past: false, text: 'ahora' };
    }

    function isCriticalEvent(e) {
        return e.is_critical || (e.importance || 1) === 3;
    }

    async function loadEvents() {
        threadEl.innerHTML = '<div class="cal-thread-line"></div><p class="text-center text-[var(--outline-elev)] py-12 loading-pulse">Cargando eventos del día...</p>';
        const params = new URLSearchParams();
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'America/Argentina/Buenos_Aires';
        params.set('tz', tz);
        const countries = selectedCountries();
        if (countries.length) params.set('countries', countries.join(','));
        if (impactSel.value) params.set('impact', impactSel.value);

        const r = await apiFetch('/api/calendar/events?' + params.toString());
        if (!r.ok || !r.data || !r.data.events) {
            threadEl.innerHTML = '<div class="cal-thread-line"></div><p class="text-center text-[var(--outline-elev)] py-12">Sin datos disponibles</p>';
            countEl.textContent = '0 eventos';
            return;
        }
        const events = r.data.events || [];
        countEl.textContent = events.length + ' eventos';

        if (events.length === 0) {
            threadEl.innerHTML = '<div class="cal-thread-line"></div><p class="text-center text-[var(--outline-elev)] py-12">No hay eventos para los filtros seleccionados</p>';
            return;
        }

        // Separate critical (next-3) from rest
        const critical = events.filter(isCriticalEvent).slice(0, 3);
        const rest = events.filter(e => !critical.includes(e));

        let html = '<div class="cal-thread-line"></div>';

        // Critical events banner
        if (critical.length > 0) {
            html += '<div class="cal-critical-banner">';
            html += '<div class="cal-critical-banner-title"><span class="material-symbols-elev">priority_high</span>PRÓXIMOS CRÍTICOS</div>';
            for (const e of critical) {
                const t = timeUntil(e.datetime_utc || e.datetime_local);
                const impact = e.importance || 1;
                html += `
                    <div class="cal-critical-row">
                        <div class="cal-critical-time">
                            <span class="cal-critical-clock">${escapeHtml(e.time || '')}</span>
                            ${t && !t.past ? `<span class="cal-critical-countdown">${escapeHtml(t.text)}</span>` : ''}
                        </div>
                        <div class="cal-critical-content">
                            <div class="cal-critical-flag">${escapeHtml(e.currency || e.country_code || '')}</div>
                            <div class="cal-critical-title">${escapeHtml(e.title || '')}</div>
                        </div>
                        <div class="cal-critical-impact dot-${impact}"></div>
                    </div>`;
            }
            html += '<div class="cal-critical-no-trade">⚠️ NO OPERAR durante la ventana crítica ±15 min</div>';
            html += '</div>';
        }

        // Rest as timeline
        for (const e of rest) {
            const impact = e.importance || 1;
            const t = timeUntil(e.datetime_utc || e.datetime_local);
            const isNow = t && !t.past && t.text.includes('m') && !t.text.includes('h') && !t.text.includes('d');
            html += `
                <div class="cal-row ${isCriticalEvent(e) ? 'cal-row-critical' : ''}">
                    <div class="cal-row-dot-col">
                        <div class="cal-row-dot dot-${impact}"></div>
                    </div>
                    <div class="cal-row-card">
                        <div class="cal-row-head">
                            <span class="cal-row-time">${escapeHtml(e.time || '')}</span>
                            <span class="cal-row-flag">${escapeHtml(e.currency || e.country_code || '')}</span>
                            <span class="cal-row-tag">${escapeHtml(e.title || '')}</span>
                            ${t && !t.past ? `<span class="cal-row-countdown">${escapeHtml(t.text)}</span>` : ''}
                        </div>
                        <div class="cal-row-meta">
                            <span>Actual: <strong>${escapeHtml(e.actual || '—')}</strong></span>
                            <span>Previsión: <strong>${escapeHtml(e.forecast || '—')}</strong></span>
                            <span>Anterior: <strong>${escapeHtml(e.previous || '—')}</strong></span>
                        </div>
                    </div>
                </div>`;
        }

        threadEl.innerHTML = html;

        // Also populate legacy table for backward compat (e.g., exports)
        if (listEl) {
            listEl.innerHTML = events.map(e => {
                const impact = e.importance || 1;
                const critical = e.is_critical ? 'cal-critical' : '';
                const t = timeUntil(e.datetime_utc || e.datetime_local);
                return `
                    <tr class="${critical}">
                        <td class="font-mono">${escapeHtml(e.time || '')}${t && !t.past ? ` <small>(${escapeHtml(t.text)})</small>` : ''}</td>
                        <td>${escapeHtml(e.currency || e.country_code || '')}</td>
                        <td>${escapeHtml(e.title || '')}</td>
                        <td class="cal-impact-${impact}">${'●'.repeat(impact)}${'○'.repeat(3 - impact)}</td>
                        <td>${escapeHtml(e.actual || '—')}</td>
                        <td>${escapeHtml(e.forecast || '—')}</td>
                        <td>${escapeHtml(e.previous || '—')}</td>
                    </tr>
                `;
            }).join('');
        }
    }

    function onFilterChange() {
        pushState();
        loadEvents();
    }

    document.addEventListener('DOMContentLoaded', () => {
        restoreState();
        if (!dateInput.value) {
            const now = new Date();
            dateInput.value = now.toISOString().slice(0, 10);
        }

        dateInput.addEventListener('change', onFilterChange);
        countrySel.addEventListener('change', onFilterChange);
        impactSel.addEventListener('change', onFilterChange);

        loadEvents();
        // Refresh every 5 minutes for countdowns
        setInterval(loadEvents, 5 * 60 * 1000);
    });
})();
</script>
{% endblock %}
