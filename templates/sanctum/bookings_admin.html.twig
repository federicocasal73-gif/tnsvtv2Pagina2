{% extends 'shell.html.twig' %}

{% block title %}Gestión de Clases 1:1 · T.N.S.V.T{% endblock %}

{% block topbar_title %}Gestión de reservas 1:1{% endblock %}
{% block topbar_subtitle %}Reservas que te han solicitado · Aceptar / rechazar / proponer horarios.{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
<div class="bookings-wrap" data-controller="bookings_admin">

    <header class="bookings-header">
        <h1 class="text-cinzel-display">RESERVAS RECIBIDAS</h1>
        <p>Clases 1:1 que alumnos te han solicitado</p>
    </header>

    <nav class="bookings-tabs" id="bookings-tabs" role="tablist">
        <button class="bookings-tab active" data-status="pending"  type="button">Pendientes</button>
        <button class="bookings-tab"        data-status="accepted" type="button">Aceptadas</button>
        <button class="bookings-tab"        data-status="declined" type="button">Rechazadas</button>
        <button class="bookings-tab"        data-status="proposed" type="button">Propuestos</button>
    </nav>

    <div class="bookings-list" id="bookings-list">
        <p class="bookings-loading">Cargando reservas...</p>
    </div>

</div>

{% endblock %}
