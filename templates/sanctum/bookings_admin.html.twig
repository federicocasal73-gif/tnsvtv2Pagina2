{% extends 'shell.html.twig' %}

{% block title %}Gestión de Clases 1:1 · T.N.S.V.T{% endblock %}

{% block topbar_title %}Gestión de reservas 1:1{% endblock %}
{% block topbar_subtitle %}Reservas que te han solicitado · Aceptar / rechazar / proponer horarios.{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
<div class="bookings-wrap">

    <header class="bookings-header">
        <h1 class="text-cinzel-display">RESERVAS RECIBIDAS</h1>
        <p>Clases 1:1 que alumnos te han solicitado</p>
    </header>

    <nav class="bookings-tabs" id="bookings-tabs" role="tablist">
        <button class="bookings-tab active" data-status="pending"  type="button">Pendientes</button>
        <button class="bookings-tab"        data-status="accepted" type="button">Aceptadas</button>
        <button class="bookings-tab"        data-status="declined" type="button">Rechazadas</button>
        <button class="bookings-tab"        data-status="proposed" type="button">Propuestos</button>
    </nav>

    <div class="bookings-list" id="bookings-list">
        <p class="bookings-loading">Cargando reservas...</p>
    </div>

</div>

<script>
(function() {
    'use strict';

    let _status = 'pending';

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }
    function fmtLong(iso) {
        try {
            return new Date(iso).toLocaleString('es-AR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        } catch (e) { return iso; }
    }
    function statusLabel(s) {
        return ({ pending: 'Pendiente', accepted: 'Aceptada', declined: 'Rechazada', proposed: 'Propuesto', canceled: 'Cancelada' })[s] || s;
    }

    async function loadBookings() {
        const list = document.getElementById('bookings-list');
        list.innerHTML = '<p class="bookings-loading">Cargando...</p>';
        try {
            const r = await apiFetch(`/api/academic/bookings?status=${encodeURIComponent(_status)}`, { silent: true });
            if (!r.ok || !r.data) {
                apiEmpty(list, { icon: 'event_busy', message: 'Sin reservas registradas' });
                return;
            }
            const items = Array.isArray(r.data) ? r.data : (r.data.bookings || []);
            const filtered = items.filter(b => !_status || b.status === _status);
            if (filtered.length === 0) {
                list.innerHTML = `
                    <div class="bookings-empty">
                        <span class="material-symbols-elev bookings-empty-icon">event_busy</span>
                        <p>Sin reservas ${_status ? statusLabel(_status).toLowerCase() + 's' : ''}.</p>
                    </div>
                `;
                return;
            }
            renderBookings(filtered);
        } catch (e) {
            list.innerHTML = '<p class="bookings-empty"><span class="material-symbols-elev bookings-empty-icon">cloud_off</span>Sin conexión.</p>';
        }
    }

    function renderBookings(items) {
        const list = document.getElementById('bookings-list');
        list.innerHTML = items.map(b => {
            const showActions = b.status === 'pending';
            const showCancel = ['pending', 'proposed', 'accepted'].includes(b.status);
            return `
                <article class="booking-card status-${esc(b.status)}" data-id="${esc(b.id)}">
                    <header class="booking-card-head">
                        <span class="booking-card-topic">${esc(b.topic || 'Clase 1:1')}</span>
                        <span class="booking-card-status ${esc(b.status)}">${esc(statusLabel(b.status))}</span>
                        ${showCancel ? `<button type="button" class="booking-btn cancel" data-action="cancel" data-id="${esc(b.id)}">Cancelar</button>` : ''}
                    </header>
                    <div class="booking-card-meta">
                        <strong>Alumno:</strong> ${esc(b.student_name || b.student_code || '—')}
                        &nbsp;·&nbsp;
                        <strong>Inicio:</strong> ${esc(fmtLong(b.start_at))}
                        &nbsp;·&nbsp;
                        <strong>Duración:</strong> ${b.duration_minutes || 30} min
                    </div>
                    ${b.notes ? `<div class="booking-card-notes">${esc(b.notes)}</div>` : ''}
                    ${showActions ? `
                        <div class="booking-card-actions">
                            <button type="button" class="booking-btn accept" data-action="accept"  data-id="${esc(b.id)}">
                                <span class="material-symbols-elev" style="font-size:1rem;">check_circle</span>
                                Aceptar
                            </button>
                            <button type="button" class="booking-btn decline" data-action="decline" data-id="${esc(b.id)}">
                                <span class="material-symbols-elev" style="font-size:1rem;">block</span>
                                Rechazar
                            </button>
                            <button type="button" class="booking-btn propose" data-action="propose" data-id="${esc(b.id)}">
                                <span class="material-symbols-elev" style="font-size:1rem;">schedule</span>
                                Proponer horarios
                            </button>
                        </div>
                        <div class="proposed-form" data-id="${esc(b.id)}" hidden>
                            <textarea placeholder="Lista de horarios propuestos (uno por línea, formato: YYYY-MM-DD HH:MM)"></textarea>
                            <div class="proposed-form-actions">
                                <button type="button" class="booking-btn propose" data-action="submit-propose" data-id="${esc(b.id)}">Enviar propuesta</button>
                            </div>
                        </div>
                    ` : ''}
                </article>
            `;
        }).join('');

        // Wire actions
        list.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', () => handleAction(btn));
        });
    }

    async function handleAction(btn) {
        const id   = btn.dataset.id;
        const act  = btn.dataset.action;
        if (act === 'cancel') {
            if (!await apiConfirm('¿Cancelar esta reserva?', { title: 'Cancelar reserva', variant: 'danger' })) return;
            await patchBooking(`/api/academic/bookings/${id}/cancel`, {});
            loadBookings();
            return;
        }
        if (act === 'accept') {
            btn.disabled = true;
            await patchBooking(`/api/academic/bookings/${id}/accept`, {});
            loadBookings();
            return;
        }
        if (act === 'decline') {
            if (!await apiConfirm('¿Rechazar esta reserva?', { title: 'Rechazar reserva', variant: 'danger' })) return;
            btn.disabled = true;
            await patchBooking(`/api/academic/bookings/${id}/decline`, {});
            loadBookings();
            return;
        }
        if (act === 'propose') {
            const form = document.querySelector(`.proposed-form[data-id="${id}"]`);
            form.hidden = !form.hidden;
            return;
        }
        if (act === 'submit-propose') {
            const form = document.querySelector(`.proposed-form[data-id="${id}"]`);
            const ta = form.querySelector('textarea');
            const lines = ta.value.split('\n').map(l => l.trim()).filter(Boolean);
            if (lines.length === 0) {
                apiToast('Ingresá al menos un horario propuesto.', 'warning');
                return;
            }
            btn.disabled = true;
            await patchBooking(`/api/academic/bookings/${id}/propose`, {
                proposed_times: lines
            });
            loadBookings();
        }
    }

    async function patchBooking(url, body) {
        try {
            const r = await apiFetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            if (!r.ok) {
                apiToast(r.data && r.data.error ? r.data.error : 'Error', 'error');
            }
        } catch (e) { console.error(e); }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('#bookings-tabs .bookings-tab').forEach(t => {
            t.addEventListener('click', () => {
                document.querySelectorAll('#bookings-tabs .bookings-tab').forEach(x => x.classList.toggle('active', x === t));
                _status = t.dataset.status;
                loadBookings();
            });
        });
        loadBookings();
    });
})();
</script>
{% endblock %}
