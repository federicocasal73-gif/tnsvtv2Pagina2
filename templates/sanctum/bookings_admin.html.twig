{% extends 'shell.html.twig' %}

{% block title %}Gestión de Clases 1:1 · T.N.S.V.T{% endblock %}

{% block topbar_title %}Gestión de reservas 1:1{% endblock %}
{% block topbar_subtitle %}Reservas que te han solicitado · Aceptar / rechazar / proponer horarios.{% endblock %}

{% block stylesheets %}
<style>
    .bookings-wrap {
        max-width: 980px;
        margin: 0 auto;
        padding-bottom: 4rem;
    }

    .bookings-tabs {
        display: flex;
        gap: 0;
        background: var(--glass-bg-elev);
        border: 1px solid var(--glass-border-elev);
        border-radius: 9999px;
        padding: 0.3rem;
        margin-bottom: 1rem;
        max-width: 480px;
    }
    .bookings-tab {
        flex: 1;
        padding: 0.5rem 1rem;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        background: transparent;
        border: none;
        border-radius: 9999px;
        color: var(--outline-elev);
        cursor: pointer;
    }
    .bookings-tab.active {
        background: rgba(242, 202, 80, 0.18);
        color: var(--gold-elev);
    }

    .bookings-header {
        text-align: center;
        margin-bottom: 1.25rem;
    }
    .bookings-header h1 {
        font-family: 'Cinzel', serif;
        font-size: 1.55rem;
        margin: 0;
    }
    .bookings-header p {
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--outline-elev);
        margin: 0.4rem 0 0;
    }

    .bookings-list { display: flex; flex-direction: column; gap: 0.75rem; }

    .booking-card {
        background: var(--glass-bg-elev);
        border: 1px solid var(--glass-border-elev);
        border-left: 3px solid var(--gold-elev);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
    }
    .booking-card.status-pending  { border-left-color: #fbbf24; }
    .booking-card.status-accepted { border-left-color: #4ade80; }
    .booking-card.status-declined { border-left-color: #f87171; }
    .booking-card.status-proposed { border-left-color: #c4a0ff; }
    .booking-card.status-canceled { border-left-color: var(--outline-elev); opacity: 0.55; }
    .booking-card-head {
        display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.4rem;
        flex-wrap: wrap;
    }
    .booking-card-topic {
        font-family: 'Cinzel', serif;
        font-size: 1.05rem;
        color: var(--gold-elev);
    }
    .booking-card-status {
        font-size: 0.65rem;
        padding: 0.15rem 0.55rem;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
    }
    .booking-card-status.pending  { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
    .booking-card-status.accepted { background: rgba(74, 222, 128, 0.18); color: #4ade80; }
    .booking-card-status.declined { background: rgba(248, 113, 113, 0.18); color: #f87171; }
    .booking-card-status.proposed { background: rgba(138, 60, 255, 0.18); color: #c4a0ff; }
    .booking-card-status.canceled { background: rgba(255, 255, 255, 0.06); color: var(--outline-elev); }

    .booking-card-meta {
        font-size: 0.78rem;
        color: var(--outline-elev);
        margin-bottom: 0.5rem;
        line-height: 1.5;
    }
    .booking-card-notes {
        font-size: 0.85rem;
        color: var(--on-surface-elev);
        background: rgba(255, 255, 255, 0.02);
        padding: 0.6rem 0.75rem;
        border-radius: 0.4rem;
        margin-bottom: 0.6rem;
        line-height: 1.4;
        white-space: pre-wrap;
    }
    .booking-card-actions {
        display: flex; gap: 0.5rem; flex-wrap: wrap;
    }
    .booking-btn {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.45rem 0.85rem;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 0.4rem;
        cursor: pointer;
        border: none;
    }
    .booking-btn.accept  { background: rgba(74, 222, 128, 0.18); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.4); }
    .booking-btn.decline { background: rgba(248, 113, 113, 0.18); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.4); }
    .booking-btn.propose { background: rgba(138, 60, 255, 0.18); color: #c4a0ff; border: 1px solid rgba(138, 60, 255, 0.4); }
    .booking-btn.cancel  { background: transparent; color: var(--outline-elev); border: 1px solid var(--glass-border-elev); }

    .bookings-empty {
        text-align: center;
        padding: 5rem 1rem;
        color: var(--outline-elev);
    }
    .bookings-empty-icon {
        font-size: 3.5rem;
        opacity: 0.4;
        color: var(--gold-elev);
        margin-bottom: 1rem;
    }
    .bookings-loading { text-align: center; padding: 3rem 1rem; color: var(--outline-elev); font-style: italic; }

    .proposed-form {
        margin-top: 0.6rem;
        padding: 0.75rem;
        background: rgba(138, 60, 255, 0.06);
        border: 1px solid rgba(138, 60, 255, 0.3);
        border-radius: 0.4rem;
    }
    .proposed-form textarea {
        width: 100%;
        min-height: 70px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border-elev);
        border-radius: 0.4rem;
        color: var(--on-surface-elev);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.85rem;
        padding: 0.5rem 0.7rem;
        resize: vertical;
    }
    .proposed-form-actions { display: flex; gap: 0.4rem; justify-content: flex-end; margin-top: 0.5rem; }
</style>
{% endblock %}

{% block content %}
<div class="bookings-wrap">

    <header class="bookings-header">
        <h1 class="text-cinzel-display">RESERVAS RECIBIDAS</h1>
        <p>Clases 1:1 que alumnos te han solicitado</p>
    </header>

    <nav class="bookings-tabs" id="bookings-tabs" role="tablist">
        <button class="bookings-tab active" data-status="pending"  type="button">Pendientes</button>
        <button class="bookings-tab"        data-status="accepted" type="button">Aceptadas</button>
        <button class="bookings-tab"        data-status="declined" type="button">Rechazadas</button>
        <button class="bookings-tab"        data-status="proposed" type="button">Propuestos</button>
    </nav>

    <div class="bookings-list" id="bookings-list">
        <p class="bookings-loading">Cargando reservas...</p>
    </div>

</div>

<script>
(function() {
    'use strict';

    let _status = 'pending';

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }
    function fmtLong(iso) {
        try {
            return new Date(iso).toLocaleString('es-AR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        } catch (e) { return iso; }
    }
    function statusLabel(s) {
        return ({ pending: 'Pendiente', accepted: 'Aceptada', declined: 'Rechazada', proposed: 'Propuesto', canceled: 'Cancelada' })[s] || s;
    }

    async function loadBookings() {
        const list = document.getElementById('bookings-list');
        list.innerHTML = '<p class="bookings-loading">Cargando...</p>';
        try {
            const r = await apiFetch(`/api/academic/bookings?status=${encodeURIComponent(_status)}`, { silent: true });
            if (!r.ok || !r.data) {
                list.innerHTML = '<p class="bookings-empty"><span class="material-symbols-elev bookings-empty-icon">error</span>Sin datos.</p>';
                return;
            }
            const items = Array.isArray(r.data) ? r.data : (r.data.bookings || []);
            const filtered = items.filter(b => !_status || b.status === _status);
            if (filtered.length === 0) {
                list.innerHTML = `
                    <div class="bookings-empty">
                        <span class="material-symbols-elev bookings-empty-icon">event_busy</span>
                        <p>Sin reservas ${_status ? statusLabel(_status).toLowerCase() + 's' : ''}.</p>
                    </div>
                `;
                return;
            }
            renderBookings(filtered);
        } catch (e) {
            list.innerHTML = '<p class="bookings-empty"><span class="material-symbols-elev bookings-empty-icon">cloud_off</span>Sin conexión.</p>';
        }
    }

    function renderBookings(items) {
        const list = document.getElementById('bookings-list');
        list.innerHTML = items.map(b => {
            const showActions = b.status === 'pending';
            const showCancel = ['pending', 'proposed', 'accepted'].includes(b.status);
            return `
                <article class="booking-card status-${esc(b.status)}" data-id="${esc(b.id)}">
                    <header class="booking-card-head">
                        <span class="booking-card-topic">${esc(b.topic || 'Clase 1:1')}</span>
                        <span class="booking-card-status ${esc(b.status)}">${esc(statusLabel(b.status))}</span>
                        ${showCancel ? `<button type="button" class="booking-btn cancel" data-action="cancel" data-id="${esc(b.id)}">Cancelar</button>` : ''}
                    </header>
                    <div class="booking-card-meta">
                        <strong>Alumno:</strong> ${esc(b.student_name || b.student_code || '—')}
                        &nbsp;·&nbsp;
                        <strong>Inicio:</strong> ${esc(fmtLong(b.start_at))}
                        &nbsp;·&nbsp;
                        <strong>Duración:</strong> ${b.duration_minutes || 30} min
                    </div>
                    ${b.notes ? `<div class="booking-card-notes">${esc(b.notes)}</div>` : ''}
                    ${showActions ? `
                        <div class="booking-card-actions">
                            <button type="button" class="booking-btn accept" data-action="accept"  data-id="${esc(b.id)}">
                                <span class="material-symbols-elev" style="font-size:1rem;">check_circle</span>
                                Aceptar
                            </button>
                            <button type="button" class="booking-btn decline" data-action="decline" data-id="${esc(b.id)}">
                                <span class="material-symbols-elev" style="font-size:1rem;">block</span>
                                Rechazar
                            </button>
                            <button type="button" class="booking-btn propose" data-action="propose" data-id="${esc(b.id)}">
                                <span class="material-symbols-elev" style="font-size:1rem;">schedule</span>
                                Proponer horarios
                            </button>
                        </div>
                        <div class="proposed-form" data-id="${esc(b.id)}" hidden>
                            <textarea placeholder="Lista de horarios propuestos (uno por línea, formato: YYYY-MM-DD HH:MM)"></textarea>
                            <div class="proposed-form-actions">
                                <button type="button" class="booking-btn propose" data-action="submit-propose" data-id="${esc(b.id)}">Enviar propuesta</button>
                            </div>
                        </div>
                    ` : ''}
                </article>
            `;
        }).join('');

        // Wire actions
        list.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', () => handleAction(btn));
        });
    }

    async function handleAction(btn) {
        const id   = btn.dataset.id;
        const act  = btn.dataset.action;
        if (act === 'cancel') {
            if (!confirm('¿Cancelar esta reserva?')) return;
            await patchBooking(`/api/academic/bookings/${id}/cancel`, {});
            loadBookings();
            return;
        }
        if (act === 'accept') {
            btn.disabled = true;
            await patchBooking(`/api/academic/bookings/${id}/accept`, {});
            loadBookings();
            return;
        }
        if (act === 'decline') {
            if (!confirm('¿Rechazar esta reserva?')) return;
            btn.disabled = true;
            await patchBooking(`/api/academic/bookings/${id}/decline`, {});
            loadBookings();
            return;
        }
        if (act === 'propose') {
            const form = document.querySelector(`.proposed-form[data-id="${id}"]`);
            form.hidden = !form.hidden;
            return;
        }
        if (act === 'submit-propose') {
            const form = document.querySelector(`.proposed-form[data-id="${id}"]`);
            const ta = form.querySelector('textarea');
            const lines = ta.value.split('\n').map(l => l.trim()).filter(Boolean);
            if (lines.length === 0) {
                alert('Ingresá al menos un horario propuesto.');
                return;
            }
            btn.disabled = true;
            await patchBooking(`/api/academic/bookings/${id}/propose`, {
                proposed_times: lines
            });
            loadBookings();
        }
    }

    async function patchBooking(url, body) {
        try {
            const r = await apiFetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            if (!r.ok) {
                alert(r.data && r.data.error ? r.data.error : 'Error');
            }
        } catch (e) { console.error(e); }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('#bookings-tabs .bookings-tab').forEach(t => {
            t.addEventListener('click', () => {
                document.querySelectorAll('#bookings-tabs .bookings-tab').forEach(x => x.classList.toggle('active', x === t));
                _status = t.dataset.status;
                loadBookings();
            });
        });
        loadBookings();
    });
})();
</script>
{% endblock %}
