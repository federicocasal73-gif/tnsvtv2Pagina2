{% extends 'shell.html.twig' %}

{% block title %}Calendario Académico · T.N.S.V.T{% endblock %}

{% block topbar_title %}Calendario Académico{% endblock %}
{% block topbar_subtitle %}Clases 1:1 con mentores · Disponibilidad · Mentorías grupales.{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="academic-layout">

<main class="academic-main">

    <header class="academic-header">
        <h1 class="text-cinzel-display">CALENDARIO ACADÉMICO</h1>
        <p>Clases 1:1 · Mentorías · Eventos</p>
    </header>

    <div class="academic-views" id="academic-views" role="tablist">
        <button class="academic-view-tab active" data-view="month" type="button">Mes</button>
        <button class="academic-view-tab"        data-view="list"  type="button">Lista</button>
    </div>

    <div class="academic-month-nav" id="academic-month-nav">
        <button type="button" class="academic-nav-btn" id="academic-prev">
            <span class="material-symbols-elev" style="font-size:1rem;">chevron_left</span>
            Ant
        </button>
        <h2 class="academic-month-title" id="academic-month-title">—</h2>
        <button type="button" class="academic-nav-btn" id="academic-next">
            Sig
            <span class="material-symbols-elev" style="font-size:1rem;">chevron_right</span>
        </button>
    </div>

    <div class="academic-filters" id="academic-filters">
        <button class="academic-filter active" data-type="" type="button">Todos</button>
        <button class="academic-filter"        data-type="class" type="button">Clases</button>
        <button class="academic-filter"        data-type="group" type="button">Grupales</button>
        <button class="academic-filter"        data-type="mentoring" type="button">Mentorías</button>
        <button class="academic-filter"        data-type="event" type="button">Eventos</button>
    </div>

    <section id="academic-month-section">
        <div class="academic-month-grid" id="academic-month-grid">
            <p class="academic-loading" style="grid-column: 1 / -1;">Cargando eventos...</p>
        </div>
    </section>

    <section id="academic-list-section" hidden>
        <div class="academic-event-list" id="academic-event-list">
            <p class="academic-loading">Cargando...</p>
        </div>
    </section>

</main>

<aside class="academic-side">
    <div class="academic-side-card">
        <h3 class="academic-side-card-header">Solicitar Clase 1:1</h3>
        <p style="font-size: 0.78rem; color: var(--outline-elev); margin: 0 0 0.75rem 0;">
            Reservá una clase con un mentor autorizado.
        </p>
        <button type="button" class="academic-modal-btn primary" id="academic-new-class-btn" style="width: 100%; justify-content: center;">
            <span class="material-symbols-elev" style="font-size:1rem;">event_available</span>
            Nueva solicitud
        </button>
    </div>

    <div class="academic-side-card">
        <h3 class="academic-side-card-header">Mis reservas</h3>
        <div id="academic-my-bookings">
            <p class="academic-loading">Cargando...</p>
        </div>
    </div>

    <div class="academic-side-card">
        <h3 class="academic-side-card-header">Próximos eventos</h3>
        <div id="academic-upcoming">
            <p class="academic-loading">Cargando...</p>
        </div>
    </div>
</aside>

</div>

<div class="academic-modal-overlay" id="academic-modal" role="dialog" aria-modal="true" aria-labelledby="academic-modal-title">
    <div class="academic-modal">
        <div class="academic-modal-header">
            <h3 id="academic-modal-title" class="academic-modal-title">Solicitar Clase 1:1</h3>
            <button type="button" class="academic-modal-close" id="academic-modal-close" aria-label="Cerrar">
                <span class="material-symbols-elev">close</span>
            </button>
        </div>
        <div class="academic-modal-body">
            <div id="academic-modal-msg" class="academic-modal-msg"></div>

            <div class="academic-form-group">
                <label class="academic-form-label" for="modal-mentor">Mentor (código)</label>
                <input type="text" id="modal-mentor" class="academic-form-input" placeholder="Ej: MENTOR01" />
            </div>
            <div class="academic-form-group">
                <label class="academic-form-label" for="modal-when">Fecha y hora</label>
                <input type="datetime-local" id="modal-when" class="academic-form-input" />
            </div>
            <div class="academic-form-group">
                <label class="academic-form-label" for="modal-duration">Duración (min)</label>
                <select id="modal-duration" class="academic-form-input">
                    <option value="30">30 min</option>
                    <option value="45">45 min</option>
                    <option value="60" selected>60 min</option>
                    <option value="90">90 min</option>
                </select>
            </div>
            <div class="academic-form-group">
                <label class="academic-form-label" for="modal-topic">Tema</label>
                <input type="text" id="modal-topic" class="academic-form-input" placeholder="Ej: Revisar setups NFP" />
            </div>
            <div class="academic-form-group">
                <label class="academic-form-label" for="modal-notes">Notas para el mentor</label>
                <textarea id="modal-notes" class="academic-form-input academic-form-textarea" placeholder="Puntos a tratar..."></textarea>
            </div>

            <div class="academic-modal-actions">
                <button type="button" class="academic-modal-btn ghost" id="academic-modal-cancel">Cancelar</button>
                <button type="button" class="academic-modal-btn primary" id="academic-modal-submit">
                    <span class="material-symbols-elev" style="font-size:1rem;">send</span>
                    Enviar solicitud
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';

    const MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    const DAYS  = ['L','M','M','J','V','S','D'];

    let _state = { year: 0, month: 0, view: 'month', typeFilter: '' };

    function nowYM() {
        const d = new Date();
        return { year: d.getFullYear(), month: d.getMonth() + 1 };
    }
    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }
    function relTime(iso) {
        try {
            const d = new Date(iso);
            const diff = Math.floor((Date.now() - d.getTime()) / 1000);
            if (diff < 0) {
                const future = -diff;
                if (future < 86400) return 'en ' + Math.floor(future/3600) + 'h';
                if (future < 604800) return 'en ' + Math.floor(future/86400) + 'd';
                return d.toLocaleDateString('es-AR', { day: '2-digit', month: 'short' });
            }
            if (diff < 3600) return 'hace ' + Math.floor(diff/60) + 'm';
            if (diff < 86400) return 'hace ' + Math.floor(diff/3600) + 'h';
            return d.toLocaleDateString('es-AR', { day: '2-digit', month: 'short' });
        } catch (e) { return ''; }
    }
    function eventTypeClass(t) {
        return {
            'class': 'class', 'group': 'group',
            'mentoring': 'mentoring', '1on1': '1on1',
            'event': 'event', 'task': 'class'
        }[t] || 'class';
    }

    // ─── Event fetching ───
    async function loadEvents() {
        const start = new Date(_state.year, _state.month - 1, 1);
        const end   = new Date(_state.year, _state.month, 1);
        const params = new URLSearchParams({
            start: start.toISOString(),
            end: end.toISOString(),
        });
        if (_state.typeFilter) params.set('type', _state.typeFilter);
        try {
            const r = await apiFetch(`/api/academic/events?${params}`, { silent: true });
            if (!r.ok || !r.data || !Array.isArray(r.data.events)) return [];
            return r.data.events;
        } catch (e) {
            return [];
        }
    }

    // ─── Month grid ───
    async function renderMonth() {
        document.getElementById('academic-month-title').textContent =
            `${MONTHS[_state.month - 1]} ${_state.year}`;
        const events = await loadEvents();
        const grid = document.getElementById('academic-month-grid');

        const firstOfMonth = new Date(_state.year, _state.month - 1, 1);
        const firstIsoWeekday = firstOfMonth.getDay() === 0 ? 7 : firstOfMonth.getDay();
        const offsetCells = firstIsoWeekday - 1;
        const daysInMonth = new Date(_state.year, _state.month, 0).getDate();
        const daysInPrevMonth = new Date(_state.year, _state.month - 1, 0).getDate();
        const totalCells = Math.ceil((offsetCells + daysInMonth) / 7) * 7;
        const today = new Date();
        const todayIso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

        const eventsByDate = {};
        events.forEach(e => {
            if (!e.starts_at) return;
            const d = new Date(e.starts_at);
            const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            (eventsByDate[key] = eventsByDate[key] || []).push(e);
        });

        const headerHtml = DAYS.map(d =>
            `<div class="academic-dow-header">${d}</div>`
        ).join('');

        let body = '';
        for (let i = 0; i < totalCells; i++) {
            let y = _state.year, m = _state.month, dnum;
            const dayIndex = i - offsetCells + 1;
            let outside = false;
            if (dayIndex < 1) {
                m = _state.month - 1; if (m < 1) { m = 12; y--; }
                dnum = daysInPrevMonth + dayIndex;
                outside = true;
            } else if (dayIndex > daysInMonth) {
                m = _state.month + 1; if (m > 12) { m = 1; y++; }
                dnum = dayIndex - daysInMonth;
                outside = true;
            } else {
                dnum = dayIndex;
            }
            const key = `${y}-${String(m).padStart(2, '0')}-${String(dnum).padStart(2, '0')}`;
            const dayEvents = eventsByDate[key] || [];
            const isToday = key === todayIso;
            const visibleEvents = outside ? [] : dayEvents.slice(0, 3);
            const more = dayEvents.length - visibleEvents.length;
            body += `
                <div class="academic-day ${outside ? 'outside' : ''} ${isToday ? 'today' : ''}" data-date="${esc(key)}">
                    <div class="academic-day-num">${dnum}</div>
                    ${visibleEvents.map(e => `
                        <div class="academic-event-chip ${esc(eventTypeClass(e.type))}" title="${esc(e.title)}">
                            ${esc(e.title)}
                        </div>
                    `).join('')}
                    ${more > 0 ? `<div class="academic-event-chip" style="opacity:0.5;">+${more} más</div>` : ''}
                </div>
            `;
        }
        grid.innerHTML = headerHtml + body;
    }

    async function renderList() {
        const list = document.getElementById('academic-event-list');
        const events = await loadEvents();
        if (events.length === 0) {
            list.innerHTML = `
                <div class="academic-empty">
                    <span class="material-symbols-elev academic-empty-icon">event_busy</span>
                    <p>Sin eventos este mes.</p>
                </div>
            `;
            return;
        }
        list.innerHTML = events.map(e => {
            const d = new Date(e.starts_at);
            const fecha = d.toLocaleString('es-AR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            const catClass = eventTypeClass(e.type);
            const typeLabel = ({ 'class': 'Clase', 'group': 'Grupal', 'mentoring': 'Mentoría', '1on1': '1:1', 'event': 'Evento', 'task': 'Tarea' })[e.type] || 'Evento';
            return `
                <article class="academic-event-row cat-${catClass}">
                    <header class="academic-event-row-head">
                        <span class="academic-event-row-title">${esc(e.title)}</span>
                        <span class="academic-event-row-time">${esc(typeLabel)} · ${esc(relTime(e.starts_at))}</span>
                    </header>
                    <div class="academic-event-row-meta">${esc(fecha)}</div>
                    ${e.description ? `<div class="academic-event-row-desc">${esc(e.description)}</div>` : ''}
                </article>
            `;
        }).join('');
    }

    async function refreshView() {
        if (_state.view === 'month') {
            document.getElementById('academic-month-section').hidden = false;
            document.getElementById('academic-list-section').hidden = true;
            document.getElementById('academic-month-nav').style.display = 'flex';
            await renderMonth();
        } else {
            document.getElementById('academic-month-section').hidden = true;
            document.getElementById('academic-list-section').hidden = false;
            document.getElementById('academic-month-nav').style.display = 'none';
            await renderList();
        }
    }

    // ─── Side panels ───
    async function loadMyBookings() {
        const el = document.getElementById('academic-my-bookings');
        try {
            const r = await apiFetch('/api/academic/bookings', { silent: true });
            if (!r.ok || !r.data || !Array.isArray(r.data.bookings)) {
                el.innerHTML = '<p class="academic-loading">Sin datos</p>';
                return;
            }
            const items = r.data.bookings.filter(b => b.start_at && new Date(b.start_at) >= new Date()).slice(0, 5);
            if (items.length === 0) {
                el.innerHTML = '<p class="academic-loading" style="font-style:normal;">No tenés reservas próximas</p>';
                return;
            }
            el.innerHTML = items.map(b => `
                <div class="academic-side-row">
                    <div style="flex-grow: 1; min-width: 0;">
                        <div class="academic-side-row-title">${esc(b.topic || 'Clase')}</div>
                        <div class="academic-side-row-time">${esc(relTime(b.start_at))} · ${esc(b.mentor_name || b.mentor_code || '—')}</div>
                    </div>
                    <span class="academic-side-row-status ${esc(b.status)}">${esc(b.status)}</span>
                </div>
            `).join('');
        } catch (e) {
            el.innerHTML = '<p class="academic-loading">Sin conexión</p>';
        }
    }

    async function loadUpcoming() {
        const el = document.getElementById('academic-upcoming');
        try {
            // Re-use events for this month + next month
            const start = new Date(_state.year, _state.month - 1, 1);
            const end   = new Date(_state.year, _state.month + 1, 1);
            const r = await apiFetch(`/api/academic/events?start=${start.toISOString()}&end=${end.toISOString()}`, { silent: true });
            if (!r.ok || !r.data) {
                el.innerHTML = '<p class="academic-loading">Sin datos</p>';
                return;
            }
            const events = (r.data.events || [])
                .filter(e => e.starts_at && new Date(e.starts_at) > new Date())
                .slice(0, 5);
            if (events.length === 0) {
                el.innerHTML = '<p class="academic-loading" style="font-style:normal;">Sin eventos próximos</p>';
                return;
            }
            el.innerHTML = events.map(e => `
                <div class="academic-side-row">
                    <div style="flex-grow: 1; min-width: 0;">
                        <div class="academic-side-row-title">${esc(e.title)}</div>
                        <div class="academic-side-row-time">${esc(relTime(e.starts_at))}</div>
                    </div>
                </div>
            `).join('');
        } catch (e) {
            el.innerHTML = '<p class="academic-loading">Sin conexión</p>';
        }
    }

    // ─── Wire ───
    function wire() {
        const init = nowYM();
        _state.year = init.year; _state.month = init.month;

        document.querySelectorAll('#academic-views .academic-view-tab').forEach(t => {
            t.addEventListener('click', () => {
                document.querySelectorAll('#academic-views .academic-view-tab').forEach(x => x.classList.toggle('active', x === t));
                _state.view = t.dataset.view;
                refreshView();
            });
        });
        document.getElementById('academic-prev').addEventListener('click', () => {
            _state.month--; if (_state.month < 1) { _state.month = 12; _state.year--; }
            refreshView();
        });
        document.getElementById('academic-next').addEventListener('click', () => {
            _state.month++; if (_state.month > 12) { _state.month = 1; _state.year++; }
            refreshView();
        });
        document.querySelectorAll('#academic-filters .academic-filter').forEach(f => {
            f.addEventListener('click', () => {
                document.querySelectorAll('#academic-filters .academic-filter').forEach(x => x.classList.toggle('active', x === f));
                _state.typeFilter = f.dataset.type;
                refreshView();
            });
        });

        // Modal
        const $modal = document.getElementById('academic-modal');
        const $msg = document.getElementById('academic-modal-msg');
        const academicModal = apiSetupModal($modal, {
            open() { resetModal(); }
        });
        function showMsg(text, type) {
            $msg.className = 'academic-modal-msg ' + type;
            $msg.textContent = text;
        }
        function resetModal() {
            document.getElementById('modal-mentor').value = '';
            document.getElementById('modal-when').value = '';
            document.getElementById('modal-duration').value = '60';
            document.getElementById('modal-topic').value = '';
            document.getElementById('modal-notes').value = '';
            $msg.className = 'academic-modal-msg';
            $msg.textContent = '';
        }
        document.getElementById('academic-new-class-btn').addEventListener('click', () => {
            academicModal.open();
        });
        document.getElementById('academic-modal-close').addEventListener('click', () => academicModal.close());
        document.getElementById('academic-modal-cancel').addEventListener('click', () => academicModal.close());

        document.getElementById('academic-modal-submit').addEventListener('click', async () => {
            const mentor    = document.getElementById('modal-mentor').value.trim();
            const whenLocal = document.getElementById('modal-when').value;
            const duration  = document.getElementById('modal-duration').value;
            const topic     = document.getElementById('modal-topic').value.trim();
            const notes     = document.getElementById('modal-notes').value.trim();
            if (!mentor || !whenLocal || !topic) {
                showMsg('Mentor, fecha/hora y tema son obligatorios', 'error');
                return;
            }
            const submit = document.getElementById('academic-modal-submit');
            submit.disabled = true;
            submit.innerHTML = '<span class="material-symbols-elev">progress_activity</span> Enviando…';
            try {
                const r = await apiFetch('/api/academic/bookings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        mentor_code: mentor,
                        start_at: whenLocal.length === 16 ? whenLocal + ':00' : whenLocal,
                        duration_minutes: parseInt(duration, 10),
                        topic: topic,
                        notes: notes || null,
                    })
                });
                if (r.ok && r.data && r.data.success) {
                    showMsg('Solicitud enviada · el mentor verá la notificación', 'success');
                    setTimeout(() => {
                        academicModal.close();
                        loadMyBookings();
                    }, 1500);
                } else {
                    showMsg(r.data && r.data.error ? r.data.error : 'Error al enviar', 'error');
                }
            } catch (e) {
                showMsg('Error de red', 'error');
            } finally {
                submit.disabled = false;
                submit.innerHTML = '<span class="material-symbols-elev">send</span> Enviar solicitud';
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        wire();
        refreshView();
        loadMyBookings();
        loadUpcoming();
    });
})();
</script>
{% endblock %}
