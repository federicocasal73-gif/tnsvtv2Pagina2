{% extends 'shell.html.twig' %}

{% block title %}Notificaciones · T.N.S.V.T{% endblock %}

{% block topbar_title %}Visiones del Reino{% endblock %}
{% block topbar_subtitle %}En Tiempo Real · Señales del Cónclave{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto"
     data-controller="notifications">
    {# ─── Header ─── #}
    <div class="glass-card-elev flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-[var(--gold-elev,#f2ca50)]/10 flex items-center justify-center border border-[var(--gold-elev,#f2ca50)]/30 pulse-gold">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl">notifications_active</span>
        </div>
        <div class="flex-1">
            <h2 class="text-lg font-semibold text-[var(--on-surface-elev)]">Visiones Recibidas</h2>
            <p class="text-xs text-[var(--outline-elev)]">
                <div class="live-indicator-header" aria-live="polite" aria-atomic="true">
                    <span class="live-dot-notif"></span>
                    <span data-notifications-target="unread">0</span> sin leer
                </div>
            </p>
        </div>
        <button class="action-ui-btn ui-btn-secondary"
                data-notifications-target="markAll"
                data-action="notifications#markAll">
            <span class="material-symbols-outlined align-middle text-sm">done_all</span>
            Marcar todas
        </button>
    </div>

    {# ─── F5: Filter + bulk actions bar ─── #}
    <div class="glass-card-elev p-3 flex flex-wrap items-center gap-2 mb-3">
        <div class="flex items-center gap-1 notif-filters" role="tablist" aria-label="Filtrar notificaciones">
            <button type="button" class="notif-filter is-active" data-filter="all"     role="tab" aria-pressed="true">Todas</button>
            <button type="button" class="notif-filter"        data-filter="unread"  role="tab" aria-pressed="false">Sin leer</button>
            <button type="button" class="notif-filter"        data-filter="comment" role="tab" aria-pressed="false">Comentarios</button>
            <button type="button" class="notif-filter"        data-filter="like"    role="tab" aria-pressed="false">Likes</button>
            <button type="button" class="notif-filter"        data-filter="post"    role="tab" aria-pressed="false">Posts</button>
            <button type="button" class="notif-filter"        data-filter="task"    role="tab" aria-pressed="false">Tareas</button>
        </div>
        <div class="flex-1"></div>
        <button type="button" class="notif-bulk-btn" data-action="notifications#toggleBulk" hidden>
            <span class="material-symbols-elev icon-size-sm" aria-hidden="true">checklist</span>
            <span class="notif-bulk-label">Seleccionar</span>
        </button>
        <button type="button" class="notif-bulk-apply" data-action="notifications#bulkMarkRead" hidden disabled>
            <span class="material-symbols-elev icon-size-sm" aria-hidden="true">done_all</span>
            Marcar leídas <span class="notif-bulk-count" data-notifications-target="bulkCount">(0)</span>
        </button>
    </div>

    {# ─── List ─── #}
    <div class="space-y-2"
         data-notifications-target="list"
         data-action="click->notifications#onListClick">
        <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando visiones...</p>
    </div>
</div>
{% endblock %}