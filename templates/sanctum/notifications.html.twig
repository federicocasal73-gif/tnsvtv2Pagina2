{% extends 'shell.html.twig' %}

{% block title %}Notificaciones · T.N.S.V.T{% endblock %}

{% block topbar_title %}Visiones del Reino{% endblock %}
{% block topbar_subtitle %}En Tiempo Real · Señales del Cónclave{% endblock %}

{% block stylesheets %}
<style>
    .notif-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .notif-card:hover {
        border-color: rgba(242, 202, 80, 0.2);
        box-shadow: 0 0 25px rgba(242, 202, 80, 0.1);
    }
    .vision-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        padding: 1.25rem;
        margin-bottom: 0.75rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        border-left-width: 3px;
    }
    .vision-card:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .vision-card.signal { border-left-color: var(--gold-elev, #f2ca50); }
    .vision-card.revelation { border-left-color: var(--secondary, #d4bbff); }
    .vision-card.message { border-left-color: var(--nebula-purple, #2D1B4E); }
    .vision-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .vision-icon.signal {
        background: rgba(242, 202, 80, 0.1);
        border: 1px solid rgba(242, 202, 80, 0.2);
    }
    .vision-icon.revelation {
        background: rgba(212, 187, 255, 0.1);
        border: 1px solid rgba(212, 187, 255, 0.2);
    }
    .vision-icon.message {
        background: rgba(45, 27, 78, 0.3);
        border: 1px solid rgba(45, 27, 78, 0.5);
    }
    .live-indicator-header {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.125rem 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 9999px;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .live-dot-notif {
        display: inline-block;
        width: 6px;
        height: 6px;
        background: #4ade80;
        border-radius: 50%;
        animation: pulse-gold 1.5s infinite;
        margin-right: 4px;
    }
    .action-btn-primary {
        background: var(--primary, #f2ca50);
        color: var(--void-black, #050308);
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .action-btn-primary:hover {
        background: var(--primary-fixed, #ffe088);
        transform: scale(1.02);
    }
    .action-btn-secondary {
        background: transparent;
        color: var(--on-surface-elev, #e9def6);
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: 1px solid rgba(255, 255, 255, 0.1);
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .action-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: var(--primary, #f2ca50);
    }
</style>
{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto">
    {# ─── Header ─── #}
    <div class="notif-card flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-[var(--gold-elev,#f2ca50)]/10 flex items-center justify-center border border-[var(--gold-elev,#f2ca50)]/30 pulse-gold">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl">notifications_active</span>
        </div>
        <div class="flex-1">
            <h2 class="text-lg font-semibold text-[var(--on-surface-elev)]">Visiones Recibidas</h2>
            <p class="text-xs text-[var(--outline-elev)]">
                <live-indicator-header class="live-indicator-header">
                    <span class="live-dot-notif"></span>
                    <span id="notif-unread">0</span> sin leer
                </live-indicator-header>
            </p>
        </div>
        <button id="notif-mark-all" class="action-btn-secondary">
            <span class="material-symbols-outlined align-middle text-sm">done_all</span>
            Marcar todas
        </button>
    </div>

    {# ─── List ─── #}
    <div id="notif-list" class="space-y-2">
        <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando visiones...</p>
    </div>
</div>

<script>
(function() {
    'use strict';
    var me = (window.TNSVT_USER && window.TNSVT_USER.code) || '';
    var listEl = document.getElementById('notif-list');
    var unreadEl = document.getElementById('notif-unread');

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(m) {
            return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];
        });
    }

    function renderIcon(type) {
        var map = {
            'comment': 'comment',
            'like': 'favorite',
            'post': 'campaign',
            'mention': 'alternate_email',
            'signal': 'trending_up',
            'dm': 'chat_bubble',
            'academia': 'school',
            'task': 'task_alt',
            'access_request': 'person_add',
            'access_accepted': 'check_circle',
            'access_rejected': 'cancel',
            'connection_removed': 'person_off',
            'permissions_changed': 'lock_open',
            'economic_alert': 'event'
        };
        return map[type] || 'notifications';
    }

    function renderLink(type) {
        var map = {
            'comment': '/feed',
            'like': '/feed',
            'post': '/feed',
            'mention': '/feed',
            'signal': '/calendar',
            'dm': '/chat',
            'academia': '/sanctum',
            'task': '/sanctum/tasks',
            'access_request': '/sanctum/social',
            'access_accepted': '/sanctum/social',
            'access_rejected': '/sanctum/social',
            'connection_removed': '/sanctum/social',
            'permissions_changed': '/sanctum/social',
            'economic_alert': '/calendar'
        };
        return map[type] || '/feed';
    }

    async function loadNotifications() {
        var r = await apiFetch('/api/notifications?user_code=' + encodeURIComponent(me));
        if (!r.ok || !Array.isArray(r.data)) {
            listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin notificaciones</p>';
            unreadEl.textContent = '0';
            return;
        }
        var notifs = r.data;
        var unread = notifs.filter(function(n){return !n.read;}).length;
        unreadEl.textContent = unread;

        if (notifs.length === 0) {
            listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin notificaciones todavía</p>';
            return;
        }
        listEl.innerHTML = notifs.map(function(n) {
            var icon = renderIcon(n.type);
            var link = n.link || renderLink(n.type);
            var time = n.ts ? new Date(n.ts).toLocaleString() : '';
            var unread_class = n.read ? '' : 'border-l-4 border-[var(--gold-elev)] bg-[rgba(242,202,80,0.05)]';
            return '<a href="' + escapeHtml(link) + '" data-id="' + n.id + '" class="block glass-card-elev p-3 ' + unread_class + ' hover:bg-[var(--glass-bg-elev)] transition">'
                + '<div class="flex items-start gap-3">'
                + '<span class="material-symbols-elev text-[var(--gold-elev)] mt-0.5">' + icon + '</span>'
                + '<div class="flex-1 min-w-0">'
                + '<p class="text-sm text-[var(--on-surface-elev)]">' + escapeHtml(n.text || '') + '</p>'
                + '<p class="text-xs text-[var(--outline-elev)] mt-1">' + escapeHtml(time) + '</p>'
                + '</div>'
                + (n.read ? '' : '<span class="text-xs text-[var(--gold-elev)] font-semibold">NUEVO</span>')
                + '</div>'
                + '</a>';
        }).join('');
    }

    async function markRead(id, el) {
        var r = await apiFetch('/api/notifications/' + id + '/read?user_code=' + encodeURIComponent(me), {
            method: 'PUT',
            silent: true
        });
        if (r.ok && el) {
            el.classList.remove('border-l-4', 'border-[var(--gold-elev)]', 'bg-[rgba(242,202,80,0.05)]');
            var badge = el.querySelector('.font-semibold');
            if (badge) badge.remove();
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        function boot() {
            if (me) loadNotifications();
            else setTimeout(boot, 500);
        }
        if (window.TNSVT_USER) boot();
        else window.addEventListener('tnsvt:user-loaded', boot, { once: true });

        listEl.addEventListener('click', function(e) {
            var a = e.target.closest('a[data-id]');
            if (!a) return;
            var id = a.dataset.id;
            markRead(id, a);
        });

        document.getElementById('notif-mark-all').addEventListener('click', async function() {
            var r = await apiFetch('/api/notifications/read-all?user_code=' + encodeURIComponent(me), {
                method: 'PUT',
                silent: true
            });
            if (r.ok) {
                if (window.apiToast) apiToast('Todas marcadas como leídas', 'success');
                loadNotifications();
            }
        });
    });
})();
</script>
{% endblock %}
