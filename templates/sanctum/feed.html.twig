{% extends 'shell.html.twig' %}

{% block title %}Salón del Cónclave · T.N.S.V.T{% endblock %}

{% block topbar_title %}Salón del Cónclave{% endblock %}
{% block topbar_subtitle %}Feed comunitario con señales, resultados y proyecciones.{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto">
    {# ─── Composer ─── #}
    <div class="glass-card-elev p-4 mb-4">
        <div class="flex items-center gap-2 mb-3">
            <select id="post-category" class="form-input"
                    style="padding:0.4rem 0.6rem; background:var(--glass-bg-elev); border:1px solid var(--glass-border-elev); border-radius:0.375rem; color:var(--on-surface-elev); font-size:0.875rem;">
                <option value="general" selected>General</option>
                <option value="signal">Señal</option>
                <option value="result">Resultado</option>
                <option value="analysis">Análisis</option>
            </select>
            <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Categoría</span>
        </div>
        <textarea id="post-text" rows="3" placeholder="¿Qué querés compartir con el Sanctum?"
                  class="w-full px-3 py-2 rounded-lg bg-[var(--glass-bg-elev)] border border-[var(--glass-border-elev)] text-[var(--on-surface-elev)] resize-none"
                  style="font-family: inherit;"></textarea>
        <div class="flex items-center justify-end gap-2 mt-3">
            <button id="post-publish" class="btn-primary">
                <span class="material-symbols-elev align-middle text-sm">send</span>
                Publicar
            </button>
        </div>
    </div>

    {# ─── Feed list ─── #}
    <div id="feed-list" class="space-y-4">
        <p class="text-center text-[var(--outline-elev)] py-8">Cargando feed...</p>
    </div>
</div>

<style>
.feed-post { padding: 1rem; }
.feed-header { display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem; }
.feed-avatar { width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,var(--gold-elev),var(--gold-bright-elev)); display:flex; align-items:center; justify-content:center; font-weight:600; color:var(--on-primary-elev); }
.feed-author { font-weight:600; font-size:0.875rem; }
.feed-time { font-size:0.7rem; color:var(--outline-elev); margin-left:auto; }
.feed-cat { display:inline-block; padding:0.15rem 0.5rem; font-size:0.65rem; font-weight:600; border-radius:0.75rem; background:var(--glass-bg-strong-elev); color:var(--gold-elev); text-transform:uppercase; letter-spacing:0.05em; }
.feed-text { font-size:0.9375rem; line-height:1.5; color:var(--on-surface-elev); white-space:pre-wrap; word-break:break-word; }
.feed-photo { max-width:100%; border-radius:0.5rem; margin-top:0.75rem; }
.feed-actions { display:flex; gap:0.5rem; margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid var(--glass-border-elev); }
.feed-action-btn { display:flex; align-items:center; gap:0.375rem; padding:0.375rem 0.75rem; background:transparent; border:none; color:var(--outline-elev); cursor:pointer; font-size:0.8rem; border-radius:0.375rem; }
.feed-action-btn:hover { background:var(--glass-bg-elev); color:var(--gold-elev); }
.feed-action-btn.liked { color:#f87171; }
</style>

<script>
(function() {
    'use strict';
    const listEl = document.getElementById('feed-list');
    const textEl = document.getElementById('post-text');
    const catEl = document.getElementById('post-category');
    const publishBtn = document.getElementById('post-publish');
    const me = () => (window.TNSVT_USER && window.TNSVT_USER.code) || '';

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    async function loadFeed() {
        const r = await apiFetch('/api/feed');
        if (!r.ok || !r.data) {
            listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin datos disponibles</p>';
            return;
        }
        const posts = Array.isArray(r.data) ? r.data : [];
        if (posts.length === 0) {
            listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin publicaciones. ¡Sé el primero en escribir!</p>';
            return;
        }
        listEl.innerHTML = posts.map(p => {
            const initial = (p.author_name || p.author_code || '?').slice(0, 1).toUpperCase();
            const time = p.created_at ? new Date(p.created_at).toLocaleString() : '';
            const photo = p.photo ? `<img src="${escapeHtml(p.photo)}" class="feed-photo" />` : '';
            const likes = p.likes || 0;
            const comments = (p.comments || []).length;
            return `
                <article class="glass-card-elev feed-post" data-id="${p.id}">
                    <div class="feed-header">
                        <div class="feed-avatar">${escapeHtml(initial)}</div>
                        <div>
                            <div class="feed-author">${escapeHtml(p.author_name || p.author_code)}</div>
                            <div class="feed-time">${escapeHtml(p.author_code)} · ${escapeHtml(time)}</div>
                        </div>
                        <span class="feed-cat">${escapeHtml(p.cat || 'general')}</span>
                    </div>
                    <div class="feed-text">${escapeHtml(p.text || '')}</div>
                    ${photo}
                    <div class="feed-actions">
                        <button class="feed-action-btn" data-action="like" data-id="${p.id}">
                            <span class="material-symbols-elev text-base">favorite</span>
                            <span>${likes}</span>
                        </button>
                        <button class="feed-action-btn" data-action="comment" data-id="${p.id}">
                            <span class="material-symbols-elev text-base">chat_bubble</span>
                            <span>${comments}</span>
                        </button>
                    </div>
                </article>
            `;
        }).join('');
    }

    async function publish() {
        const text = textEl.value.trim();
        if (!text) return;

        publishBtn.disabled = true;
        const r = await apiFetch('/api/feed', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                code: me(),
                text: text,
                cat: catEl.value,
            })
        });
        publishBtn.disabled = false;

        if (r.ok && r.data && (r.data.success || r.data.id)) {
            textEl.value = '';
            if (window.apiToast) apiToast('Publicación creada', 'success');
            await loadFeed();
        } else {
            const msg = (r.data && (r.data.error || r.data.message)) || 'Error';
            if (window.apiToast) apiToast(msg, 'error');
        }
    }

    async function toggleLike(postId, btn) {
        const r = await apiFetch(`/api/feed/${postId}/like`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: me() })
        });
        if (r.ok && r.data && r.data.likes !== undefined) {
            btn.classList.add('liked');
            const span = btn.querySelector('span:last-child');
            if (span) span.textContent = r.data.likes;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        publishBtn.addEventListener('click', publish);

        listEl.addEventListener('click', (e) => {
            const likeBtn = e.target.closest('[data-action="like"]');
            if (likeBtn) {
                toggleLike(likeBtn.dataset.id, likeBtn);
                return;
            }
            const commentBtn = e.target.closest('[data-action="comment"]');
            if (commentBtn) {
                if (window.apiToast) apiToast('Comentarios próximamente', 'info');
            }
        });

        function boot() {
            if (me()) loadFeed();
            else setTimeout(boot, 1000);
        }
        if (window.TNSVT_USER) boot();
        else window.addEventListener('tnsvt:user-loaded', boot, { once: true });
    });
})();
</script>
{% endblock %}