{% extends 'shell.html.twig' %}

{% block title %}Settings · T.N.S.V.T{% endblock %}

{% block topbar_title %}Settings · Configuración Global{% endblock %}
{% block topbar_subtitle %}Feature flags, tier prices, límites del sistema{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto"
     data-controller="settings"
     data-settings-user-code-value="{{ app.user.code ?? '' }}">
    <div class="glass-card-elev p-6 mb-6">
        <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)] flex items-center gap-2">
            <span class="material-symbols-elev text-[var(--gold-elev)]">person</span>
            Mis Preferencias
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="form-label">Sonido de Notificación</label>
                <select data-settings-target="sound"
                        data-action="change->settings#savePreference"
                        class="form-input">
                    <option value="chime">🔔 Chime</option>
                    <option value="mario_coin">🍄 Mario Coin</option>
                    <option value="zelda_secret">🗡️ Zelda Secret</option>
                    <option value="sonic_ring">💍 Sonic Ring</option>
                    <option value="apple_tritone">🍎 Apple Tritone</option>
                    <option value="pixel_popcorn">🍿 Pixel Popcorn</option>
                    <option value="pokemon_levelup">⚡ Pokemon Levelup</option>
                    <option value="deus_ex_scan">🔍 Deus Ex Scan</option>
                    <option value="indiana_jones_whip">🏃 Indiana Jones Whip</option>
                    <option value="msn_message">💬 MSN Message</option>
                    <option value="swoosh">💨 Swoosh</option>
                </select>
            </div>
        </div>
        <button data-settings-target="savePrefsBtn"
                data-action="click->settings#saveAll"
                class="btn-primary mt-4">Guardar Preferencias</button>
    </div>

    <div class="glass-card-elev p-4 mb-6 flex items-center justify-between">
        <div>
            <p class="text-sm text-[var(--on-surface-elev)]">Configuración global del Sanctum</p>
            <p class="text-xs text-[var(--outline-elev)]">Los cambios se aplican inmediatamente a todos los usuarios</p>
        </div>
        <button data-action="click->settings#reload" class="btn-elev-secondary text-xs">
            <span class="material-symbols-elev align-middle text-sm">refresh</span>
            Recargar
        </button>
    </div>

    <div data-settings-target="container">
        <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando configuración...</p>
    </div>
</div>

<style>
.toggle-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    cursor: pointer;
}
.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}
.toggle-slider {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--glass-border-elev);
    border-radius: 12px;
    transition: 0.3s;
}
.toggle-slider::before {
    content: "";
    position: absolute;
    height: 18px; width: 18px;
    left: 3px; bottom: 3px;
    background: var(--on-surface-elev);
    border-radius: 50%;
    transition: 0.3s;
}
.toggle-switch input:checked + .toggle-slider {
    background: var(--gold-elev);
}
.toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(20px);
}
</style>
{% endblock %}