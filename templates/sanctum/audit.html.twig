{% extends 'shell.html.twig' %}

{% block title %}Audit Log · T.N.S.V.T{% endblock %}

{% block topbar_title %}Audit Log{% endblock %}
{% block topbar_subtitle %}Registro de acciones administrativas{% endblock %}

{% block content %}
    <div class="glass-card-elev p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-[var(--on-surface-elev)]">Audit Log</h3>
            <div class="flex gap-2 text-xs">
                <select id="filter-action" class="px-2 py-1 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)]">
                    <option value="">Todas las acciones</option>
                    <option value="login">Login</option>
                    <option value="user">User</option>
                    <option value="admin">Admin</option>
                </select>
                <button id="refresh-audit" class="btn-elev-secondary text-xs">
                    <span class="material-symbols-elev text-sm align-middle">refresh</span>
                    Actualizar
                </button>
            </div>
        </div>
        <div id="audit-list" class="overflow-x-auto">
            <p class="text-[var(--outline-elev)] text-center py-8 loading-pulse">Cargando audit log...</p>
        </div>
        <div id="audit-pagination" class="mt-4 flex justify-center gap-2 text-xs"></div>
    </div>

    <script>
    (async function() {
        let currentPage = 1;
        const perPage = 25;

        async function loadAudit() {
            const container = document.getElementById('audit-list');
            const action = document.getElementById('filter-action').value;
            container.classList.add('loading-pulse');
            container.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Cargando...</p>';
            try {
                let url = '/sanctum/api/audit?page=' + currentPage + '&per_page=' + perPage;
                if (action) url += '&action=' + action;
                const r = await fetch(url);
                if (!r.ok) throw new Error('HTTP ' + r.status);
                const data = await r.json();
                if (!data.success) throw new Error(data.error || 'unknown');

                if (data.entries.length === 0) {
                    container.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin entradas de audit. Las acciones admin se loguean automáticamente.</p>';
                    return;
                }

                container.innerHTML = `
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Time</th>
                                <th>Admin</th>
                                <th>Action</th>
                                <th>Result</th>
                                <th>IP</th>
                                <th>UA</th>
                            </tr>
                        </thead>
                        <tbody>
                        ${data.entries.map(e => `
                            <tr>
                                <td>${e.id}</td>
                                <td>${e.createdAt}</td>
                                <td><code>${e.admin || ''}</code></td>
                                <td>${e.action}</td>
                                <td>${e.result === 'success' ? '<span class="status-pill status-completed">OK</span>' : '<span class="status-pill status-inactive">FAIL</span>'}</td>
                                <td>${e.ip || ''}</td>
                                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis">${e.userAgent || ''}</td>
                            </tr>
                        `).join('')}
                        </tbody>
                    </table>
                `;
                // Pagination
                const pag = data.pagination;
                const pagHtml = [];
                if (pag.page > 1) pagHtml.push(`<button class="btn-action btn-toggle" data-page="${pag.page - 1}">← Anterior</button>`);
                pagHtml.push(`<span class="px-2 text-[var(--on-surface-variant-elev)]">Página ${pag.page} de ${pag.pages} (${pag.total} total)</span>`);
                if (pag.page < pag.pages) pagHtml.push(`<button class="btn-action btn-toggle" data-page="${pag.page + 1}">Siguiente →</button>`);
                document.getElementById('audit-pagination').innerHTML = pagHtml.join('');
                document.querySelectorAll('#audit-pagination [data-page]').forEach(b => b.addEventListener('click', e => { currentPage = parseInt(e.target.dataset.page); loadAudit(); }));
            } catch (e) {
                container.innerHTML = '<p class="text-red-400 text-center py-8">Error: ' + e.message + '</p>';
            }
            container.classList.remove('loading-pulse');
        }

        document.getElementById('refresh-audit').addEventListener('click', loadAudit);
        document.getElementById('filter-action').addEventListener('change', () => { currentPage = 1; loadAudit(); });
        loadAudit();
    })();
    </script>
{% endblock %}