{% extends 'shell.html.twig' %}

{% block title %}Social · T.N.S.V.T{% endblock %}

{% block topbar_title %}Social{% endblock %}
{% block topbar_subtitle %}Conexiones y acceso a Journals de otros miembros.{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto">
    {# ─── Tabs ─── #}
    <div class="glass-card-elev p-4 mb-4">
        <div class="flex gap-2 mb-3 border-b border-[var(--outline-variant-elev)] pb-2">
            <button data-tab="users" class="social-tab px-4 py-2 rounded text-sm font-semibold bg-[var(--glass-bg-elev)] text-[var(--gold-elev)]">Buscar usuarios</button>
            <button data-tab="received" class="social-tab px-4 py-2 rounded text-sm">Solicitudes recibidas <span id="received-badge" class="hidden ml-1 px-2 rounded-full bg-[var(--gold-elev)] text-black text-xs font-bold">0</span></button>
            <button data-tab="sent" class="social-tab px-4 py-2 rounded text-sm">Solicitudes enviadas <span id="sent-badge" class="hidden ml-1 px-2 rounded-full bg-[var(--outline-elev)] text-white text-xs">0</span></button>
            <button data-tab="connections" class="social-tab px-4 py-2 rounded text-sm">Conexiones <span id="conn-badge" class="hidden ml-1 px-2 rounded-full bg-[var(--outline-elev)] text-white text-xs">0</span></button>
        </div>

        {# Users list #}
        <div id="tab-users" class="social-panel">
            <p class="text-xs text-[var(--outline-elev)] mb-3">Otros miembros del Sanctum. Click para enviar solicitud de acceso a su journal.</p>
            <div id="users-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2">
                <p class="text-center text-[var(--outline-elev)] py-8 col-span-full">Cargando...</p>
            </div>
        </div>

        {# Received requests #}
        <div id="tab-received" class="social-panel hidden">
            <p class="text-xs text-[var(--outline-elev)] mb-3">Solicitudes que otros miembros enviaron para ver tu journal.</p>
            <div id="received-list" class="space-y-2">
                <p class="text-center text-[var(--outline-elev)] py-8">Cargando...</p>
            </div>
        </div>

        {# Sent requests #}
        <div id="tab-sent" class="social-panel hidden">
            <p class="text-xs text-[var(--outline-elev)] mb-3">Solicitudes que enviaste a otros miembros.</p>
            <div id="sent-list" class="space-y-2">
                <p class="text-center text-[var(--outline-elev)] py-8">Cargando...</p>
            </div>
        </div>

        {# Connections #}
        <div id="tab-connections" class="social-panel hidden">
            <p class="text-xs text-[var(--outline-elev)] mb-3">Miembros con los que tenés conexión. Click para ver su journal o eliminar.</p>
            <div id="conn-list" class="space-y-2">
                <p class="text-center text-[var(--outline-elev)] py-8">Cargando...</p>
            </div>
        </div>
    </div>
</div>

<style>
.social-tab.active {
    background: var(--glass-bg-elev) !important;
    color: var(--gold-elev) !important;
}
.social-user-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--glass-bg-elev);
    border: 1px solid var(--glass-border-elev);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
}
.social-user-card:hover {
    border-color: var(--gold-elev);
}
.social-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--gold-elev), var(--gold-bright-elev));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--on-primary-elev);
    flex-shrink: 0;
}
</style>

<script>
(function() {
    'use strict';
    var me = (window.TNSVT_USER && window.TNSVT_USER.code) || '';
    var currentTab = 'users';

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(m) {
            return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];
        });
    }

    function initials(name) {
        return (name || '?').slice(0, 2).toUpperCase();
    }

    function statusBadge(status) {
        var map = {
            'owner': '<span class="px-2 py-1 rounded-full bg-[var(--gold-elev)] text-black text-xs font-bold">Tú</span>',
            'connected': '<span class="px-2 py-1 rounded-full bg-emerald-700 text-emerald-200 text-xs">Conectado</span>',
            'pending_sent': '<span class="px-2 py-1 rounded-full bg-amber-700 text-amber-200 text-xs">Pendiente enviada</span>',
            'pending_received': '<span class="px-2 py-1 rounded-full bg-blue-700 text-blue-200 text-xs">Pendiente recibida</span>',
            'none': '<button class="btn-elev-secondary text-xs connect-btn">Conectar</button>',
            'blocked': '<span class="px-2 py-1 rounded-full bg-red-900 text-red-300 text-xs">Bloqueado</span>'
        };
        return map[status] || '';
    }

    async function loadUsers() {
        var r = await apiFetch('/sanctum/social/api/users?user_code=' + encodeURIComponent(me));
        var list = document.getElementById('users-list');
        if (!r.ok || !r.data || !r.data.users) {
            list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8 col-span-full">Sin datos</p>';
            return;
        }
        var users = r.data.users;
        list.innerHTML = users.map(function(u) {
            return '<div class="social-user-card" data-code="' + escapeHtml(u.code) + '">'
                + '<div class="social-avatar">' + escapeHtml(initials(u.name)) + '</div>'
                + '<div class="flex-1 min-w-0">'
                + '<div class="font-semibold text-sm">' + escapeHtml(u.name) + '</div>'
                + '<div class="text-xs text-[var(--outline-elev)]">' + escapeHtml(u.code) + (u.is_admin ? ' • admin' : '') + '</div>'
                + '</div>'
                + '<div data-status="' + escapeHtml(u.status) + '">' + statusBadge(u.status) + '</div>'
                + '</div>';
        }).join('');

        list.querySelectorAll('.connect-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var card = btn.closest('.social-user-card');
                sendRequest(card.dataset.code);
            });
        });
    }

    async function loadReceivedRequests() {
        var r = await apiFetch('/api/access-request?user_code=' + encodeURIComponent(me));
        var list = document.getElementById('received-list');
        if (!r.ok || !r.data || !r.data.received) {
            list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin solicitudes</p>';
            return;
        }
        var recs = r.data.received;
        if (recs.length === 0) {
            list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin solicitudes recibidas</p>';
            document.getElementById('received-badge').classList.add('hidden');
            return;
        }
        document.getElementById('received-badge').textContent = recs.length;
        document.getElementById('received-badge').classList.remove('hidden');
        list.innerHTML = recs.map(function(r) {
            return '<div class="glass-card-elev p-3 flex items-center gap-3">'
                + '<div class="social-avatar">' + escapeHtml(initials(r.requester_name)) + '</div>'
                + '<div class="flex-1">'
                + '<div class="font-semibold">' + escapeHtml(r.requester_name) + '</div>'
                + '<div class="text-xs text-[var(--outline-elev)]">' + escapeHtml(r.requester_code) + ' • ' + escapeHtml(r.created_at) + '</div>'
                + '</div>'
                + '<button class="btn-elev-secondary text-xs" data-id="' + r.id + '" data-action="accept">Aceptar</button>'
                + '<button class="btn-elev-secondary text-xs" data-id="' + r.id + '" data-action="reject" style="color:#f87171">Rechazar</button>'
                + '</div>';
        }).join('');

        list.querySelectorAll('[data-action]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                respondRequest(parseInt(btn.dataset.id), btn.dataset.action);
            });
        });
    }

    function loadSentRequests() {
        apiFetch('/api/access-request?user_code=' + encodeURIComponent(me)).then(function(r) {
            var list = document.getElementById('sent-list');
            if (!r.ok || !r.data || !r.data.sent) {
                list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin solicitudes enviadas</p>';
                return;
            }
            var sents = r.data.sent;
            if (sents.length === 0) {
                list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin solicitudes enviadas</p>';
                document.getElementById('sent-badge').classList.add('hidden');
                return;
            }
            document.getElementById('sent-badge').textContent = sents.length;
            document.getElementById('sent-badge').classList.remove('hidden');
            list.innerHTML = sents.map(function(s) {
                var color = s.status === 'accepted' ? 'text-emerald-400' : s.status === 'rejected' ? 'text-red-400' : 'text-amber-400';
                return '<div class="glass-card-elev p-3 flex items-center gap-3">'
                    + '<div class="social-avatar">' + escapeHtml(initials(s.target_name)) + '</div>'
                    + '<div class="flex-1">'
                    + '<div class="font-semibold">' + escapeHtml(s.target_name) + '</div>'
                    + '<div class="text-xs text-[var(--outline-elev)]">' + escapeHtml(s.target_code) + '</div>'
                    + '</div>'
                    + '<span class="text-xs ' + color + ' font-semibold">' + s.status.toUpperCase() + '</span>'
                    + '</div>';
            }).join('');
        });
    }

    function loadConnections() {
        apiFetch('/api/connections?user_code=' + encodeURIComponent(me)).then(function(r) {
            var list = document.getElementById('conn-list');
            if (!r.ok || !r.data || !r.data.connections) {
                list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin conexiones</p>';
                return;
            }
            var conns = r.data.connections;
            if (conns.length === 0) {
                list.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8">Sin conexiones todavía</p>';
                document.getElementById('conn-badge').classList.add('hidden');
                return;
            }
            document.getElementById('conn-badge').textContent = conns.length;
            document.getElementById('conn-badge').classList.remove('hidden');
            list.innerHTML = conns.map(function(c) {
                return '<div class="glass-card-elev p-3 flex items-center gap-3">'
                    + '<div class="social-avatar">' + escapeHtml(initials(c.user_name)) + '</div>'
                    + '<div class="flex-1">'
                    + '<div class="font-semibold">' + escapeHtml(c.user_name) + '</div>'
                    + '<div class="text-xs text-[var(--outline-elev)]">' + escapeHtml(c.user_code) + ' • desde ' + escapeHtml(c.created_at.slice(0, 10)) + '</div>'
                    + '</div>'
                    + '<button class="btn-elev-secondary text-xs" data-id="' + c.id + '" data-action="view-journal">Ver journal</button>'
                    + '<button class="btn-elev-secondary text-xs" data-id="' + c.id + '" data-action="remove" style="color:#f87171">Eliminar</button>'
                    + '</div>';
            }).join('');

            list.querySelectorAll('[data-action="remove"]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    removeConnection(parseInt(btn.dataset.id));
                });
            });
            list.querySelectorAll('[data-action="view-journal"]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var card = btn.closest('.glass-card-elev');
                    var name = card.querySelector('.font-semibold').textContent;
                    window.location.href = '/sanctum/social?view_user=' + encodeURIComponent(name);
                });
            });
        });
    }

    async function sendRequest(targetCode) {
        var r = await apiFetch('/api/access-request?user_code=' + encodeURIComponent(me), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_code: me, target_code: targetCode })
        });
        if (r.ok && r.data && r.data.success) {
            if (window.apiToast) apiToast('Solicitud enviada', 'success');
            loadUsers();
            loadSentRequests();
        } else {
            var msg = (r.data && r.data.error) || 'Error';
            if (window.apiToast) apiToast(msg, 'error');
        }
    }

    async function respondRequest(id, action) {
        var status = action === 'accept' ? 'accepted' : 'rejected';
        var r = await apiFetch('/api/access-request/' + id + '?user_code=' + encodeURIComponent(me), {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_code: me, status: status })
        });
        if (r.ok && r.data && r.data.success) {
            if (window.apiToast) apiToast('Solicitud ' + (status === 'accepted' ? 'aceptada' : 'rechazada'), 'success');
            loadReceivedRequests();
            loadUsers();
        } else {
            var msg = (r.data && r.data.error) || 'Error';
            if (window.apiToast) apiToast(msg, 'error');
        }
    }

    async function removeConnection(id) {
        if (!confirm('¿Eliminar esta conexión?')) return;
        var r = await apiFetch('/api/connections/' + id + '?user_code=' + encodeURIComponent(me), {
            method: 'DELETE',
            silent: true
        });
        if (r.ok) {
            if (window.apiToast) apiToast('Conexión eliminada', 'success');
            loadConnections();
            loadUsers();
        }
    }

    function showTab(name) {
        currentTab = name;
        document.querySelectorAll('.social-tab').forEach(function(t) {
            t.classList.toggle('active', t.dataset.tab === name);
        });
        document.querySelectorAll('.social-panel').forEach(function(p) {
            p.classList.toggle('hidden', p.id !== 'tab-' + name);
        });
        if (name === 'received') loadReceivedRequests();
        else if (name === 'sent') loadSentRequests();
        else if (name === 'connections') loadConnections();
        else loadUsers();
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.social-tab').forEach(function(t) {
            t.addEventListener('click', function() { showTab(t.dataset.tab); });
        });

        function boot() {
            if (me) {
                loadUsers();
                loadReceivedRequests();
                loadSentRequests();
                loadConnections();
            } else setTimeout(boot, 500);
        }
        if (window.TNSVT_USER) boot();
        else window.addEventListener('tnsvt:user-loaded', boot, { once: true });
    });
})();
</script>
{% endblock %}
