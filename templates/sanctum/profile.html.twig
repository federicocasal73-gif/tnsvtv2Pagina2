{% extends 'shell.html.twig' %}

{% block title %}Perfil · T.N.S.V.T{% endblock %}

{% block meta_description %}Tu perfil y seguridad en el Sanctum. Identidad celestial, tier, disciplina, reputación, coins, wallet y avatar.{% endblock %}

{% block topbar_title %}Perfil y Seguridad{% endblock %}
{% block topbar_subtitle %}Identidad Celestial · Tier · Disciplina{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
<h1 class="page-title text-cinzel-display text-2xl md:text-3xl tracking-wide mb-6">{{ block('topbar_title') }}</h1>

<div class="max-w-2xl mx-auto pb-24" data-controller="profile">
    {# ─── Profile Hero (3D Sacred Sigil removed in cleanup 2026-09-28) ─── #}
    <div class="glass-card-elev">
        <div class="text-center mb-4">
            <p class="font-label-sm text-label-sm text-primary uppercase tracking-widest">Identidad Celestial</p>
        </div>
        <div class="flex items-center gap-4 mb-6">
            <div class="relative">
                <div id="profile-avatar" class="w-20 h-20 rounded-full bg-gradient-to-br from-[var(--gold-elev)] to-[var(--gold-bright-elev)] flex items-center justify-center text-2xl font-bold text-[var(--on-primary-elev)] overflow-hidden border-2 border-[var(--gold-elev)]/30">
                    <img id="avatar-img" src="" alt="Avatar" width="96" height="96" class="w-full h-full object-cover" style="display:none;" decoding="async">
                    <span id="avatar-initial">?</span>
                </div>
                <label class="absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-[var(--gold-elev)] flex items-center justify-center cursor-pointer hover:scale-110 transition-transform" title="Cambiar avatar">
                    <span class="material-symbols-elev icon-size-xs text-black">camera_alt</span>
                    <input type="file" id="avatar-input" accept="image/*" class="hidden">
                </label>
            </div>
            <div class="flex-1">
                <h2 id="profile-name" class="text-xl font-bold">Cargando...</h2>
                <div class="flex items-center gap-2 mt-0.5">
                    <p id="profile-code" class="text-sm text-[var(--outline-elev)]">—</p>
                    <button type="button" id="profile-code-copy" class="text-[var(--outline-elev)] hover:text-[var(--gold-elev)] transition-colors" title="Copiar código" aria-label="Copiar código" style="display:none;">
                        <span class="material-symbols-elev icon-size-sm" aria-hidden="true">content_copy</span>
                    </button>
                    <button type="button" id="profile-share" class="text-[var(--outline-elev)] hover:text-[var(--gold-elev)] transition-colors" title="Compartir perfil" aria-label="Compartir perfil" style="display:none;">
                        <span class="material-symbols-elev icon-size-sm" aria-hidden="true">share</span>
                    </button>
                </div>
                <div class="flex items-center gap-2 mt-1">
                    <span id="profile-tier" class="tier-badge-elev">—</span>
                    <span id="profile-vip" class="text-xs px-2 py-0.5 rounded-full bg-gradient-to-r from-amber-500 to-yellow-400 text-black font-semibold" style="display:none;">VIP</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-3 text-center">
            <div class="stat-mini">
                <div id="profile-reputation" class="stat-mini-value">—</div>
                <div class="stat-mini-label">Reputación</div>
            </div>
            <div class="stat-mini">
                <div id="profile-coins" class="stat-mini-value">—</div>
                <div class="stat-mini-label">Coins</div>
            </div>
            <div class="stat-mini">
                <div id="profile-wallet" class="stat-mini-value">—</div>
                <div class="stat-mini-label">Wallet</div>
            </div>
        </div>
    </div>

    {# ─── Edit Profile ─── #}
    <div class="glass-card-elev">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-4 flex items-center gap-2">
            <span class="material-symbols-elev">edit</span>
            Editar Perfil
        </h3>
        <div class="space-y-4">
            <div>
                <label class="form-label">Nombre</label>
                <input id="edit-name" type="text" class="form-input" placeholder="Tu nombre">
            </div>
            <div>
                <label class="form-label">Sonido de Notificación</label>
                <select id="edit-sound" class="form-input">
                    <option value="chime">Chime</option>
                    <option value="mario_coin">Mario Coin</option>
                    <option value="zelda_secret">Zelda Secret</option>
                    <option value="sonic_ring">Sonic Ring</option>
                    <option value="apple_tritone">Apple Tritone</option>
                    <option value="pixel_popcorn">Pixel Popcorn</option>
                    <option value="pokemon_levelup">Pokemon Levelup</option>
                    <option value="deus_ex_scan">Deus Ex Scan</option>
                    <option value="indiana_jones_whip">Indiana Jones Whip</option>
                    <option value="msn_message">MSN Message</option>
                    <option value="swoosh">Swoosh</option>
                </select>
            </div>
            <button id="save-profile" class="ui-btn ui-btn-primary w-full">Guardar Cambios</button>
        </div>
    </div>

    {# ─── Journal Stats ─── #}
    <div class="glass-card-elev p-6">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-4 flex items-center gap-2">
            <span class="material-symbols-elev">analytics</span>
            Estadísticas de Trading
        </h3>
        <div id="journal-stats" class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="text-center p-3 glass-card-elev">
                <div id="js-total" class="text-lg font-bold">—</div>
                <div class="text-xs text-[var(--outline-elev)]">Total</div>
            </div>
            <div class="text-center p-3 glass-card-elev">
                <div id="js-wins" class="text-lg font-bold text-green-400">—</div>
                <div class="text-xs text-[var(--outline-elev)]">Wins</div>
            </div>
            <div class="text-center p-3 glass-card-elev">
                <div id="js-winrate" class="text-lg font-bold text-[var(--gold-elev)]">—</div>
                <div class="text-xs text-[var(--outline-elev)]">Win Rate</div>
            </div>
            <div class="text-center p-3 glass-card-elev">
                <div id="js-pnl" class="text-lg font-bold">—</div>
                <div class="text-xs text-[var(--outline-elev)]">PnL</div>
            </div>
        </div>
    </div>

    {# ─── Progreso Personal (Fase 5) ─── #}
    {% import '_partials/components/_progress.html.twig' as progress %}
    <div class="space-y-4">
        {{ progress.streak_widget() }}
        {{ progress.heatmap_widget() }}
        {{ progress.achievements_widget() }}
    </div>

    {# ─── Mail y Contraseña (verificación en dos pasos) ─── #}
    <div class="glass-card-elev">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-4 flex items-center gap-2">
            <span class="material-symbols-elev">mark_as_unread</span>
            Mail y Contraseña
        </h3>
        <div class="space-y-4">
            <div>
                <label class="form-label" for="sec-email">Mail <span id="sec-email-badge" class="text-xs"></span></label>
                <div class="flex gap-2">
                    <input id="sec-email" type="email" class="form-input flex-1" autocomplete="email" placeholder="vos@mail.com">
                    <button id="sec-email-send" type="button" class="ui-btn ui-btn-secondary">Enviar código</button>
                </div>
            </div>
            <div id="sec-email-code-row" style="display:none;">
                <label class="form-label" for="sec-email-code">Código de 6 dígitos</label>
                <div class="flex gap-2">
                    <input id="sec-email-code" type="text" class="form-input flex-1" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000">
                    <button id="sec-email-verify" type="button" class="ui-btn ui-btn-primary">Verificar</button>
                </div>
                <p class="text-xs text-[var(--outline-elev)] mt-1">Vale 2 minutos. <button type="button" id="sec-email-resend" class="linklike" disabled>Reenviar (<span id="sec-email-timer">60</span>s)</button></p>
            </div>
            <div class="text-xs text-[var(--outline-elev)]" id="sec-2fa-status">Verificación en dos pasos: —</div>
            <hr class="border-[var(--outline-variant-elev)]">
            <div>
                <label class="form-label" for="sec-pass-current">Contraseña actual <span class="text-xs text-[var(--outline-elev)]">(vacío si aún no tenés)</span></label>
                <input id="sec-pass-current" type="password" class="form-input" autocomplete="current-password" placeholder="••••••••••">
            </div>
            <div>
                <label class="form-label" for="sec-pass-new">Nueva contraseña <span class="text-xs text-[var(--outline-elev)]">(mínimo 10 caracteres)</span></label>
                <input id="sec-pass-new" type="password" class="form-input" autocomplete="new-password" placeholder="Mínimo 10 caracteres">
            </div>
            <div>
                <label class="form-label" for="sec-pass-code">Código de tu mail verificado <span class="text-xs text-[var(--outline-elev)]">(vale 2 minutos)</span></label>
                <div class="flex gap-2">
                    <input id="sec-pass-code" type="text" class="form-input flex-1" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000">
                    <button id="sec-pass-send" type="button" class="ui-btn ui-btn-secondary">Enviar código</button>
                </div>
            </div>
            <button id="sec-pass-save" type="button" class="ui-btn ui-btn-primary w-full">Guardar contraseña</button>
            <p class="text-xs text-[var(--outline-elev)] mt-1">El código de arriba es solo para este cambio (vale 2 minutos). Si no recordás tu contraseña actual, <a href="/login" class="linklike">cerrá sesión</a> y usá «¿Olvidaste tu contraseña?» en el login — ese flujo no la pide.</p>
        </div>
    </div>

    {# ─── Security Settings ─── #}
    <div class="glass-card-elev">
        <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-4 flex items-center gap-2">
            <span class="material-symbols-elev">shield</span>
            Protocolos de Seguridad
            <span class="ml-auto text-[10px] font-semibold tracking-wider uppercase px-2 py-0.5 rounded-full border border-[var(--outline-variant-elev)] text-[var(--outline-elev)]" title="Próximamente">Próximamente</span>
        </h3>
        <div class="toggle-row opacity-60">
            <div class="flex items-center gap-3">
                <span class="material-symbols-elev text-[var(--gold-elev)]">fingerprint</span>
                <div>
                    <p class="text-sm text-[var(--on-surface-elev)] font-medium">Bloqueo por Huella</p>
                    <p class="text-xs text-[var(--outline-elev)]">Acceso biométrico al Sanctum</p>
                </div>
            </div>
            <div class="toggle-switch active" id="toggle-biometric" aria-disabled="true" title="Próximamente"></div>
        </div>
        <div class="toggle-row opacity-60">
            <div class="flex items-center gap-3">
                <span class="material-symbols-elev text-[var(--gold-elev)]">password</span>
                <div>
                    <p class="text-sm text-[var(--on-surface-elev)] font-medium">PIN de Seguridad</p>
                    <p class="text-xs text-[var(--outline-elev)]">Código de 6 dígitos</p>
                </div>
            </div>
            <button type="button" class="text-[var(--gold-elev)] text-xs font-medium opacity-60 cursor-not-allowed" disabled aria-disabled="true" title="Próximamente">Configurar</button>
        </div>
        <div class="toggle-row opacity-60">
            <div class="flex items-center gap-3">
                <span class="material-symbols-elev text-[var(--gold-elev)]">notifications_active</span>
                <div>
                    <p class="text-sm text-[var(--on-surface-elev)] font-medium">Notificaciones Push</p>
                    <p class="text-xs text-[var(--outline-elev)]">Recibir alertas en tiempo real</p>
                </div>
            </div>
            <div class="toggle-switch active" id="toggle-notifs" aria-disabled="true" title="Próximamente"></div>
        </div>
    </div>

    {# ─── Danger Zone ─── #}
    <div class="danger-zone">
        <h3 class="text-sm font-semibold text-[var(--error)] uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="material-symbols-elev">warning</span>
            Danger Zone
        </h3>
        <p class="text-xs text-[var(--outline-elev)] mb-4">Acciones irreversibles. Proceder con cuidado.</p>
        <button type="button" disabled aria-disabled="true" title="Próximamente" class="w-full py-2 px-4 border border-[var(--error)]/50 text-[var(--error)] rounded-lg text-sm font-medium opacity-60 cursor-not-allowed">
            Disolver Vínculo Soul Sigil · Próximamente
        </button>
    </div>
</div>
{% endblock %}
