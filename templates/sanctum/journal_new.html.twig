{% extends 'shell.html.twig' %}

{% block title %}Asentar Operación · T.N.S.V.T{% endblock %}

{% block topbar_title %}Asentar Operación{% endblock %}
{% block topbar_subtitle %}"Lo que no se registra, no se domina."{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="trade-form-wrap" data-controller="account-switcher">

    <div class="trade-form-header">
        <span class="material-symbols-elev icon-size-lg" style="color: var(--gold-elev);">edit_note</span>
        <h1 class="text-cinzel-display" style="font-size: 1.7rem; margin: 0.5rem 0 0.25rem;">ASENTAR OPERACIÓN CERRADA</h1>
        <p>Registrá cada trade · Mantené tu bitácora de ejecutor</p>
    </div>

    {# ─── L23: Progress stepper (auto-tracks which sections are filled) ─── #}
    <ol class="form-stepper" id="trade-form-stepper" aria-label="Pasos para registrar un trade">
        <li class="form-step is-current" data-step="date">
            <span class="form-step-num">1</span><span class="form-step-label">Fecha</span>
        </li>
        <li class="form-step" data-step="asset">
            <span class="form-step-num">2</span><span class="form-step-label">Activo</span>
        </li>
        <li class="form-step" data-step="price">
            <span class="form-step-num">3</span><span class="form-step-label">Precio</span>
        </li>
        <li class="form-step" data-step="risk">
            <span class="form-step-num">4</span><span class="form-step-label">Riesgo</span>
        </li>
    </ol>

    <div id="form-error" class="form-error"></div>
    <div id="form-success" class="form-success"></div>

    <form id="trade-form" data-test-id="trade-form" autocomplete="off" novalidate data-api-validate>

        {# ─── 1. Fecha y hora ─── #}
        <div class="form-section" data-form-step="date" data-wizard="1">
            <h3 class="form-section-title"><span class="material-symbols-elev">event</span>Fecha y hora</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="form-label required" for="trade-date">Fecha</label>
                    <input type="date" id="trade-date" name="date" class="form-input" value="{{ "now"|date("Y-m-d") }}" required />
                </div>
                <div>
                    <label class="form-label" for="trade-time">Hora</label>
                    <input type="time" id="trade-time" name="time" class="form-input" required value="12:00" />
                </div>
            </div>
        </div>

        {# ─── 2. Activo ─── #}
        <div class="form-section" data-form-step="asset" data-wizard="2">
            <h3 class="form-section-title"><span class="material-symbols-elev">currency_exchange</span>Activo</h3>
            <div class="flex flex-wrap gap-2 mb-3" id="asset-chips">
                <button type="button" class="chip" data-asset="XAUUSD">XAUUSD</button>
                <button type="button" class="chip" data-asset="NAS100">NAS100</button>
                <button type="button" class="chip" data-asset="EURUSD">EURUSD</button>
                <button type="button" class="chip" data-asset="GBPUSD">GBPUSD</button>
                <button type="button" class="chip" data-asset="USDJPY">USDJPY</button>
                <button type="button" class="chip" data-asset="US30">US30</button>
                <button type="button" class="chip" data-asset="BTCUSDT">BTCUSDT</button>
                <button type="button" class="chip" data-asset="ETHUSDT">ETHUSDT</button>
                <button type="button" class="chip" data-asset="XAGUSD">XAGUSD</button>
            </div>
            <input type="text" id="trade-asset" name="asset" data-test-id="trade-asset" class="form-input"
                   required maxlength="16" placeholder="Otro activo (ej: AUDUSD, SPX, NATGAS)"
                   style="text-transform: uppercase;" />
        </div>

        {# ─── 3. Dirección ─── #}
        <div class="form-section" data-form-step="price" data-wizard="2">
            <h3 class="form-section-title"><span class="material-symbols-elev">swap_horiz</span>Dirección</h3>
            <div class="grid grid-cols-2 gap-3" id="dir-toggle">
                <button type="button" class="dir-btn" data-dir="BUY">
                    <span class="material-symbols-elev">trending_up</span>
                    BUY · Long
                </button>
                <button type="button" class="dir-btn" data-dir="SELL">
                    <span class="material-symbols-elev">trending_down</span>
                    SELL · Short
                </button>
            </div>
        </div>

        {# ─── 3b. Cuenta ─── #}
        <div class="form-section" data-wizard="2">
            <h3 class="form-section-title"><span class="material-symbols-elev">account_balance</span>Cuenta</h3>
            <select id="trade-account-id" name="account_id" class="form-input" required>
                <option value="">— Cargando cuentas... —</option>
            </select>
            <p class="text-xs text-[var(--outline-elev)] mt-1" id="trade-account-hint"></p>
        </div>

        {# ─── 4. Precios ─── #}
        <div class="form-section" data-wizard="3">
            <h3 class="form-section-title"><span class="material-symbols-elev">price_check</span>Precios (opcional)</h3>
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="form-label" for="trade-entry">Entry</label>
                    <input type="number" step="any" id="trade-entry" data-test-id="trade-entry" name="entry" class="form-input" placeholder="2650.50" />
                </div>
                <div>
                    <label class="form-label pos" for="trade-tp">Take Profit</label>
                    <input type="number" step="any" id="trade-tp" data-test-id="trade-tp" name="tp" class="form-input" placeholder="2660.00" />
                </div>
                <div>
                    <label class="form-label neg" for="trade-sl">Stop Loss</label>
                    <input type="number" step="any" id="trade-sl" data-test-id="trade-sl" name="sl" class="form-input" placeholder="2645.00" />
                </div>
            </div>
        </div>

        {# ─── 5. Resultado + P&L ─── #}
        <div class="form-section" data-wizard="3">
            <h3 class="form-section-title"><span class="material-symbols-elev">emoji_events</span>Resultado</h3>
            <div class="grid grid-cols-4 gap-2 mb-4" id="result-toggle">
                <button type="button" class="result-btn" data-result="WIN">WIN</button>
                <button type="button" class="result-btn" data-result="LOSS">LOSS</button>
                <button type="button" class="result-btn" data-result="BE">BE</button>
                <button type="button" class="result-btn" data-result="OPEN">OPEN</button>
            </div>
            <div>
                <label class="form-label" for="trade-pnl">P&L final (USD)</label>
                <input type="number" step="any" id="trade-pnl" data-test-id="trade-pnl" name="pnl" class="form-input"
                       placeholder="ej: +95.50 o -50.00" required />
                <p class="text-xs text-[var(--outline-elev)] mt-1">
                    Positivo si fue ganancia, negativo si fue pérdida.
                </p>
            </div>
        </div>

        {# ─── 6. Risk:Reward computed ─── #}
        <div class="form-section" data-form-step="risk" data-wizard="4">
            <h3 class="form-section-title"><span class="material-symbols-elev">calculate</span>Ratio Riesgo:Beneficio</h3>
            <div id="rr-display" class="rr-display">—</div>
            <div id="rr-warning" class="rr-warning" hidden>
                <span class="material-symbols-elev" aria-hidden="true">warning</span>
                Risk:Reward bajo. Considerá ajustar TP o SL antes de operar.
            </div>
            <small>Calculado automáticamente desde Entry / TP / SL (TP arriba del Entry si BUY; SL abajo)</small>
        </div>

        {# ─── 7. Capturas (drag-drop) ─── #}
        <div class="form-section" data-wizard="4">
            <h3 class="form-section-title"><span class="material-symbols-elev">image</span>Capturas (opcional, máx 3)</h3>

            <div class="photo-dropzone" id="photo-dropzone" tabindex="0" role="button" aria-label="Soltá imágenes o hacé click para elegir">
                <input type="file" id="photo-file-input" accept="image/png,image/jpeg,image/webp" multiple hidden />
                <span class="material-symbols-elev photo-dropzone-icon">add_photo_alternate</span>
                <p class="photo-dropzone-title">Arrastrá imágenes o hacé click</p>
                <p class="photo-dropzone-sub">PNG · JPG · WebP · máx 4MB c/u</p>
            </div>

            <input type="url" id="trade-photo-url" class="form-input mt-2" placeholder="O pegá una URL: https://..." />

            <div id="photo-preview" class="photo-preview-grid"></div>
        </div>

        {# ─── 8. Notas + Tips del Creador ─── #}
        <div class="form-section" data-wizard="4">
            <h3 class="form-section-title"><span class="material-symbols-elev">description</span>Notas (opcional)</h3>
            <textarea id="trade-notes" name="notes" data-test-id="trade-notes" class="form-textarea"
                      placeholder="¿Qué patrón reconociste? ¿Qué hiciste bien? ¿Qué patrón volvió a aparecer?"></textarea>
            <div class="flex flex-wrap gap-2 mt-3">
                <button type="button" class="tip-chip" data-tip="¿Qué patrón reconociste?">Patrón</button>
                <button type="button" class="tip-chip" data-tip="¿Qué hiciste bien?">Aciertos</button>
                <button type="button" class="tip-chip" data-tip="¿Qué patrón volvió a aparecer?">Repetición</button>
                <button type="button" class="tip-chip" data-tip="¿Qué emoción dominó?">Emoción</button>
                <button type="button" class="tip-chip" data-tip="¿Qué ajustarías la próxima vez?">Ajuste</button>
            </div>
        </div>

        {# ─── F6: wizard footer ─── #}
        <div class="form-footer form-footer-wizard">
            <a href="/journal" class="form-cancel-btn" id="cancel-btn">Cancelar</a>
            <span class="wizard-spacer"></span>
            <button type="button" id="wizard-back" class="form-cancel-btn" hidden>
                ← Anterior
            </button>
            <button type="button" id="wizard-next" class="form-submit-primary">
                Siguiente →
            </button>
            <button type="submit" id="submit-btn" class="form-submit-primary" hidden>
                <span class="material-symbols-elev">save</span>
                Registrar trade
            </button>
        </div>
    </form>
</div>

<script>
(function() {
    'use strict';

    // ══════ F2 — Estado y referencias ══════
    const state = {
        direction: null,
        result: null,
        asset: null,
    };

    const $form = document.getElementById('trade-form');
    const $error = document.getElementById('form-error');
    const $success = document.getElementById('form-success');
    const $submit = document.getElementById('submit-btn');

    // ══════ F2 v2 — Capturas (drag-drop + URL) ══════
    const _PHOTOS = []; // array de {dataUrl, kind:'file'|'url', name}
    const PHOTOS_MAX = 3;
    const PHOTOS_MAX_BYTES = 4 * 1024 * 1024; // 4MB

    function renderPhotosPreview() {
        const grid = document.getElementById('photo-preview');
        if (!grid) return;
        if (_PHOTOS.length === 0) {
            grid.innerHTML = '';
            return;
        }
        grid.innerHTML = _PHOTOS.map((p, i) => `
            <div class="photo-thumb">
                <img class="lightbox-trigger" data-lightbox-group="trade-new" data-lightbox-name="${p.kind === 'file' ? (p.name || ('captura ' + (i + 1))) : 'URL'}" src="${p.dataUrl}" alt="captura ${i + 1}" loading="lazy" decoding="async" style="max-width:100%;height:auto;border-radius:0.5rem;" />
                <button type="button" class="photo-remove" data-idx="${i}" aria-label="Eliminar captura ${i + 1}">
                    <span class="material-symbols-elev icon-size-sm">close</span>
                </button>
                <span class="photo-thumb-label">${p.kind === 'file' ? (p.name.length > 16 ? p.name.slice(0, 14) + '…' : p.name) : 'URL'}</span>
            </div>
        `).join('');
        grid.querySelectorAll('.photo-remove').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = parseInt(btn.dataset.idx, 10);
                _PHOTOS.splice(idx, 1);
                renderPhotosPreview();
            });
        });
    }

    function addPhotoDataUrl(dataUrl, kind, name) {
        if (_PHOTOS.length >= PHOTOS_MAX) {
            showError(`Máximo ${PHOTOS_MAX} capturas.`);
            return;
        }
        _PHOTOS.push({ dataUrl, kind, name });
        renderPhotosPreview();
    }

    function handleFiles(fileList) {
        const files = Array.from(fileList).filter(f => f.type.startsWith('image/'));
        if (files.length === 0) return;
        let remaining = PHOTOS_MAX - _PHOTOS.length;
        if (remaining <= 0) {
            showError(`Máximo ${PHOTOS_MAX} capturas.`);
            return;
        }
        const toProcess = files.slice(0, remaining);
        if (files.length > remaining) {
            showError(`Solo se agregan ${remaining} imagen(es) (máx ${PHOTOS_MAX}).`);
        }
        toProcess.forEach(f => {
            if (f.size > PHOTOS_MAX_BYTES) {
                showError(`${f.name} supera 4MB — omitida.`);
                return;
            }
            const reader = new FileReader();
            reader.onload = (e) => addPhotoDataUrl(e.target.result, 'file', f.name);
            reader.readAsDataURL(f);
        });
    }

    function showError(msg) {
        $error.textContent = msg;
        $error.classList.add('visible');
        $success.classList.remove('visible');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function showSuccess(msg) {
        $success.textContent = msg;
        $success.classList.add('visible');
        $error.classList.remove('visible');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        // Fullscreen checkmark overlay with progress bar to confirm
        // success while we wait for the redirect. Pure JS injection,
        // lives until the next page load.
        if (document.getElementById('trade-success-overlay')) return;
        const overlay = document.createElement('div');
        overlay.id = 'trade-success-overlay';
        overlay.className = 'trade-success-overlay';
        overlay.setAttribute('role', 'status');
        overlay.setAttribute('aria-live', 'polite');
        overlay.innerHTML = `
            <div class="trade-success-card">
                <div class="trade-success-check" aria-hidden="true">
                    <span class="material-symbols-elev" style="font-size:4rem;">check_circle</span>
                </div>
                <p class="trade-success-title">Trade registrado</p>
                <p class="trade-success-msg">${escapeHtml(msg)}</p>
                <div class="trade-success-progress" aria-hidden="true">
                    <div class="trade-success-progress-bar"></div>
                </div>
            </div>`;
        document.body.appendChild(overlay);
        // Trigger CSS animation on next tick.
        requestAnimationFrame(() => overlay.classList.add('is-visible'));
    }
    function hideMessages() {
        $error.classList.remove('visible');
        $success.classList.remove('visible');
    }

    // ─── Default fecha = hoy, hora = ahora ───
    const now = new Date();
    const _elTradeDate = document.getElementById('trade-date');
    if (_elTradeDate) _elTradeDate.value = now.toISOString().slice(0, 10);
    const _elTradeTime = document.getElementById('trade-time');
    if (_elTradeTime) _elTradeTime.value = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

    // ─── Asset chips ───
    document.querySelectorAll('#asset-chips .chip').forEach(btn => {
        btn.addEventListener('click', () => {
            const asset = btn.dataset.asset;
            state.asset = asset;
            const _elTradeAsset = document.getElementById('trade-asset');
            if (_elTradeAsset) _elTradeAsset.value = asset;
            document.querySelectorAll('#asset-chips .chip').forEach(b => b.classList.toggle('active', b === btn));
            updateRR();
        });
    });
    document.getElementById('trade-asset').addEventListener('input', e => {
        const v = e.target.value.trim().toUpperCase();
        state.asset = v;
        document.querySelectorAll('#asset-chips .chip').forEach(b => {
            b.classList.toggle('active', b.dataset.asset === v);
        });
        updateRR();
    });

    // ─── Direction toggle ───
    document.querySelectorAll('#dir-toggle .dir-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            state.direction = btn.dataset.dir;
            document.querySelectorAll('#dir-toggle .dir-btn').forEach(b => b.classList.toggle('active', b === btn));
            updateRR();
        });
    });

    // ─── Result toggle ───
    document.querySelectorAll('#result-toggle .result-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            state.result = btn.dataset.result;
            document.querySelectorAll('#result-toggle .result-btn').forEach(b => b.classList.toggle('active', b === btn));
        });
    });

    // ─── R:R auto-compute ───
    const $entry = document.getElementById('trade-entry');
    const $tp = document.getElementById('trade-tp');
    const $sl = document.getElementById('trade-sl');
    const $rr = document.getElementById('rr-display');

    function num(el) { return el.value ? parseFloat(el.value) : null; }

    function updateRR() {
        const entry = num($entry);
        const tp = num($tp);
        const sl = num($sl);
        const dir = state.direction;

        if (entry === null || tp === null || sl === null || !dir) {
            $rr.textContent = '—';
            return;
        }

        let risk, reward;
        if (dir === 'BUY') {
            risk = Math.abs(entry - sl);
            reward = Math.abs(tp - entry);
        } else {
            risk = Math.abs(sl - entry);
            reward = Math.abs(entry - tp);
        }
        if (risk <= 0) {
            $rr.textContent = '—';
            const warn = document.getElementById('rr-warning');
            if (warn) warn.hidden = true;
            return;
        }
        const ratio = reward / risk;
        const warn = document.getElementById('rr-warning');
        if (warn) warn.hidden = ratio >= 1;
        $rr.innerHTML = `<span style="color: var(--gold-elev);">1 : ${ratio.toFixed(2)}</span> <small>Riesgo ${risk.toFixed(2)} / Benef ${reward.toFixed(2)}</small>`;
    }

    [$entry, $tp, $sl].forEach(el => el.addEventListener('input', updateRR));

    // ─── L23: progress stepper — mark current step based on which
    // fields have values; mark earlier steps complete.
    // In wizard mode (F6) the stepper is driven by the wizard instead.
    let wizardActive = true;
    let wizardStep = 1;
    let wizardMax = 1;
    const WIZARD_STEPS = ['date', 'asset', 'price', 'risk'];
    function updateStepper() {
        const steps = document.querySelectorAll('#trade-form-stepper .form-step');
        if (!steps.length) return;
        if (wizardActive) {
            const cur = WIZARD_STEPS[wizardStep - 1];
            steps.forEach(function (s) {
                const idx = WIZARD_STEPS.indexOf(s.dataset.step);
                s.classList.toggle('is-complete', idx < wizardStep - 1);
                s.classList.toggle('is-current', s.dataset.step === cur);
            });
            return;
        }
        const checks = {
            date: () => !!document.getElementById('trade-date')?.value
                      && !!document.getElementById('trade-time')?.value,
            asset: () => !!(document.getElementById('trade-asset')?.value
                       || document.querySelector('#asset-chips .chip.active')),
            price: () => !!document.getElementById('trade-entry')?.value,
            risk:  () => {
                const tp = document.getElementById('trade-tp')?.value;
                const sl = document.getElementById('trade-sl')?.value;
                return !!tp && !!sl;
            },
        };
        const order = ['date', 'asset', 'price', 'risk'];
        let currentStep = null;
        order.forEach(function (name) {
            const step = document.querySelector('#trade-form-stepper .form-step[data-step="' + name + '"]');
            if (!step) return;
            const done = checks[name]();
            step.classList.toggle('is-complete', done);
            if (done && currentStep === null) {
                // mark next step as current (if any)
            }
        });
        // First incomplete step becomes "current"
        currentStep = order.find(function (n) { return !checks[n](); }) || order[order.length - 1];
        steps.forEach(function (s) {
            s.classList.remove('is-current');
            if (s.dataset.step === currentStep) s.classList.add('is-current');
        });
    }
    // Hook into existing change handlers
    ['trade-date', 'trade-time', 'trade-asset', 'trade-entry', 'trade-tp', 'trade-sl'].forEach(function (id) {
        document.getElementById(id)?.addEventListener('input', updateStepper);
        document.getElementById(id)?.addEventListener('change', updateStepper);
    });
    // Asset chip clicks also update stepper
    document.querySelectorAll('#asset-chips .chip').forEach(function (c) {
        c.addEventListener('click', updateStepper);
    });
    document.querySelectorAll('#dir-toggle .dir-btn').forEach(function (c) {
        c.addEventListener('click', updateStepper);
    });
    updateStepper();

    // ─── F6: trade form wizard (4 steps) ───
    // Sections carry data-wizard="1..4". showWizardStep toggles them,
    // drives the stepper, and swaps the footer buttons. Per-step gates
    // validate before advancing; the F19 submit handler still guards
    // the final POST (e.g. Enter-key submits).
    function wizardSections(n) {
        return Array.from(document.querySelectorAll('#trade-form .form-section[data-wizard="' + n + '"]'));
    }
    function wizardGates() {
        return {
            1: () => {
                const d = document.getElementById('trade-date');
                const t = document.getElementById('trade-time');
                const okD = d && d.value;
                const okT = t && t.value;
                if (window.apiValidateField) {
                    let ok = true;
                    if (d && !window.apiValidateField(d)) ok = false;
                    if (t && !window.apiValidateField(t)) ok = false;
                    return ok;
                }
                return !!(okD && okT);
            },
            2: () => {
                const assetEl = document.getElementById('trade-asset');
                const hasAsset = !!(assetEl && assetEl.value.trim())
                    || !!document.querySelector('#asset-chips .chip.active');
                if (!hasAsset && window.apiToast) {
                    window.apiToast('Elegí un activo o escribilo para continuar', 'warning');
                }
                return hasAsset;
            },
            3: () => {
                const pnl = document.getElementById('trade-pnl');
                if (window.apiValidateField && pnl) return window.apiValidateField(pnl);
                return !!(pnl && pnl.value.trim());
            },
            4: () => true,
        };
    }
    function showWizardStep(n, opts) {
        opts = opts || {};
        n = Math.min(4, Math.max(1, n));
        wizardStep = n;
        wizardMax = Math.max(wizardMax, n);
        for (let i = 1; i <= 4; i++) {
            wizardSections(i).forEach(sec => { sec.hidden = (i !== n); });
        }
        const back = document.getElementById('wizard-back');
        const next = document.getElementById('wizard-next');
        const submit = document.getElementById('submit-btn');
        if (back) back.hidden = (n === 1);
        if (next) next.hidden = (n === 4);
        if (submit) submit.hidden = (n !== 4);
        updateStepper();
        if (!opts.noScroll) {
            const form = document.getElementById('trade-form');
            if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        // Focus the first field of the step for keyboard flow.
        const first = wizardSections(n)[0]?.querySelector('input, select, textarea, button.chip, button.dir-btn');
        if (first && !opts.noFocus) {
            setTimeout(() => { try { first.focus({ preventScroll: true }); } catch (e) { first.focus(); } }, 120);
        }
    }
    function wizardNext() {
        const gate = wizardGates()[wizardStep];
        if (gate && !gate()) return;
        showWizardStep(wizardStep + 1);
    }
    function wizardBack() {
        showWizardStep(wizardStep - 1);
    }
    document.getElementById('wizard-next')?.addEventListener('click', wizardNext);
    document.getElementById('wizard-back')?.addEventListener('click', wizardBack);
    // Stepper steps are clickable — only up to the furthest reached.
    document.querySelectorAll('#trade-form-stepper .form-step').forEach(el => {
        el.style.cursor = 'pointer';
        el.addEventListener('click', () => {
            const idx = WIZARD_STEPS.indexOf(el.dataset.step) + 1;
            if (idx >= 1 && idx <= wizardMax) showWizardStep(idx);
        });
    });
    showWizardStep(1, { noScroll: true, noFocus: true });

    // ─── Tip chips ───
    document.querySelectorAll('.tip-chip').forEach(btn => {
        btn.addEventListener('click', () => {
            const notesEl = document.getElementById('trade-notes');
            const phrase = btn.dataset.tip;
            const current = notesEl.value.trim();
            notesEl.value = current ? `${current}\n${phrase} — ` : `${phrase} — `;
            notesEl.focus();
        });
    });

    // ─── Submit ───
    $form.addEventListener('submit', async e => {
        e.preventDefault();
        hideMessages();

        // F2 guard — user must be authenticated
        if (!window.TNSVT_USER || !window.TNSVT_USER.code) {
            showError('Necesitás estar autenticado. Volvé a /login.');
            return;
        }

        if (!state.direction) {
            showError('Elegí una dirección (BUY o SELL).');
            return;
        }
        if (!state.result) {
            showError('Elegí un resultado (WIN / LOSS / BE / OPEN).');
            return;
        }
        const _elTradeAssetSubmit = document.getElementById('trade-asset');
        const asset = state.asset || (_elTradeAssetSubmit ? _elTradeAssetSubmit.value.trim().toUpperCase() : '');
        if (!asset) {
            showError('Indicá el activo operado (ej: XAUUSD).');
            return;
        }

        const _elTradeDateSubmit = document.getElementById('trade-date');
        const dateStr = _elTradeDateSubmit ? _elTradeDateSubmit.value : '';
        const _elTradeTimeSubmit = document.getElementById('trade-time');
        const timeStr = _elTradeTimeSubmit ? _elTradeTimeSubmit.value : '';
        if (!dateStr || !timeStr) {
            showError('Indicá fecha y hora.');
            return;
        }

        const _elTradePnl = document.getElementById('trade-pnl');
        const pnlRaw = _elTradePnl ? _elTradePnl.value.trim() : '';
        const pnl = pnlRaw === '' ? null : parseFloat(pnlRaw);
        if (pnl === null || isNaN(pnl)) {
            showError('Indicá el P&L (puede ser 0 para BE/OPEN).');
            return;
        }

        // ─── F2 v2 — Capturas vía drag-drop o URL ───
        // photos[] es un array de strings (DataURL o URL) — el backend acepta cualquier string
        const photos = _PHOTOS.slice(0, 3);

        const _elTradeNotes = document.getElementById('trade-notes');
        const notes = _elTradeNotes ? _elTradeNotes.value.trim() : '';

        const payload = {
            user_code: window.TNSVT_USER.code,
            asset: asset,
            dir: state.direction,
            date: `${dateStr}T${timeStr}:00`,
            result: state.result,
            pnl: pnl,
            account_id: parseInt(document.getElementById('trade-account-id')?.value) || window.TNSVT_ACTIVE_ACCOUNT_ID || null,
        };

        const entry = num($entry); if (entry !== null) payload.entry = String(entry);
        const tp = num($tp);       if (tp !== null)    payload.tp = String(tp);
        const sl = num($sl);       if (sl !== null)    payload.sl = String(sl);

        // Compute R:R ratio for `ratio` field
        if (entry !== null && tp !== null && sl !== null) {
            let risk, reward;
            if (state.direction === 'BUY') {
                risk = Math.abs(entry - sl);
                reward = Math.abs(tp - entry);
            } else {
                risk = Math.abs(sl - entry);
                reward = Math.abs(entry - tp);
            }
            if (risk > 0 && reward > 0) {
                payload.ratio = `1:${(reward / risk).toFixed(2)}`;
            }
        }
        if (photos.length > 0) payload.photos = photos;
        if (notes) payload.notes = notes;

        $submit.disabled = true;
        $submit.innerHTML = '<span class="material-symbols-elev">progress_activity</span> Guardando...';

        try {
            const r = await apiFetch('/api/journal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            if (r.ok && r.data && r.data.success) {
                showSuccess(`Operación registrada · id #${r.data.id}. Redirigiendo al journal...`);
                setTimeout(() => { window.location.href = '/journal'; }, 1200);
            } else {
                const msg = (r.data && (r.data.error || r.data.message)) ||
                    (r.timeout ? 'Timeout: el server no respondió' :
                     r.networkError ? 'Sin conexión con el servidor' :
                     `HTTP ${r.status || '?'}: error desconocido`);
                showError(msg);
                $submit.disabled = false;
                $submit.innerHTML = '<span class="material-symbols-elev">save</span> Registrar trade';
            }
        } catch (err) {
            showError('Error de red: ' + (err.message || 'sin detalle'));
            $submit.disabled = false;
            $submit.innerHTML = '<span class="material-symbols-elev">save</span> Registrar trade';
        }
    });

    // ─── F2 v2 — Drag-drop capturas ───
    (function wirePhotoDropzone() {
        const dz = document.getElementById('photo-dropzone');
        const fileInput = document.getElementById('photo-file-input');
        const urlInput = document.getElementById('trade-photo-url');
        if (!dz || !fileInput || !urlInput) return;

        dz.addEventListener('click', () => fileInput.click());
        dz.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                fileInput.click();
            }
        });

        fileInput.addEventListener('change', e => {
            if (e.target.files && e.target.files.length) {
                handleFiles(e.target.files);
                fileInput.value = '';
            }
        });

        ['dragenter', 'dragover'].forEach(ev => {
            dz.addEventListener(ev, e => {
                e.preventDefault();
                e.stopPropagation();
                dz.classList.add('dragging');
            });
        });
        ['dragleave', 'drop'].forEach(ev => {
            dz.addEventListener(ev, e => {
                e.preventDefault();
                e.stopPropagation();
                dz.classList.remove('dragging');
            });
        });
        dz.addEventListener('drop', e => {
            const dt = e.dataTransfer;
            if (dt && dt.files && dt.files.length) {
                handleFiles(dt.files);
            }
        });

        // URL fallback
        urlInput.addEventListener('change', () => {
            const v = urlInput.value.trim();
            if (!v) return;
            if (_PHOTOS.length >= PHOTOS_MAX) {
                showError(`Máximo ${PHOTOS_MAX} capturas.`);
                urlInput.value = '';
                return;
            }
            // Validate looks like URL
            try {
                const u = new URL(v);
                if (!/^https?:$/.test(u.protocol)) throw new Error('Solo http(s)://');
            } catch (e) {
                showError('URL inválida (debe ser http(s)://…)');
                return;
            }
            addPhotoDataUrl(v, 'url', 'URL externa');
            urlInput.value = '';
        });
    })();

// ─── Cancel ───
    document.getElementById('cancel-btn').addEventListener('click', async e => {
        if ($form.dataset.dirty === '1') {
            if (!await apiConfirm('Tenés cambios sin guardar. ¿Salir igual?', { title: 'Cambios sin guardar' })) {
                e.preventDefault();
                return;
            }
        }
    });
    $form.addEventListener('input', () => { $form.dataset.dirty = '1'; });
})();
</script>
{% endblock %}
