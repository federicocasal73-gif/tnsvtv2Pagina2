{% extends 'shell.html.twig' %}

{% block title %}Adeptos · T.N.S.V.T{% endblock %}

{% block topbar_title %}Trono de Control{% endblock %}
{% block topbar_subtitle %}Comando de Reino · Gestión de Adeptos{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto">
        {# Header #}
        <div class="text-center mb-6">
            <p class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">Trono de Control</p>
            <h1 class="font-headline-lg text-headline-lg shimmer-text">Comando de Reino</h1>
        </div>

        {# Global Kingdom Stats #}
        <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="stat-mini-admin">
                <div class="stat-mini-admin-value" id="admin-stat-total">0</div>
                <div class="stat-mini-admin-label">Total Users</div>
            </div>
            <div class="stat-mini-admin">
                <div class="stat-mini-admin-value" id="admin-stat-signals">0</div>
                <div class="stat-mini-admin-label">Señales</div>
            </div>
            <div class="stat-mini-admin">
                <div class="stat-mini-admin-value text-green-400" id="admin-stat-pnl">+$0</div>
                <div class="stat-mini-admin-label">Total PnL</div>
            </div>
        </div>

        {# Alert Mode Switch #}
        <div class="glass-card-elev">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-red-500/10 rounded-lg flex items-center justify-center border border-red-500/20">
                    <span class="material-symbols-elev text-red-400">warning</span>
                </div>
                <div class="flex-1">
                    <p class="font-label-md text-label-md font-bold text-[var(--on-surface-elev)]">Modo Alerta Alta Precisión</p>
                    <p class="text-[10px] text-[var(--outline-elev)] uppercase tracking-wider">Protocolo de Emergencia</p>
                </div>
                <div class="alert-toggle" id="alert-mode-toggle" onclick="this.classList.toggle('active')"></div>
            </div>
        </div>

        {# Audio Player Mini #}
        <div class="audio-player-mini">
            <div class="flex items-center gap-5 mb-4 relative z-10">
                <div class="w-16 h-16 rounded-lg overflow-hidden shadow-2xl relative bg-[var(--primary-container,#d4af37)]/20 flex items-center justify-center">
                    <div class="audio-wave">
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                    </div>
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[10px] font-bold text-[var(--primary)] uppercase tracking-widest">Global Temple Broadcast</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] pulse-gold"></span>
                    </div>
                    <p class="font-title-md text-title-md font-bold text-[var(--starlight-white,#FDFCF8)] leading-tight">Sinfonía Atmosférica Nro. 4</p>
                    <p class="text-xs text-[var(--outline-elev)]">Frecuencia de Cónclave · 432Hz</p>
                </div>
            </div>
            <div class="flex items-center justify-center gap-6 relative z-10">
                <button class="text-[var(--outline-elev)] hover:text-[var(--primary)] transition-colors">
                    <span class="material-symbols-elev text-2xl">skip_previous</span>
                </button>
                <button class="w-12 h-12 rounded-full bg-[var(--primary)] text-[var(--void-black,#050308)] flex items-center justify-center gold-glow-elev hover:scale-110 transition-transform">
                    <span class="material-symbols-elev text-3xl" style="font-variation-settings: 'FILL' 1;">pause</span>
                </button>
                <button class="text-[var(--outline-elev)] hover:text-[var(--primary)] transition-colors">
                    <span class="material-symbols-elev text-2xl">skip_next</span>
                </button>
            </div>
        </div>

        {# Toolbar #}
        <div class="glass-card-elev flex items-center justify-between flex-wrap gap-4">
            <div>
                <h2 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">groups</span>
                    Lista de Adeptos
                </h2>
                <p class="text-xs text-[var(--outline-elev)]">Gestión de miembros y tiers del Sanctum</p>
            </div>
            <div class="flex gap-3 items-center">
                <input id="search-input" type="text" placeholder="Buscar por código..." class="px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
                <select id="filter-tier" class="px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm">
                    <option value="">Todos los tiers</option>
                    <option value="INITIATE">Initiate</option>
                    <option value="ASPIRANT">Aspirant</option>
                    <option value="TIER_1">Tier 1</option>
                    <option value="TIER_2">Tier 2</option>
                    <option value="TIER_3_ZENITH">Tier 3 Zenith</option>
                    <option value="MASTER">Master</option>
                </select>
                <button id="refresh-btn" class="btn-elev-secondary text-xs">
                    <span class="material-symbols-elev align-middle text-sm">refresh</span>
                </button>
            </div>
        </div>

        {# User grid #}
        <div id="users-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <p class="col-span-full text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando adeptos...</p>
        </div>
    </div>
    <script>
    let allUsers = [];
    let currentFilter = { search: '', tier: '' };

    async function loadUsers() {
        try {
            const r = await fetch('/sanctum/api/users');
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            if (!data.success) throw new Error(data.error || 'unknown');
            allUsers = data.users;
            renderUsers();
        } catch (e) {
            const _elUsersGrid = document.getElementById('users-grid');
            if (_elUsersGrid) _elUsersGrid.innerHTML = '<p class="col-span-full text-red-400 text-center py-8">Error: ' + e.message + '</p>';
        }
    }

    function renderUsers() {
        const filtered = allUsers.filter(u => {
            if (currentFilter.search && !u.code.toLowerCase().includes(currentFilter.search.toLowerCase())) return false;
            if (currentFilter.tier && u.tier !== currentFilter.tier) return false;
            return true;
        });

        if (filtered.length === 0) {
            const _elUsersGridEmpty = document.getElementById('users-grid');
            if (_elUsersGridEmpty) _elUsersGridEmpty.innerHTML = '<p class="col-span-full text-center text-[var(--outline-elev)] py-8">Sin usuarios encontrados</p>';
            return;
        }

        const _elUsersGridRender = document.getElementById('users-grid');
        if (_elUsersGridRender) _elUsersGridRender.innerHTML = filtered.map(u => {
            const initials = (u.code || '??').substring(0, 2).toUpperCase();
            const roleClass = u.isAdmin ? 'ADMIN' : 'USER';
            const avatarClass = u.isAdmin ? 'admin' : 'user';
            const statusClass = u.active ? 'active' : 'inactive';
            const statusText = u.active ? 'Active' : 'Inactive';
            const statusDotClass = u.active ? 'online' : 'offline';
            const tier = u.tier || 'INITIATE';
            return `
            <div class="user-card ${u.active ? '' : 'inactive'}">
                <div class="flex items-start gap-3">
                    <div class="relative">
                        <div class="user-avatar ${avatarClass}">${initials}</div>
                        <span class="user-status-dot ${statusDotClass}"></span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-2">
                            <p class="text-sm font-mono text-[var(--on-surface-elev)] truncate">${escapeHtml(u.code || '')}</p>
                            <span class="role-pill ${roleClass}">${roleClass}</span>
                        </div>
                        <p class="text-sm text-[var(--outline-elev)] truncate">${escapeHtml(u.name || '')}</p>
                        ${u.email ? `<p class="text-xs text-[var(--outline-elev)] truncate">${escapeHtml(u.email)}</p>` : ''}
                        <div class="flex items-center gap-2 mt-2">
                            <span class="tier-badge tier-${escapeHtml(tier)}">${tier.replace(/_/g, ' ')}</span>
                            <span class="status-pill ${statusClass}">${statusText}</span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center justify-between mt-3 pt-3 border-t border-[var(--outline-variant-elev)] text-xs text-[var(--outline-elev)]">
                    <span>$${parseFloat(u.walletBalance || 0).toFixed(2)}</span>
                    <span>${u.coins || 0} coins</span>
                    <span>${u.lastLogin ? u.lastLogin.substring(5, 16).replace('T', ' ') : '—'}</span>
                </div>
                <div class="mt-2 flex justify-end">
                    <button class="text-xs px-2 py-1 rounded ${u.active ? 'bg-red-900/30 text-red-400 hover:bg-red-900/50' : 'bg-green-900/30 text-green-400 hover:bg-green-900/50'} transition-colors" data-user-code="${escapeHtml(u.code || '')}" data-action="toggle-user">
                        ${u.active ? 'Desactivar' : 'Activar'}
                    </button>
                </div>
            </div>`;
        }).join('');
    }

    function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    document.getElementById('refresh-btn').addEventListener('click', loadUsers);
    document.getElementById('search-input').addEventListener('input', e => { currentFilter.search = e.target.value; renderUsers(); });
    document.getElementById('filter-tier').addEventListener('change', e => { currentFilter.tier = e.target.value; renderUsers(); });

    // Toggle user active state
    document.addEventListener('click', async (e) => {
        if (!e.target.matches('[data-action="toggle-user"]')) return;
        const code = e.target.dataset.userCode;
        if (!code) return;
        e.target.disabled = true;
        try {
            const r = await fetch('/sanctum/api/users/' + encodeURIComponent(code) + '/active', { method: 'PATCH' });
            const data = await r.json();
            if (data.success) {
                loadUsers();
            } else {
                apiToast('Error: ' + (data.error || 'desconocido'), 'error');
                e.target.disabled = false;
            }
        } catch (err) {
            apiToast('Error: ' + err.message, 'error');
            e.target.disabled = false;
        }
    });

    loadUsers();
    </script>
{% endblock %}
