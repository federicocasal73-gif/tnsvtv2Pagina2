{% extends 'shell.html.twig' %}

{% block title %}Adeptos · T.N.S.V.T{% endblock %}

{% block meta_description %}Gestión de Adeptos del Sanctum. Busca por código o nombre, asigna roles y tiers, revisa disciplina y reputación.{% endblock %}

{% block topbar_title %}Trono de Control{% endblock %}
{% block topbar_subtitle %}Comando de Reino · Gestión de Adeptos{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto">
        {# Header #}
        <div class="text-center mb-6">
            <p class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">Trono de Control</p>
            <h1 class="font-headline-lg text-headline-lg shimmer-text">Comando de Reino</h1>
        </div>

        {# Global Kingdom Stats #}
        <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="stat-mini-admin">
                <div class="stat-mini-admin-value" id="admin-stat-total">0</div>
                <div class="stat-mini-admin-label">Total Users</div>
            </div>
            <div class="stat-mini-admin">
                <div class="stat-mini-admin-value" id="admin-stat-signals">0</div>
                <div class="stat-mini-admin-label">Señales</div>
            </div>
            <div class="stat-mini-admin">
                <div class="stat-mini-admin-value text-green-400" id="admin-stat-pnl">+$0</div>
                <div class="stat-mini-admin-label">Total PnL</div>
            </div>
        </div>

        {# Audio Player Mini — cableado al Sonic Sanctuary (Phase 3).
           Antes era decorativo puro. Ahora el botón ▶ emite el evento
           `sonic:open-and-play-global` que el sonic-sanctuary controller
           escucha: abre el panel + carga la playlist admin + reproduce el
           track active. #}
        <div class="audio-player-mini">
            <div class="flex items-center gap-5 mb-4 relative z-10">
                <div class="w-16 h-16 rounded-lg overflow-hidden shadow-2xl relative bg-[var(--primary-container,#d4af37)]/20 flex items-center justify-center">
                    <div class="audio-wave">
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                        <div class="audio-wave-bar"></div>
                    </div>
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[10px] font-bold text-[var(--primary)] uppercase tracking-widest">Global Temple Broadcast</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] pulse-gold"></span>
                    </div>
                    <p class="font-title-md text-title-md font-bold text-[var(--starlight-white,#FDFCF8)] leading-tight" id="broadcast-track-name">Cargando playlist…</p>
                    <p class="text-xs text-[var(--outline-elev)]" id="broadcast-track-sub">Santuario Sonoro</p>
                </div>
            </div>
            <div class="flex items-center justify-center gap-6 relative z-10">
                <button type="button"
                        class="text-[var(--outline-elev)] hover:text-[var(--primary)] transition-colors"
                        title="Pista anterior"
                        onclick="window.dispatchEvent(new CustomEvent('sonic:global-prev'))">
                    <span class="material-symbols-elev text-2xl">skip_previous</span>
                </button>
                <button type="button"
                        class="w-12 h-12 rounded-full bg-[var(--primary)] text-[var(--void-black,#050308)] flex items-center justify-center gold-glow-elev hover:scale-110 transition-transform"
                        title="Reproducir playlist del Cónclave (abre Santuario Sonoro)"
                        onclick="window.dispatchEvent(new CustomEvent('sonic:global-play'))">
                    <span class="material-symbols-elev text-3xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                </button>
                <button type="button"
                        class="text-[var(--outline-elev)] hover:text-[var(--primary)] transition-colors"
                        title="Pista siguiente"
                        onclick="window.dispatchEvent(new CustomEvent('sonic:global-next'))">
                    <span class="material-symbols-elev text-2xl">skip_next</span>
                </button>
            </div>
        </div>

        {# Toolbar #}
        <div class="glass-card-elev flex items-center justify-between flex-wrap gap-4">
            <div>
                <h2 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">groups</span>
                    Lista de Adeptos
                </h2>
                <p class="text-xs text-[var(--outline-elev)]">Gestión de miembros y tiers del Sanctum</p>
            </div>
            <div class="flex gap-3 items-center">
                <input id="search-input" type="text" placeholder="Buscar por código..." aria-label="Buscar adeptos por código o nombre" class="px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
                <select id="filter-tier" class="px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm">
                    <option value="">Todos los tiers</option>
                    <option value="INITIATE">Initiate</option>
                    <option value="ASPIRANT">Aspirant</option>
                    <option value="TIER_1">Tier 1</option>
                    <option value="TIER_2">Tier 2</option>
                    <option value="TIER_3_ZENITH">Tier 3 Zenith</option>
                    <option value="MASTER">Master</option>
                </select>
                <button id="refresh-btn" type="button" class="ui-btn ui-btn secondary text-xs">
                    <span class="material-symbols-elev align-middle icon-size-xs">refresh</span>
                </button>
                <button id="add-user-btn" type="button" class="ui-btn ui-btn primary text-xs">
                    <span class="material-symbols-elev align-middle icon-size-xs">person_add</span>
                    Agregar adepto
                </button>
            </div>
        </div>

        {# User grid #}
        <div id="users-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-controller="users-admin">
            <p class="col-span-full text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando adeptos...</p>
        </div>
    </div>

    {# ─── Modal: Agregar adepto → POST /api/admin/users ─── #}
    <div class="tnsvt-modal-overlay" id="add-user-modal" role="dialog" aria-modal="true" aria-labelledby="add-user-title" hidden>
        <div class="tnsvt-modal">
            <header class="tnsvt-modal__header">
                <h2 id="add-user-title" class="tnsvt-modal__title">
                    <span class="material-symbols-elev">person_add</span>
                    <span>Agregar adepto</span>
                </h2>
                <button type="button" class="tnsvt-modal__close" id="add-user-close" aria-label="Cerrar">
                    <span class="material-symbols-elev" aria-hidden="true">close</span>
                </button>
            </header>
            <div class="tnsvt-modal__body">
                <label class="oracle-label block mb-1" for="add-user-code">Código</label>
                <input id="add-user-code" type="text" placeholder="Ej: JUAN01" autocomplete="off"
                       class="w-full px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)] mb-3" />
                <label class="oracle-label block mb-1" for="add-user-name">Nombre</label>
                <input id="add-user-name" type="text" placeholder="Nombre del adepto" autocomplete="off"
                       class="w-full px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
                <p class="text-xs text-[var(--outline-elev)] mt-3">Se crea activo con rol USER y tier INITIATE, sin contraseña (entra con código + nombre). Después podés activarlo/desactivarlo o eximirlo de 2FA desde su tarjeta.</p>
            </div>
            <footer class="tnsvt-modal__footer">
                <button type="button" class="ui-btn ui-btn ghost" id="add-user-cancel">Cancelar</button>
                <button type="button" class="ui-btn ui-btn primary" id="add-user-submit">Crear adepto</button>
            </footer>
        </div>
    </div>
{% endblock %}
