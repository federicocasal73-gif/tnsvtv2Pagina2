{% extends 'shell.html.twig' %}

{% block title %}Adeptos · T.N.S.V.T{% endblock %}

{% block topbar_title %}Adeptos{% endblock %}
{% block topbar_subtitle %}Gestión de usuarios con avatares, tier badges y status indicators{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto">
        {# Toolbar #}
        <div class="glass-card-elev p-4 mb-6 flex items-center justify-between flex-wrap gap-4">
            <div>
                <h2 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">groups</span>
                    Lista de Adeptos
                </h2>
                <p class="text-xs text-[var(--outline-elev)]">Gestión de miembros y tiers del Sanctum</p>
            </div>
            <div class="flex gap-3 items-center">
                <input id="search-input" type="text" placeholder="Buscar por código..." class="px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
                <select id="filter-tier" class="px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm">
                    <option value="">Todos los tiers</option>
                    <option value="INITIATE">Initiate</option>
                    <option value="ASPIRANT">Aspirant</option>
                    <option value="TIER_1">Tier 1</option>
                    <option value="TIER_2">Tier 2</option>
                    <option value="TIER_3_ZENITH">Tier 3 Zenith</option>
                    <option value="MASTER">Master</option>
                </select>
                <button id="refresh-btn" class="btn-elev-secondary text-xs">
                    <span class="material-symbols-elev align-middle text-sm">refresh</span>
                </button>
            </div>
        </div>

        {# User grid #}
        <div id="users-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <p class="col-span-full text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando adeptos...</p>
        </div>
    </div>

    <style>
    .user-card {
        position: relative;
        background: var(--glass-bg-elev);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border-elev);
        border-radius: 0.75rem;
        padding: 1.25rem;
        transition: all 0.3s ease;
        overflow: hidden;
    }
    .user-card:hover {
        background: var(--glass-bg-strong-elev);
        border-color: var(--gold-elev);
        transform: translateY(-2px);
    }
    .user-card.inactive {
        opacity: 0.6;
        border-color: #ff6b6b;
    }
    .user-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(to right, var(--gold-elev), transparent);
        opacity: 0.6;
    }
    .user-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--on-primary-elev);
        font-size: 1.5rem;
        border: 2px solid rgba(212, 175, 55, 0.5);
        box-shadow: 0 0 12px rgba(212, 175, 55, 0.2);
    }
    .user-avatar.admin {
        background: linear-gradient(135deg, #fbbf24, var(--gold-elev));
    }
    .user-avatar.user {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
    }
    .user-status-dot {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid var(--surface-elev, var(--void-elev));
    }
    .user-status-dot.online { background: #4ade80; }
    .user-status-dot.offline { background: #94a3b8; }
    .user-status-dot.locked { background: #ff6b6b; }
    .tier-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem 0.6rem;
        border-radius: 0.3rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .tier-INITIATE { background: linear-gradient(135deg, rgba(107, 114, 128, 0.2) 0%, transparent 100%); border-left: 2px solid #6b7280; }
    .tier-ASPIRANT { background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, transparent 100%); border-left: 2px solid #3b82f6; }
    .tier-TIER_1 { background: linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, transparent 100%); border-left: 2px solid #8b5cf6; }
    .tier-TIER_2 { background: linear-gradient(135deg, rgba(197, 160, 40, 0.2) 0%, transparent 100%); border-left: 2px solid var(--gold-elev); }
    .tier-TIER_3_ZENITH { background: linear-gradient(135deg, rgba(242, 202, 80, 0.3) 0%, transparent 100%); border-left: 2px solid #f2ca50; }
    .tier-MASTER { background: linear-gradient(135deg, rgba(251, 191, 36, 0.3) 0%, transparent 100%); border-left: 2px solid #fbbf24; }
    .role-pill {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 0.3rem;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .role-pill.ADMIN { background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3); }
    .role-pill.USER { background: rgba(100, 116, 139, 0.15); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.3); }
    .status-pill { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 1rem; font-size: 0.65rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
    .status-pill.active { background: rgba(74, 222, 128, 0.15); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.3); }
    .status-pill.inactive { background: rgba(100, 116, 139, 0.15); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.3); }
    </style>

    <script>
    let allUsers = [];
    let currentFilter = { search: '', tier: '' };

    async function loadUsers() {
        try {
            const r = await fetch('/sanctum/api/users');
            if (!r.ok) throw new Error('HTTP ' + r.status);
            const data = await r.json();
            if (!data.success) throw new Error(data.error || 'unknown');
            allUsers = data.users;
            renderUsers();
        } catch (e) {
            document.getElementById('users-grid').innerHTML = '<p class="col-span-full text-red-400 text-center py-8">Error: ' + e.message + '</p>';
        }
    }

    function renderUsers() {
        const filtered = allUsers.filter(u => {
            if (currentFilter.search && !u.code.toLowerCase().includes(currentFilter.search.toLowerCase())) return false;
            if (currentFilter.tier && u.tier !== currentFilter.tier) return false;
            return true;
        });

        if (filtered.length === 0) {
            document.getElementById('users-grid').innerHTML = '<p class="col-span-full text-center text-[var(--outline-elev)] py-8">Sin usuarios encontrados</p>';
            return;
        }

        document.getElementById('users-grid').innerHTML = filtered.map(u => {
            const initials = (u.code || '??').substring(0, 2).toUpperCase();
            const roleClass = u.isAdmin ? 'ADMIN' : 'USER';
            const avatarClass = u.isAdmin ? 'admin' : 'user';
            const statusClass = u.active ? 'active' : 'inactive';
            const statusText = u.active ? 'Active' : 'Inactive';
            const statusDotClass = u.active ? 'online' : 'offline';
            const tier = u.tier || 'INITIATE';
            return `
            <div class="user-card ${u.active ? '' : 'inactive'}">
                <div class="flex items-start gap-3">
                    <div class="relative">
                        <div class="user-avatar ${avatarClass}">${initials}</div>
                        <span class="user-status-dot ${statusDotClass}"></span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-2">
                            <p class="text-sm font-mono text-[var(--on-surface-elev)] truncate">${escapeHtml(u.code || '')}</p>
                            <span class="role-pill ${roleClass}">${roleClass}</span>
                        </div>
                        <p class="text-sm text-[var(--outline-elev)] truncate">${escapeHtml(u.name || '')}</p>
                        ${u.email ? `<p class="text-xs text-[var(--outline-elev)] truncate">${escapeHtml(u.email)}</p>` : ''}
                        <div class="flex items-center gap-2 mt-2">
                            <span class="tier-badge tier-${escapeHtml(tier)}">${tier.replace(/_/g, ' ')}</span>
                            <span class="status-pill ${statusClass}">${statusText}</span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center justify-between mt-3 pt-3 border-t border-[var(--outline-variant-elev)] text-xs text-[var(--outline-elev)]">
                    <span>$${parseFloat(u.walletBalance || 0).toFixed(2)}</span>
                    <span>${u.coins || 0} coins</span>
                    <span>${u.lastLogin ? u.lastLogin.substring(5, 16).replace('T', ' ') : '—'}</span>
                </div>
                <div class="mt-2 flex justify-end">
                    <button class="text-xs px-2 py-1 rounded ${u.active ? 'bg-red-900/30 text-red-400 hover:bg-red-900/50' : 'bg-green-900/30 text-green-400 hover:bg-green-900/50'} transition-colors" data-user-code="${escapeHtml(u.code || '')}" data-action="toggle-user">
                        ${u.active ? 'Desactivar' : 'Activar'}
                    </button>
                </div>
            </div>`;
        }).join('');
    }

    function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    document.getElementById('refresh-btn').addEventListener('click', loadUsers);
    document.getElementById('search-input').addEventListener('input', e => { currentFilter.search = e.target.value; renderUsers(); });
    document.getElementById('filter-tier').addEventListener('change', e => { currentFilter.tier = e.target.value; renderUsers(); });

    // Toggle user active state
    document.addEventListener('click', async (e) => {
        if (!e.target.matches('[data-action="toggle-user"]')) return;
        const code = e.target.dataset.userCode;
        if (!code) return;
        e.target.disabled = true;
        try {
            const r = await fetch('/sanctum/api/users/' + encodeURIComponent(code) + '/active', { method: 'PATCH' });
            const data = await r.json();
            if (data.success) {
                loadUsers();
            } else {
                alert('Error: ' + (data.error || 'desconocido'));
                e.target.disabled = false;
            }
        } catch (err) {
            alert('Error: ' + err.message);
            e.target.disabled = false;
        }
    });

    loadUsers();
    </script>
{% endblock %}