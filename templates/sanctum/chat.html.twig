{% extends 'shell.html.twig' %}

{% block title %}Mensajes · T.N.S.V.T{% endblock %}

{% block topbar_title %}Mensajes{% endblock %}
{% block topbar_subtitle %}Conversaciones 1:1 y grupos del Sanctum.{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="chat-layout" data-controller="chat">

    {# ─── Lista conversaciones ─── #}
    <aside class="chat-pane chat-list-pane">
        <div class="chat-pane-header">
            <div class="chat-tabs" id="chat-tabs" data-chat-target="tabs">
                <button class="chat-tab active" data-tab="all"    type="button">Todos</button>
                <button class="chat-tab"        data-tab="unread" type="button">No leídos</button>
                <button class="chat-tab"        data-tab="groups" type="button">Grupos</button>
            </div>
            <input type="text" class="chat-search" id="chat-search" data-chat-target="search" placeholder="Buscar..." />
            <button type="button" class="chat-new-dm-btn" id="chat-new-dm-btn" data-chat-target="newDmBtn">
                <span class="material-symbols-elev icon-size-sm">add_comment</span>
                Nuevo DM
            </button>
        </div>
        <div class="chat-list" id="chat-list" data-chat-target="list">
            <div class="skeleton-stack" aria-hidden="true">
                <div class="skeleton skeleton-row"><span class="skeleton skeleton-avatar"></span><span class="skeleton-lines"><span class="skeleton skeleton-line w-3-4"></span><span class="skeleton skeleton-line w-1-2"></span></span></div>
                <div class="skeleton skeleton-row"><span class="skeleton skeleton-avatar"></span><span class="skeleton-lines"><span class="skeleton skeleton-line w-3-4"></span><span class="skeleton skeleton-line w-1-2"></span></span></div>
                <div class="skeleton skeleton-row"><span class="skeleton skeleton-avatar"></span><span class="skeleton-lines"><span class="skeleton skeleton-line w-3-4"></span><span class="skeleton skeleton-line w-1-2"></span></span></div>
            </div>
        </div>
    </aside>

    {# ─── Panel de mensajes ─── #}
    <section class="chat-pane">
        <div class="chat-conv-header" id="chat-conv-header" data-chat-target="convHeader" style="display:none;">
            <div class="chat-conv-avatar" id="chat-conv-avatar" data-chat-target="convAvatar">C</div>
            <div>
                <div class="chat-conv-header-name" id="chat-conv-name" data-chat-target="convName">Conversación</div>
                <div class="chat-conv-header-status" id="chat-conv-status" data-chat-target="convStatus">—</div>
            </div>
        </div>
        <div class="chat-messages" id="chat-messages" data-chat-target="messages">
            <div class="chat-empty" id="chat-empty-default" data-chat-target="emptyDefault">
                <span class="material-symbols-elev chat-empty-icon">forum</span>
                <p>Selecciona una conversación para empezar.</p>
            </div>
        </div>
        <div class="chat-composer" id="chat-composer" data-chat-target="composer" style="display:none;">
            <textarea id="chat-input" data-chat-target="input" class="chat-composer-textarea"
                      placeholder="Escribe un mensaje..." rows="1"></textarea>
            <button id="chat-send" data-chat-target="send" class="chat-send-btn" disabled>
                <span class="material-symbols-elev icon-size-sm">send</span>
                Enviar
            </button>
        </div>
    </section>

</div>

{# ─── Modal: Nuevo DM — unified tnsvt-modal (Phase 12, F2) ─── #}
<div class="tnsvt-modal-overlay" id="chat-new-dm-modal" data-chat-target="newDmModal" role="dialog" aria-modal="true" aria-labelledby="chat-modal-title" hidden>
    <div class="tnsvt-modal">
        <div class="tnsvt-modal__header">
            <h2 id="chat-modal-title" class="tnsvt-modal__title">
                <span class="material-symbols-elev">person_add</span>
                <span>Nuevo mensaje directo</span>
            </h2>
            <button type="button" class="tnsvt-modal__close" id="chat-modal-close" data-chat-target="modalClose" aria-label="Cerrar">
                <span class="material-symbols-elev" aria-hidden="true">close</span>
            </button>
        </div>
        <div class="tnsvt-modal__body">
            <input type="text" id="chat-dm-search" data-chat-target="dmSearch" class="form-input" style="width:100%;margin-bottom:0.75rem;"
                   placeholder="Buscar por código o nombre..." autocomplete="off" />
            <div id="chat-dm-results" data-chat-target="dmResults">
                <p class="chat-list-empty">Escribí un código o nombre para buscar...</p>
            </div>
        </div>
    </div>
</div>

{% endblock %}
