    function fmtUSD(n) {
        const v = Math.abs(n);
        if (v >= 1e6) return `$${(n/1e6).toFixed(2)}M`;
        if (v >= 1e3) return `$${(n/1e3).toFixed(2)}k`;
        return `$${n.toFixed(2)}`;
    }
    function fmtPct(n) {
        const s = n >= 0 ? '+' : '';
        return `${s}${n.toFixed(2)}%`;
    }
    function _pad(n) { return n < 10 ? '0' + n : '' + n; }
    function _nowYM() {
        const d = new Date();
        return { year: d.getFullYear(), month: d.getMonth() + 1 };
    }
    function formatLongDate(isoDate) {
        const [y, m, d] = isoDate.split('-').map(Number);
        const date = new Date(y, m - 1, d);
        const dias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
        const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        return `${dias[date.getDay()]} ${d} de ${meses[date.getMonth()]}, ${y}`;
    }

    let _currentRange = 'all';
    function getCurrentRange() {
        const active = document.querySelector('#ec-range-tabs .ec-tab.active');
        return active ? active.dataset.range : _currentRange;
    }

    async function loadEquityCurve(range) {
        const svg = document.getElementById('ec-chart');
        if (!svg) return;

        const accSize = (window.TNSVT_ACTIVE_ACCOUNT && Number(window.TNSVT_ACTIVE_ACCOUNT.account_size)) || 10000;
        const accParam = window.TNSVT_ACTIVE_ACCOUNT_ID ? `&account_id=${window.TNSVT_ACTIVE_ACCOUNT_ID}` : '';
        const url = `/api/journal/equity-curve?range=${encodeURIComponent(range)}&account_size=${accSize}${accParam}`;
        const r = await apiFetch(url, { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;

        const { summary, points, account_size: accountSize, range: serverRange } = r.data;
        _currentRange = serverRange;

        document.querySelectorAll('#ec-range-tabs .ec-tab').forEach(btn => {
            const isActive = btn.dataset.range === serverRange;
            btn.classList.toggle('active', isActive);
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        const balanceEl = document.getElementById('ec-balance');
        const balanceMetaEl = document.getElementById('ec-balance-meta');
        balanceEl.textContent = fmtUSD(summary.current);
        balanceMetaEl.textContent = `Peak ${fmtUSD(summary.peak)} · Low ${fmtUSD(summary.low)}`;

        const returnEl = document.getElementById('ec-return');
        returnEl.textContent = fmtPct(summary.total_return_pct);
        returnEl.classList.remove('pos', 'neg');
        returnEl.classList.add(summary.total_return_pct >= 0 ? 'pos' : 'neg');
        document.getElementById('ec-return-meta').textContent =
            `${summary.trade_count} trades · ${summary.wins}W / ${summary.losses}L · WR ${summary.win_rate}%`;

        const ddEl = document.getElementById('ec-drawdown');
        ddEl.textContent = `-${(summary.max_drawdown_pct || 0).toFixed(2)}%`;
        ddEl.classList.remove('pos', 'neg');
        ddEl.classList.add('neg');
        document.getElementById('ec-drawdown-meta').textContent =
            `Peak-to-trough · ${summary.breakeven} BE`;

        const emptyEl = document.getElementById('ec-empty');
        const loadingEl = document.getElementById('ec-loading');
        if (loadingEl) loadingEl.remove();

        if (points.length === 0) {
            svg.hidden = true;
            emptyEl.hidden = false;
            document.getElementById('ec-source').textContent = serverRange;
            return;
        }
        svg.hidden = false;
        emptyEl.hidden = true;

        drawEquitySvg(svg, points, accountSize, serverRange);
    }

    function drawEquitySvg(svg, points, accountSize, rangeLabel) {
        const W = 1000, H = 280;
        const padT = 20, padB = 32, padL = 60, padR = 24;
        const chartW = W - padL - padR;
        const chartH = H - padT - padB;

        const balances = points.map(p => p.balance);
        const min = Math.min(accountSize, ...balances);
        const max = Math.max(accountSize, ...balances);
        const range = (max - min) || 1;

        const xs = points.map((_, i) =>
            points.length === 1
                ? padL + chartW / 2
                : padL + (i / (points.length - 1)) * chartW
        );
        const ys = points.map(p =>
            padT + chartH - ((p.balance - min) / range) * chartH
        );

        const linePath = xs.map((x, i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${ys[i].toFixed(1)}`).join(' ');
        const fillPath = `${linePath} L ${xs[xs.length-1].toFixed(1)} ${padT+chartH} L ${xs[0].toFixed(1)} ${padT+chartH} Z`;
        const baselineY = padT + chartH - ((accountSize - min) / range) * chartH;

        const yTicks = [0, 0.25, 0.5, 0.75, 1].map(f => {
            const value = min + (max - min) * f;
            const y = padT + chartH - f * chartH;
            return `<text x="${padL-8}" y="${y+4}" fill="rgba(255,255,255,0.45)" font-size="10" text-anchor="end" font-family="Space Grotesk">${fmtUSD(value)}</text>`;
        }).join('');

        svg.innerHTML = `
            <defs>
                <linearGradient id="ec-fill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="rgba(242, 202, 80, 0.35)" />
                    <stop offset="100%" stop-color="rgba(242, 202, 80, 0)" />
                </linearGradient>
            </defs>
            <g stroke="rgba(255,255,255,0.06)" stroke-width="1">
                <line x1="${padL}" x2="${W-padR}" y1="${padT}" y2="${padT}" />
                <line x1="${padL}" x2="${W-padR}" y1="${padT+chartH/2}" y2="${padT+chartH/2}" />
                <line x1="${padL}" x2="${W-padR}" y1="${padT+chartH}" y2="${padT+chartH}" />
            </g>
            ${yTicks}
            <line x1="${padL}" x2="${W-padR}" y1="${baselineY.toFixed(1)}" y2="${baselineY.toFixed(1)}"
                  stroke="rgba(255,255,255,0.25)" stroke-dasharray="4 4" stroke-width="1" />
            <text x="${W-padR}" y="${(baselineY-4).toFixed(1)}" fill="rgba(255,255,255,0.5)" font-size="9" text-anchor="end" font-family="Space Grotesk">baseline</text>
            <g id="ec-baseline-hit" style="cursor:pointer" role="button" tabindex="0"
               aria-label="Baseline: tamaño de cuenta. Activar para ver el valor.">
                <title>Baseline = tamaño de cuenta ($${accountSize.toLocaleString('es-AR')})</title>
                <line x1="${padL}" x2="${W-padR}" y1="${baselineY.toFixed(1)}" y2="${baselineY.toFixed(1)}"
                      stroke="transparent" stroke-width="14" />
            </g>
            <path d="${fillPath}" fill="url(#ec-fill)" />
            <path d="${linePath}" stroke="#f2ca50" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            ${points.map((p, i) => {
                const color = p.pnl > 0 ? 'var(--success-elev)' : p.pnl < 0 ? 'var(--error-elev)' : 'rgba(255,255,255,0.45)';
                return `<circle class="ec-point" cx="${xs[i].toFixed(1)}" cy="${ys[i].toFixed(1)}" r="3" fill="${color}" stroke="#0e0a18" stroke-width="1" data-idx="${i}" style="cursor:pointer" />`;
            }).join('')}
        `;

        const tooltip = document.getElementById('ec-tooltip');
        const card = svg.closest('.equity-curve-card');
        svg.querySelectorAll('.ec-point').forEach(circle => {
            const idx = parseInt(circle.dataset.idx, 10);
            const p = points[idx];
            circle.addEventListener('mouseenter', () => {
                const dateStr = p.date ? new Date(p.date).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: '2-digit' }) : '—';
                // L17: coerce numerics — API may send strings/nulls, which
                // used to render "$NaN" in the tooltip.
                const pnl = Number(p.pnl) || 0;
                const bal = Number(p.balance) || 0;
                const dd = Number(p.drawdown_pct) || 0;
                const pnlSign = pnl >= 0 ? '+' : '';
                const pnlColor = pnl >= 0 ? 'var(--success-elev)' : 'var(--error-elev)';
                tooltip.innerHTML = `
                    <div class="text-xs">
                        <div class="flex items-center gap-2 mb-1">
                            <strong class="text-[var(--gold-elev)]">${escapeHtml(p.asset)} ${escapeHtml(p.direction)}</strong>
                            <span class="text-[10px] px-1.5 rounded ${p.result === 'WIN' ? 'bg-green-500/20 text-green-300' : p.result === 'LOSS' ? 'bg-red-500/20 text-red-300' : 'bg-white/10 text-white/60'}">${escapeHtml(p.result || '—')}</span>
                        </div>
                        <div class="text-[var(--outline-elev)]">${dateStr}</div>
                        <div class="mt-1">Balance <span class="font-bold">$${bal.toLocaleString('es-AR', {minimumFractionDigits: 2})}</span></div>
                        <div style="color: ${pnlColor}">P&L ${pnlSign}$${Math.abs(pnl).toFixed(2)}</div>
                        ${dd > 0 ? `<div class="text-[var(--outline-elev)] text-[10px]">DD ${dd.toFixed(2)}%</div>` : ''}
                    </div>
                `;
                if (card) {
                    const cardRect = card.getBoundingClientRect();
                    const svgRect  = svg.getBoundingClientRect();
                    const xRatio = xs[idx] / W;
                    const yRatio = ys[idx] / H;
                    const left = (svgRect.left - cardRect.left) + xRatio * svgRect.width;
                    const top  = (svgRect.top  - cardRect.top)  + yRatio * svgRect.height;
                    tooltip.style.left = `${left}px`;
                    tooltip.style.top  = `${top}px`;
                    tooltip.hidden = false;
                }
            });
            circle.addEventListener('mouseleave', () => {
                tooltip.hidden = true;
            });
        });

        // P6: baseline hit-area — click/Enter announces the value.
        const baseHit = document.getElementById('ec-baseline-hit');
        if (baseHit) {
            const announce = () => {
                if (window.apiToast) {
                    window.apiToast('Baseline = tamaño de cuenta ($' + Number(accountSize).toLocaleString('es-AR') + ')', 'info');
                }
            };
            baseHit.addEventListener('click', announce);
            baseHit.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); announce(); }
            });
        }

        document.getElementById('ec-source').textContent =
            `${rangeLabel.toUpperCase()} · ${points.length} ops`;
    }

    function wireEquityCurveTabs() {
        const wrap = document.getElementById('ec-range-tabs');
        if (!wrap) return;
        wrap.addEventListener('click', e => {
            const btn = e.target.closest('.ec-tab');
            if (!btn) return;
            loadEquityCurve(btn.dataset.range);
        });
    }

    async function loadStats() {
        if (!document.getElementById('stats-pf')) return;

        const r = await apiFetch('/api/journal/stats', { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;
        const s = r.data.stats;
        const hasTrades = s.total > 0;

        const pfEl = document.getElementById('stats-pf');
        const pfMetaEl = document.getElementById('stats-pf-meta');
        pfEl.textContent = hasTrades ? (s.profit_factor >= 99.99 ? '∞' : s.profit_factor.toFixed(2)) : '—';
        pfEl.classList.remove('pos', 'neg', 'muted');
        if (!hasTrades) pfEl.classList.add('muted');
        else if (s.profit_factor >= 1.5) pfEl.classList.add('pos');
        else if (s.profit_factor < 1) pfEl.classList.add('neg');
        pfMetaEl.textContent = hasTrades
            ? `Gross +$${s.gross_profit.toFixed(0)} / -$${s.gross_loss.toFixed(0)}`
            : 'Sin operaciones';

        const expEl = document.getElementById('stats-expect');
        expEl.textContent = hasTrades
            ? (s.expectancy >= 0 ? '+$' : '-$') + Math.abs(s.expectancy).toFixed(2)
            : '—';
        expEl.classList.remove('pos', 'neg', 'muted');
        if (!hasTrades) expEl.classList.add('muted');
        else expEl.classList.add(s.expectancy >= 0 ? 'pos' : 'neg');
        document.getElementById('stats-expect-meta').textContent = hasTrades
            ? 'por trade promedio'
            : '—';

        const wrEl = document.getElementById('stats-wr');
        wrEl.textContent = hasTrades ? s.win_rate.toFixed(1) + '%' : '—';
        wrEl.classList.remove('pos', 'neg', 'muted');
        if (!hasTrades) wrEl.classList.add('muted');
        else if (s.win_rate >= 50) wrEl.classList.add('pos');
        else wrEl.classList.add('neg');
        document.getElementById('stats-wr-meta').textContent = hasTrades
            ? `${s.wins}W / ${s.losses}L`
            : '—';

        document.getElementById('stats-avg-w').textContent = hasTrades && s.avg_win > 0
            ? '+$' + s.avg_win.toFixed(2)
            : '—';
        document.getElementById('stats-avg-w-meta').textContent = hasTrades
            ? `${s.wins} ops ganadoras`
            : '—';

        document.getElementById('stats-avg-l').textContent = hasTrades && s.avg_loss > 0
            ? '-$' + s.avg_loss.toFixed(2)
            : '—';
        document.getElementById('stats-avg-l-meta').textContent = hasTrades
            ? `${s.losses} ops perdedoras`
            : '—';

        document.getElementById('stats-best').textContent = s.best_trade !== null
            ? '+$' + s.best_trade.toFixed(2)
            : '—';
        document.getElementById('stats-worst').textContent = s.worst_trade !== null
            ? '-$' + Math.abs(s.worst_trade).toFixed(2)
            : '—';
        const totalEl = document.getElementById('stats-total-pnl');
        totalEl.textContent = (s.total_pnl >= 0 ? '+' : '-$') + Math.abs(s.total_pnl).toFixed(2);
        totalEl.style.color = s.total_pnl >= 0 ? 'var(--success-elev)' : 'var(--error-elev)';

        document.getElementById('stats-trade-count').textContent = s.total;

        // Mirror into stats-detail if present
        const dpf = document.getElementById('stats-detail-pf');
        if (dpf) {
            dpf.textContent = pfEl.textContent;
            dpf.className = pfEl.className;
            const dpfMeta = document.getElementById('stats-detail-pf-meta');
            if (dpfMeta) dpfMeta.textContent = pfMetaEl.textContent;
            const dexp = document.getElementById('stats-detail-expect');
            if (dexp) {
                dexp.textContent = expEl.textContent;
                dexp.className = expEl.className;
            }
            const dwr = document.getElementById('stats-detail-wr');
            if (dwr) {
                dwr.textContent = wrEl.textContent;
                dwr.className = wrEl.className;
            }
            const dwrMeta = document.getElementById('stats-detail-wr-meta');
            if (dwrMeta) dwrMeta.textContent = document.getElementById('stats-wr-meta').textContent;
            const dwin = document.getElementById('stats-detail-avg-w');
            if (dwin) dwin.textContent = document.getElementById('stats-avg-w').textContent;
            const dwinMeta = document.getElementById('stats-detail-avg-w-meta');
            if (dwinMeta) dwinMeta.textContent = document.getElementById('stats-avg-w-meta').textContent;
            const dlos = document.getElementById('stats-detail-avg-l');
            if (dlos) dlos.textContent = document.getElementById('stats-avg-l').textContent;
            const dlosMeta = document.getElementById('stats-detail-avg-l-meta');
            if (dlosMeta) dlosMeta.textContent = document.getElementById('stats-avg-l-meta').textContent;
            const dtot = document.getElementById('stats-detail-total');
            if (dtot) {
                dtot.textContent = totalEl.textContent;
                dtot.style.color = totalEl.style.color;
            }
            const dbest = document.getElementById('stats-detail-best');
            if (dbest) dbest.textContent = document.getElementById('stats-best').textContent;
            const dworst = document.getElementById('stats-detail-worst');
            if (dworst) dworst.textContent = document.getElementById('stats-worst').textContent;
            const dwins = document.getElementById('stats-detail-wins');
            if (dwins) dwins.textContent = s.wins;
            const dloses = document.getElementById('stats-detail-losses');
            if (dloses) dloses.textContent = s.losses;
            const dbe = document.getElementById('stats-detail-be');
            if (dbe) dbe.textContent = s.breakeven || 0;
            const dopen = document.getElementById('stats-detail-open');
            if (dopen) dopen.textContent = s.open || 0;
        }
    }

