        await loadStats();
    }

    // ════════════════════════════════════════════════════════════
    // CALENDAR
    // ════════════════════════════════════════════════════════════
    let _CALstate = null;

    async function loadCalendarMonthly(year, month) {
        const grid = document.getElementById('cal-month-grid');
        if (!grid) return;
        const url = `/api/journal/calendar-monthly?year=${year}&month=${month}`;
        const r = await apiFetch(url, { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;

        _CALstate = { year: r.data.year, month: r.data.month_num };

        document.getElementById('cal-month-title').textContent =
            `${r.data.month_name} ${r.data.year}`;
        document.getElementById('cal-month-pnl').textContent = fmtUSD(r.data.summary.total_pnl);
        document.getElementById('cal-month-pnl').style.color =
            r.data.summary.total_pnl >= 0 ? 'var(--success-elev)' : 'var(--error-elev)';
        document.getElementById('cal-month-trades').textContent = r.data.summary.trade_count;
        document.getElementById('cal-month-wr').textContent = r.data.summary.win_rate;

        renderMonthGrid(r.data.year, r.data.month_num, r.data.days);
        renderMonthlyPnlChart(r.data.monthly_pnl);
    }

    function renderMonthGrid(year, month, daysByDate) {
        const grid = document.getElementById('cal-month-grid');
        const dayMap = Object.fromEntries(daysByDate.map(d => [d.date, d]));
        const headers = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
        const headerHtml = headers.map(h =>
            `<div class="cal-month-day-header">${h}</div>`
        ).join('');

        const firstOfMonth = new Date(year, month - 1, 1);
        const firstIsoWeekday = firstOfMonth.getDay() === 0 ? 7 : firstOfMonth.getDay();
        const offsetCells = firstIsoWeekday - 1;
        const daysInMonth = new Date(year, month, 0).getDate();
        const daysInPrevMonth = new Date(year, month - 1, 0).getDate();
        const totalCells = Math.ceil((offsetCells + daysInMonth) / 7) * 7;

        const today = new Date();
        const todayIso = `${today.getFullYear()}-${_pad(today.getMonth() + 1)}-${_pad(today.getDate())}`;

        let bodyHtml = '';
        for (let i = 0; i < totalCells; i++) {
            let cellYear = year, cellMonth = month;
            let cellNum;
            let outside = false;
            const dayIndex = i - offsetCells + 1;
            if (dayIndex < 1) {
                cellMonth = month === 1 ? 12 : month - 1;
                cellYear  = month === 1 ? year - 1 : year;
                cellNum = daysInPrevMonth + dayIndex;
                outside = true;
            } else if (dayIndex > daysInMonth) {
                cellMonth = month === 12 ? 1 : month + 1;
                cellYear  = month === 12 ? year + 1 : year;
                cellNum = dayIndex - daysInMonth;
                outside = true;
            } else {
                cellNum = dayIndex;
            }
            const isoDate = `${cellYear}-${_pad(cellMonth)}-${_pad(cellNum)}`;
            const dayData = !outside ? dayMap[isoDate] : null;
            const isToday = !outside && isoDate === todayIso;

            const trades = dayData?.trade_count || 0;
            const pnl = dayData?.pnl || 0;
            const wins = dayData?.wins || 0;
            const losses = dayData?.losses || 0;
            const hasOpen = dayData?.has_open || false;

            let variant = '';
            if (trades > 0) {
                if (wins > 0 && losses === 0 && !hasOpen) variant = 'wins';
                else if (losses > 0 && wins === 0 && !hasOpen) variant = 'losses';
                else if (hasOpen) variant = 'has-open';
                else variant = 'mixed';
            }

            const pnlClass = pnl > 0 ? 'pos' : (pnl < 0 ? 'neg' : 'zero');
            const pnlSign = pnl > 0 ? '+' : '';
            const pnlTxt = trades === 0 ? '' : `${pnlSign}$${Math.abs(pnl).toFixed(0)}`;
            const countTxt = trades === 0 ? '' : `${trades} op${trades>1?'s':''}`;

            bodyHtml += `
                <div class="cal-month-day ${outside ? 'outside' : ''} ${isToday ? 'today' : ''} ${variant}"
                     data-date="${isoDate}"
                     ${outside ? '' : 'role="button" tabindex="0"'}>
                    <div class="cal-month-day-num">${cellNum}</div>
                    <div>
                        <div class="cal-month-day-pnl ${pnlClass}">${pnlTxt}</div>
                        <div class="cal-month-day-count">${countTxt}</div>
                    </div>
                </div>
            `;
        }
        grid.innerHTML = headerHtml + bodyHtml;
        grid.classList.add('cal-month-grid-animate');
        setTimeout(() => grid.classList.remove('cal-month-grid-animate'), 400);
    }

    function wireCalendarNav() {
        const prev = document.getElementById('cal-prev');
        const next = document.getElementById('cal-next');
        const today = document.getElementById('cal-today');
        if (!prev || !next || !today) return;
        prev.addEventListener('click', () => {
            const s = _CALstate || _nowYM();
            let m = s.month - 1, y = s.year;
            if (m < 1) { m = 12; y--; }
            loadCalendarMonthly(y, m);
        });
        next.addEventListener('click', () => {
            const s = _CALstate || _nowYM();
            let m = s.month + 1, y = s.year;
            if (m > 12) { m = 1; y++; }
            loadCalendarMonthly(y, m);
        });
        today.addEventListener('click', () => {
            const t = _nowYM();
            loadCalendarMonthly(t.year, t.month);
        });
    }

    function wireCalendarClicks() {
        const grid = document.getElementById('cal-month-grid');
        if (!grid) return;
        grid.addEventListener('click', e => {
            const cell = e.target.closest('.cal-month-day');
            if (!cell || cell.classList.contains('outside')) return;
            openCalDayModal(cell.dataset.date);
        });
        grid.addEventListener('keydown', e => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            const cell = e.target.closest('.cal-month-day');
            if (!cell || cell.classList.contains('outside')) return;
            e.preventDefault();
            openCalDayModal(cell.dataset.date);
        });
    }

    async function openCalDayModal(isoDate) {
        if (!_CALstate) {
            const t = _nowYM();
            _CALstate = t;
        }
        const r = await apiFetch(`/api/journal/calendar-monthly?year=${_CALstate.year}&month=${_CALstate.month}`, { silent: true });
        if (!r.ok || !r.data || !r.data.success) return;
        const dayData = (r.data.days || []).find(d => d.date === isoDate);

        const titleEl = document.getElementById('cal-day-modal-title');
        titleEl.textContent = `Detalle · ${formatLongDate(isoDate)}`;

        const body = document.getElementById('cal-day-modal-body');
        if (!dayData || !dayData.trades || dayData.trades.length === 0) {
            body.innerHTML = '<p class="cal-trades-empty">No hay trades registrados en este día.</p>';
        } else {
            const total = dayData.pnl;
            const totalClass = total >= 0 ? 'pnl-pos' : 'pnl-neg';
            const totalSign = total >= 0 ? '+' : '';
            body.innerHTML = `
                <div class="flex items-center gap-3 mb-3 text-sm">
                    <span>Total del día: <strong class="${totalClass}">${totalSign}$${Math.abs(total).toFixed(2)}</strong></span>
                    <span class="text-[var(--outline-elev)]">·</span>
                    <span>${dayData.trade_count} operacion${dayData.trade_count>1?'es':''}</span>
                    <span class="text-[var(--outline-elev)]">·</span>
                    <span><span class="text-green-400">${dayData.wins}W</span> / <span class="text-red-400">${dayData.losses}L</span>${dayData.breakeven ? ` / <span class="text-[var(--outline-elev)]">${dayData.breakeven}BE</span>` : ''}${dayData.has_open ? ` / <span class="text-violet-400">abiertas</span>` : ''}</span>
                </div>
                <table class="cal-trades-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Activo</th>
                            <th>Dir</th>
                            <th>Result</th>
                            <th class="text-right">P&L</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${dayData.trades.map(t => {
                            const date = new Date(t.date);
                            const hora = `${_pad(date.getHours())}:${_pad(date.getMinutes())}`;
                            const pnlCls = t.pnl >= 0 ? 'pnl-pos' : 'pnl-neg';
                            const pnlSign = t.pnl >= 0 ? '+' : '';
                            return `
                                <tr>
                                    <td class="font-mono text-xs text-[var(--outline-elev)]">${hora}</td>
                                    <td class="font-semibold">${escapeHtml(t.asset || '')}</td>
                                    <td><span class="px-1.5 py-0.5 rounded text-xs ${t.direction === 'BUY' ? 'bg-green-500/15 text-green-300' : 'bg-red-500/15 text-red-300'}">${escapeHtml(t.direction || '')}</span></td>
                                    <td><span class="px-1.5 py-0.5 rounded text-xs ${t.result === 'WIN' ? 'bg-green-500/20 text-green-300' : t.result === 'LOSS' ? 'bg-red-500/20 text-red-300' : 'bg-white/10 text-white/60'}">${escapeHtml(t.result || '')}</span></td>
                                    <td class="text-right ${pnlCls}">${pnlSign}$${Math.abs(t.pnl).toFixed(2)}</td>
                                </tr>
                            `;
                        }).join('')}
                    </tbody>
                </table>
            `;
        }
        const modal = document.getElementById('cal-day-modal');
        if (typeof calDayModal !== 'undefined' && calDayModal) {
            calDayModal.open();
        }
    }

    const calDayModal = apiSetupModal(document.getElementById('cal-day-modal'));

    function wireCalDayModal() {
        document.querySelectorAll('[data-action="close-cal-day"]').forEach(b => {
            b.addEventListener('click', () => {
                if (typeof calDayModal !== 'undefined' && calDayModal) calDayModal.close();
            });
        });
    }

    function renderMonthlyPnlChart(rows) {
        const wrap = document.getElementById('monthly-pnl-chart');
        if (!wrap) return;
        if (!rows || rows.length === 0) {
            wrap.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-8 text-xs">Sin datos.</p>';
            return;
        }
        const W = 720, H = 260;
        const padT = 20, padB = 36, padL = 56, padR = 16;
        const chartW = W - padL - padR;
        const chartH = H - padT - padB;
        const n = rows.length;
        const barGap = 0.25;
        const barW = (chartW / n) * (1 - barGap);

        const vals = rows.map(r => r.pnl);
        const maxAbs = Math.max(...vals.map(Math.abs), 1);
        const yMax = Math.ceil(maxAbs * 1.1);
        const yMin = -yMax;
        const yRange = yMax - yMin;
        const zeroY = padT + chartH * (yMax / yRange);

        const xFor = (i) => padL + (i + 0.5) * (chartW / n) - barW / 2;
        const yFor = (v) => padT + chartH * ((yMax - v) / yRange);

        const monthLabels = ['ENE','FEB','MAR','ABR','MAY','JUN','JUL','AGO','SEP','OCT','NOV','DIC'];
        const bars = rows.map((r, i) => {
            const x = xFor(i);
            const y = yFor(r.pnl);
            const h = Math.abs(zeroY - y);
            const color = r.pnl >= 0 ? 'var(--success-elev)' : 'var(--error-elev)';
            return `
                <rect class="monthly-bar" x="${x.toFixed(1)}" y="${Math.min(y, zeroY).toFixed(1)}" width="${barW.toFixed(1)}" height="${h.toFixed(1)}" fill="${color}" stroke="#0e0a18" stroke-width="1" rx="3" data-month="${r.month}" />
                <text class="monthly-pnl-axis-text" x="${(x + barW/2).toFixed(1)}" y="${(padT + chartH + 16).toFixed(1)}" text-anchor="middle">${monthLabels[parseInt(r.month.slice(5), 10) - 1]}</text>
            `;
        }).join('');

        const ticks = [-yMax, -yMax/2, 0, yMax/2, yMax].map(v => {
            const y = yFor(v);
            return `
                <line x1="${padL}" x2="${W-padR}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                <text class="monthly-pnl-axis-text" x="${padL-8}" y="${(y+4).toFixed(1)}" text-anchor="end">${fmtUSD(v)}</text>
            `;
        }).join('');

        wrap.innerHTML = `
            <svg class="monthly-pnl-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-label="P&L mensual últimos 6 meses">
                ${ticks}
                <line x1="${padL}" x2="${W-padR}" y1="${zeroY.toFixed(1)}" y2="${zeroY.toFixed(1)}" stroke="rgba(255,255,255,0.25)" stroke-dasharray="4 4" stroke-width="1" />
                <text class="monthly-pnl-axis-text" x="${W-padR}" y="${(zeroY-4).toFixed(1)}" text-anchor="end">$0</text>
                ${bars}
            </svg>
        `;

        const tot = vals.reduce((a, b) => a + b, 0);
        const sign = tot >= 0 ? '+' : '';
        const srcEl = document.getElementById('monthly-pnl-source');
        if (srcEl) srcEl.textContent = `6m: ${sign}${fmtUSD(tot)} · ${rows.reduce((a, r) => a + r.trade_count, 0)} ops`;
    }

    // ════════════════════════════════════════════════════════════
    // BOOT
    // ════════════════════════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', () => {
        // Tabs
        restoreTab();

        // Wire overview tab controls
        wireEquityCurveTabs();
        wireCalendarNav();
        wireCalendarClicks();
        wireCalDayModal();

        // Modal handlers
        document.getElementById('btn-new-trade').addEventListener('click', () => openModal(null));
        document.querySelectorAll('[data-action="close-trade-modal"]').forEach(b => b.addEventListener('click', closeModal));
        document.getElementById('trade-form').addEventListener('submit', saveTrade);

        listEl.addEventListener('click', (e) => {
            // F3: inline editor buttons (Guardar / Cancelar / Más campos).
            const inlineBtn = e.target.closest('[data-inline]');
            if (inlineBtn) {
                const id = inlineBtn.dataset.id;
                const kind = inlineBtn.dataset.inline;
                if (kind === 'save') saveInlineEdit(id);
                else if (kind === 'cancel') cancelInlineEdit(id);
                else if (kind === 'full') {
                    const trade = window._tradesById && window._tradesById[id];
                    cancelInlineEdit(id);
                    if (trade) openModal(trade);
                }
                return;
            }
            const editBtn = e.target.closest('[data-action="edit"]');
            if (editBtn) {
                // F3: edit in place; the modal stays for new trades +
                // full-field editing via the "Más" button.
                openInlineEdit(editBtn.dataset.id);
                return;
            }
            const delBtn = e.target.closest('[data-action="delete"]');
            if (delBtn) {
                deleteTrade(delBtn.dataset.id);
            }
        });

        // ─── Accounts Manager modal close + reset ───
        const accountsManagerModal = document.getElementById('accounts-manager-modal');
        let accountsManagerApiModal = null;
        if (accountsManagerModal) {
            accountsManagerApiModal = apiSetupModal(accountsManagerModal);
            document.querySelectorAll('[data-action="close-accounts-manager"]').forEach(b => {
                b.addEventListener('click', () => accountsManagerApiModal.close());
            });
            document.querySelectorAll('[data-action="reset-account-form"]').forEach(b => {
                b.addEventListener('click', () => {
                    const form = document.getElementById('accounts-manager-form');
                    if (form) form.reset();
                    document.getElementById('accounts-manager-cap')?.dispatchEvent(new Event('refresh-cap'));
                    const editIdInput = form.querySelector('input[name="id"]');
                    if (editIdInput) editIdInput.value = '';
                });
            });
        }
        window.openAccountsManager = (editId) => {
            if (window._accountSwitcher && typeof window._accountSwitcher.openManager === 'function') {
                window._accountSwitcher.openManager(editId);
            } else if (accountsManagerApiModal) {
                accountsManagerApiModal.open();
            }
        };

        // Initial data load: KPI cards + guardian banner (always visible)
        function boot() {
            if (currentUserCode()) {
                loadTrades();
                loadGuardianBanner();
            } else {
                setTimeout(() => {
                    if (currentUserCode()) {
                        loadTrades();
                        loadGuardianBanner();
                    } else if (listEl) {
                        listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-12">Sin sesión</p>';
                    }
                }, 1000);
            }
        }
        if (window.TNSVT_USER) {
            boot();
        } else {
            window.addEventListener('tnsvt:user-loaded', boot, { once: true });
            setTimeout(boot, 2000);
        }

        // Expose key functions globally so account-switcher controller can refresh data
        window.loadTrades = loadTrades;
        window.loadEquityCurve = loadEquityCurve;
        window.loadStats = loadStats;
        window.loadCalendarMonthly = loadCalendarMonthly;
        window.refreshOverviewPanel = typeof refreshOverviewPanel === 'function' ? refreshOverviewPanel : function() {};
    });
})();
</script>
{% endblock %}
