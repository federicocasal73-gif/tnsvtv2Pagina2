{% extends 'shell.html.twig' %}

{% block title %}Trading Journal · T.N.S.V.T{% endblock %}

{% block topbar_title %}El Libro del Ejecutor{% endblock %}
{% block topbar_subtitle %}"Lo que no se registra, no se domina."{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto">
    {# ─── Header ─── #}
    <div class="text-center mb-6">
        <p class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">El Libro del Ejecutor</p>
        <h1 class="font-headline-lg text-headline-lg shimmer-text">Trading Journal</h1>
    </div>

    {# ─── KPI Stats Row (Bento Grid 2x2) ─── #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" id="journal-stats">
        <div class="glass-card-elev text-center">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">analytics</span>
            <p class="kpi-label mt-2">Trades</p>
            <p class="kpi-value gold" id="stat-total">0</p>
        </div>
        <div class="glass-card-elev text-center">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">trending_up</span>
            <p class="kpi-label mt-2">Win Rate</p>
            <p class="kpi-value gold" id="stat-winrate">0%</p>
        </div>
        <div class="glass-card-elev text-center col-span-2">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">payments</span>
            <p class="kpi-label mt-2">PnL Neto Total</p>
            <p class="text-4xl font-bold text-[var(--gold-elev)] mt-1" id="stat-pnl">$0</p>
        </div>
    </div>

    {# ─── Equity Curve ─── #}
    <div class="glass-card-elev mb-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-title-md text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-[var(--gold-elev)]">show_chart</span>
                Curva de Equity
            </h3>
            <div class="flex gap-2">
                <button class="filter-pill" data-range="7">7d</button>
                <button class="filter-pill active" data-range="30">30d</button>
                <button class="filter-pill" data-range="90">90d</button>
            </div>
        </div>
        <div class="journal-equity">
            <svg class="w-full h-full" preserveaspectratio="none" viewBox="0 0 400 100">
                <defs>
                    <lineargradient id="equityGradient" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="#f2ca50" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="#f2ca50" stop-opacity="0"/>
                    </lineargradient>
                </defs>
                <path class="reveal-path drop-shadow-[0_0_8px_rgba(242,202,80,0.5)]"
                      d="M0,80 Q50,75 100,85 T200,60 T300,40 T400,20"
                      fill="none" stroke="#f2ca50" stroke-width="2"/>
                <path d="M0,80 Q50,75 100,85 T200,60 T300,40 T400,20 V100 H0 Z"
                      fill="url(#equityGradient)"/>
            </svg>
        </div>
    </div>

    {# ─── Navigation Tabs ─── #}
    <nav class="flex justify-between items-center glass-card-elev rounded-full px-1 py-1 mb-4">
        <button class="journal-nav-btn active">Dashboard</button>
        <button class="journal-nav-btn">Registrar</button>
        <button class="journal-nav-btn">Log</button>
        <button class="journal-nav-btn">Stats</button>
    </nav>

    {# ─── Guardian Pre-Trade Banner (Phase 3) ─── #}
    <div id="guardian-banner" class="hidden mb-4 p-4 rounded-lg border" style="border-color: var(--outline-variant-elev); background: var(--glass-bg-elev);">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-elev text-[var(--gold-elev)]">shield_person</span>
                Guardian — señales activas
            </h3>
            <a href="/sanctum/guardian" class="text-xs text-[var(--gold-elev)] hover:underline">Ver completo →</a>
        </div>
        <div id="guardian-banner-list" class="space-y-1.5"></div>
        <p class="text-xs text-[var(--outline-elev)] mt-2">Estas señales no bloquean el registro. Guardian es tu coach, no tu carcelero.</p>
    </div>

    {# ─── Toolbar ─── #}
    <div class="glass-card-elev mb-4 flex flex-wrap items-center gap-3">
        <button id="btn-new-trade" class="btn-primary flex items-center gap-2">
            <span class="material-symbols-elev align-middle text-sm">add</span>
            Nuevo Trade
        </button>
        <div class="flex-1"></div>
        <div class="flex items-center gap-2 text-sm text-[var(--outline-elev)]">
            <span id="journal-count">0 trades</span>
        </div>
    </div>

    {# ─── Trade List ─── #}
    <div class="glass-card-elev p-0 overflow-hidden">
        <div id="trade-list" class="divide-y divide-[var(--outline-variant-elev)]">
            <p class="text-center text-[var(--outline-elev)] py-12 loading-pulse">Cargando journal...</p>
        </div>
    </div>
</div>

{# ─── New/Edit Trade Modal ─── #}
<div id="trade-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); backdrop-filter:blur(8px); z-index:100; align-items:center; justify-content:center; padding:1rem;">
    <div class="glass-card-elev" style="width:100%; max-width:540px; max-height:90vh; overflow-y:auto;">
        <div class="flex items-center justify-between p-5 border-b border-[var(--glass-border-elev)]">
            <h2 class="text-lg font-semibold flex items-center gap-2">
                <span class="material-symbols-elev text-[var(--gold-elev)]">edit_note</span>
                <span id="trade-modal-title">Nuevo Trade</span>
            </h2>
            <button type="button" data-action="close-trade-modal" class="text-[var(--outline-elev)] hover:text-white">
                <span class="material-symbols-elev">close</span>
            </button>
        </div>
        <form id="trade-form" class="p-5 space-y-3">
            <input type="hidden" id="trade-id" />

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="kpi-label block mb-1">Asset *</label>
                    <input id="trade-asset" type="text" required maxlength="20" placeholder="XAUUSD"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">Dirección</label>
                    <select id="trade-dir" class="form-input">
                        <option value="BUY">BUY (Long)</option>
                        <option value="SELL">SELL (Short)</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="kpi-label block mb-1">Fecha</label>
                    <input id="trade-date" type="datetime-local"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">Resultado</label>
                    <select id="trade-result" class="form-input">
                        <option value="">—</option>
                        <option value="WIN">WIN</option>
                        <option value="LOSS">LOSS</option>
                        <option value="BE">BREAK-EVEN</option>
                        <option value="OPEN">OPEN</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-4 gap-3">
                <div>
                    <label class="kpi-label block mb-1">Entry</label>
                    <input id="trade-entry" type="text" step="any" placeholder="2650.50"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">SL</label>
                    <input id="trade-sl" type="text" step="any" placeholder="2645"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">TP</label>
                    <input id="trade-tp" type="text" step="any" placeholder="2660"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">PnL ($)</label>
                    <input id="trade-pnl" type="number" step="any" placeholder="125.50"
                           class="form-input" />
                </div>
            </div>

            <div>
                <label class="kpi-label block mb-1">Notas</label>
                <textarea id="trade-notes" rows="3" placeholder="Análisis, emociones, plan ejecutado..."
                          class="form-input"></textarea>
            </div>

            <p id="trade-form-error" class="text-red-400 text-sm hidden"></p>

            <div class="flex justify-end gap-2 pt-2 border-t border-[var(--glass-border-elev)]">
                <button type="button" data-action="close-trade-modal"
                        class="btn-secondary">Cancelar</button>
                <button type="submit" id="trade-submit" class="btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<script>
(function() {
    'use strict';
    const listEl = document.getElementById('trade-list');
    const modal = document.getElementById('trade-modal');
    const form = document.getElementById('trade-form');
    const modalTitle = document.getElementById('trade-modal-title');
    const errEl = document.getElementById('trade-form-error');

    function currentUserCode() {
        return (window.TNSVT_USER && window.TNSVT_USER.code) || '';
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    function openModal(trade) {
        form.reset();
        errEl.classList.add('hidden');
        document.getElementById('trade-id').value = '';
        if (trade) {
            modalTitle.textContent = 'Editar Trade';
            document.getElementById('trade-id').value = trade.id || '';
            document.getElementById('trade-asset').value = trade.asset || '';
            document.getElementById('trade-dir').value = trade.dir || 'BUY';
            document.getElementById('trade-date').value = trade.date ? trade.date.slice(0, 16) : '';
            document.getElementById('trade-entry').value = trade.entry || '';
            document.getElementById('trade-sl').value = trade.sl || '';
            document.getElementById('trade-tp').value = trade.tp || '';
            document.getElementById('trade-result').value = trade.result || '';
            document.getElementById('trade-pnl').value = trade.pnl != null ? trade.pnl : '';
            document.getElementById('trade-notes').value = trade.notes || '';
        } else {
            modalTitle.textContent = 'Nuevo Trade';
            document.getElementById('trade-date').value = new Date().toISOString().slice(0, 16);
        }
        modal.style.display = 'flex';
        setTimeout(() => document.getElementById('trade-asset').focus(), 100);
    }

    function closeModal() {
        modal.style.display = 'none';
    }

    async function loadTrades() {
        const r = await apiFetch('/api/journal?user_code=' + currentUserCode());
        if (!r.ok || !r.data || !r.data.success) {
            listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-12">Sin datos disponibles</p>';
            return;
        }
        const trades = r.data.trades || [];
        const stats = r.data.stats || {};
        document.getElementById('stat-total').textContent = stats.total || 0;
        document.getElementById('stat-wins').textContent = stats.wins || 0;
        document.getElementById('stat-losses').textContent = stats.losses || 0;
        document.getElementById('stat-winrate').textContent = (stats.win_rate || 0) + '%';
        document.getElementById('stat-pnl').textContent = '$' + (stats.total_pnl || 0).toFixed(2);
        document.getElementById('journal-count').textContent = trades.length + ' trades';

        if (trades.length === 0) {
            listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-12">Sin trades. Click "Nuevo Trade" para empezar.</p>';
            return;
        }

        listEl.innerHTML = trades.map(t => {
            const pnlClass = (t.pnl >= 0) ? 'trade-pnl-pos' : 'trade-pnl-neg';
            const pnlStr = (t.pnl >= 0 ? '+$' : '-$') + Math.abs(t.pnl).toFixed(2);
            const dateStr = t.date ? new Date(t.date).toLocaleString() : '';
            return `
                <div class="trade-row" data-id="${t.id}">
                    <span class="trade-asset">${escapeHtml(t.asset)}</span>
                    <span class="trade-dir-${escapeHtml(t.dir)} text-sm">${escapeHtml(t.dir)}</span>
                    <span class="text-xs text-[var(--outline-elev)] flex-1 truncate">${escapeHtml(dateStr)}</span>
                    <span class="${pnlClass} text-sm">${pnlStr}</span>
                    <span class="status-pill ${t.result === 'WIN' ? 'status-completed' : t.result === 'LOSS' ? 'status-inactive' : 'status-pending'}">${escapeHtml(t.result || 'OPEN')}</span>
                    <div class="trade-actions">
                        <button data-action="edit" data-id="${t.id}">Editar</button>
                        <button data-action="delete" data-id="${t.id}">Eliminar</button>
                    </div>
                </div>
            `;
        }).join('');
    }

    async function saveTrade(e) {
        e.preventDefault();
        errEl.classList.add('hidden');
        const id = document.getElementById('trade-id').value;
        const data = {
            user_code: currentUserCode(),
            asset: document.getElementById('trade-asset').value.trim().toUpperCase(),
            dir: document.getElementById('trade-dir').value,
            date: document.getElementById('trade-date').value || null,
            entry: document.getElementById('trade-entry').value,
            sl: document.getElementById('trade-sl').value,
            tp: document.getElementById('trade-tp').value,
            result: document.getElementById('trade-result').value,
            pnl: document.getElementById('trade-pnl').value,
            notes: document.getElementById('trade-notes').value,
        };
        const url = id ? '/api/journal/' + id : '/api/journal';
        const method = id ? 'PATCH' : 'POST';
        const r = await apiFetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (r.ok && r.data && r.data.success) {
            if (window.apiToast) apiToast(id ? 'Trade actualizado' : 'Trade creado', 'success');
            closeModal();
            loadTrades();
            loadGuardianBanner(); // refresh after save — subscriber may have produced new alerts
        } else {
            const msg = (r.data && (r.data.error || r.data.message)) || 'Error';
            errEl.textContent = msg;
            errEl.classList.remove('hidden');
        }
    }

    async function deleteTrade(id) {
        if (!confirm('¿Eliminar este trade?')) return;
        const r = await apiFetch('/api/journal/' + id, { method: 'DELETE' });
        if (r.ok && r.data && r.data.success) {
            if (window.apiToast) apiToast('Trade eliminado', 'success');
            loadTrades();
            loadGuardianBanner();
        } else {
            if (window.apiToast) apiToast('Error al eliminar', 'error');
        }
    }

    const JOURNAL_SEVERITY_VISUAL = {
        danger:  { icon: 'error',   color: '#f87171' },
        warning: { icon: 'warning', color: 'var(--gold-elev)' },
        info:    { icon: 'info',    color: 'var(--violet)' },
    };

    async function loadGuardianBanner() {
        const banner = document.getElementById('guardian-banner');
        const listEl = document.getElementById('guardian-banner-list');
        if (!banner || !listEl) return;

        const r = await apiFetch('/api/guardian/signals', { silent: true });
        if (!r.ok || !r.data) {
            banner.classList.add('hidden');
            return;
        }
        const signals = r.data.signals || [];
        // Filter to most actionable: risk.* types (most relevant for pre-trade context)
        const risk = signals.filter(s => s.type.startsWith('risk.'));
        const top = (risk.length > 0 ? risk : signals).slice(0, 3);

        if (top.length === 0) {
            banner.classList.add('hidden');
            return;
        }

        listEl.innerHTML = top.map(s => {
            const v = JOURNAL_SEVERITY_VISUAL[s.severity] || JOURNAL_SEVERITY_VISUAL.info;
            const action = s.action_label && s.action_route
                ? `<a href="${s.action_route}" class="text-xs text-[var(--gold-elev)] hover:underline ml-auto whitespace-nowrap">${s.action_label} →</a>`
                : '';
            return `
                <div class="flex items-center gap-2 text-sm py-1">
                    <span class="material-symbols-elev flex-shrink-0" style="color: ${v.color}; font-size: 1.1rem;">${v.icon}</span>
                    <span class="text-[var(--on-surface-elev)]">${s.title}</span>
                    <span class="text-xs text-[var(--outline-elev)] truncate">· ${s.message}</span>
                    ${action}
                </div>
            `;
        }).join('');
        banner.classList.remove('hidden');
    }

    // Event handlers
    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('btn-new-trade').addEventListener('click', () => openModal(null));
        document.querySelectorAll('[data-action="close-trade-modal"]').forEach(b => b.addEventListener('click', closeModal));
        modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
        form.addEventListener('submit', saveTrade);

        listEl.addEventListener('click', (e) => {
            const editBtn = e.target.closest('[data-action="edit"]');
            if (editBtn) {
                const id = editBtn.dataset.id;
                const row = listEl.querySelector(`[data-id="${id}"]`);
                if (row) {
                    const trade = {
                        id: id,
                        asset: row.querySelector('.trade-asset')?.textContent,
                        dir: row.querySelector('[class*="trade-dir-"]')?.textContent,
                        date: row.querySelector('.text-xs')?.textContent,
                        pnl: parseFloat(row.querySelector('[class*="trade-pnl-"]')?.textContent.replace(/[^-\d.]/g, '')),
                        result: row.querySelector('.status-pill')?.textContent.trim(),
                    };
                    openModal(trade);
                }
                return;
            }
            const delBtn = e.target.closest('[data-action="delete"]');
            if (delBtn) {
                deleteTrade(delBtn.dataset.id);
            }
        });

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
        });

        // Wait for TNSVT_USER (set by shell.html.twig after /api/auth/check resolves)
        function boot() {
            if (currentUserCode()) {
                loadTrades();
                loadGuardianBanner();
            } else {
                // Try once more after a short delay; if still no user, give up.
                setTimeout(() => {
                    if (currentUserCode()) {
                        loadTrades();
                        loadGuardianBanner();
                    }
                    else listEl.innerHTML = '<p class="text-center text-[var(--outline-elev)] py-12">Sin sesión</p>';
                }, 1000);
            }
        }
        if (window.TNSVT_USER) {
            boot();
        } else {
            window.addEventListener('tnsvt:user-loaded', boot, { once: true });
            // Fallback timeout in case event never fires
            setTimeout(boot, 2000);
        }
    });
})();
</script>
{% endblock %}