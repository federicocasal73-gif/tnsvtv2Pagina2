<div id="accounts-manager-modal" class="tnsvt-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="accounts-manager-title" hidden>
    <div class="tnsvt-modal tnsvt-modal--wide" style="max-width: 720px; width: 90%;">
        <header class="tnsvt-modal__header">
            <h2 id="accounts-manager-title" class="tnsvt-modal__title">
                <span class="material-symbols-elev">account_balance</span>
                <span>Mis Cuentas</span>
            </h2>
            <button type="button" class="tnsvt-modal__close" data-action="close-accounts-manager" aria-label="Cerrar">
                <span class="material-symbols-elev">close</span>
            </button>
        </header>
        <div class="tnsvt-modal__body" style="padding-top: 0;">
            <p class="text-xs text-[var(--outline-elev)] mb-3">
                Máximo <strong id="accounts-manager-cap">3</strong> cuentas. Las cuentas con trades no se borran físicamente — solo se ocultan (soft-delete).
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {# ─── List (left column) ─── #}
                <div>
                    <h4 class="text-xs uppercase tracking-widest text-[var(--outline-elev)] mb-2">Existentes</h4>
                    <div id="accounts-manager-list" class="space-y-2 max-h-72 overflow-y-auto">
                        <p class="text-xs text-[var(--outline-elev)] py-2">Cargando…</p>
                    </div>
                </div>

                {# ─── Form (right column) ─── #}
                <div>
                    <h4 class="text-xs uppercase tracking-widest text-[var(--outline-elev)] mb-2">Crear / Editar</h4>
                    <form id="accounts-manager-form" class="space-y-3">
                        <input type="hidden" name="id" value="">

                        <div>
                            <label class="kpi-label block mb-1">Nombre *</label>
                            <input type="text" name="name" required maxlength="50" placeholder="Mi Cuenta, Swing, Spot…"
                                   class="form-input">
                        </div>

                        <div>
                            <label class="kpi-label block mb-1">Tamaño (USD) *</label>
                            <input type="number" name="account_size" required min="100" step="0.01" value="10000"
                                   class="form-input">
