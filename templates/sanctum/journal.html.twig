        <footer class="tnsvt-modal__footer">
            <button type="button" class="btn btn-secondary" data-action="close-accounts-manager">Cerrar</button>
        </footer>
    </div>
</div>

<script>
(function() {
    'use strict';

    // ════════════════════════════════════════════════════════════
    // TAB NAVIGATION
    // ════════════════════════════════════════════════════════════
    const tabs = document.querySelectorAll('#journal-tabs .journal-nav-btn');
    const panels = document.querySelectorAll('.journal-panel');

    function activateTab(panelKey) {
        tabs.forEach(t => {
            const active = t.dataset.panel === panelKey;
            t.classList.toggle('active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach(p => {
            p.hidden = p.dataset.panel !== panelKey;
        });
        // Persistir en URL sin recargar
        try {
            const url = new URL(location.href);
            if (panelKey === 'overview') url.searchParams.delete('tab');
            else url.searchParams.set('tab', panelKey);
            history.replaceState(null, '', url);
        } catch (e) { /* noop */ }
        // Disparar refresh de datos según panel
        if (panelKey === 'overview') {
            refreshOverviewPanel();
        } else if (panelKey === 'stats') {
            refreshStatsPanel();
        }
    }

    tabs.forEach(t => {
        t.addEventListener('click', () => activateTab(t.dataset.panel));
    });

    // Keyboard navigation: Left/Right arrows cycle through tabs.
    const tabArray = Array.from(tabs);
    tabArray.forEach((t, i) => {
        t.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const next = tabArray[(i + dir + tabArray.length) % tabArray.length];
            if (next) {
                e.preventDefault();
                next.focus();
                activateTab(next.dataset.panel);
            }
        });
    });

    // Botón "Asentá la primera →" en equity vacía
    document.querySelectorAll('[data-jump-tab]').forEach(b => {
        b.addEventListener('click', () => activateTab(b.dataset.jumpTab));
    });

    // Restore from URL
    function restoreTab() {
        const urlTab = new URLSearchParams(location.search).get('tab');
        const valid = ['overview', 'form', 'log', 'stats'];
        if (urlTab && valid.includes(urlTab)) {
            activateTab(urlTab);
        } else {
            activateTab('overview');
        }
    }

    function refreshOverviewPanel() {
        if (typeof loadEquityCurve === 'function') loadEquityCurve(getCurrentRange());
        if (typeof loadStats === 'function') loadStats();
        const initialCal = _nowYM();
        if (typeof loadCalendarMonthly === 'function') loadCalendarMonthly(initialCal.year, initialCal.month);
    }

    function refreshStatsPanel() {
        // Reutilizar loadStats() y copiar a los IDs detail
        if (typeof loadStatsDetail === 'function') loadStatsDetail();
    }

    // ════════════════════════════════════════════════════════════
    // TRADE MODAL & LOG LIST (copiado del original)
    // ════════════════════════════════════════════════════════════
    const listEl = document.getElementById('trade-list');
    const modal = document.getElementById('trade-modal');
    const form = document.getElementById('trade-form');
    const modalTitle = document.getElementById('trade-modal-title');
    const errEl = document.getElementById('trade-form-error');
    const tradeModal = apiSetupModal(modal);

    function currentUserCode() {
        return (window.TNSVT_USER && window.TNSVT_USER.code) || '';
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    function openModal(trade) {
        form.reset();
        errEl.classList.add('hidden');
        document.getElementById('trade-id').value = '';
        // Pre-select account: from trade (edit) or active account (new)
        const accountSelect = document.getElementById('trade-account-id');
        if (accountSelect) {
            const wanted = trade?.account_id || window.TNSVT_ACTIVE_ACCOUNT_ID || '';
            accountSelect.value = wanted ? String(wanted) : '';
        }
        if (trade) {
            modalTitle.textContent = 'Editar Trade';
            document.getElementById('trade-id').value = trade.id || '';
            document.getElementById('trade-asset').value = trade.asset || '';
            document.getElementById('trade-dir').value = trade.dir || 'BUY';
            document.getElementById('trade-date').value = trade.date ? trade.date.slice(0, 16) : '';
            document.getElementById('trade-entry').value = trade.entry || '';
            document.getElementById('trade-sl').value = trade.sl || '';
            document.getElementById('trade-tp').value = trade.tp || '';
            document.getElementById('trade-result').value = trade.result || '';
            document.getElementById('trade-pnl').value = trade.pnl != null ? trade.pnl : '';
            document.getElementById('trade-notes').value = trade.notes || '';
        } else {
            modalTitle.textContent = 'Nuevo Trade';
            document.getElementById('trade-date').value = new Date().toISOString().slice(0, 16);
        }
        tradeModal.open();
    }

    function closeModal() {
        tradeModal.close();
    }

    async function loadTrades() {
        const r = await apiFetch('/api/journal?user_code=' + currentUserCode());
        if (!r.ok || !r.data || !r.data.success) {
            apiEmpty(listEl, { icon: 'cloud_off', message: 'Sin datos disponibles' });
            return;
        }
        const trades = r.data.trades || [];
        const stats = r.data.stats || {};
        document.getElementById('stat-total').textContent = stats.total || 0;
        document.getElementById('stat-wins').textContent = stats.wins || 0;
        updateStreakChip(trades);
        document.getElementById('stat-losses').textContent = stats.losses || 0;
        document.getElementById('stat-winrate').textContent = (stats.win_rate || 0) + '%';
        document.getElementById('stat-pnl').textContent = '$' + (stats.total_pnl || 0).toFixed(2);
        document.getElementById('journal-count').textContent = trades.length + ' trades';
        // P2: animate the KPI counters from 0 → final value.
        apiAnimateCounters('#journal-stats [data-counter]');
        updateJournalInsights(trades);

        // Cache by id so edit handler can rebuild the form from authoritative
        // API data instead of scraping the rendered DOM (which loses notes,
        // entry/sl/tp/photos/tags/ratio and mangles the datetime).
        window._tradesById = Object.fromEntries(trades.map(t => [String(t.id), t]));

        if (trades.length === 0) {
            apiEmpty(listEl, {
                icon: 'edit_note',
                message: 'Sin trades registrados',
                description: 'Asentá tu primer trade para empezar tu bitácora.',
                cta_label: 'Asentar primer trade',
                cta_url: '/journal/new',
                size: 'md'
            });
            return;
        }

        listEl.innerHTML = trades.map(t => tradeRowHtml(t)).join('');
    }

    // ─── Row renderer (shared by full list render + single-row restore
    // after inline-edit cancel / save). ───
    function tradeRowHtml(t) {
        const pnlClass = (t.pnl >= 0) ? 'trade-pnl-pos' : 'trade-pnl-neg';
        const pnlStr = (t.pnl >= 0 ? '+$' : '-$') + Math.abs(t.pnl).toFixed(2);
        const dateStr = t.date ? new Date(t.date).toLocaleString() : '';
        return `
                <div class="trade-row" data-id="${t.id}">
                    <span class="trade-asset">${escapeHtml(t.asset)}</span>
                    ${t.account_name ? `<span class="trade-account-chip" title="Cuenta">${escapeHtml(t.account_name)}</span>` : ''}
                    <span class="trade-dir-${escapeHtml(t.dir)} text-sm">${escapeHtml(t.dir)}</span>
                    <span class="text-xs text-[var(--outline-elev)] flex-1 truncate">${escapeHtml(dateStr)}</span>
                    <span class="${pnlClass} text-sm">${pnlStr}</span>
                    <span class="status-pill ${t.result === 'WIN' ? 'status-completed' : t.result === 'LOSS' ? 'status-inactive' : 'status-pending'}">${escapeHtml(t.result || 'OPEN')}</span>
                    <div class="trade-actions">
                        <button data-action="edit" data-id="${t.id}">Editar</button>
                        <button data-action="delete" data-id="${t.id}">Eliminar</button>
                    </div>
                </div>
            `;
    }

    // ─── F3: inline row editor. Edits the row-visible fields
    // (asset, dir, date, pnl, result) in place. Full-field editing
    // (entry/sl/tp/notes/…) stays in the modal via "Más campos".
    function openInlineEdit(id) {
        const trade = window._tradesById && window._tradesById[id];
        if (!trade) return;
        // Only one row edits at a time — restore any other open editor.
        document.querySelectorAll('.trade-row.is-editing').forEach(row => {
            const rid = row.dataset.id;
            const orig = window._tradesById && window._tradesById[rid];
            if (orig) row.outerHTML = tradeRowHtml(orig);
        });
        const row = listEl.querySelector(`[data-id="${id}"]`);
        if (!row) return;
        const dateVal = trade.date ? String(trade.date).slice(0, 16) : '';
        const pnlVal = trade.pnl != null ? trade.pnl : '';
        row.classList.add('is-editing');
        row.innerHTML = `
            <input class="trade-inline-input trade-inline-asset" data-field="asset"
                   value="${escapeHtml(trade.asset || '')}" maxlength="20"
                   aria-label="Activo" />
            <select class="trade-inline-input" data-field="dir" aria-label="Dirección">
                <option value="BUY"${trade.dir === 'BUY' ? ' selected' : ''}>BUY</option>
                <option value="SELL"${trade.dir === 'SELL' ? ' selected' : ''}>SELL</option>
            </select>
            <input class="trade-inline-input trade-inline-date" data-field="date" type="datetime-local"
                   value="${escapeHtml(dateVal)}" aria-label="Fecha" />
            <input class="trade-inline-input trade-inline-pnl" data-field="pnl" type="number" step="any"
                   value="${escapeHtml(String(pnlVal))}" aria-label="PnL" />
            <select class="trade-inline-input" data-field="result" aria-label="Resultado">
                ${['OPEN', 'WIN', 'LOSS', 'BE'].map(r =>
                    `<option value="${r}"${(trade.result || 'OPEN') === r ? ' selected' : ''}>${r}</option>`
                ).join('')}
            </select>
            <div class="trade-actions trade-inline-actions">
                <button data-inline="save" data-id="${id}">Guardar</button>
                <button data-inline="cancel" data-id="${id}">Cancelar</button>
                <button data-inline="full" data-id="${id}" title="Editar todos los campos">Más</button>
            </div>
            <p class="trade-inline-err" hidden></p>
        `;
        const assetInput = row.querySelector('[data-field="asset"]');
        if (assetInput) { assetInput.focus(); assetInput.select(); }
        // Enter saves, Esc cancels.
        row.querySelectorAll('.trade-inline-input').forEach(el => {
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); saveInlineEdit(id); }
                else if (e.key === 'Escape') { e.preventDefault(); cancelInlineEdit(id); }
            });
        });
    }

    function inlineErr(id, msg) {
        const row = listEl.querySelector(`[data-id="${id}"]`);
        const err = row && row.querySelector('.trade-inline-err');
        if (err) { err.textContent = msg; err.hidden = !msg; }
    }

    function cancelInlineEdit(id) {
        const trade = window._tradesById && window._tradesById[id];
        const row = listEl.querySelector(`[data-id="${id}"]`);
        if (trade && row) row.outerHTML = tradeRowHtml(trade);
    }

    async function saveInlineEdit(id) {
        const row = listEl.querySelector(`[data-id="${id}"]`);
        if (!row) return;
        const get = (f) => row.querySelector(`[data-field="${f}"]`);
        const asset = (get('asset').value || '').trim().toUpperCase();
        const dir = get('dir').value;
        const result = get('result').value;
        const pnlRaw = (get('pnl').value || '').trim();
        if (!asset) { inlineErr(id, 'El activo es obligatorio'); get('asset').focus(); return; }
        if (pnlRaw !== '' && !isFinite(Number(pnlRaw))) {
            inlineErr(id, 'PnL debe ser numérico'); get('pnl').focus(); return;
        }
        inlineErr(id, '');
        const saveBtn = row.querySelector('[data-inline="save"]');
        const done = (typeof window.apiButtonLoading === 'function' && saveBtn)
            ? window.apiButtonLoading(saveBtn) : function () {};
        try {
            const r = await apiFetch('/api/journal/' + id, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_code: currentUserCode(),
                    asset: asset,
                    dir: dir,
                    date: get('date').value || null,
                    result: result,
                    pnl: pnlRaw === '' ? null : Number(pnlRaw),
                }),
            });
            if (r.ok && r.data && r.data.success) {
                if (window.apiToast) apiToast('Trade actualizado', 'success');
                // Refresh cache + dependent panels, then restore the row.
                await loadTrades();
                loadGuardianBanner();
                if (typeof refreshOverviewPanel === 'function') {
                    const overviewVisible = !document.getElementById('journal-panel-overview').hidden;
                    if (overviewVisible) refreshOverviewPanel();
                }
            } else {
                inlineErr(id, (r.data && (r.data.error || r.data.message)) || 'Error al guardar');
            }
        } catch (e) {
            inlineErr(id, 'Error de red: ' + (e.message || 'sin detalle'));
        } finally {
            done();
        }
    }

    // ─── F11: insights card (best day, best asset, profit factor) ───
    function updateJournalInsights(trades) {
        const box = document.getElementById('journal-insights');
        const grid = document.getElementById('journal-insights-grid');
        if (!box || !grid) return;
        if (!Array.isArray(trades) || trades.length < 3) {
            box.hidden = true;
            return;
        }
        const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
        const byDow = { pnl: Array(7).fill(0), count: Array(7).fill(0) };
        const assetStats = {};
        let wins = 0, losses = 0;
        for (const t of trades) {
            if (!t.date) continue;
            const d = new Date(t.date);
            if (Number.isNaN(d.getTime())) continue;
            const dow = d.getDay();
            const pnl = Number(t.pnl) || 0;
            byDow.pnl[dow] += pnl;
            byDow.count[dow] += 1;
            if (t.result === 'WIN') wins += pnl;
            if (t.result === 'LOSS') losses += Math.abs(pnl);
            const a = (t.asset || '?').toUpperCase();
            if (!assetStats[a]) assetStats[a] = { pnl: 0, count: 0, wins: 0 };
            assetStats[a].pnl += pnl;
            assetStats[a].count += 1;
            if (t.result === 'WIN') assetStats[a].wins += 1;
        }
        const insights = [];
        let bestDow = 0, bestPnl = -Infinity;
        for (let i = 0; i < 7; i++) {
            if (byDow.count[i] > 0 && byDow.pnl[i] > bestPnl) {
                bestPnl = byDow.pnl[i];
                bestDow = i;
            }
        }
        if (bestPnl > -Infinity) {
            const avg = bestPnl / byDow.count[bestDow];
            insights.push({
                icon: 'event_available',
                label: 'Tu mejor día',
                value: days[bestDow],
                sub: '$' + avg.toFixed(2) + ' prom · ' + byDow.count[bestDow] + ' trades',
            });
        }
        let bestAsset = null, bestAssetPnl = -Infinity;
        for (const a in assetStats) {
            if (assetStats[a].pnl > bestAssetPnl) {
                bestAssetPnl = assetStats[a].pnl;
                bestAsset = a;
            }
        }
        if (bestAsset) {
            const s = assetStats[bestAsset];
            insights.push({
                icon: 'workspace_premium',
                label: 'Mejor activo',
                value: bestAsset,
                sub: '$' + s.pnl.toFixed(2) + ' · ' + s.wins + '/' + s.count + ' wins',
            });
        }
        const pf = losses > 0 ? (wins / losses) : (wins > 0 ? 999 : 0);
        if (pf > 0) {
            insights.push({
                icon: 'analytics',
                label: 'Profit Factor',
                value: pf >= 99 ? '∞' : pf.toFixed(2),
                sub: '$' + wins.toFixed(0) + ' gan / $' + losses.toFixed(0) + ' perd',
            });
        }
        if (insights.length === 0) { box.hidden = true; return; }
        box.hidden = false;
        grid.innerHTML = insights.map(i => `
            <div class="journal-insight">
                <span class="material-symbols-elev journal-insight-icon" aria-hidden="true">${i.icon}</span>
                <div class="flex-1 min-w-0">
                    <p class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">${i.label}</p>
                    <p class="text-base font-bold text-[var(--gold-elev)]">${escapeHtml(String(i.value))}</p>
                    <p class="text-xs text-[var(--outline-elev)]">${escapeHtml(i.sub)}</p>
                </div>
            </div>
        `).join('');
    }

    // ─── H9: streak = consecutive calendar days (ending today or
    // yesterday) with at least one trade. Days are counted in local TZ.
    function updateStreakChip(trades) {
        const chip = document.getElementById('journal-streak-chip');
        const valEl = document.getElementById('journal-streak-value');
        if (!chip || !valEl) return;
        if (!Array.isArray(trades) || trades.length === 0) {
            chip.hidden = true;
            return;
        }
        const days = new Set();
        for (const t of trades) {
            if (!t.date) continue;
            const d = new Date(t.date);
            if (Number.isNaN(d.getTime())) continue;
            days.add(d.getFullYear() + '-' + d.getMonth() + '-' + d.getDate());
        }
        const today = new Date();
        const todayKey = today.getFullYear() + '-' + today.getMonth() + '-' + today.getDate();
        const yestKey = (() => {
            const y = new Date(today); y.setDate(y.getDate() - 1);
            return y.getFullYear() + '-' + y.getMonth() + '-' + y.getDate();
        })();
        if (!days.has(todayKey) && !days.has(yestKey)) {
            chip.hidden = true;
            return;
        }
        let streak = 0;
        const cursor = new Date(today);
        if (!days.has(todayKey)) cursor.setDate(cursor.getDate() - 1);
        while (true) {
            const key = cursor.getFullYear() + '-' + cursor.getMonth() + '-' + cursor.getDate();
            if (!days.has(key)) break;
            streak++;
            cursor.setDate(cursor.getDate() - 1);
        }
        if (streak <= 0) { chip.hidden = true; return; }
        valEl.textContent = streak;
        chip.hidden = false;
    }

    async function saveTrade(e) {
        e.preventDefault();
        errEl.classList.add('hidden');
        const id = document.getElementById('trade-id').value;
        const data = {
            user_code: currentUserCode(),
            asset: document.getElementById('trade-asset').value.trim().toUpperCase(),
            dir: document.getElementById('trade-dir').value,
            date: document.getElementById('trade-date').value || null,
            entry: document.getElementById('trade-entry').value,
            sl: document.getElementById('trade-sl').value,
            tp: document.getElementById('trade-tp').value,
            result: document.getElementById('trade-result').value,
            pnl: document.getElementById('trade-pnl').value,
            notes: document.getElementById('trade-notes').value,
            account_id: parseInt(document.getElementById('trade-account-id')?.value) || window.TNSVT_ACTIVE_ACCOUNT_ID || null,
        };
        const url = id ? '/api/journal/' + id : '/api/journal';
        const method = id ? 'PATCH' : 'POST';
        const r = await apiFetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (r.ok && r.data && r.data.success) {
            if (window.apiToast) apiToast(id ? 'Trade actualizado' : 'Trade creado', 'success');
            closeModal();
            loadTrades();
            loadGuardianBanner();
            // refrescar overview si está activo
            const overviewVisible = !document.getElementById('journal-panel-overview').hidden;
            if (overviewVisible) refreshOverviewPanel();
        } else {
            const msg = (r.data && (r.data.error || r.data.message)) || 'Error';
            errEl.textContent = msg;
            errEl.classList.remove('hidden');
        }
    }

    async function deleteTrade(id) {
        if (!await apiConfirm('¿Eliminar este trade?', { title: 'Eliminar trade', variant: 'danger' })) return;
        const btn = listEl.querySelector(`[data-action="delete"][data-id="${id}"]`);
        const done = (typeof window.apiButtonLoading === 'function' && btn) ? window.apiButtonLoading(btn) : function () {};
        // Snapshot the trade BEFORE we delete so we can restore on undo.
        const trade = window._tradesById && window._tradesById[id]
            ? Object.assign({}, window._tradesById[id]) : null;
        try {
            const r = await apiFetch('/api/journal/' + id, { method: 'DELETE' });
            if (r.ok && r.data && r.data.success) {
                loadTrades();
                loadGuardianBanner();
                refreshOverviewPanel();
                // H14: undo toast — re-POST the trade with the same payload.
                if (window.apiUndoToast && trade) {
                    window.apiUndoToast({
                        message: 'Trade eliminado',
                        undoLabel: 'Deshacer',
                        ttl: 5000,
                        undo: async () => {
                            const payload = {
                                user_code: currentUserCode(),
                                asset: trade.asset,
                                dir: trade.dir,
                                date: trade.date ? trade.date.slice(0, 16) : null,
                                entry: trade.entry || '',
                                sl: trade.sl || '',
                                tp: trade.tp || '',
                                result: trade.result || '',
                                pnl: trade.pnl != null ? trade.pnl : '',
                                notes: trade.notes || '',
                                account_id: trade.account_id || window.TNSVT_ACTIVE_ACCOUNT_ID || null,
                            };
                            const rr = await apiFetch('/api/journal', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload),
                            });
                            if (rr.ok && rr.data && rr.data.success) {
                                loadTrades();
                                loadGuardianBanner();
                                refreshOverviewPanel();
                            } else {
                                throw new Error((rr.data && rr.data.error) || 'Error');
                            }
                        },
                    });
                } else if (window.apiToast) {
                    apiToast('Trade eliminado', 'success');
                }
            } else {
                if (window.apiToast) apiToast('Error al eliminar', 'error');
            }
        } finally {
            done();
        }
    }

