{% extends 'shell.html.twig' %}

{% block title %}Trading Journal · T.N.S.V.T{% endblock %}

{% block topbar_title %}El Libro del Ejecutor{% endblock %}
{% block topbar_subtitle %}"Lo que no se registra, no se domina."{% endblock %}

{% block topbar_chips %}
    {# ─── H9: streak chip ─── #}
    <span class="topbar-chip" id="journal-streak-chip" title="Días consecutivos con al menos un trade" hidden>
        <span class="material-symbols-elev icon-size-sm" aria-hidden="true">local_fire_department</span>
        <span id="journal-streak-value">0</span>
        <span class="topbar-chip-unit">días</span>
    </span>
{% endblock %}

{% block stylesheets %}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto" data-controller="journal_root account-switcher">

    {# ─── Header ─── #}
    <div class="text-center mb-6">
        <p class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">El Libro del Ejecutor</p>
        <h1 class="font-headline-lg text-headline-lg shimmer-text">Trading Journal</h1>
    </div>

    {# ─── KPI Stats Row ─── #}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-6" id="journal-stats">
        <div class="glass-card-elev kpi-card kpi-violet text-center">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">analytics</span>
            <p class="kpi-label mt-2">Trades</p>
            <p class="kpi-value gold" id="stat-total" data-counter>0</p>
        </div>
        <div class="glass-card-elev kpi-card kpi-green text-center">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">check_circle</span>
            <p class="kpi-label mt-2">Wins</p>
            <p class="kpi-value gold" id="stat-wins" data-counter>0</p>
        </div>
        <div class="glass-card-elev kpi-card kpi-red text-center">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">cancel</span>
            <p class="kpi-label mt-2">Losses</p>
            <p class="kpi-value gold" id="stat-losses" data-counter>0</p>
        </div>
        <div class="glass-card-elev kpi-card kpi-gold text-center">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">trending_up</span>
            <p class="kpi-label mt-2">Win Rate</p>
            <p class="kpi-value gold" id="stat-winrate" data-counter>0%</p>
        </div>
        <div class="glass-card-elev kpi-card kpi-blue text-center">
            <span class="material-symbols-outlined text-[var(--gold-elev)] text-2xl opacity-50">payments</span>
            <p class="kpi-label mt-2">PnL Neto Total</p>
            <p class="text-4xl font-bold text-[var(--gold-elev)] mt-1" id="stat-pnl" data-counter>$0</p>
        </div>
    </div>

    {# ─── F11: Insights card (client-side computed) ─── #}
    <div class="glass-card-elev p-4 mb-4 journal-insights" id="journal-insights" hidden>
        <div class="flex items-center gap-2 mb-3">
            <span class="material-symbols-elev text-[var(--gold-elev)]">auto_awesome</span>
            <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider">Tus Insights</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="journal-insights-grid"></div>
    </div>

    {# ─── Tabs Navigation ─── #}
    <nav class="flex justify-between items-center glass-card-elev rounded-full px-1 py-1 mb-4 overflow-x-auto scrollbar-hide" id="journal-tabs" role="tablist" aria-label="Secciones del Journal">
        <button class="journal-nav-btn active" data-panel="overview" role="tab" aria-selected="true">Dashboard</button>
        <button class="journal-nav-btn"        data-panel="form"     role="tab" aria-selected="false">Registrar</button>
        <button class="journal-nav-btn"        data-panel="log"      role="tab" aria-selected="false">Log</button>
        <button class="journal-nav-btn"        data-panel="stats"    role="tab" aria-selected="false">Stats</button>
    </nav>

    {# ─── Account Selector Strip ─── #}
    <section class="glass-card-elev p-3 mb-4" id="account-selector-strip" aria-label="Cuentas de trading"
             title="La cuenta activa se recuerda entre sesiones">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs uppercase tracking-widest text-[var(--outline-elev)] flex items-center gap-1.5 mr-1">
                <span class="material-symbols-elev text-[var(--gold-elev)] icon-size-sm">account_balance</span>
                Cuentas
            </span>
            <div id="account-chips" class="flex items-center gap-2 flex-wrap flex-1">
                <span class="text-xs text-[var(--outline-elev)] loading-pulse">Cargando cuentas…</span>
            </div>
            <button type="button" class="account-chip account-chip-add" id="open-accounts-manager" title="Crear nueva cuenta"
                    aria-label="Crear nueva cuenta">
                <span class="material-symbols-elev icon-size-sm">add</span>
                <span class="hidden sm:inline text-xs">Nueva</span>
            </button>
        </div>
        <p class="text-[11px] text-[var(--outline-elev)] mt-1.5 opacity-80">Tu cuenta activa se guarda y se mantiene al volver.</p>
    </section>

    {# ─── Guardian Pre-Trade Banner ─── #}
    <div id="guardian-banner" class="hidden mb-4 p-4 rounded-lg border" style="border-color: var(--outline-variant-elev); background: var(--glass-bg-elev);">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                <span class="material-symbols-elev text-[var(--gold-elev)]">shield_person</span>
                Guardian — señales activas
            </h3>
            <a href="/sanctum/guardian" class="text-xs text-[var(--gold-elev)] hover:underline">Ver completo →</a>
        </div>
        <div id="guardian-banner-list" class="space-y-1.5"></div>
        <p class="text-xs text-[var(--outline-elev)] mt-2">Estas señales no bloquean el registro. Guardian es tu coach, no tu carcelero.</p>
    </div>

    {# ════════════════════════════════════════════════════════════
       PANEL: OVERVIEW — Equity + Calendar + P&L + Stats Row
       ════════════════════════════════════════════════════════════ #}
    <section class="journal-panel" id="journal-panel-overview" role="tabpanel" aria-labelledby="journal-tab-overview" data-panel="overview">

        {# ─── Equity Curve ─── #}
        <section class="glass-card-elev p-6 mb-6 equity-curve-card">
            <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">timeline</span>
                    <span class="text-cinzel-display text-base tracking-wider">EQUITY CURVE</span>
                </h3>
                <div class="ec-range-tabs" id="ec-range-tabs" role="tablist" aria-label="Range">
                    <button type="button" class="ec-tab active" data-range="all" role="tab" aria-selected="true">Todo</button>
                    <button type="button" class="ec-tab" data-range="30d" role="tab" aria-selected="false">30d</button>
                    <button type="button" class="ec-tab" data-range="7d" role="tab" aria-selected="false">7d</button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div class="ec-stat">
                    <span class="ec-stat-label">Balance actual</span>
                    <span class="ec-stat-value" id="ec-balance">$0</span>
                    <span class="ec-stat-meta" id="ec-balance-meta">—</span>
                </div>
                <div class="ec-stat">
                    <span class="ec-stat-label">Total return</span>
                    <span class="ec-stat-value" id="ec-return">0.00%</span>
                    <span class="ec-stat-meta" id="ec-return-meta">—</span>
                </div>
                <div class="ec-stat">
                    <span class="ec-stat-label">Max drawdown</span>
                    <span class="ec-stat-value" id="ec-drawdown">0.00%</span>
                    <span class="ec-stat-meta" id="ec-drawdown-meta">—</span>
                </div>
            </div>

            <svg id="ec-chart" viewBox="0 0 1000 280" preserveAspectRatio="none" class="w-full h-48 sm:h-64 md:h-72" aria-label="Equity curve">
                <defs>
                    <linearGradient id="ec-fill" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="rgba(242, 202, 80, 0.35)" />
                        <stop offset="100%" stop-color="rgba(242, 202, 80, 0)" />
                    </linearGradient>
                </defs>
                <text id="ec-loading" x="500" y="140" fill="rgba(255,255,255,0.4)" font-size="14" text-anchor="middle" font-family="Space Grotesk">Cargando curva...</text>
            </svg>

            <div id="ec-tooltip" class="ec-tooltip" hidden></div>

            <div id="ec-empty" class="text-center text-[var(--outline-elev)] py-8" hidden>
                <span class="material-symbols-elev text-4xl block mb-2 opacity-50">timeline</span>
                Aún no hay operaciones registradas.
                <button type="button" data-jump-tab="form" class="text-[var(--gold-elev)] hover:underline ml-1">Asentá la primera →</button>
            </div>

            <div class="ec-legend mt-3">
                <span><span class="ec-legend-dot ec-legend-pos"></span>Win</span>
                <span><span class="ec-legend-dot ec-legend-neg"></span>Loss</span>
                <span><span class="ec-legend-dot" style="background: rgba(255,255,255,0.4)"></span>BE</span>
                <span class="ml-auto" id="ec-source">—</span>
            </div>
        </section>

        {# ─── Calendar + P&L Mensual ─── #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <section class="glass-card-elev p-6 calendar-monthly-card">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">calendar_month</span>
                        <span class="text-cinzel-display text-base tracking-wider">CALENDARIO</span>
                    </h3>
                    <div class="flex flex-wrap items-center gap-2" id="cal-month-nav" role="group" aria-label="Mes">
                        <button type="button" class="cal-nav-btn" id="cal-prev" aria-label="Mes anterior">
                            <span class="material-symbols-elev icon-size-sm">chevron_left</span>
                        </button>
                        <span id="cal-month-title" class="text-sm font-semibold min-w-[140px] text-center">—</span>
                        <button type="button" class="cal-nav-btn" id="cal-next" aria-label="Mes siguiente">
                            <span class="material-symbols-elev icon-size-sm">chevron_right</span>
                        </button>
                        <button type="button" class="cal-today-btn" id="cal-today">Hoy</button>
                    </div>
                </div>

                <div class="flex items-center gap-4 mb-3 text-xs text-[var(--outline-elev)]">
                    <span>Total mes: <strong id="cal-month-pnl" class="text-[var(--on-surface-elev)]">$0</strong></span>
                    <span><span id="cal-month-trades">0</span> trades</span>
                    <span><span id="cal-month-wr">0</span>% WR</span>
                </div>

                <div class="cal-month-grid" id="cal-month-grid" aria-label="Calendario de operaciones">
                    <div class="col-span-7 text-center text-[var(--outline-elev)] py-6 text-xs loading-pulse">Cargando calendario...</div>
                </div>

                <div class="cal-legend mt-3">
                    <span><span class="cal-legend-dot cal-dot-wins"></span>Día ganador</span>
                    <span><span class="cal-legend-dot cal-dot-losses"></span>Día perdedor</span>
                    <span><span class="cal-legend-dot cal-dot-mixed"></span>Mixto</span>
                    <span><span class="cal-legend-dot cal-dot-open"></span>Abierta</span>
                </div>
            </section>

            <section class="glass-card-elev p-6 monthly-pnl-card" id="monthly-pnl-card">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                        <span class="material-symbols-elev text-[var(--gold-elev)]">bar_chart</span>
                        <span class="text-cinzel-display text-base tracking-wider">P&L MENSUAL</span>
                    </h3>
                    <span class="text-xs text-[var(--outline-elev)]">últimos 6 meses</span>
                </div>
                <div id="monthly-pnl-chart" class="w-full" style="min-height: 240px;">
                    <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse text-xs">Cargando P&L mensual...</p>
                </div>
                <div class="cal-legend mt-3">
                    <span><span class="ec-legend-dot ec-legend-pos"></span>Positivo</span>
                    <span><span class="ec-legend-dot ec-legend-neg"></span>Negativo</span>
                    <span class="ml-auto" id="monthly-pnl-source">—</span>
                </div>
            </section>
        </div>

        {# ─── Stats Row ─── #}
        <section class="glass-card-elev p-6 mb-6 stats-row" aria-label="Estadísticas de trading">
            <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">analytics</span>
                    <span class="text-cinzel-display text-base tracking-wider">ESTADÍSTICAS</span>
                </h3>
                <span class="text-xs text-[var(--outline-elev)]">
                    <span id="stats-trade-count">0</span> trades en total
                </span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3" id="stats-grid">
                <div class="kpi-card" data-stat="pf">
                    <span class="kpi-label">Profit Factor</span>
                    <p class="kpi-value" id="stats-pf">—</p>
                    <p class="kpi-meta" id="stats-pf-meta">—</p>
                </div>
                <div class="kpi-card" data-stat="expect">
                    <span class="kpi-label">Expectativa</span>
                    <p class="kpi-value" id="stats-expect">—</p>
                    <p class="kpi-meta" id="stats-expect-meta">—</p>
                </div>
                <div class="kpi-card" data-stat="wr">
                    <span class="kpi-label">Win Rate</span>
                    <p class="kpi-value" id="stats-wr">—</p>
                    <p class="kpi-meta" id="stats-wr-meta">—</p>
                </div>
                <div class="kpi-card" data-stat="avg-w">
                    <span class="kpi-label">Avg Win</span>
                    <p class="kpi-value text-green-400" id="stats-avg-w">—</p>
                    <p class="kpi-meta" id="stats-avg-w-meta">—</p>
                </div>
                <div class="kpi-card" data-stat="avg-l">
                    <span class="kpi-label">Avg Loss</span>
                    <p class="kpi-value text-red-400" id="stats-avg-l">—</p>
                    <p class="kpi-meta" id="stats-avg-l-meta">—</p>
                </div>
            </div>
            <div class="mt-4 pt-4 border-t border-[var(--outline-variant-elev)] grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
                <div>
                    <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Mejor trade</span>
                    <p class="text-green-400 font-bold text-lg" id="stats-best">—</p>
                </div>
                <div>
                    <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Peor trade</span>
                    <p class="text-red-400 font-bold text-lg" id="stats-worst">—</p>
                </div>
                <div>
                    <span class="text-xs text-[var(--outline-elev)] uppercase tracking-wider">Total P&L</span>
                    <p class="font-bold text-lg" id="stats-total-pnl">—</p>
                </div>
            </div>
        </section>

    </section>

    {# ─── Day Detail Modal — unified tnsvt-modal (V1-style slide-up) ─── #}
    <div id="cal-day-modal" class="tnsvt-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="cal-day-modal-title" hidden>
        <div class="tnsvt-modal tnsvt-modal--wide tnsvt-modal--slide-up">
            <div class="tnsvt-modal__header">
                <h2 id="cal-day-modal-title" class="tnsvt-modal__title">Detalle</h2>
                <button type="button" class="tnsvt-modal__close" data-action="close-cal-day" aria-label="Cerrar">
                    <span class="material-symbols-elev">close</span>
                </button>
            </div>
            <div id="cal-day-modal-body" class="tnsvt-modal__body">
                <!-- table injected via JS -->
            </div>
        </div>
    </div>

    {# ════════════════════════════════════════════════════════════
       PANEL: FORM — Registrar Trade
       ════════════════════════════════════════════════════════════ #}
    <section class="journal-panel" id="journal-panel-form" role="tabpanel" aria-labelledby="journal-tab-form" data-panel="form" hidden>
        <div class="tab-panel-active">
            {% include '_partials/dashboard/trade_form.html.twig' %}
        </div>
    </section>

    {# ════════════════════════════════════════════════════════════
       PANEL: LOG — Lista de trades
       ════════════════════════════════════════════════════════════ #}
    <section class="journal-panel" id="journal-panel-log" role="tabpanel" aria-labelledby="journal-tab-log" data-panel="log" hidden>
        {# ─── Toolbar ─── #}
        <div class="glass-card-elev mb-4 flex flex-wrap items-center gap-3">
            <button id="btn-new-trade" data-test-id="btn-new-trade" class="ui-btn ui-btn-primary flex items-center gap-2">
                <span class="material-symbols-elev align-middle icon-size-xs">add</span>
                Nuevo Trade
            </button>
            <div class="flex-1"></div>
            <div class="flex items-center gap-2 text-sm text-[var(--outline-elev)]">
                <span id="journal-count">0 trades</span>
            </div>
        </div>

        {# ─── Trade List ─── #}
        <div class="glass-card-elev p-0 overflow-hidden">
            <div id="trade-list" class="divide-y divide-[var(--outline-variant-elev)]">
                <p class="text-center text-[var(--outline-elev)] py-12 loading-pulse">Cargando journal...</p>
            </div>
        </div>
    </section>

    {# ════════════════════════════════════════════════════════════
       PANEL: STATS — Stats detallados
       ════════════════════════════════════════════════════════════ #}
    <section class="journal-panel" id="journal-panel-stats" role="tabpanel" aria-labelledby="journal-tab-stats" data-panel="stats" hidden>
        <div class="glass-card-elev p-6 mb-6">
            <h3 class="text-lg font-semibold text-[var(--on-surface-elev)] flex items-center gap-2 mb-4">
                <span class="material-symbols-elev text-[var(--gold-elev)]">insights</span>
                <span class="text-cinzel-display text-base tracking-wider">ESTADÍSTICAS DETALLADAS</span>
            </h3>

            <div id="stats-detail-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                <div class="kpi-card" data-stat-detail="pf">
                    <span class="kpi-label">Profit Factor</span>
                    <p class="kpi-value" id="stats-detail-pf">—</p>
                    <p class="kpi-meta" id="stats-detail-pf-meta">—</p>
                </div>
                <div class="kpi-card" data-stat-detail="expect">
                    <span class="kpi-label">Expectativa</span>
                    <p class="kpi-value" id="stats-detail-expect">—</p>
                    <p class="kpi-meta">por trade promedio</p>
                </div>
                <div class="kpi-card" data-stat-detail="wr">
                    <span class="kpi-label">Win Rate</span>
                    <p class="kpi-value" id="stats-detail-wr">—</p>
                    <p class="kpi-meta" id="stats-detail-wr-meta">—</p>
                </div>
                <div class="kpi-card" data-stat-detail="avg-w">
                    <span class="kpi-label">Avg Win</span>
                    <p class="kpi-value text-green-400" id="stats-detail-avg-w">—</p>
                    <p class="kpi-meta" id="stats-detail-avg-w-meta">—</p>
                </div>
                <div class="kpi-card" data-stat-detail="avg-l">
                    <span class="kpi-label">Avg Loss</span>
                    <p class="kpi-value text-red-400" id="stats-detail-avg-l">—</p>
                    <p class="kpi-meta" id="stats-detail-avg-l-meta">—</p>
                </div>
                <div class="kpi-card" data-stat-detail="total">
                    <span class="kpi-label">Total P&L</span>
                    <p class="kpi-value" id="stats-detail-total">—</p>
                    <p class="kpi-meta">acumulado</p>
                </div>
                <div class="kpi-card" data-stat-detail="best">
                    <span class="kpi-label">Mejor trade</span>
                    <p class="kpi-value text-green-400" id="stats-detail-best">—</p>
                    <p class="kpi-meta">single best</p>
                </div>
                <div class="kpi-card" data-stat-detail="worst">
                    <span class="kpi-label">Peor trade</span>
                    <p class="kpi-value text-red-400" id="stats-detail-worst">—</p>
                    <p class="kpi-meta">single worst</p>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-[var(--outline-variant-elev)]">
                <h4 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span class="material-symbols-elev icon-size-sm">rule</span>
                    Distribución de resultados
                </h4>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                    <div class="glass-card-elev text-center">
                        <p class="kpi-label">Wins</p>
                        <p class="kpi-value gold" id="stats-detail-wins">0</p>
                    </div>
                    <div class="glass-card-elev text-center">
                        <p class="kpi-label">Losses</p>
                        <p class="kpi-value gold" id="stats-detail-losses">0</p>
                    </div>
                    <div class="glass-card-elev text-center">
                        <p class="kpi-label">Break-Even</p>
                        <p class="kpi-value gold" id="stats-detail-be">0</p>
                    </div>
                    <div class="glass-card-elev text-center">
                        <p class="kpi-label">Abiertas</p>
                        <p class="kpi-value gold" id="stats-detail-open">0</p>
                    </div>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-[var(--outline-variant-elev)] text-sm text-[var(--outline-elev)]">
                <p class="flex items-start gap-2">
                    <span class="material-symbols-elev text-[var(--gold-elev)] icon-size-sm">info</span>
                    <span>
                        Las métricas se calculan sobre todas las operaciones cerradas (WIN, LOSS, BE). Las posiciones abiertas no afectan Profit Factor ni Expectativa.
                        Para análisis más profundo, consultá el calendario y la curva de equity en el panel "Dashboard".
                    </span>
                </p>
            </div>
        </div>
    </section>

</div>

{# ─── New/Edit Trade Modal — unified tnsvt-modal ─── #}
<div id="trade-modal" class="tnsvt-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="trade-modal-title" hidden>
    <div class="tnsvt-modal">
        <div class="tnsvt-modal__header">
            <h2 class="tnsvt-modal__title">
                <span class="material-symbols-elev text-[var(--gold-elev)]">edit_note</span>
                <span id="trade-modal-title">Nuevo Trade</span>
            </h2>
            <button type="button" class="tnsvt-modal__close" data-action="close-trade-modal" aria-label="Cerrar">
                <span class="material-symbols-elev" aria-hidden="true">close</span>
            </button>
        </div>
        <form id="trade-form" data-test-id="trade-form" class="tnsvt-modal__body space-y-3" style="padding-top:1.25rem;" data-api-validate>
            <input type="hidden" id="trade-id" />

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="kpi-label block mb-1">Asset *</label>
                    <input id="trade-asset" data-test-id="trade-asset" type="text" required maxlength="20" placeholder="XAUUSD"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">Dirección</label>
                    <select id="trade-dir" class="form-input">
                        <option value="BUY">BUY (Long)</option>
                        <option value="SELL">SELL (Short)</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="kpi-label block mb-1">
                    Cuenta
                    <span class="text-[10px] text-[var(--outline-elev)] ml-1" id="trade-account-cap-hint"></span>
                </label>
                <select id="trade-account-id" class="form-input" data-action="change->account-switcher#onTradeFormChange">
                    <option value="">— Cargando cuentas... —</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="kpi-label block mb-1">Fecha</label>
                    <input id="trade-date" type="datetime-local"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">Resultado</label>
                    <select id="trade-result" class="form-input">
                        <option value="">—</option>
                        <option value="WIN">WIN</option>
                        <option value="LOSS">LOSS</option>
                        <option value="BE">BREAK-EVEN</option>
                        <option value="OPEN">OPEN</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-4 gap-3">
                <div>
                    <label class="kpi-label block mb-1">Entry</label>
                    <input id="trade-entry" data-test-id="trade-entry" type="text" step="any" placeholder="2650.50"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">SL</label>
                    <input id="trade-sl" data-test-id="trade-sl" type="text" step="any" placeholder="2645"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">TP</label>
                    <input id="trade-tp" data-test-id="trade-tp" type="text" step="any" placeholder="2660"
                           class="form-input" />
                </div>
                <div>
                    <label class="kpi-label block mb-1">PnL ($)</label>
                    <input id="trade-pnl" data-test-id="trade-pnl" type="number" step="any" placeholder="125.50"
                           class="form-input" />
                </div>
            </div>

            <div>
                <label class="kpi-label block mb-1">Notas</label>
                <textarea id="trade-notes" data-test-id="trade-notes" rows="3" placeholder="Análisis, emociones, plan ejecutado..."
                          class="form-input"></textarea>
            </div>

            <p id="trade-form-error" class="text-red-400 text-sm hidden"></p>

            <div class="tnsvt-modal__footer">
                <button type="button" data-action="close-trade-modal" class="ui-btn ui-btn-secondary">Cancelar</button>
                <button type="submit" id="trade-submit" class="ui-btn ui-btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

