{% extends 'shell.html.twig' %}

{% block title %}Guardian · T.N.S.V.T{% endblock %}

{% block topbar_title %}Guardian · Riesgo & Disciplina{% endblock %}
{% block topbar_subtitle %}Señales operativas y disciplina de los últimos 30 días{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto"
         data-controller="guardian">

        {# ─── Toolbar ─── #}
        <div class="glass-card-elev p-4 mb-6 flex items-center justify-between">
            <div>
                <p class="text-sm text-[var(--on-surface-elev)]">Señales calculadas desde tu Journal, Diario, Macro y cuentas PropFirm</p>
                <p class="text-xs text-[var(--outline-elev)]">Refresh: <span id="last-refresh" data-guardian-target="lastRefresh">--</span></p>
            </div>
            <button type="button"
                    data-guardian-target="refreshBtn"
                    data-action="click->guardian#refresh"
                    class="ui-btn ui-btn secondary text-xs">
                <span class="material-symbols-elev align-middle icon-size-xs">refresh</span>
                Refrescar
            </button>
        </div>

        {# ─── Loading skeleton ─── #}
        <div id="loading-state"
             data-guardian-target="loadingState"
             class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="glass-card-elev p-6 lg:col-span-1">
                <p class="loading-pulse text-[var(--outline-elev)] text-center py-12">Calculando score...</p>
            </div>
            <div class="glass-card-elev p-6 lg:col-span-2">
                <p class="loading-pulse text-[var(--outline-elev)] text-center py-12">Recolectando señales...</p>
            </div>
        </div>

        {# ─── Error state ─── #}
        <div id="error-state"
             data-guardian-target="errorState"
             class="hidden glass-card-elev p-6">
            <p class="text-red-400 text-center">Error cargando Guardian. Probá refrescar.</p>
        </div>

        {# ─── Main content (populated by Stimulus) ─── #}
        <div id="guardian-content"
             data-guardian-target="content"
             class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6">

            {# Score card (left) #}
            <div class="glass-card-elev p-6 lg:col-span-1">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">shield_person</span>
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)]">Discipline Score</h3>
                </div>

                <div class="flex flex-col items-center py-4">
                    <div id="score-value"
                         data-guardian-target="scoreValue"
                         class="text-6xl font-bold tracking-tight"
                         style="color: var(--gold-elev);">--</div>
                    <div class="text-sm text-[var(--outline-elev)] mt-1">/ 100</div>
                    <div id="score-tier"
                         data-guardian-target="scoreTier"
                         class="mt-3 tier-badge-elev tier-initiate"
                         style="font-size: 0.8rem; letter-spacing: 0.1em;">--</div>
                </div>

                <div class="mt-6">
                    <p class="text-xs uppercase tracking-wider text-[var(--outline-elev)] mb-2">Breakdown</p>
                    <ul id="score-breakdown"
                        data-guardian-target="scoreBreakdown"
                        class="space-y-1 text-sm">
                        <li class="text-[var(--outline-elev)] py-2">Sin factores negativos.</li>
                    </ul>
                </div>

                <p class="text-xs text-[var(--outline-elev)] mt-4 text-center">
                    Calculado: <span id="score-computed-at" data-guardian-target="scoreComputedAt">--</span>
                </p>
            </div>

            {# Signals card (right) #}
            <div class="glass-card-elev p-6 lg:col-span-2">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-elev text-[var(--gold-elev)]">notifications_active</span>
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)]">Señales activas</h3>
                    <span id="signal-count-badge"
                          data-guardian-target="signalCountBadge"
                          class="ml-auto text-xs px-2 py-0.5 rounded-full bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--outline-elev)]">0</span>
                </div>

                <div id="signals-list"
                     data-guardian-target="signalsList"
                     class="space-y-3">
                    <div id="signals-empty"
                         data-guardian-target="signalsEmpty"
                         class="hidden text-center py-8">
                        <span class="material-symbols-elev text-4xl text-green-400">check_circle</span>
                        <p class="text-sm text-[var(--on-surface-elev)] mt-2">Todo en orden</p>
                        <p class="text-xs text-[var(--outline-elev)]">Sin señales activas. Tu disciplina está bajo control.</p>
                    </div>
                </div>
            </div>

        </div>

    </div>
{% endblock %}
