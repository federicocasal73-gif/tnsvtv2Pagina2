{% extends 'shell.html.twig' %}

{% import '_partials/components/_macros.html.twig' as ui %}

{% block title %}Tareas · T.N.S.V.T{% endblock %}

{% block topbar_title %}Tareas{% endblock %}
{% block topbar_subtitle %}Sistema unificado de tareas, entregas y feedback{% endblock %}

{% block content %}
<div class="tasks-shell" data-controller="tasks"
     data-tasks-user-code-value="{{ app.user ? app.user.code : '' }}"
     data-tasks-is-admin-value="{{ is_granted('ROLE_ADMIN') ? '1' : '0' }}">

    {# ─── Stats bar ─── #}
    <section class="tasks-stats glass-card-elev">
        <div class="tasks-stat" data-tasks-target="countPending">
            <span class="tasks-stat-value">—</span>
            <span class="tasks-stat-label">Pendientes</span>
        </div>
        <div class="tasks-stat" data-tasks-target="countInProgress">
            <span class="tasks-stat-value">—</span>
            <span class="tasks-stat-label">En progreso</span>
        </div>
        <div class="tasks-stat" data-tasks-target="countSubmitted">
            <span class="tasks-stat-value">—</span>
            <span class="tasks-stat-label">Entregadas</span>
        </div>
        <div class="tasks-stat" data-tasks-target="countApproved">
            <span class="tasks-stat-value">—</span>
            <span class="tasks-stat-label">Aprobadas</span>
        </div>
        <div class="tasks-stat" data-tasks-target="countOverdue">
            <span class="tasks-stat-value">—</span>
            <span class="tasks-stat-label">Vencidas</span>
        </div>
    </section>

    {# ─── View tabs (mine / created by me / all) ─── #}
    <nav class="tasks-tabs" aria-label="Vistas de tareas">
        <button type="button" class="tasks-tab is-active" data-tasks-target="tabMine" data-action="click->tasks#switchView" data-view="mine">
            <span class="material-symbols-elev">inbox</span>
            Mis tareas
        </button>
        <button type="button" class="tasks-tab" data-tasks-target="tabCreated" data-action="click->tasks#switchView" data-view="created">
            <span class="material-symbols-elev">outbox</span>
            Asignadas por mí
        </button>
        {% if is_granted('ROLE_ADMIN') %}
        <button type="button" class="tasks-tab" data-tasks-target="tabAll" data-action="click->tasks#switchView" data-view="all">
            <span class="material-symbols-elev">list_alt</span>
            Todas
        </button>
        {% endif %}
    </nav>

    {# ─── Filter bar ─── #}
    <section class="tasks-filters glass-card-elev">
        <label class="tasks-filter">
            <span class="tasks-filter-label">Buscar</span>
            <input type="search" placeholder="Título o descripción…"
                   data-tasks-target="searchInput"
                   data-action="input->tasks#onFilterChange"
                   class="tasks-filter-input" />
        </label>
        <label class="tasks-filter">
            <span class="tasks-filter-label">Estado</span>
            <select data-tasks-target="statusFilter" data-action="change->tasks#onFilterChange" class="tasks-filter-input">
                <option value="">Todos</option>
                <option value="pending">Pendiente</option>
                <option value="in_progress">En progreso</option>
                <option value="submitted">Entregada</option>
                <option value="in_review">En revisión</option>
                <option value="approved">Aprobada</option>
                <option value="needs_revision">Necesita corrección</option>
                <option value="overdue">Vencida</option>
            </select>
        </label>
        <label class="tasks-filter">
            <span class="tasks-filter-label">Prioridad</span>
            <select data-tasks-target="priorityFilter" data-action="change->tasks#onFilterChange" class="tasks-filter-input">
                <option value="">Todas</option>
                <option value="urgent">Urgente</option>
                <option value="high">Alta</option>
                <option value="normal">Normal</option>
                <option value="low">Baja</option>
            </select>
        </label>
        <label class="tasks-filter">
            <span class="tasks-filter-label">Ordenar</span>
            <select data-tasks-target="sortSelect" data-action="change->tasks#onFilterChange" class="tasks-filter-input">
                <option value="due_date|asc">Vencimiento ↑</option>
                <option value="due_date|desc">Vencimiento ↓</option>
                <option value="priority|asc">Prioridad ↑</option>
                <option value="created|desc">Más recientes</option>
                <option value="title|asc">Título A-Z</option>
                <option value="status|asc">Estado</option>
            </select>
        </label>
    </section>

    {# ─── Task list ─── #}
    <section class="tasks-list-section">
        <header class="tasks-list-header">
            <h2 class="tasks-list-title">Listado</h2>
            <span class="tasks-list-count" data-tasks-target="listCount">—</span>
        </header>

        <div class="tasks-list" data-tasks-target="list">
            {% include '_partials/loading_state.html.twig' with {
                icon: 'progress_activity',
                message: 'Cargando tareas...',
                size: 'md'
            } only %}
        </div>
    </section>

    {# ─── Empty state ─── #}
    {% include '_partials/empty_state.html.twig' with {
        icon: 'task_alt',
        message: 'Sin tareas',
        description: 'No se encontraron tareas con los filtros actuales.',
        cta_url: '',
        cta_label: '',
        size: 'md'
    } only %}
</div>
{% endblock %}
