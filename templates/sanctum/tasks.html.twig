{% extends 'shell.html.twig' %}

{% block title %}Tasks · T.N.S.V.T{% endblock %}

{% block topbar_title %}Tasks · Task Sovereignty{% endblock %}
{% block topbar_subtitle %}Gestión de tareas globales del Sanctum{% endblock %}

{% block content %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" data-controller="tasks">
        {# Left: list of tasks with inline actions #}
        <div class="lg:col-span-2">
            <div class="glass-card-elev p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-[var(--on-surface-elev)]">Lista de tareas</h3>
                    <div class="flex gap-2 text-xs">
                        <span id="active-count" class="status-pill status-active" data-tasks-target="activeCount">0 active</span>
                        <span id="inactive-count" class="status-pill status-inactive" data-tasks-target="inactiveCount">0 inactive</span>
                    </div>
                </div>
                <div id="tasks-list" class="space-y-2" data-tasks-target="list">
                    <p class="text-center text-[var(--outline-elev)] py-8 loading-pulse">Cargando...</p>
                </div>
            </div>
        </div>

        {# Right: create form #}
        <div>
            <div class="glass-card-elev p-6">
                <h3 class="text-lg font-semibold mb-4 text-[var(--on-surface-elev)]">Crear nueva tarea</h3>
                <form id="create-task-form" class="space-y-3" data-action="submit->tasks#createTask">
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-[var(--outline-elev)] mb-1">Título *</label>
                        <input id="create-title" type="text" required maxlength="255" placeholder="Ej: Auditar journal del usuario FRAN" class="w-full px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-[var(--outline-elev)] mb-1">Descripción</label>
                        <textarea id="create-description" rows="3" maxlength="5000" placeholder="Detalles opcionales..." class="w-full px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]"></textarea>
                    </div>
                    <div class="flex gap-2">
                        <label class="flex-1">
                            <span class="block text-xs uppercase tracking-wider text-[var(--outline-elev)] mb-1">Orden</span>
                            <input id="create-orden" type="number" min="0" value="0" class="w-full px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm focus:outline-none focus:border-[var(--gold-elev)]" />
                        </label>
                        <label class="flex items-end gap-2 pb-2">
                            <input id="create-active" type="checkbox" checked class="w-4 h-4" />
                            <span class="text-sm text-[var(--on-surface-elev)]">Activa</span>
                        </label>
                    </div>
                    <button type="submit" class="btn-elev-primary w-full">
                        <span class="material-symbols-elev align-middle text-sm">add</span>
                        Crear tarea
                    </button>
                    <p id="create-error" class="text-sm text-red-400 hidden"></p>
                </form>
            </div>

            <div class="glass-card-elev p-6 mt-4">
                <h3 class="text-sm font-semibold mb-3 text-[var(--outline-elev)] uppercase tracking-wider">Tip</h3>
                <p class="text-xs text-[var(--outline-elev)] leading-relaxed">
                    Las tareas se muestran en el dashboard. Reordénalas cambiando los valores de "Orden" o usando los botones ↑/↓ de cada tarjeta.
                </p>
            </div>
        </div>
    </div>

{# Tasks loading handled by tasks_controller.js #}
{% endblock %}
