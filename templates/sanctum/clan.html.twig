{% extends 'shell.html.twig' %}

{% block title %}Clan · T.N.S.V.T{% endblock %}

{% block topbar_title %}Clan{% endblock %}
{% block topbar_subtitle %}Tu hermandad en el Reino.{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto" data-controller="clans">
    <div id="clan-info" class="glass-card-elev p-4 mb-4" data-clans-target="info">
        <p class="text-center text-[var(--outline-elev)] py-4">Cargando clan...</p>
    </div>

    <h3 class="text-sm font-semibold text-[var(--gold-elev)] uppercase tracking-wider mb-3">Buscar Clanes</h3>
    <div id="clan-search" class="space-y-3" data-clans-target="search">
        <p class="text-center text-[var(--outline-elev)] py-8">Cargando...</p>
    </div>
</div>
{% endblock %}
