<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050308" />
    <title>{% block title %}T.N.S.V.T{% endblock %}</title>

    {% include '_partials/og_meta.html.twig' with {
        title: block('title')|default('T.N.S.V.T — Gateway'),
        description: 'Plataforma neuro-espiritual de trading. Análisis macro, bitácora y guardian para ejecutores del reino.',
        type: 'website',
    } %}

    {# Fonts loaded via canonical partial _partials/fonts.html.twig — see that file to add new families. #}
    {% include '_partials/fonts.html.twig' %}

    {# Public shell loads ONLY the tokens + home styles.
       NO Sanctum CSS (no elev/v2/glass-premium) — clean boundary. #}
    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}" />
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}" />

    {% block stylesheets %}{% endblock %}
</head>

<body class="{% block body_class %}{% endblock %} relative">

{# ═══ FASE 0 — Fondo estrellado (V2 identidad visual) ═══ #}
{% block background %}{% endblock %}
<script src="{{ asset('js/modules/theme.js') }}" defer></script>
<script src="{{ asset('js/modules/webgl-background.js') }}" defer></script>
{% block javascripts %}
    {{ importmap('divine_overlay') }}
{% endblock %}

{# Public shell loads ONLY the tokens + home styles. #}
{% block public_nav %}{% include 'public/_public_nav.html.twig' with {} %}{% endblock %}

{# api_helper is needed because the login form calls /api/auth/login #}
{% include '_partials/api_helper.html.twig' with {} %}

{# ═══ FASE 0 — Emblema 3D del gateway (home) ═══ #}
{% block gateway_emblem %}{% endblock %}

<div class="public-shell">
    {% block content %}{% endblock %}
</div>

<div class="public-floats">
    {% block floats %}{% endblock %}
</div>

</body>
</html>
