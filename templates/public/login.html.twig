{% extends 'public/shell.html.twig' %}

{% block title %}Entrar al Sanctum · T.N.S.V.T{% endblock %}

{% block meta_description %}Entrar al Sanctum. Plataforma neuro-espiritual de trading con análisis macro, bitácora, Guardian y campus académico.{% endblock %}

{% block body_class %}login-body gateway-emblem{% endblock %}

{# Login page renders its own top app bar. #}
{% block public_nav %}{% endblock %}

{# FASE 0 — Bring the shader stars to full opacity for the login. #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/components/gateway.css') }}" />
{% endblock %}

{% block background %}{% endblock %}

{% block gateway_emblem %}{% endblock %}

{% block content %}
    <a class="gw-skip-link" href="#login-card">Skip to content</a>
    {# ─── WebGL shader background handled in JS ─── #}

    {# ─── Top App Bar ─── #}
    <header class="gw-topbar">
        <div class="gw-brand">
            <a class="gw-menu material-symbols-elev" href="/" aria-label="Volver">arrow_back</a>
            <span class="gw-brand-sigil material-symbols-elev" aria-hidden="true">token</span>
            <span class="gw-brand-name">T.N.S.V.T</span>
            <span class="gw-dot" aria-hidden="true"></span>
        </div>
        <div class="gw-topbar-actions">
            <a class="gw-entrar" href="/">
                <span class="material-symbols-elev" aria-hidden="true">home</span> Inicio
            </a>
        </div>
    </header>

    <main class="gw-main">
        {# ─── Hero celestial ─── #}
        <section class="gw-hero" id="gw-hero">
            <div class="gw-emblem" aria-hidden="true">
                <div class="gw-ring gw-ring-a"></div>
                <div class="gw-ring gw-ring-b"></div>
                <div class="gw-orbit"></div>
                <div class="gw-core"></div>
            </div>
            <p class="gw-kicker">Reino del Cristo Íntegro</p>
            <h1 class="gw-title">Neuro-Spiritual Value Theory</h1>
            <p class="verse">"Por mí, los reyes reinan y los príncipes gobiernan con justicia." — Proverbios 8:15</p>
        </section>

        {# ─── Live platform stats (real data) ─── #}
        <div class="stats-strip">
            <div class="stat-item">
                <div class="stat-value" id="stat-traders">—</div>
                <div class="stat-label"><span class="stat-live"></span>Traders Activos</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="stat-trades">—</div>
                <div class="stat-label">Trades Hoy</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="stat-pnl">—</div>
                <div class="stat-label">PnL Global</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">99.9%</div>
                <div class="stat-label"><span class="stat-live"></span>Uptime</div>
            </div>
        </div>

        {# ─── Login card ─── #}
        <section id="login-card" class="login-section">
            <div class="login-card">
                <h2>Iniciar sesión</h2>
                <form id="login-form" autocomplete="off">
                    <div class="form-field">
                        <label for="login-code">Código de acceso</label>
                        <input type="text" id="login-code" name="code" required autocomplete="username"
                               placeholder="ADMIN01 / DEMO / tu código" />
                    </div>
                    <div class="form-field">
                        <label for="login-name" id="login-name-label">Nombre (solo usuarios)</label>
                        <input type="text" id="login-name" name="name" autocomplete="name"
                               placeholder="Nombre del usuario (Demo, Juan, etc.)" />
                    </div>
                    <div class="form-field" id="login-password-field">
                        <label for="login-password">Contraseña</label>
                        <input type="password" id="login-password" name="password" autocomplete="current-password"
                               placeholder="Requerida para admins; opcional si definiste una" />
                    </div>
                    <button type="submit" class="login-submit" id="login-submit-btn">
                        <span id="login-btn-text">Entrar</span>
                    </button>
                    <div class="login-error" id="login-error" role="alert" aria-live="assertive"></div>
                    <div class="login-success" id="login-success" role="status" aria-live="polite"></div>
                    <p class="login-forgot"><button type="button" id="login-forgot-link" class="linklike">¿Olvidaste tu contraseña?</button> · <button type="button" id="login-code-forgot-link" class="linklike">¿Olvidaste tu código?</button></p>
                </form>

                {# ─── Paso 2: código de 6 dígitos ─── #}
                <div id="login-2fa" style="display:none;" aria-live="polite">
                    <h3>Verificación en dos pasos</h3>
                    <p class="login-2fa-sub">Te enviamos un código a <strong id="tfa-email">tu mail</strong>. Vale 10 minutos.</p>
                    <div class="form-field">
                        <label for="tfa-code">Código de 6 dígitos</label>
                        <input type="text" id="tfa-code" inputmode="numeric" autocomplete="one-time-code"
                               maxlength="6" placeholder="000000" />
                    </div>
                    <button type="button" class="login-submit" id="tfa-verify-btn">Verificar y entrar</button>
                    <p class="login-2fa-row">
                        <button type="button" id="tfa-resend-btn" class="linklike" disabled>Reenviar código (<span id="tfa-timer">60</span>s)</button>
                        <button type="button" id="tfa-back-btn" class="linklike">Volver</button>
                    </p>
                    <div class="login-error" id="tfa-error" role="alert" aria-live="assertive"></div>
                </div>

                {# ─── Enrolamiento: cargar mail ─── #}
                <div id="login-enroll" style="display:none;" aria-live="polite">
                    <h3>Protegé tu cuenta</h3>
                    <p class="login-2fa-sub">Cargá tu mail para activar la verificación en dos pasos.</p>
                    <div class="form-field">
                        <label for="enroll-email">Tu mail</label>
                        <input type="email" id="enroll-email" autocomplete="email" placeholder="vos@mail.com" />
                    </div>
                    <button type="button" class="login-submit" id="enroll-send-btn">Enviarme el código</button>
                    <p class="login-2fa-row">
                        <button type="button" id="enroll-back-btn" class="linklike">Volver</button>
                    </p>
                    <div class="login-error" id="enroll-error" role="alert" aria-live="assertive"></div>
                </div>

                {# ─── Recupero: pedir código ─── #}
                <div id="login-recover" style="display:none;" aria-live="polite">
                    <h3>Recuperar contraseña</h3>
                    <p class="login-2fa-sub">Ingresá tu código de adepto. Si tiene mail verificado, te mandamos un código.</p>
                    <div class="form-field">
                        <label for="recover-code">Código de acceso</label>
                        <input type="text" id="recover-code" autocomplete="username" placeholder="TU CÓDIGO" />
                    </div>
                    <button type="button" class="login-submit" id="recover-send-btn">Enviar código</button>
                    <p class="login-2fa-row">
                        <button type="button" id="recover-back-btn" class="linklike">Volver al login</button>
                    </p>
                    <div class="login-error" id="recover-error" role="alert" aria-live="assertive"></div>
                </div>

                {# ─── Recupero: código + nueva contraseña ─── #}
                <div id="login-reset" style="display:none;" aria-live="polite">
                    <h3>Nueva contraseña</h3>
                    <p class="login-2fa-sub">Mínimo 10 caracteres. Al guardarla se cierran tus otras sesiones.</p>
                    <div class="form-field">
                        <label for="reset-code">Código recibido</label>
                        <input type="text" id="reset-code" inputmode="numeric" autocomplete="one-time-code"
                               maxlength="6" placeholder="000000" />
                    </div>
                    <div class="form-field">
                        <label for="reset-pass">Nueva contraseña</label>
                        <input type="password" id="reset-pass" autocomplete="new-password" placeholder="Mínimo 10 caracteres" />
                    </div>
                    <button type="button" class="login-submit" id="reset-save-btn">Guardar y entrar</button>
                    <p class="login-2fa-row">
                        <button type="button" id="reset-back-btn" class="linklike">Volver al login</button>
                    </p>
                    <div class="login-error" id="reset-error" role="alert" aria-live="assertive"></div>
                </div>

                {# ─── Recupero de código de adepto (por mail verificado) ─── #}
                <div id="login-recover-code" style="display:none;" aria-live="polite">
                    <h3>Recuperar código</h3>
                    <p class="login-2fa-sub">Ingresá tu mail verificado y te enviamos tu código de adepto. Si no tenés mail verificado, pedíselo a un administrador.</p>
                    <div class="form-field">
                        <label for="recover-code-email">Tu mail</label>
                        <input type="email" id="recover-code-email" autocomplete="email" placeholder="vos@mail.com" />
                    </div>
                    <button type="button" class="login-submit" id="recover-code-send-btn">Enviar mi código</button>
                    <p class="login-2fa-row">
                        <button type="button" id="recover-code-back-btn" class="linklike">Volver al login</button>
                    </p>
                    <div class="login-error" id="recover-code-error" role="alert" aria-live="assertive"></div>
                    <div class="login-success" id="recover-code-success" role="status" aria-live="polite" style="display:none;"></div>
                </div>
                <div class="login-hint">
                    <strong>Cómo funciona:</strong> ADMIN01 = admin (necesita contraseña).<br>
                    Usuarios: código + nombre (y contraseña solo si definiste una en tu perfil).<br>
                    Tu sesión queda activa hasta cerrar el navegador.
                </div>
            </div>
        </section>

        {# ─── Módulos del Sanctum (preview antes de entrar) ─── #}
        <section class="gw-modules">
            <div class="gw-modules-head">
                <h2 class="gw-modules-title">Módulos del Sanctum</h2>
                <span class="gw-modules-phase">Acceso tras login</span>
            </div>

            <a class="gw-bento gw-fade" style="animation-delay: .1s" href="#login-card">
                <span class="gw-bento-icon"><span class="material-symbols-elev" aria-hidden="true">dashboard</span></span>
                <span class="gw-bento-body">
                    <span class="gw-bento-title">Sanctum</span>
                    <span class="gw-bento-desc">Command center con KPIs, tareas y auditoría</span>
                </span>
                <span class="gw-bento-chevron material-symbols-elev" aria-hidden="true">chevron_right</span>
            </a>

            <a class="gw-bento gw-fade" style="animation-delay: .2s" href="#login-card">
                <span class="gw-bento-icon"><span class="material-symbols-elev" aria-hidden="true">edit_note</span></span>
                <span class="gw-bento-body">
                    <span class="gw-bento-title">Trading Journal</span>
                    <span class="gw-bento-desc">Bitácora de operaciones, métricas y análisis</span>
                </span>
                <span class="gw-bento-chevron material-symbols-elev" aria-hidden="true">chevron_right</span>
            </a>

            <div class="gw-grid-2">
                <a class="gw-bento gw-bento-tile gw-fade" style="animation-delay: .3s" href="#login-card">
                    <span class="material-symbols-elev" aria-hidden="true">calendar_month</span>
                    <span>
                        <span class="gw-tile-title">Calendario Macro</span>
                        <span class="gw-tile-sub">Los hilos del mundo</span>
                    </span>
                </a>
                <a class="gw-bento gw-bento-tile gw-fade" style="animation-delay: .4s" href="#login-card">
                    <span class="material-symbols-elev" aria-hidden="true">menu_book</span>
                    <span>
                        <span class="gw-tile-title">Diario</span>
                        <span class="gw-tile-sub">Bitácora privada cifrada</span>
                    </span>
                </a>
            </div>

            <a class="gw-bento gw-bento-accent gw-fade" style="animation-delay: .5s" href="#login-card">
                <span class="gw-bento-icon"><span class="material-symbols-elev" aria-hidden="true">forum</span></span>
                <span class="gw-bento-body">
                    <span class="gw-bento-title">Salón del Cónclave</span>
                    <span class="gw-bento-desc">Señales, resultados y decisiones ejecutadas</span>
                </span>
                <span class="material-symbols-elev gw-bento-play" aria-hidden="true">play_circle</span>
            </a>

            <div class="gw-grid-2">
                <a class="gw-bento gw-bento-tile gw-fade" style="animation-delay: .6s" href="#login-card">
                    <span class="material-symbols-elev" aria-hidden="true">chat</span>
                    <span>
                        <span class="gw-tile-title">Mensajes</span>
                        <span class="gw-tile-sub">Conversaciones y grupos</span>
                    </span>
                </a>
            </div>
        </section>
    </main>

    {# ─── Bottom Navigation Bar ─── #}
    <nav class="gw-bottomnav" aria-label="Módulos">
        <a class="gw-navitem" href="/">
            <span class="gw-navpill"><span class="material-symbols-elev" aria-hidden="true">home_max</span></span>
            <span>Gateway</span>
        </a>
        <a class="gw-navitem active" href="#login-card">
            <span class="gw-navpill"><span class="material-symbols-elev" aria-hidden="true">login</span></span>
            <span>Entrar</span>
        </a>
    </nav>

    {# ─── Live stats loader ─── #}
    <script nonce="{{ csp_nonce('script') }}">
    (function () {
        'use strict';
        if (typeof apiFetch === 'function') {
            apiFetch('/api/public/stats', { silent: true })
                .then(function (r) {
                    if (!r.ok || !r.data || !r.data.success) return;
                    var s = r.data.stats || {};
                    var set = function (id, val) {
                        var el = document.getElementById(id);
                        if (el) el.textContent = val;
                    };
                    if (s.active_traders !== undefined) set('stat-traders', s.active_traders);
                    if (s.trades_today !== undefined) set('stat-trades', s.trades_today);
                    if (s.global_pnl !== undefined) set('stat-pnl', s.global_pnl);
                })
                .catch(function () { /* silent fail */ });
        }
    })();
    </script>

    <script nonce="{{ csp_nonce('script') }}">
    (function () {
        'use strict';
        var form = document.getElementById('login-form');
        var codeInput = document.getElementById('login-code');
        var nameInput = document.getElementById('login-name');
        var passInput = document.getElementById('login-password');
        var passField = document.getElementById('login-password-field');
        var nameLabel = document.getElementById('login-name-label');
        var submitBtn = document.getElementById('login-submit-btn');
        var btnText = document.getElementById('login-btn-text');
        var errorEl = document.getElementById('login-error');
        var successEl = document.getElementById('login-success');

        function isAdmin(code) {
            return code.toUpperCase().startsWith('ADMIN');
        }

        codeInput.addEventListener('input', function () {
            var v = codeInput.value.trim();
            if (isAdmin(v)) {
                nameLabel.textContent = 'Nombre (opcional para admins)';
                nameInput.placeholder = 'Nombre del admin (opcional)';
            } else {
                nameLabel.textContent = 'Nombre (requerido para usuarios)';
                nameInput.placeholder = 'Ej: Demo';
            }
        });

        function showError(msg) {
            errorEl.textContent = msg;
            errorEl.style.display = 'block';
            successEl.style.display = 'none';
        }

        function showSuccess(msg) {
            successEl.textContent = msg;
            successEl.style.display = 'block';
            errorEl.style.display = 'none';
        }

        function loginOk(user, tokens) {
            user = user || {};
            showSuccess('Bienvenido ' + (user.name || user.code) + '. Redirigiendo…');
            try { localStorage.setItem('tnsvt_user', JSON.stringify(user)); } catch (_) {}
            // Persist JWT + refresh_token for apiFetch silent refresh
            // (Authorization: Bearer on every call, one retry via
            // /api/auth/refresh on 401 before bouncing to '/').
            try {
                if (tokens && tokens.token && tokens.refresh_token && typeof window.apiSaveTokens === 'function') {
                    window.apiSaveTokens({ code: user.code, token: tokens.token, refresh_token: tokens.refresh_token });
                }
            } catch (_) {}
            var target = user.isAdmin ? '/sanctum' : '/journal';
            setTimeout(function () { window.location.href = target; }, 600);
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var code = codeInput.value.trim();
            if (!code) {
                showError('Ingresá tu código de acceso');
                codeInput.focus();
                return;
            }

        // ─── Paso 2 / enrolamiento / recupero (verificación por mail) ───
        var tfaState = { challengeId: null, mode: 'login', timer: null, cooldown: null };

        function showPanel(id) {
            ['login-form', 'login-2fa', 'login-enroll', 'login-recover', 'login-reset', 'login-recover-code'].forEach(function (pid) {
                var el = document.getElementById(pid);
                if (el) el.style.display = pid === id ? '' : 'none';
            });
        }

        function startCooldown(sec) {
            var btn = document.getElementById('tfa-resend-btn');
            var label = document.getElementById('tfa-timer');
            clearInterval(tfaState.cooldown);
            var left = sec;
            btn.disabled = true;
            label.textContent = left;
            tfaState.cooldown = setInterval(function () {
                left -= 1;
                if (left <= 0) {
                    clearInterval(tfaState.cooldown);
                    btn.disabled = false;
                    btn.innerHTML = 'Reenviar código';
                } else {
                    label.textContent = left;
                }
            }, 1000);
        }

        function enterStep2(challengeId, maskedEmail, mode) {
            tfaState.challengeId = challengeId;
            tfaState.mode = mode;
            document.getElementById('tfa-email').textContent = maskedEmail || 'tu mail';
            document.getElementById('tfa-code').value = '';
            document.getElementById('tfa-error').style.display = 'none';
            showPanel('login-2fa');
            startCooldown(60);
            document.getElementById('tfa-code').focus();
        }

        function tfaError(msg) {
            var el = document.getElementById('tfa-error');
            el.textContent = msg;
            el.style.display = 'block';
        }

        document.getElementById('tfa-verify-btn').addEventListener('click', function () {
            var code = document.getElementById('tfa-code').value.trim();
            if (code.length < 6) { tfaError('Ingresá los 6 dígitos'); return; }
            fetch('/api/auth/2fa/verify', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ challenge_id: tfaState.challengeId, code: code })
            })
            .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
            .then(function (resp) {
                if (resp.status === 200 && resp.data && resp.data.success) {
                    loginOk(resp.data.user, resp.data);
                } else if (resp.status === 410) {
                    tfaError('El código venció. Pedí uno nuevo abajo.');
                } else {
                    tfaError((resp.data && resp.data.error) || 'Código incorrecto');
                }
            })
            .catch(function () { tfaError('Sin conexión con el servidor'); });
        });

        document.getElementById('tfa-resend-btn').addEventListener('click', function () {
            fetch('/api/auth/2fa/resend', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ challenge_id: tfaState.challengeId })
            })
            .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
            .then(function (resp) {
                if (resp.status === 200) {
                    startCooldown(60);
                    tfaError('');
                    document.getElementById('tfa-error').style.display = 'none';
                } else {
                    tfaError((resp.data && resp.data.error) || 'Esperá unos segundos');
                }
            })
            .catch(function () { tfaError('Sin conexión con el servidor'); });
        });

        function backToLogin() {
            clearInterval(tfaState.cooldown);
            tfaState.challengeId = null;
            if (doneLoading) doneLoading(); else submitBtn.disabled = false;
            btnText.textContent = 'Entrar';
            showPanel('login-form');
        }
        document.getElementById('tfa-back-btn').addEventListener('click', backToLogin);
        document.getElementById('enroll-back-btn').addEventListener('click', backToLogin);
        document.getElementById('recover-back-btn').addEventListener('click', backToLogin);
        document.getElementById('reset-back-btn').addEventListener('click', backToLogin);
        document.getElementById('recover-code-back-btn').addEventListener('click', backToLogin);

        // Enter en el código verifica directo.
        document.getElementById('tfa-code').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('tfa-verify-btn').click();
            }
        });
        // Solo dígitos en el código.
        document.getElementById('tfa-code').addEventListener('input', function (e) {
            e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6);
        });

        // ─── Enrolamiento ───
        document.getElementById('enroll-send-btn').addEventListener('click', function () {
            var email = document.getElementById('enroll-email').value.trim();
            var code = codeInput.value.trim().toUpperCase();
            var err = document.getElementById('enroll-error');
            if (!email || email.indexOf('@') < 0) {
                err.textContent = 'Ingresá un mail válido';
                err.style.display = 'block';
                return;
            }
            err.style.display = 'none';
            fetch('/api/auth/2fa/enroll/start', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code, email: email })
            })
            .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
            .then(function (resp) {
                if (resp.status === 200 && resp.data && resp.data.success) {
                    enterStep2(resp.data.challenge_id, resp.data.masked_email, 'enroll');
                } else {
                    err.textContent = (resp.data && resp.data.error) || 'No se pudo enviar';
                    err.style.display = 'block';
                }
            })
            .catch(function () {
                err.textContent = 'Sin conexión con el servidor';
                err.style.display = 'block';
            });
        });

        // ─── Recupero ───
        var resetChallengeId = null;
        document.getElementById('login-forgot-link').addEventListener('click', function () {
            var code = codeInput.value.trim().toUpperCase();
            if (code) document.getElementById('recover-code').value = code;
            showPanel('login-recover');
        });
        document.getElementById('login-code-forgot-link').addEventListener('click', function () {
            showPanel('login-recover-code');
        });
        document.getElementById('recover-code-send-btn').addEventListener('click', function () {
            var email = document.getElementById('recover-code-email').value.trim();
            var err = document.getElementById('recover-code-error');
            var ok = document.getElementById('recover-code-success');
            if (!email || email.indexOf('@') < 0) {
                err.textContent = 'Ingresá un mail válido';
                err.style.display = 'block';
                ok.style.display = 'none';
                return;
            }
            err.style.display = 'none';
            ok.style.display = 'none';
            fetch('/api/auth/code/forgot', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            })
            .then(function () {
                // Respuesta genérica a propósito: no revela si el mail existe.
                ok.textContent = 'Si el mail existe y está verificado, enviamos tu código.';
                ok.style.display = 'block';
            })
            .catch(function () {
                err.textContent = 'Sin conexión con el servidor';
                err.style.display = 'block';
            });
        });
        document.getElementById('recover-send-btn').addEventListener('click', function () {
            var code = document.getElementById('recover-code').value.trim().toUpperCase();
            var err = document.getElementById('recover-error');
            if (!code) {
                err.textContent = 'Ingresá tu código de adepto';
                err.style.display = 'block';
                return;
            }
            err.style.display = 'none';
            fetch('/api/auth/password/forgot', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code })
            })
            .then(function () {
                // Respuesta genérica a propósito: no revela si el código existe.
                resetChallengeId = null;
                showPanel('login-reset');
            })
            .catch(function () {
                err.textContent = 'Sin conexión con el servidor';
                err.style.display = 'block';
            });
        });
        document.getElementById('reset-save-btn').addEventListener('click', function () {
            var err = document.getElementById('reset-error');
            var code = document.getElementById('reset-code').value.trim();
            var pass = document.getElementById('reset-pass').value;
            if (code.length < 6) {
                err.textContent = 'Ingresá el código de 6 dígitos de tu mail';
                err.style.display = 'block';
                return;
            }
            if (pass.length < 10) {
                err.textContent = 'La contraseña debe tener al menos 10 caracteres';
                err.style.display = 'block';
                return;
            }
            err.style.display = 'none';
            // El challenge_id viaja implícito: el último activo de recupero.
            // Pedimos challenge por código+mail es inseguro; el server lo
            // resuelve por (usuario del forgot, propósito reset).
            fetch('/api/auth/password/reset-by-code', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    code: document.getElementById('recover-code').value.trim().toUpperCase(),
                    email_code: code,
                    new_password: pass
                })
            })
            .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
            .then(function (resp) {
                if (resp.status === 200 && resp.data && resp.data.success) {
                    showPanel('login-form');
                    showSuccess('Contraseña actualizada. Iniciá sesión con tu código y la nueva contraseña.');
                    if (doneLoading) doneLoading(); else submitBtn.disabled = false;
                    btnText.textContent = 'Entrar';
                } else {
                    err.textContent = (resp.data && resp.data.error) || 'No se pudo guardar';
                    err.style.display = 'block';
                }
            })
            .catch(function () {
                err.textContent = 'Sin conexión con el servidor';
                err.style.display = 'block';
            });
        });

            var payload = { code: code.toUpperCase() };
            if (isAdmin(code)) {
                var pass = passInput.value;
                if (!pass) {
                    showError('Los administradores necesitan contraseña');
                    passInput.focus();
                    return;
                }
                payload.password = pass;
                var name = nameInput.value.trim();
                if (name) payload.name = name;
            } else {
                var name = nameInput.value.trim();
                if (!name) {
                    showError('Los usuarios necesitan su nombre (Ej: Demo)');
                    nameInput.focus();
                    return;
                }
                payload.name = name;
                // Contraseña opcional: si el usuario definió una, el server la exige.
                if (passInput.value) payload.password = passInput.value;
            }

            var doneLoading = (typeof window.apiButtonLoading === 'function')
                ? window.apiButtonLoading(submitBtn)
                : (submitBtn.disabled = true, null);
            btnText.textContent = 'Conectando…';
            errorEl.style.display = 'none';

            fetch('/api/auth/login', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, status: r.status, data: d }; }); })
            .then(function (resp) {
                if (resp.ok && resp.data && resp.data.success) {
                    loginOk(resp.data.user, resp.data);
                } else if (resp.data && resp.data.error_code === 'two_factor_required') {
                    enterStep2(resp.data.challenge_id, resp.data.masked_email, 'login');
                } else if (resp.data && resp.data.error_code === 'enrollment_required') {
                    showPanel('login-enroll');
                } else {
                    var msg = (resp.data && resp.data.error) || 'Error ' + resp.status;
                    showError(msg);
                    if (resp.data && resp.data.error_code === 'password_invalid') passInput.focus();
                    if (doneLoading) doneLoading(); else submitBtn.disabled = false;
                    btnText.textContent = 'Entrar';
                }
            })
            .catch(function (err) {
                showError('Sin conexión con el servidor: ' + (err.message || err));
                if (doneLoading) doneLoading(); else submitBtn.disabled = false;
                btnText.textContent = 'Entrar';
            });
        });

        codeInput.focus();
    })();
    </script>
{% endblock %}
