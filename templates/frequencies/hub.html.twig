{% extends 'shell.html.twig' %}

{% block title %}Santuario de Frecuencias · T.N.S.V.T{% endblock %}

{% block topbar_title %}Santuario de Frecuencias{% endblock %}
{% block topbar_subtitle %}Dimensión Sonora · 432Hz Solfeggio{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
{# WebGL Background #}
<script src="{{ asset('js/modules/webgl-background.js') }}" defer></script>

<div class="max-w-6xl mx-auto"
     data-controller="frequency-player"
     data-frequency-player-default-duration-value="30">

    {# Header #}
    <div class="text-center mb-8">
        <p class="font-label-sm text-label-sm text-primary uppercase tracking-[0.3em] mb-2">Dimensión Sonora</p>
        <h1 class="font-headline-xl text-headline-xl shimmer-text">Santuario de Frecuencias</h1>
        <div class="h-0.5 w-24 bg-gradient-to-r from-transparent via-primary to-transparent mx-auto mt-4"></div>
    </div>

    {# Sacred Geometry Visualizer #}
    <div class="sanctuary-card mb-8">
        <div class="frequency-visualizer is-idle"
             id="frequency-visualizer"
             data-frequency-player-target="visualizer">
            <div class="freq-ring freq-ring-1"></div>
            <div class="freq-ring freq-ring-2"></div>
            <div class="freq-ring freq-ring-3"></div>
            <div class="freq-ring freq-ring-4"></div>
            <div class="freq-center">
                <p class="freq-value">432</p>
                <p class="freq-label">Hz · Sintonía Universal</p>
            </div>
        </div>
    </div>

    {# Stats + Player #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="glass-card-elev p-6 lg:col-span-2">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-full gold-glow-elev flex items-center justify-center bg-gradient-to-br from-[var(--gold-elev)] to-[var(--gold-bright-elev)]">
                    <span class="material-symbols-elev text-[var(--on-primary-elev)]" style="font-variation-settings: 'FILL' 1;">graphic_eq</span>
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-[var(--on-surface-elev)]">Sintonía actual</h2>
                    <p class="text-xs text-[var(--outline-elev)]">Web Audio API · OscillatorNode</p>
                </div>
            </div>
            <div class="text-center my-8">
                <p id="current-freq"
                   data-frequency-player-target="freqDisplay"
                   class="text-7xl font-bold text-[var(--gold-elev)] tracking-wider">—</p>
                <p id="current-freq-name"
                   data-frequency-player-target="freqNameDisplay"
                   class="text-sm text-[var(--outline-elev)] mt-2">Selecciona una frecuencia</p>
            </div>
            <div class="flex items-center justify-center gap-3 mb-6">
                <select id="duration-select"
                        data-frequency-player-target="durationSelect"
                        data-action="change->frequency-player#setDuration"
                        class="px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)] text-sm">
                    <option value="15">15 min</option>
                    <option value="30" selected>30 min</option>
                    <option value="60">1 hora</option>
                    <option value="0">∞ Infinito</option>
                </select>
                <button id="play-btn"
                        data-frequency-player-target="playBtn"
                        data-action="click->frequency-player#startSession"
                        class="ui-btn ui-btn primary">
                    <span class="material-symbols-elev align-middle">play_arrow</span>
                    Iniciar
                </button>
                <button id="stop-btn"
                        data-frequency-player-target="stopBtn"
                        data-action="click->frequency-player#stopSession"
                        class="ui-btn ui-btn ghost" disabled>
                    <span class="material-symbols-elev align-middle">stop</span>
                    Detener
                </button>
            </div>
            <div id="timer-display"
                 data-frequency-player-target="timerDisplay"
                 class="text-center text-sm text-[var(--outline-elev)] h-6"></div>
        </div>

        <div class="glass-card-elev p-6">
            <h3 class="text-sm font-semibold text-[var(--outline-elev)] mb-4 tracking-wider">TU PRÁCTICA</h3>
            <div id="user-stats">
                <div class="mb-4">
                    <p class="text-xs text-[var(--outline-elev)]">Total minutos</p>
                    <p id="stat-minutes"
                       data-frequency-player-target="statMinutes"
                       class="text-3xl font-bold text-[var(--gold-elev)]">0</p>
                </div>
                <div class="mb-4">
                    <p class="text-xs text-[var(--outline-elev)]">Horas equivalentes</p>
                    <p id="stat-hours"
                       data-frequency-player-target="statHours"
                       class="text-2xl text-[var(--on-surface-elev)]">0.0</p>
                </div>
                <div>
                    <p class="text-xs text-[var(--outline-elev)]">Sesiones activas</p>
                    <p id="stat-active"
                       data-frequency-player-target="statActive"
                       class="text-2xl text-[var(--on-surface-elev)]">0</p>
                </div>
            </div>
        </div>
    </div>

    {# Frequency grid (loaded by Stimulus) #}
    <h3 class="text-xl font-semibold mb-4 text-[var(--on-surface-elev)]">Frecuencias Sagradas</h3>
    {# L59: recently played (localStorage, rendered by Stimulus) #}
    <div id="recent-freqs"
         data-frequency-player-target="recentFreqs"
         class="flex flex-wrap gap-2 mb-4"
         hidden></div>
    <div id="presets-grid"
         data-frequency-player-target="presetsGrid"
         class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-8">
        <p class="col-span-full text-center text-[var(--outline-elev)] py-8">Cargando frecuencias...</p>
    </div>

    {# My custom frequencies #}
    <h3 class="text-xl font-semibold mb-4 text-[var(--on-surface-elev)]">Mis Frecuencias</h3>
    <div class="glass-card-elev p-4 mb-4">
        <div class="flex gap-2 mb-3">
            <input id="my-freq-name"
                   data-frequency-player-target="myFreqName"
                   type="text"
                   placeholder="Nombre (ej: Meditación matutina)"
                   class="flex-1 px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)]" />
            <input id="my-freq-hz"
                   data-frequency-player-target="myFreqHz"
                   type="number" min="50" max="2000" placeholder="Hz"
                   class="w-24 px-3 py-2 rounded bg-[var(--glass-bg-elev)] border border-[var(--outline-variant-elev)] text-[var(--on-surface-elev)]" />
            <button id="add-freq-btn"
                    data-frequency-player-target="addFreqBtn"
                    data-action="click->frequency-player#addMyFreq"
                    class="ui-btn ui-btn secondary text-xs">+ Agregar</button>
        </div>
        <div id="my-freqs-list"
             data-frequency-player-target="myFreqsList"
             class="space-y-2">
            <p class="text-sm text-[var(--outline-elev)] text-center py-4">Sin frecuencias personalizadas aún.</p>
        </div>
    </div>

    {# Sacred Timer #}
    <div class="sanctuary-card">
        <div class="flex items-center justify-between mb-4">
            <span class="font-label-md text-label-md text-on-surface uppercase tracking-widest">Sacred Timer</span>
            <span class="font-label-sm text-label-sm text-primary">Focused Session</span>
        </div>
        <div class="grid grid-cols-4 gap-3">
            <button type="button" class="timer-btn" data-time="15">15m</button>
            <button type="button" class="timer-btn active" data-time="30">30m</button>
            <button type="button" class="timer-btn" data-time="60">1h</button>
            <button type="button" class="timer-btn" data-time="0"><span class="material-symbols-outlined">all_inclusive</span></button>
        </div>
    </div>

    {# Floating Mini Player #}
    <div class="mini-player"
         id="mini-player"
         data-frequency-player-target="miniPlayer"
         style="display: none;">
        <div class="mini-player-icon">
            <span class="material-symbols-outlined text-[var(--void-black)]" style="font-size: 1rem; font-variation-settings: 'FILL' 1;">music_note</span>
        </div>
        <div>
            <p class="text-xs font-bold text-[var(--gold-elev)]" id="mini-player-freq">432Hz</p>
            <p class="text-[10px] text-[var(--outline-elev)]">TNSVT Sanctum</p>
        </div>
        <button id="mini-player-toggle"
                data-frequency-player-target="miniPlayerToggle"
                data-action="click->frequency-player#toggleMiniPlayer"
                class="text-[var(--on-surface-elev)]">
            <span class="material-symbols-outlined">pause</span>
        </button>
    </div>
</div>
{% endblock %}
