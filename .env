# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
APP_VERSION=2.0.0
APP_VERSION_CODE=500

###> sentry/sentry-symfony ###
# Sentry error tracking. Leave empty to disable. Set SENTRY_DSN in .env.local for production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
###< sentry/sentry-symfony ###
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"

###> lexik/jwt-authentication-bundle ###
# Generate with: openssl genrsa -out config/jwt/private.pem -aes256 -algorithm rsa -pkeyopt rsa_keygen_bits:4096
#                 openssl rsa -pubout -in config/jwt/private.pem -out config/jwt/public.pem
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=!placeholder-rotate-in-env-local!
###< lexik/jwt-authentication-bundle ###
###> doctrine/doctrine-bundle ###
# Set DATABASE_URL in .env.local (NOT .env, NOT committed).
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> trusted-proxies ###
# Comma-separated list of IPs/CIDR ranges of trusted reverse proxies.
# Set in .env.local to your hosting provider's proxy IP(s) (e.g. Hostinger).
# Default in .env (dev): trust REMOTE_ADDR so rate limiters work behind any proxy.
# Example for Hostinger shared: TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< trusted-proxies ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=default&auto_setup=0
###< symfony/messenger ###

###> mercure ###
# Mercure hub URL — for SSE (Server-Sent Events) push notifications
# Local dev: run `mercure` binary (download from https://mercure.rocks)
# Production: deploy alongside Symfony or use managed service
# MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
# JWT secret for publishing — generate with: openssl rand -base64 32
MERCURE_JWT_SECRET=!rotate-in-env-local-mercure-jwt!
###< mercure ###

###> legacy-migration ###
# Connection string for the legacy tnsvt.com DB.
# Set LEGACY_DATABASE_URL in .env.local (NOT .env, NOT committed).
# Example: mysql://u310596868:PASS@localhost:3306/u310596868_tnsvt?serverVersion=8.0.32&charset=utf8mb4
# LEGACY_DATABASE_URL=
###< legacy-migration ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###
