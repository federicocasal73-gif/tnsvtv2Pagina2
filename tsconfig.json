{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022", "DOM"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "noEmit": true,
        "types": ["@playwright/test"]
    },
    "include": [
        "tests/e2e/**/*.ts",
        "playwright.config.ts"
    ]
}
